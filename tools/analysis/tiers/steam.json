{
  "tier": "steam",
  "title": "Era de vapor",
  "note": "Puerta: coque -> bronce -> vapor -> acero -> turbina de vapor LV + primer circuito LV + casco LV (docs/eras/vapor.md). Fuentes: GregTech Modern 7.5.3 (GTMachines, GTMultiMachines, GTOres, FuelRecipes) y el volcado de gg_dump.js.",

  "unconditionalTypes": [
    "minecraft:crafting_shaped",
    "minecraft:crafting_shapeless",
    "gtceu:crafting_shaped_strict",
    "gtceu:crafting_shaped_energy_transfer",
    "gtceu:crafting_shaped_fluid_container"
  ],

  "typeAliases": {
    "kubejs:shaped": "minecraft:crafting_shaped",
    "kubejs:shapeless": "minecraft:crafting_shapeless",
    "gtceu:shaped": "minecraft:crafting_shaped",
    "gtceu:shapeless": "minecraft:crafting_shapeless"
  },

  "ignoreTypes": [
    "minecraft:crafting_special_*",
    "minecraft:crafting_decorated_pot",
    "minecraft:smithing_trim",
    "gtceu:crafting_tool_head_replace",
    "gtceu:crafting_facade_cover",
    "ae2:*"
  ],

  "toolTags": [
    "gtceu:tools/crafting_hammers",
    "gtceu:tools/crafting_files",
    "gtceu:tools/crafting_mortars",
    "gtceu:tools/crafting_saws",
    "gtceu:tools/crafting_screwdrivers",
    "gtceu:tools/crafting_wrenches",
    "gtceu:tools/crafting_wire_cutters",
    "gtceu:tools/crafting_crowbars",
    "gtceu:tools/crafting_knives",
    "gtceu:tools/crafting_mallets"
  ],

  "conditions": {
    "adjacent_fluid": { "fluidsFrom": "fluids" },
    "cleanroom": { "unsupported": true },
    "research": { "unsupported": true },
    "*": { "ignore": true }
  },

  "world": [
    {
      "id": "arboles",
      "mode": "manual",
      "bootstrap": true,
      "items": ["#minecraft:logs_that_burn", "#minecraft:saplings", "gtceu:rubber_leaves", "minecraft:apple"],
      "note": "Talar y recoger plantones de las hojas."
    },
    {
      "id": "resina",
      "mode": "manual",
      "bootstrap": true,
      "items": ["gtceu:sticky_resin"],
      "note": "Los troncos de caucho naturales (rubberTreeSpawnChance 0,5 por chunk) sueltan resina pegajosa el 85 % de las veces (loot_tables/blocks/rubber_log.json de GTM)."
    },
    {
      "id": "suelo",
      "mode": "manual",
      "bootstrap": true,
      "items": [
        "minecraft:dirt", "minecraft:grass_block", "minecraft:gravel", "#minecraft:sand", "minecraft:clay_ball", "minecraft:clay",
        "minecraft:cobblestone", "minecraft:andesite", "minecraft:diorite", "minecraft:granite", "minecraft:cobbled_deepslate",
        "minecraft:flint"
      ],
      "note": "Se pica o se excava con herramientas de madera/piedra. El pedernal sale de la grava."
    },
    {
      "id": "plantas",
      "mode": "manual",
      "items": [
        "minecraft:sugar_cane", "minecraft:wheat_seeds", "minecraft:wheat", "minecraft:beetroot_seeds", "minecraft:melon_seeds",
        "minecraft:pumpkin_seeds", "minecraft:carrot", "minecraft:potato", "minecraft:cactus", "minecraft:bamboo", "minecraft:vine",
        "#minecraft:flowers"
      ],
      "note": "Cultivos y plantas del mundo."
    },
    {
      "id": "fluidos",
      "mode": "manual",
      "bootstrap": true,
      "items": ["fluid:minecraft:water", "fluid:minecraft:lava"],
      "note": "Con cubo. La lava solo hace falta una vez, junto a la trituradora de rocas."
    },
    {
      "id": "gemas-y-polvos",
      "mode": "manual",
      "bootstrap": true,
      "items": ["minecraft:coal", "minecraft:redstone", "minecraft:raw_iron", "minecraft:raw_copper", "minecraft:raw_gold"],
      "note": "GTM 7.5.3 quita las menas vanilla (removeVanillaOreGen = true): el carbón y la redstone vienen de las vetas coal_vein / redstone_vein_ow, y el hierro, cobre y oro crudos de copper_vein (deepslate) y magnetite_vein_ow; GT unifica sus items crudos con los vanilla."
    },
    {
      "id": "menas-gt",
      "mode": "manual",
      "bootstrap": true,
      "template": "gtceu:raw_{m}",
      "fromVeins": { "dimensions": ["minecraft:overworld"], "layers": ["stone", "deepslate"] },
      "materials": [
        "almandine", "apatite", "asbestos", "bauxite", "bentonite", "calcite", "cassiterite", "cassiterite_sand", "chalcopyrite",
        "cinnabar", "cobaltite", "diatomite", "fullers_earth", "galena", "garnet_sand", "garnierite", "glauconite_sand", "goethite",
        "gold", "granitic_mineral_sand", "graphite", "green_sapphire", "grossular", "gypsum", "hematite", "kyanite", "lazurite",
        "lead", "lepidolite", "magnesite", "magnetite", "malachite", "mica", "nickel", "olivine", "opal", "pentlandite", "pollucite",
        "pyrite", "pyrochlore", "pyrolusite", "pyrope", "realgar", "red_garnet", "rock_salt", "ruby", "salt", "sapphire", "silver",
        "soapstone", "sodalite", "spessartine", "spodumene", "talc", "tantalite", "tin", "tricalcium_phosphate", "vanadium_magnetite",
        "yellow_garnet", "yellow_limonite", "zeolite", "basaltic_mineral_sand", "amethyst"
      ],
      "note": "Menas crudas de las vetas del Overworld de GTM 7.5.3 (volcado veins.json; la lista `materials` es solo de reserva)."
    },
    {
      "id": "mobs",
      "mode": "manual",
      "enabled": false,
      "items": ["minecraft:string", "minecraft:leather", "minecraft:bone", "minecraft:feather", "minecraft:gunpowder", "minecraft:slime_ball"],
      "note": "Botín de mobs. Deshabilitado a propósito: si una receta de la puerta lo necesita, es un fallo del diseño (el informe lo señala)."
    },
    {
      "id": "bomba-primitiva",
      "mode": "auto",
      "via": ["gtceu:primitive_pump"],
      "items": ["fluid:minecraft:water"],
      "note": "La bomba primitiva da agua sin parar (PrimitivePumpMachine); no tiene recetas, por eso se modela como fuente."
    },
    {
      "id": "minero-de-vapor",
      "mode": "auto",
      "finite": true,
      "via": ["gtceu:lp_steam_miner", "gtceu:hp_steam_miner"],
      "items": [
        "minecraft:coal", "minecraft:redstone", "minecraft:raw_iron", "minecraft:raw_copper", "minecraft:raw_gold",
        "minecraft:cobblestone", "minecraft:dirt", "minecraft:gravel", "#minecraft:sand"
      ],
      "note": "El minero de vapor recoge lo que hay bajo él y lo agota; no hay recetas (DUMMY_RECIPES)."
    },
    {
      "id": "minero-de-vapor-menas",
      "mode": "auto",
      "finite": true,
      "via": ["gtceu:lp_steam_miner", "gtceu:hp_steam_miner"],
      "template": "gtceu:raw_{m}",
      "fromVeins": { "dimensions": ["minecraft:overworld"], "layers": ["stone", "deepslate"] },
      "materials": [],
      "note": "Igual que arriba, para las menas crudas de GT."
    }
  ],

  "machines": [
    {
      "machine": "minecraft:furnace",
      "types": ["minecraft:smelting"],
      "needs": [["#minecraft:coals", "#minecraft:logs_that_burn", "gtceu:coke_gem"]],
      "note": "Horno vanilla: gasta combustible."
    },
    {
      "machine": "minecraft:blast_furnace",
      "types": ["minecraft:blasting"],
      "needs": [["#minecraft:coals", "#minecraft:logs_that_burn", "gtceu:coke_gem"]]
    },
    {
      "machine": "minecraft:smoker",
      "types": ["minecraft:smoking"],
      "needs": [["#minecraft:coals", "#minecraft:logs_that_burn", "gtceu:coke_gem"]]
    },
    {
      "machine": "minecraft:campfire",
      "types": ["minecraft:campfire_cooking"],
      "needs": [["#minecraft:logs_that_burn", "#minecraft:coals"]]
    },
    { "machine": "minecraft:stonecutter", "types": ["minecraft:stonecutting"] },
    { "machine": "minecraft:smithing_table", "types": ["minecraft:smithing_transform"] },

    { "machine": "gtceu:coke_oven", "types": ["gtceu:coke_oven"], "parts": ["gtceu:coke_oven_bricks"], "note": "Patrón: casing de ladrillos de coque + escotilla opcional (COKE_OVEN en GTMultiMachines)." },
    { "machine": "gtceu:primitive_blast_furnace", "types": ["gtceu:primitive_blast_furnace"], "parts": ["gtceu:firebricks"], "note": "Patrón: bloques de ladrillo refractario." },
    {
      "machine": "gtceu:primitive_pump",
      "types": [],
      "parts": ["gtceu:pump_deck", "gtceu:treated_wood_frame", ["gtceu:pump_hatch", "gtceu:ulv_output_hatch", "gtceu:lv_output_hatch"]],
      "note": "Cubierta de bomba + marcos de madera tratada + escotilla de bomba o de salida de fluidos."
    },

    { "machine": "gtceu:lp_steam_solid_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:lp_steam_liquid_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:lp_steam_solar_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:hp_steam_solid_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:hp_steam_liquid_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:hp_steam_solar_boiler", "types": ["gtceu:steam_boiler"] },

    { "machine": "gtceu:lp_steam_macerator", "types": ["gtceu:macerator"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"], "note": "SimpleSteamMachine.recipeModifier: rechaza recetas por encima de LV (32 EU/t)." },
    { "machine": "gtceu:hp_steam_macerator", "types": ["gtceu:macerator"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_furnace", "types": ["gtceu:electric_furnace"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"], "note": "GT clona las recetas vanilla de horno (minecraft:smelting) en este tipo." },
    { "machine": "gtceu:hp_steam_furnace", "types": ["gtceu:electric_furnace"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_alloy_smelter", "types": ["gtceu:alloy_smelter"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_alloy_smelter", "types": ["gtceu:alloy_smelter"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_compressor", "types": ["gtceu:compressor"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_compressor", "types": ["gtceu:compressor"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_extractor", "types": ["gtceu:extractor"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_extractor", "types": ["gtceu:extractor"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_forge_hammer", "types": ["gtceu:forge_hammer"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_forge_hammer", "types": ["gtceu:forge_hammer"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_rock_crusher", "types": ["gtceu:rock_breaker"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_rock_crusher", "types": ["gtceu:rock_breaker"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_miner", "types": [], "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_miner", "types": [], "needs": ["fluid:gtceu:steam"] },

    {
      "machine": "gtceu:steam_grinder",
      "types": ["gtceu:macerator"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "parts": ["gtceu:bronze_brick_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus"],
      "note": "Multibloque de vapor de GTM (SteamParallelMultiblockMachine): rechaza recetas por encima de LV."
    },
    {
      "machine": "gtceu:steam_oven",
      "types": ["gtceu:electric_furnace"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "parts": ["gtceu:bronze_brick_casing", "gtceu:bronze_firebox_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus"]
    },

    {
      "machine": "gtceu:steam_vein_drill",
      "types": ["gtceu:vein_drilling"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "parts": [
        "gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus",
        ["gtceu:bronze_pipe_casing", "gtceu:steel_pipe_casing"], ["gtceu:bronze_frame", "gtceu:steel_frame"]
      ],
      "note": "Patrón de pack/kubejs/startup_scripts/grindless/steam/machines.js (veinDrillPattern)."
    },
    {
      "machine": "gtceu:steam_greenhouse",
      "types": ["gtceu:greenhouse"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "parts": [
        "gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus",
        "#forge:glass", ["minecraft:dirt", "minecraft:grass_block"]
      ],
      "note": "Patrón de machines.js (greenhousePattern): casco de vapor, cristal y suelo de tierra."
    },

    {
      "machine": "gtceu:lv_steam_turbine",
      "types": ["gtceu:steam_turbine"],
      "needs": ["fluid:gtceu:steam"],
      "note": "Generador LV de un bloque: quema vapor y da 32 EU/t."
    }
  ],

  "synthetic": [
    {
      "id": "caldera-solida",
      "machines": ["gtceu:lp_steam_solid_boiler", "gtceu:hp_steam_solid_boiler"],
      "consumes": [{ "fuelOf": "gtceu:steam_boiler", "kind": "item" }, "fluid:minecraft:water"],
      "produces": ["fluid:gtceu:steam"],
      "note": "Las calderas no usan receta de salida: las recetas gtceu:steam_boiler solo listan combustibles (FuelRecipes). Convierte combustible sólido + agua en vapor."
    },
    {
      "id": "caldera-liquida",
      "machines": ["gtceu:lp_steam_liquid_boiler", "gtceu:hp_steam_liquid_boiler"],
      "consumes": [{ "fuelOf": "gtceu:steam_boiler", "kind": "fluid" }, "fluid:minecraft:water"],
      "produces": ["fluid:gtceu:steam"]
    },
    {
      "id": "caldera-solar",
      "machines": ["gtceu:lp_steam_solar_boiler", "gtceu:hp_steam_solar_boiler"],
      "consumes": ["fluid:minecraft:water"],
      "produces": ["fluid:gtceu:steam"]
    }
  ],

