{
  "tier": "steam",
  "title": "Steam era",
  "note": "Gate: coke -> bronze -> steam -> steel -> LV steam turbine + first LV circuit + LV hull (docs/eras/steam.md). Sources: GregTech Modern 7.5.3 (GTMachines, GTMultiMachines, GTOres, FuelRecipes) and the gg_dump.js dump.",

  "eraOrder": ["steam", "lv", "mv", "hv", "ev", "ev-mars", "iv", "iv-venus", "iv-mercury", "luv", "zpm", "uv", "uhv", "uev", "uiv", "uxv", "opv", "max"],
  "eraSiblings": [["iv-venus", "iv-mercury"]],

  "unconditionalTypes": [
    "minecraft:crafting_shaped",
    "minecraft:crafting_shapeless",
    "gtceu:crafting_shaped_strict",
    "gtceu:crafting_shaped_energy_transfer",
    "gtceu:crafting_shaped_fluid_container",
    "enderchests:crafting",
    "endertanks:crafting",
    "sophisticatedbackpacks:basic_backpack",
    "sophisticatedbackpacks:backpack_upgrade",
    "sophisticatedcore:upgrade_next_tier"
  ],

  "typeAliases": {
    "kubejs:shaped": "minecraft:crafting_shaped",
    "kubejs:shapeless": "minecraft:crafting_shapeless",
    "gtceu:shaped": "minecraft:crafting_shaped",
    "gtceu:shapeless": "minecraft:crafting_shapeless"
  },

  "ignoreTypes": [
    "minecraft:crafting_special_*",
    "minecraft:crafting_decorated_pot",
    "minecraft:smithing_trim",
    "gtceu:crafting_tool_head_replace",
    "gtceu:crafting_facade_cover",
    "ae2:entropy",
    "ae2:matter_cannon",
    "ae2:facade"
  ],

  "toolTags": [
    "gtceu:tools/crafting_hammers",
    "gtceu:tools/crafting_files",
    "gtceu:tools/crafting_mortars",
    "gtceu:tools/crafting_saws",
    "gtceu:tools/crafting_screwdrivers",
    "gtceu:tools/crafting_wrenches",
    "gtceu:tools/crafting_wire_cutters",
    "gtceu:tools/crafting_crowbars",
    "gtceu:tools/crafting_knives",
    "gtceu:tools/crafting_mallets"
  ],

  "conditions": {
    "adjacent_fluid": { "fluidsFrom": "fluids" },
    "cleanroom": { "unsupported": true },
    "research": { "unsupported": true },
    "environmental_hazard": { "unsupported": true },
    "*": { "ignore": true }
  },

  "partAbilities": {
    "steam": ["gtceu:steam_input_hatch"],
    "steam_input_bus": ["gtceu:steam_input_bus"],
    "steam_output_bus": ["gtceu:steam_output_bus"]
  },

  "world": [
    {
      "id": "trees",
      "mode": "manual",
      "bootstrap": true,
      "items": ["#minecraft:logs_that_burn", "#minecraft:saplings", "gtceu:rubber_leaves", "minecraft:apple"],
      "note": "Chop trees and collect saplings from leaves."
    },
    {
      "id": "resin",
      "mode": "manual",
      "bootstrap": true,
      "items": ["gtceu:sticky_resin"],
      "note": "Natural rubber logs (rubberTreeSpawnChance 0.5 per chunk) drop sticky resin 85% of the time (GTM's loot_tables/blocks/rubber_log.json)."
    },
    {
      "id": "ground",
      "mode": "manual",
      "bootstrap": true,
      "items": [
        "minecraft:dirt", "minecraft:grass_block", "minecraft:gravel", "#minecraft:sand", "minecraft:clay_ball", "minecraft:clay",
        "minecraft:cobblestone", "minecraft:andesite", "minecraft:diorite", "minecraft:granite", "minecraft:cobbled_deepslate",
        "minecraft:flint"
      ],
      "note": "Mined or dug with wood/stone tools. Flint comes from gravel."
    },
    {
      "id": "stones-gt",
      "mode": "manual",
      "items": ["gtceu:marble", "gtceu:red_granite"],
      "note": "GTM 7.5.3's stone patches in the Overworld (GTPlacedFeatures/GTBiomeModifiers), mined by hand; tiers/obtain.json has the same source. GTM's red granite gave a chance of uranium dust in the macerator: the pack rebuilds it without (grindless:macerator/offworld_only/macerate_red_granite), and the EV tier's radioactive check watches it."
    },
    {
      "id": "plants",
      "mode": "manual",
      "items": [
        "minecraft:sugar_cane", "minecraft:wheat_seeds", "minecraft:wheat", "minecraft:beetroot_seeds", "minecraft:melon_seeds",
        "minecraft:pumpkin_seeds", "minecraft:carrot", "minecraft:potato", "minecraft:cactus", "minecraft:bamboo", "minecraft:vine",
        "#minecraft:flowers"
      ],
      "note": "Crops and plants from the world."
    },
    {
      "id": "fluids",
      "mode": "manual",
      "bootstrap": true,
      "items": ["fluid:minecraft:water", "fluid:minecraft:lava"],
      "note": "With a bucket. Lava is only needed once, next to the rock crusher."
    },
    {
      "id": "gems-and-dusts",
      "mode": "manual",
      "bootstrap": true,
      "items": ["minecraft:coal", "minecraft:redstone", "minecraft:raw_iron", "minecraft:raw_copper", "minecraft:raw_gold"],
      "note": "GTM 7.5.3 removes vanilla ores (removeVanillaOreGen = true): coal and redstone come from the coal_vein / redstone_vein_ow veins, and raw iron, copper and gold from copper_vein (deepslate) and magnetite_vein_ow; GT unifies its raw items with the vanilla ones."
    },
    {
      "id": "ores-gt",
      "mode": "manual",
      "bootstrap": true,
      "template": "gtceu:raw_{m}",
      "fromVeins": { "dimensions": ["minecraft:overworld"], "layers": ["stone", "deepslate"] },
      "materials": [
        "almandine", "apatite", "asbestos", "bauxite", "bentonite", "calcite", "cassiterite", "cassiterite_sand", "chalcopyrite",
        "cinnabar", "cobaltite", "diatomite", "fullers_earth", "galena", "garnet_sand", "garnierite", "glauconite_sand", "goethite",
        "gold", "granitic_mineral_sand", "graphite", "green_sapphire", "grossular", "gypsum", "hematite", "kyanite", "lazurite",
        "lead", "lepidolite", "magnesite", "magnetite", "malachite", "mica", "nickel", "olivine", "opal", "pentlandite", "pollucite",
        "pyrite", "pyrochlore", "pyrolusite", "pyrope", "realgar", "red_garnet", "rock_salt", "ruby", "salt", "sapphire", "silver",
        "soapstone", "sodalite", "spessartine", "spodumene", "talc", "tantalite", "tin", "tricalcium_phosphate", "vanadium_magnetite",
        "yellow_garnet", "yellow_limonite", "zeolite", "basaltic_mineral_sand", "amethyst"
      ],
      "note": "Raw ores from GTM 7.5.3's Overworld veins (veins.json dump; the `materials` list is just a fallback)."
    },
    {
      "id": "mobs",
      "mode": "manual",
      "enabled": false,
      "items": ["minecraft:string", "minecraft:leather", "minecraft:bone", "minecraft:feather", "minecraft:gunpowder", "minecraft:slime_ball"],
      "note": "Mob loot. Disabled on purpose: if a gate recipe needs it, that's a design flaw (the report flags it)."
    },
    {
      "id": "pump-primitive",
      "mode": "auto",
      "via": ["gtceu:primitive_pump"],
      "items": ["fluid:minecraft:water"],
      "note": "The primitive pump gives water non-stop (PrimitivePumpMachine); it has no recipes, which is why it's modeled as a source."
    },
    {
      "id": "miner-of-steam",
      "mode": "auto",
      "finite": true,
      "via": ["gtceu:lp_steam_miner", "gtceu:hp_steam_miner"],
      "items": [
        "minecraft:coal", "minecraft:redstone", "minecraft:raw_iron", "minecraft:raw_copper", "minecraft:raw_gold",
        "minecraft:cobblestone", "minecraft:dirt", "minecraft:gravel", "#minecraft:sand"
      ],
      "note": "The steam miner picks up whatever is beneath it and depletes it; there are no recipes (DUMMY_RECIPES)."
    },
    {
      "id": "miner-of-steam-ores",
      "mode": "auto",
      "finite": true,
      "via": ["gtceu:lp_steam_miner", "gtceu:hp_steam_miner"],
      "template": "gtceu:raw_{m}",
      "fromVeins": { "dimensions": ["minecraft:overworld"], "layers": ["stone", "deepslate"] },
      "materials": [],
      "note": "Same as above, for GT's raw ores."
    }
  ],

  "machines": [
    {
      "machine": "minecraft:furnace",
      "types": ["minecraft:smelting"],
      "needs": [["#minecraft:coals", "#minecraft:logs_that_burn", "gtceu:coke_gem"]],
      "note": "Vanilla furnace: consumes fuel."
    },
    {
      "machine": "minecraft:blast_furnace",
      "types": ["minecraft:blasting"],
      "needs": [["#minecraft:coals", "#minecraft:logs_that_burn", "gtceu:coke_gem"]]
    },
    {
      "machine": "minecraft:smoker",
      "types": ["minecraft:smoking"],
      "needs": [["#minecraft:coals", "#minecraft:logs_that_burn", "gtceu:coke_gem"]]
    },
    {
      "machine": "minecraft:campfire",
      "types": ["minecraft:campfire_cooking"],
      "needs": [["#minecraft:logs_that_burn", "#minecraft:coals"]]
    },
    { "machine": "minecraft:stonecutter", "types": ["minecraft:stonecutting"] },
    { "machine": "minecraft:smithing_table", "types": ["minecraft:smithing_transform"] },

    { "machine": "gtceu:coke_oven", "types": ["gtceu:coke_oven"], "parts": ["gtceu:coke_oven_bricks"], "note": "Pattern: coke-brick casing + an optional hatch (COKE_OVEN in GTMultiMachines)." },
    { "machine": "gtceu:primitive_blast_furnace", "types": ["gtceu:primitive_blast_furnace"], "parts": ["gtceu:firebricks"], "note": "Pattern: firebrick blocks." },
    {
      "machine": "gtceu:primitive_pump",
      "types": [],
      "parts": ["gtceu:pump_deck", "gtceu:treated_wood_frame", ["gtceu:pump_hatch", "gtceu:ulv_output_hatch", "gtceu:lv_output_hatch"]],
      "note": "Pump deck + treated wood frames + a pump hatch or fluid output hatch."
    },

    { "machine": "gtceu:lp_steam_solid_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:lp_steam_liquid_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:lp_steam_solar_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:hp_steam_solid_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:hp_steam_liquid_boiler", "types": ["gtceu:steam_boiler"] },
    { "machine": "gtceu:hp_steam_solar_boiler", "types": ["gtceu:steam_boiler"] },

    { "machine": "gtceu:lp_steam_macerator", "types": ["gtceu:macerator"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"], "note": "SimpleSteamMachine.recipeModifier: rejects recipes above LV (32 EU/t)." },
    { "machine": "gtceu:hp_steam_macerator", "types": ["gtceu:macerator"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_furnace", "types": ["gtceu:electric_furnace"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"], "note": "GT clones the vanilla furnace recipes (minecraft:smelting) into this type." },
    { "machine": "gtceu:hp_steam_furnace", "types": ["gtceu:electric_furnace"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_alloy_smelter", "types": ["gtceu:alloy_smelter"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_alloy_smelter", "types": ["gtceu:alloy_smelter"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_compressor", "types": ["gtceu:compressor"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_compressor", "types": ["gtceu:compressor"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_extractor", "types": ["gtceu:extractor"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_extractor", "types": ["gtceu:extractor"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_forge_hammer", "types": ["gtceu:forge_hammer"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_forge_hammer", "types": ["gtceu:forge_hammer"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_rock_crusher", "types": ["gtceu:rock_breaker"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_rock_crusher", "types": ["gtceu:rock_breaker"], "maxEUt": 32, "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:lp_steam_miner", "types": [], "needs": ["fluid:gtceu:steam"] },
    { "machine": "gtceu:hp_steam_miner", "types": [], "needs": ["fluid:gtceu:steam"] },

    {
      "machine": "gtceu:steam_grinder",
      "types": ["gtceu:macerator"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "parts": ["gtceu:bronze_brick_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus"],
      "note": "GTM's steam multiblock (SteamParallelMultiblockMachine): rejects recipes above LV."
    },
    {
      "machine": "gtceu:steam_oven",
      "types": ["gtceu:electric_furnace"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "parts": ["gtceu:bronze_brick_casing", "gtceu:bronze_firebox_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus"]
    },

    {
      "machine": "gtceu:steam_vein_drill",
      "types": ["gtceu:vein_drilling"],
      "onlyTier": "",
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus",
        ["gtceu:bronze_pipe_casing", "gtceu:steel_pipe_casing"], ["gtceu:bronze_frame", "gtceu:steel_frame"]
      ],
      "note": "The parts come from the structure the pack dumps (structures.json); `parts` is the fallback for when the dump doesn't carry it (machines.js's pattern, veinDrillPattern)."
    },
    {
      "machine": "gtceu:steam_greenhouse",
      "types": ["gtceu:greenhouse"],
      "onlyTier": "",
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus",
        "#forge:glass", ["minecraft:dirt", "minecraft:grass_block"]
      ],
      "note": "Same: the pack's structure first, `parts` as fallback (greenhousePattern: steam hull, glass and dirt floor)."
    },
    {
      "machine": "gtceu:steam_observatory",
      "types": ["gtceu:stargazing"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus", "minecraft:stone_bricks",
        "gtceu:bronze_gearbox", "gtceu:bronze_frame", "gtceu:bronze_pipe_casing", "#forge:glass"
      ],
      "note": "Clockwork observatory (observatory/machines.js): steam-hull platform with its parts, a stone brick pillar, a bronze gear box between two frame forks, and a bronze pipe-casing tube with a glass pane. Its recipe conditions (at night, clear sky, controller at Y 100 or above) aren't modeled: the validator takes them as met, and gg_test_observatory checks them in-game."
    },

    {
      "machine": "gtceu:steam_blast_furnace",
      "types": ["gtceu:steelmaking"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus", "gtceu:firebricks",
        ["gtceu:bronze_pipe_casing", "gtceu:steel_pipe_casing"], ["gtceu:bronze_frame", "gtceu:steel_frame"]
      ],
      "note": "Steam blast furnace (steam/blast_furnace.js): crucible of steam hull with its parts, hollow firebrick bosh and shaft, pipe-casing tuyeres and downcomer, and four frame posts. Iron ore + coke + calcite -> steel + ash."
    },
    {
      "machine": "gtceu:coking_battery",
      "types": ["gtceu:coking"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "partAbilities": { "output_hatch": ["gtceu:ulv_output_hatch", "gtceu:lv_output_hatch"] },
      "parts": [
        "gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus", "gtceu:coke_oven_bricks",
        "gtceu:bronze_firebox_casing", ["gtceu:bronze_pipe_casing", "gtceu:steel_pipe_casing"], ["gtceu:ulv_output_hatch", "gtceu:lv_output_hatch"]
      ],
      "note": "Coking battery with byproducts (steam/coking_battery.js): steam-hull base and roof with its parts, coke-brick chambers between bronze firebox walls and a pipe-casing gas collector. The two fluid output hatches are GTM's; the ULV one has a hand-craftable recipe in steam (ULV hull + glass + resin)."
    },
    {
      "machine": "gtceu:steam_forge_hammer",
      "types": ["gtceu:forge_hammer"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": ["gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus"],
      "note": "Steam Forge Hammer (steam/small_family.js, small steam family, GTL's idea, reimplemented): hollow 3x3x3 cube, 8 parallels, GTM's forge hammer recipe untouched. Replaces gtceu:lp_steam_forge_hammer/hp_steam_forge_hammer (a single block)."
    },
    {
      "machine": "gtceu:steam_compressor",
      "types": ["gtceu:compressor"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": ["gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus"],
      "note": "Steam Compressor (steam/small_family.js): same casing, GTM's compressor recipe untouched. Replaces gtceu:lp_steam_compressor/hp_steam_compressor."
    },
    {
      "machine": "gtceu:steam_alloy_smelter",
      "types": ["gtceu:alloy_smelter"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": ["gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus"],
      "note": "Steam Alloy Smelter (steam/small_family.js): same casing, GTM's alloy smelting recipe untouched. Replaces gtceu:lp_steam_alloy_smelter/hp_steam_alloy_smelter."
    },
    {
      "machine": "gtceu:steam_mixer",
      "types": ["gtceu:mixer"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "partAbilities": { "input_hatch": ["gtceu:ulv_input_hatch", "gtceu:lv_input_hatch"], "output_hatch": ["gtceu:ulv_output_hatch", "gtceu:lv_output_hatch"] },
      "parts": ["gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus"],
      "note": "Steam Mixer (steam/small_family.js): GTM has no single-block steam mixer. Its fluid hatches are optional in the structure (0-2 input, 0-1 output): dust alloys (bronze, brass, invar...) don't need a fluid; glue, salt water, concrete and drilling mud do."
    },
    {
      "machine": "gtceu:steam_chemical_bath",
      "types": ["gtceu:chemical_bath"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "partAbilities": { "input_hatch": ["gtceu:ulv_input_hatch", "gtceu:lv_input_hatch"] },
      "parts": ["gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus", ["gtceu:ulv_input_hatch", "gtceu:lv_input_hatch"]],
      "note": "Steam Chemical Bath (steam/small_family.js): GTM has no single-block steam chemical bath. Its paper/treated wood/dark concrete recipes at LV or below always need 1 fluid (water or creosote); the ULV input hatch has a hand-craftable recipe in steam (steam/small_family.js, same as the coking battery's output one)."
    },
    {
      "machine": "gtceu:steam_ore_washer",
      "types": ["gtceu:ore_washer"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "partAbilities": { "input_hatch": ["gtceu:ulv_input_hatch", "gtceu:lv_input_hatch"] },
      "parts": ["gtceu:steam_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus", ["gtceu:ulv_input_hatch", "gtceu:lv_input_hatch"]],
      "note": "Steam Ore Washer (steam/small_family.js): GTM has no single-block steam ore washer. It always needs 1 fluid (water); the ULV input hatch has a hand-craftable recipe in steam."
    },
    {
      "machine": "gtceu:large_steam_macerator",
      "types": ["gtceu:macerator"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:solid_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus",
        ["gtceu:bronze_frame", "gtceu:steel_frame"]
      ],
      "note": "Large Steam Macerator (steam/large_family.js, GregTech Leisure's idea, reimplemented): 5x5x5 steel casing, 64 parallels, GTM's macerator recipes untouched (always EUt 2: the steam cap never blocks them)."
    },
    {
      "machine": "gtceu:large_steam_thermal_centrifuge",
      "types": ["gtceu:thermal_centrifuge"],
      "maxEUt": 32,
      "needs": ["fluid:gtceu:steam"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:solid_machine_casing", "gtceu:steam_input_hatch", "gtceu:steam_input_bus", "gtceu:steam_output_bus",
        ["gtceu:bronze_frame", "gtceu:steel_frame"]
