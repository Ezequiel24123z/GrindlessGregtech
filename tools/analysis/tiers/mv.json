    "input_hatch": ["gtceu:lv_input_hatch", "gtceu:ulv_input_hatch", "gtceu:mv_input_hatch"],
    "output_hatch": ["gtceu:lv_output_hatch", "gtceu:ulv_output_hatch", "gtceu:mv_output_hatch"],
    "muffler": ["gtceu:lv_muffler_hatch", "gtceu:ulv_muffler_hatch", "gtceu:mv_muffler_hatch"],
    "maintenance": ["gtceu:maintenance_hatch"]
