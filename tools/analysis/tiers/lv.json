{
  "tier": "lv",
  "title": "LV era",
  "extends": "steam",
  "inheritTargets": true,
  "note": "LV era per docs/eras/lv.md and its \"Decisions taken\" (which rule): hybrid AE2 (only the inputs are redone: silicon, presses, sky stone, controller, drive, acceptor, molecular assembler, interface, pattern provider, inscriber, charger), ae2:silicon only for AE2, stone dust doesn't drop to LV, veins from every dimension (the LV drill adds the Nether), the first ender pearl comes from a quest. Inherits the world, the machines and the targets from steam. Energy: single-block gtceu:lv_* machines (from the registry) run recipes up to 32 V; an electric multiblock with 2 or more LV energy hatches counts as one step higher, 128 V (MV), because GTM 7.5.3 (WorkableElectricMultiblockMachine.getMaxVoltage) raises it one tier whenever there are several hatches of the highest tier, whatever their amperage; that's why each multiblock has `energy` (the hatches its pattern allows: the pack's are read from structures.json, GTM's are declared). The eu:lv power comes from the LV steam turbine; cables, amperage and batteries aren't modeled. The pack's multiblock parts are read from structures.json (a dump of global.grindless.structures); the `parts` here are the fallback for when it's missing.",

  "unconditionalTypes": ["ae2:transform"],

  "conditions": {
    "ae2_circumstance_explosion": { "unsupported": true }
  },

  "contexts": ["minecraft:overworld", "grindless:flat", "grindless:void"],

  "partAbilities": {
    "energy_input": ["gtceu:lv_energy_input_hatch"],
    "energy_output": ["gtceu:lv_energy_output_hatch"],
    "input_bus": ["gtceu:lv_input_bus", "gtceu:ulv_input_bus"],
    "output_bus": ["gtceu:lv_output_bus", "gtceu:ulv_output_bus"],
    "input_hatch": ["gtceu:lv_input_hatch", "gtceu:ulv_input_hatch"],
    "output_hatch": ["gtceu:lv_output_hatch", "gtceu:ulv_output_hatch"],
    "muffler": ["gtceu:lv_muffler_hatch", "gtceu:ulv_muffler_hatch"],
    "maintenance": ["gtceu:maintenance_hatch"]
  },

  "world": [
    {
      "id": "mision-perla",
      "mode": "manual",
      "bootstrap": true,
      "items": ["minecraft:ender_pearl"],
      "note": "Decision 5: the first ender pearl comes from LV's \"First pearl\" quest (just one, to print the enderman model). From then on the creature simulator multiplies it."
    },
    {
      "id": "menas-nether",
      "mode": "manual",
      "bootstrap": true,
      "template": "gtceu:raw_{m}",
      "fromVeins": { "dimensions": ["minecraft:the_nether"] },
      "materials": [],
      "note": "Decision 4: a Nether vein's sample is made from two ores of that vein, so a single hand trip is enough (exploration, not grinding); after that the LV drill keeps them coming."
    }
  ],

  "machines": [
    {
      "machine": "gtceu:lv_vein_drill",
      "types": ["gtceu:vein_drilling"],
      "energy": { "voltage": 32 },
      "needs": ["eu:lv"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:solid_machine_casing", "gtceu:steel_frame", "gtceu:steel_pipe_casing", "gtceu:lv_energy_input_hatch",
        "gtceu:lv_input_bus", "gtceu:lv_output_bus", "gtceu:lv_input_hatch"
      ],
      "note": "LV vein drill (docs/eras/lv.md): steel tower, LV energy hatch (its pattern allows 1 or 2: with 2, 128 V), input bus (sample and bit), output bus and a fluid hatch (mud)."
    },
    {
      "machine": "gtceu:lv_greenhouse",
      "types": ["gtceu:greenhouse"],
      "energy": { "voltage": 32 },
      "needs": ["eu:lv"],
      "partsFromStructure": true,
      "parts": ["gtceu:solid_machine_casing", "#forge:glass", "minecraft:dirt", "gtceu:lv_energy_input_hatch", "gtceu:lv_input_bus", "gtceu:lv_output_bus"],
      "note": "LV greenhouse: steel hull, glass, dirt floor and an LV energy hatch (1 or 2 per its pattern)."
    },
    {
      "machine": "gtceu:submerged_arc_furnace",
      "types": ["gtceu:arc_smelting"],
      "energy": { "voltage": 32 },
      "needs": ["eu:lv"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:heatproof_machine_casing", "gtceu:lv_energy_input_hatch", "gtceu:lv_input_bus", "gtceu:lv_output_bus",
        "gtceu:lv_input_hatch", "gtceu:lv_muffler_hatch"
      ],
      "note": "Submerged arc furnace: exactly 2 LV energy hatches (its pattern), so GTM treats it as 128 V (MV); its recipes need 2 A at 32 V. Heat-resistant casing, chimney with muffler, input and output buses, and a fluid hatch."
    },
    {
      "machine": "gtceu:optical_observatory",
      "types": ["gtceu:astrophotography"],
      "energy": { "voltage": 32 },
      "needs": ["eu:lv"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:solid_machine_casing", "minecraft:stone_bricks", "gtceu:steel_frame", "gtceu:steel_gearbox", "gtceu:steel_pipe_casing", "#forge:glass",
        "gtceu:lv_energy_input_hatch", "gtceu:lv_input_bus", "gtceu:lv_output_bus"
      ],
      "note": "Optical observatory (observatory/machines.js): steel dome with an open slit over a stone brick wall, a steel-casing floor ring with its parts, and a refractor (pillar, gear box, two steel pipes and a glass pane). Its conditions (at night, clear sky) aren't modeled."
    },

    {
      "machine": "gtceu:electric_blast_furnace",
      "types": ["gtceu:electric_blast_furnace"],
      "energy": { "voltage": 32, "hatches": 2 },
      "coilTemp": 1800,
      "needs": ["eu:lv"],
      "parts": [
        "gtceu:heatproof_machine_casing", "gtceu:cupronickel_coil_block", "gtceu:lv_energy_input_hatch", "gtceu:lv_input_bus",
        "gtceu:lv_output_bus", "gtceu:lv_muffler_hatch",
        { "anyOf": ["gtceu:maintenance_hatch"], "onlyIf": { "config": "machines.enableMaintenance", "equals": true } }
      ],
      "note": "GTM's EBF: its pattern allows 1 or 2 energy hatches (autoAbilities); with 2 LV hatches the multiblock counts as MV (128 V), with no MV component at all: it's the canonical path to aluminium. With cupronickel coils (1,800 K, assembler recipe at 30 EU/t) it runs recipes up to 128 V and 1,800 K: aluminium (1,700 K), steel, etc.; not silicon (2,273 K) or Kanthal (assembler at 120 EU/t). To treat it as LV-only, set hatches to 1."
    },
    {
      "machine": "gtceu:sulfide_roaster",
      "types": ["gtceu:sulfide_roasting"],
      "energy": { "voltage": 32 },
      "needs": ["eu:lv"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:heatproof_machine_casing", "gtceu:solid_machine_casing", "gtceu:steel_firebox_casing", "gtceu:steel_pipe_casing", "gtceu:steel_frame",
        "gtceu:lv_energy_input_hatch", "gtceu:lv_input_bus", "gtceu:lv_input_hatch", "gtceu:lv_output_bus", "gtceu:lv_output_hatch"
      ],
      "note": "Sulfide roaster (reinforced LV, lv/sulfide_roaster.js): exactly 2 LV energy hatches (its pattern), so it counts as 128 V; its recipes are 4 A at 30 V. GTM's EBF roastings with air, SO2 turned into acid over the vanadium catalyst, and steam back, in one pass."
    },
    {
      "machine": "gtceu:heliostat_tower",
      "types": ["gtceu:solar_steam"],
      "energy": { "voltage": 32 },
      "needs": ["eu:lv"],
      "partsFromStructure": true,
      "parts": [
        "gtceu:solid_machine_casing", "gtceu:steel_firebox_casing", "gtceu:steel_pipe_casing", "gtceu:steel_frame", "grindless:heliostat_mirror",
        "gtceu:lv_energy_input_hatch", "gtceu:lv_input_hatch", "gtceu:lv_output_hatch"
      ],
      "note": "Heliostat solar tower (lv/heliostat_tower.js): 28 mirrors, a steel firebox receiver and a pump house. Water (or distilled water) -> steam, 16 EU/t; its daytime condition and its open-sky check aren't modeled."
    },
    { "machine": "gtceu:lv_1a_energy_converter", "types": [], "note": "GTM's EU -> FE converter (decision 6): feeds AE2's energy acceptor." },
    { "machine": "ae2:vibration_chamber", "types": [], "note": "AE2's vibration chamber: burns fuel and gives AE2 energy (decision 6: with coke, at the start)." },
    { "machine": "ae2:inscriber", "types": ["ae2:inscriber"], "needs": ["ae:power"], "note": "Decision 1: the inscriber stays (it's made with LV GT parts)." },
    { "machine": "ae2:charger", "types": ["ae2:charger"], "needs": ["ae:power"], "note": "Decision 1: the charger stays (it's made with LV GT parts)." }
  ],

  "machinesFromRegistry": [
    {
      "prefix": "gtceu:lv_",
      "maxEUt": 32,
      "needs": ["eu:lv"],
      "excludeTypes": ["gtceu:dummy", "gtceu:steam_turbine", "gtceu:combustion_generator", "gtceu:gas_turbine"]
    }
  ],

  "synthetic": [
    {
      "id": "turbina-lv",
      "machines": ["gtceu:lv_steam_turbine"],
      "produces": ["eu:lv"],
      "note": "The LV steam turbine (already modeled in steam with a steam need) gives LV energy."
    },
    {
      "id": "ae-vibracion",
      "machines": ["ae2:vibration_chamber"],
      "consumes": [{ "fuelOf": "gtceu:steam_boiler", "kind": "item" }],
      "produces": ["ae:power"],
      "note": "AE2 energy with the vibration chamber: coke, coal, charcoal, wood..."
    },
    {
      "id": "ae-convertidor",
      "machines": ["gtceu:lv_1a_energy_converter"],
      "consumes": ["eu:lv"],
      "capital": ["ae2:energy_acceptor"],
      "produces": ["ae:power"],
      "note": "AE2 energy from the LV grid: GTM's EU -> FE converter + AE2's energy acceptor."
    }
  ],

