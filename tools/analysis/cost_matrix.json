{
  "title": "Cost matrix: cumulative base cost of key items per era (tools/analysis/cost-matrix.mjs)",
  "note": "Every number-changing choice of the matrix lives here and is printed in docs/reforge/01_cost_matrix.md. Keys are item ids, fluids are `fluid:<id>`. Globs use `*`.",

  "settings": {
    "fluidUnitMb": 1000,
    "allocation": "full",
    "melt": { "mbPerItem": 144, "itemSuffixes": ["_ingot"], "always": true },
    "chance": "expected",
    "sourceAsBase": true,
    "euWeight": 0,
    "freeEpsilon": 0.0001,
    "topContributors": 3,
    "shapedCells": true,
    "eraAware": true,
    "neverFile": "pack/kubejs/data/grindless/tables/hidden_until.json"
  },

  "curve": {
    "note": "Phase 2 cost curve (DECISIONS.md:708): the core index of era n (MV = 0) should be anchor x rate^n. --solve finds per-era factors for it within tolerance; fluidFactorRatio is fluid factor / item factor.",
    "anchor": 3,
    "rate": 2.5,
    "fluidFactorRatio": 1,
    "tolerance": 0.1,
    "solveTolerance": 0.03,
    "maxIterations": 7
  },

  "excludeRecipes": {
    "types": ["gtceu:vein_drilling"],
    "categories": ["*recycling*", "*decomposition*"],
    "ids": ["*/uncraft*", "*_recycling*", "*/unpack*", "gtceu:forge_hammer/decompress_*", "quark:*_decompress", "megacells:*decompress*", "grindless:r_process_decompression/*", "grindless:slurry_separation/slurry_decompression", "gtnn:component_assembly_line/*"]
  },

  "base": {
    "note": "Resources the player takes from the world for free (drills, fluid rigs, pumps, farms). Their cost is themselves; the recipes that make them are ignored.",
    "drillOutputsOfTypes": ["gtceu:vein_drilling"],
    "items": ["*:raw_*"],
    "notBase": ["*rubber*"],
    "unproducedItems": ["minecraft:*", "*:*_leaves", "gcyr:moon_stone*", "gcyr:moon_cobblestone*", "gcyr:moon_sand", "gcyr:*regolith*", "gcyr:prb_*", "grindless:lv_horizon_collector"],
    "unproducedFluids": ["*"],
    "free": ["fluid:minecraft:water", "fluid:gtceu:steam", "fluid:gtceu:air", "fluid:gtceu:nether_air", "fluid:gtceu:ender_air", "fluid:*sea_water"],
    "weights": [],
    "noShareOutputs": ["fluid:minecraft:water", "minecraft:cobblestone", "minecraft:netherrack", "minecraft:cobbled_deepslate", "minecraft:end_stone", "minecraft:dirt", "minecraft:gravel", "minecraft:sand"],
    "trivial": ["minecraft:cobblestone", "minecraft:netherrack", "minecraft:cobbled_deepslate", "minecraft:end_stone", "minecraft:dirt", "minecraft:gravel", "minecraft:sand", "minecraft:stone", "fluid:minecraft:water"]
  },

  "tiers": ["ulv", "lv", "mv", "hv", "ev", "iv", "luv", "zpm", "uv", "uhv", "uev", "uiv", "uxv", "opv", "max"],

  "groups": {
    "note": "Per-tier key items. `${t}` is the tier. The first candidate that exists in the dump and is reachable is used.",
    "hull": ["gtceu:${t}_machine_hull"],
    "machine_casing": ["gtceu:${t}_machine_casing"],
    "motor": ["gtceu:${t}_electric_motor", "grindless:${t}_electric_motor"],
    "pump": ["gtceu:${t}_electric_pump", "grindless:${t}_electric_pump"],
    "piston": ["gtceu:${t}_electric_piston", "grindless:${t}_electric_piston"],
    "conveyor": ["gtceu:${t}_conveyor_module", "grindless:${t}_conveyor_module"],
    "robot_arm": ["gtceu:${t}_robot_arm", "grindless:${t}_robot_arm"],
    "emitter": ["gtceu:${t}_emitter", "grindless:${t}_emitter"],
    "sensor": ["gtceu:${t}_sensor", "grindless:${t}_sensor"],
    "field_generator": ["gtceu:${t}_field_generator", "grindless:${t}_field_generator"],
    "energy_hatch": ["gtceu:${t}_energy_input_hatch"],
    "energy_hatch_4a": ["gtceu:${t}_energy_input_hatch_4a"],
    "energy_hatch_16a": ["gtceu:${t}_energy_input_hatch_16a"]
  },

  "circuits": {
    "note": "Every member of the dump's tag gtceu:circuits/<tier> is a key item of that tier.",
    "tagPrefix": "gtceu:circuits/",
    "skipNote": "Only a circuit that has no recipe and no consumer is skipped (extendedfeatures:opv_universal_circuit: consumers use the gtnn alternative). Circuits hidden by hidden_until.json `never` are already dropped as key items; the live gtnn OpV and MAX circuits must stay visible.",
    "skip": ["extendedfeatures:opv_universal_circuit"]
  },

  "superconductorWire": {
    "note": "Single wire of the tier's superconductor (GTM standard LV-UHV; pack materials above).",
    "lv": "manganese_phosphide", "mv": "magnesium_diboride", "hv": "mercury_barium_calcium_cuprate", "ev": "uranium_triplatinum",
    "iv": "samarium_iron_arsenic_oxide", "luv": "indium_tin_barium_titanium_cuprate", "zpm": "uranium_rhodium_dinaquadide",
    "uv": "enriched_naquadah_trinium_europium_duranide", "uhv": "ruthenium_trinium_americium_neutronate",
    "uev": "lay_superhydride", "uiv": "metallic_hydrogen", "uxv": "pasta_strand", "opv": "chain_strand", "max": "horizon_strand"
  },

  "capstones": {
    "note": "The headline multiblock of each era (docs/journey.md).",
    "steam": "steam_blast_furnace", "lv": "sulfide_roaster", "mv": "ore_plant", "hv": "syngas_plant", "ev": "combined_cycle_plant",
    "iv": "fission_reactor", "luv": "orbital_solar_station", "zpm": "assembly_hall", "uv": "synchrotron", "uhv": "quantum_fabricator",
    "uev": "stellar_forge", "uiv": "penrose_engine", "uxv": "stellar_elevator", "opv": "kugelblitz_forge", "max": "mirror_shell"
  },

