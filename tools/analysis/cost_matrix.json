  "outliers": {
    "note": "Bands and thresholds of the flags in the document.",
    "tierRatioBand": [1.3, 30],
    "eraMedianRatioBand": [1.0, 12],
    "dominanceShare": 0.8,
    "lvCheapScore": 6,
    "maxLvFlags": 12,
    "gate": {
      "note": "--check fails (exit 1) on any step under minRatio in these series (M2-07): each era must cost at least x1.3 the previous one. AF-CC added the 4 A hatch and the eight components.",
