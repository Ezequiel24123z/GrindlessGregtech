  "custom": [
    {
      "id": "grindless:ae2/inscriber/calculation_processor_print",
      "replaces": ["ae2:inscriber/calculation_processor_print"],
      "json": {
        "type": "ae2:inscriber",
        "ingredients": {
          "middle": { "tag": "grindless:ae2/certus_quartz" },
          "top": { "item": "ae2:calculation_processor_press" }
        },
        "mode": "inscribe",
        "result": { "item": "ae2:printed_calculation_processor" }
      }
    },
    {
      "id": "grindless:ae2/charger/charged_certus_quartz_crystal",
      "replaces": ["ae2:charger/charged_certus_quartz_crystal"],
      "json": {
        "type": "ae2:charger",
        "ingredient": { "tag": "grindless:ae2/certus_quartz" },
        "result": { "item": "ae2:charged_certus_quartz_crystal" }
      }
    },
    {
      "id": "grindless:ae2/crafting/quartz_block",
      "replaces": ["ae2:decorative/quartz_block"],
      "json": {
        "type": "minecraft:crafting_shaped",
        "category": "misc",
        "key": { "a": { "tag": "grindless:ae2/certus_quartz" } },
        "pattern": ["aa", "aa"],
        "result": { "item": "ae2:quartz_block" },
        "show_notification": true
      }
    }
  ],

  "removeOnly": [
    { "id": "ae2:smelting/silicon_from_certus_quartz_dust", "why": "silicon only comes from the Submerged Arc Furnace (gtceu:arc_smelting)" },
    { "id": "ae2:blasting/silicon_from_certus_quartz_dust", "why": "same shortcut, blasting version" }
  ]
}
