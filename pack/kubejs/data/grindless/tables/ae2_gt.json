{
  "format": 1,
  "note": "Data for server_scripts/grindless/integration/ae2.js (hybrid AE2 on LV, docs/eras/lv.md 'Decisiones tomadas' #1, #2 and #6). Only the ENTRY POINTS of AE2 are rewritten; every other AE2 recipe is left untouched. Item and recipe ids were checked against the AE2 15.4.11 jar and GTM 7.5.3. Inputs use KubeJS item strings ('Nx id' or 'Nx #tag'); fluids use GTM strings ('#tag amount' in mB). 'tags' are new item tags, 'extendTags' add members to existing ones: ae2:all_nether_quartz gets the quartzite gem, so AE2's annihilation core (needed by interface, pattern provider, molecular assembler, buses...) and light detector no longer ask for Nether quartz.",

  "tags": {
    "grindless:ae2/certus_quartz": ["ae2:certus_quartz_crystal", "gtceu:certus_quartz_gem"]
  },

  "extendTags": {
    "ae2:all_nether_quartz": ["gtceu:quartzite_gem"]
  },

  "removeCookingOutputs": ["ae2:silicon"],

  "recipes": [
    {
      "key": "inscriber",
      "type": "assembler",
      "eut": 16,
      "duration": 200,
      "in": ["gtceu:lv_machine_hull", "2x gtceu:lv_electric_piston", "#gtceu:circuits/lv", "2x #grindless:ae2/certus_quartz"],
      "out": "ae2:inscriber",
      "replaces": ["ae2:network/blocks/inscribers"]
    },
    {
      "key": "charger",
      "type": "assembler",
      "eut": 16,
      "duration": 200,
      "in": ["gtceu:lv_machine_hull", "gtceu:lv_electric_motor", "#gtceu:circuits/lv", "#grindless:ae2/certus_quartz"],
      "out": "ae2:charger",
      "replaces": ["ae2:network/blocks/crystal_processing_charger"]
    },
    {
      "key": "controller",
      "type": "assembler",
      "eut": 16,
      "duration": 300,
