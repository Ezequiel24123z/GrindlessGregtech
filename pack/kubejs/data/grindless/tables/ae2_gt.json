      "key": "certus_quartz_crystal_water",
      "type": "autoclave",
      "eut": 24,
      "duration": 1200,
      "in": ["#forge:dusts/certus_quartz"],
      "fluidIn": ["#forge:water 250"],
      "chanced": [{ "item": "ae2:certus_quartz_crystal", "chance": 7500 }],
      "replaces": ["gtceu:autoclave/autoclave_dust_certus_quartz_water"]
    },
    {
      "key": "certus_quartz_crystal_distilled",
      "type": "autoclave",
