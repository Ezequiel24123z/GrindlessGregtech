	quests: [
		{
			dependencies: ["7C3E8D47479787F5"]
			description: ["Cobalt, iron and boron melted in the levitation melter, atomised, printed and pressed into a bonded &6CoFeB Target&r. The magnesia, Heusler and SAF targets come the same way."]
			icon: "grindless:cofeb_target"
			id: "5A5BA6B9228A4383"
			rewards: [{ id: "184989028EF88168", type: "xp", xp: 100 }]
			tasks: [
				{ id: "7E0B29BF824D6628", item: "grindless:cofeb_ingot", type: "item" }
				{ id: "17F658071C44D8AF", item: "grindless:cofeb_target", type: "item" }
			]
			title: "CoFeB Target"
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["5A5BA6B9228A4383", "1595ABB6AB097B3E"]
			description: ["Two magnets with an insulator a few atoms thick between them: current tunnels through more easily when they point the same way. A wafer of them, cut up, gives the &6MTJ Die&r. The MTJ sputter cluster, a CoFeB target and a magnesia target, on silicon-28. The MRAM wafer, the scandate substrate and the racetrack chip. Targets wear out, so stock them by ME and send dies on to the foundry."]
			icon: "grindless:mtj_die"
			id: "7A0AB21F31B7820B"
			rewards: [{ id: "5F77A2DE046B6BE8", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "169FAB1A0BAC3061", item: "grindless:mtj_die", type: "item" }]
			title: "Magnetic Tunnel Junction Die"
			x: 4.5d
			y: 3.0d
		}
		{
			dependencies: ["7A0AB21F31B7820B"]
			description: ["The same junctions in a grid make memory that keeps its bits with the power off. The &6MRAM Wafer&r is sputtered, annealed and etched. The MTJ sputter cluster, the photonic foundry and a Heusler target. The racetrack chip, which stacks memory into tracks. Dies and targets by ME; keep a few wafers waiting for the racetrack fab."]
			icon: "grindless:mram_wafer"
			id: "3B4ABEFD993C5FE7"
			rewards: [{ id: "56D11ACBBADAA1EC", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3F6717F34E6F2A02", item: "grindless:mram_wafer", type: "item" }]
			title: "MRAM Wafer"
			x: 7.0d
			y: 3.0d
		}
		{
			dependencies: ["7A0AB21F31B7820B"]
			description: ["Oxide films only grow well on a crystal whose spacing matches theirs. Dysprosium scandate is grown as a boule, sliced, polished and annealed into a &6DyScO3 Substrate&r. The crystal growth furnace from UHV, then slicing, polishing and an anneal. The MESO logic die, whose films need this crystal underneath. Boules are slow, so run two furnaces and stock substrates in a chest."]
			icon: "grindless:dysco3_substrate"
			id: "3044F5740EC5319D"
			rewards: [{ id: "37470CF7D9117F23", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3FB1CCB0BD50E23D", item: "grindless:dysco3_substrate", type: "item" }]
			title: "Scandate Substrate"
			x: 7.0d
			y: 4.5d
		}
		{
			dependencies: ["3B4ABEFD993C5FE7", "780482A9BF2D46A1"]
			description: ["Push magnetic domains along a nanowire with current pulses and read them as they pass a head. The &6Racetrack Chip&r is the memory of the mainframe. The racetrack fab, an MRAM wafer and a SAF track wafer. The spintronic mainframe, as its storage. Wafers by ME; the fab returns chips in a chest, so stock a few."]
			icon: "grindless:racetrack_chip"
			id: "33E470E07FDCB9C9"
			rewards: [{ id: "7F25BC2DB3F1FB4E", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3C41E39CEEAB7668", item: "grindless:racetrack_chip", type: "item" }]
			title: "Racetrack Chip"
			x: 9.5d
			y: 3.0d
		}
		{
			dependencies: ["3044F5740EC5319D", "17F1BEE08FE87731"]
			description: ["A multiferroic film flips a magnet with voltage instead of current, and a spin-orbit stack reads it back. Joined in the photonic foundry they make the &6MESO Logic Die&r. The oxide PLD chamber, the vdW stacking cell, a scandate substrate and the photonic foundry. The spintronic mainframe, as its logic. Substrates by ME; send the dies on as soon as they come out of the foundry."]
			icon: "grindless:meso_logic_die"
			id: "528E7523EDB83CC3"
			rewards: [{ id: "19F673989FBFE430", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5F8DE2F1358366D2", item: "grindless:meso_logic_die", type: "item" }]
			title: "MESO Logic Die"
			x: 9.5d
			y: 4.5d
		}
		{
			dependencies: ["33E470E07FDCB9C9", "528E7523EDB83CC3", "7486DF37973BED77"]
			description: ["Spin waves in a garnet film carry signals between the chips with almost no heat. Logic, memory and that bus together are the &6Spintronic Mainframe&r, the UXV circuit. The photonic integration hall, a racetrack chip, a MESO logic die and a magnonic bus from the YIG furnace. The sensor, the controller of every machine past the hull, and the hatches and parts that go with them. One of each part per mainframe: keep a dedicated chest, never a big stock."]
			icon: "gtnn:spintronic_mainframe"
			id: "72D835B7C533F4A5"
			rewards: [{ id: "56300952C8BAFC35", type: "xp", xp: 250 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "36D8C64E88D967FC", item: "gtnn:spintronic_mainframe", type: "item" }]
			title: "Spintronic Mainframe"
			x: 12.0d
			y: 3.75d
		}
		{
			dependencies: ["7C3E8D47479787F5"]
			description: ["A silicon nitride membrane drilled with thousands of holes, each narrower than a virus, by the electron beam furnace. Superfluid helium leaks through the &6Nanoaperture Array&r in step, as one quantum object."]
			icon: "grindless:nanoaperture_array"
			id: "5562CBB4F6304BB1"
			rewards: [{ id: "5656D7361817B272", type: "xp", xp: 100 }]
			tasks: [{ id: "7EC448ED8DB5EA53", item: "grindless:nanoaperture_array", type: "item" }]
			title: "Nanoaperture Array"
			x: 2.0d
			y: 8.0d
		}
		{
			dependencies: ["5562CBB4F6304BB1", "7AE0BEC91F59A48B"]
			description: ["Two baths of superfluid helium joined by the array oscillate at a frequency set by the pressure across it. The &6Weak Link Cell&r is that pair, filled and sealed. The SHeQUID works, a nanoaperture array and superfluid helium. The SHeQUID gyro, which closes two of them into a loop. Helium by pipe; cells come out sealed, so send them straight on."]
			icon: "grindless:weak_link_cell"
			id: "1E406BA02A37205D"
			rewards: [{ id: "7615F33772CCE588", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5DA4F3874226E985", item: "grindless:weak_link_cell", type: "item" }]
			title: "Weak Link Cell"
			x: 4.5d
			y: 8.0d
		}
		{
			dependencies: ["1E406BA02A37205D"]
			description: ["Two weak links in a loop make an interferometer for superfluid, and it feels the rotation of the Earth. The &6SHeQUID Gyro&r is real physics. The SHeQUID works and two weak link cells. The UXV sensor. Cells arrive by ME; one gyro goes into each sensor."]
			icon: "grindless:shequid_gyro"
			id: "37DA616C29C996F0"
			rewards: [{ id: "7353C1E0DEE070E3", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "725EB4799D1D41A9", item: "grindless:shequid_gyro", type: "item" }]
			title: "SHeQUID Gyro"
			x: 7.0d
			y: 8.0d
		}
		{
			dependencies: ["37DA616C29C996F0"]
			description: ["The &6UXV Sensor&r feels rotation with superfluid and magnetic fields with diamond. The emitter, both new generators and most controllers need one. A SHeQUID gyro, the UXV hull and a spintronic mainframe, on the assembly line. The UXV emitter and the controllers of the Cygnus, Vela and Cassiopeia machines. Gyros by ME in matched counts; keep sensors in a small stock."]
			icon: "gtceu:uxv_sensor"
			id: "103E024FEAF25DDC"
			rewards: [{ id: "195F84FA1ECDA9B1", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "539FFF875D152F3C", item: "gtceu:uxv_sensor", type: "item" }]
			title: "UXV Sensor"
			x: 9.5d
			y: 8.0d
		}
		{
			dependencies: ["586BAF51DA2477E3"]
			description: ["The &6UXV Machine Hull&r is the first thing Vela's lasagna plate goes into. The UXV hatches and buses are built on it."]
			icon: "gtceu:uxv_machine_hull"
			id: "3BB0A93D15E3A2D3"
			rewards: [{ id: "5A674D4B87D5B74F", type: "xp", xp: 200 }]
			tasks: [{ id: "3AFD3095A3D2A6A7", item: "gtceu:uxv_machine_hull", type: "item" }]
			title: "UXV Machine Hull"
			x: 2.0d
			y: 11.0d
		}
		{
			dependencies: ["3BB0A93D15E3A2D3"]
			description: ["The &6UXV Electric Motor&r is wound with pasta strand round a meteorite-iron rotor, and the &6UXV Electric Pump&r pushes liquid metal with a moving field. The piston and the conveyor move by metals that change shape in a magnetic field, the robot arm turns on a gear with no backlash, and the field generator projects from a plasma ring that holds its own field."]
			icon: "gtceu:uxv_electric_motor"
			id: "795E541822A26BC7"
			rewards: [{ id: "58CB8EF35A95FF71", type: "xp", xp: 200 }]
