			]
			title: "Recoil Separator"
			x: 7.0d
			y: 0.0d
		}
		{
			dependencies: ["77D53467B126D5EE"]
			description: ["The &6Superheavy Chemistry Lab&r studies a handful of atoms before they decay. A UHV hull, the stable casing and a steady supply of counted atoms. The superheavy census, and the data the later lines ask for. Atoms come by hatch from the separator; log the results, then discard the decayed rest."]
			icon: "gtceu:superheavy_chemistry_lab"
			id: "7997AD3A03140BA9"
