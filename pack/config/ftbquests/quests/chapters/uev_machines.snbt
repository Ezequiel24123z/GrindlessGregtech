			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["79361740BE1544E3"]
			description: ["The rare isotope that a superheavy run fires. The UEV Lines chart shows how much one run uses."]
			icon: "gtceu:calcium_48_dust"
