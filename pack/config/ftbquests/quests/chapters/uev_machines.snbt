			y: -1.5d
		}
		{
			dependencies: ["79361740BE1544E3"]
			description: ["The &6Heavy Ion Cyclotron&r accelerates calcium-48 until it can fuse with a plutonium target. A UHV hull, the stable casing and the cyclotron parts, and a calcium-48 supply. Atoms of flerovium and heavier, which the recoil separator catches. Beam and target arrive by ME; the output is a few atoms, so route it straight to the separator."]
			icon: "gtceu:heavy_ion_cyclotron"
			id: "5BA764E947B7B979"
			rewards: [{ id: "53BCABF510A06DA8", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
