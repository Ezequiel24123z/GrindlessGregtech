				{ id: "52A320958EBC388E", item: "gtceu:stable_machine_casing", type: "item" }
			]
			title: "Heavy Ion Cyclotron"
			x: 4.5d
			y: 0.0d
		}
		{
			dependencies: ["5BA764E947B7B979"]
			description: ["The &6Recoil Separator&r picks the few new atoms out of the beam, in the milliseconds they live. A UHV hull, the stable casing and the cyclotron output. Counted superheavy atoms, ready for the chemistry lab. Link it to the cyclotron by pipe and hatch; sort the atoms by element."]
			icon: "gtceu:recoil_separator"
			id: "77D53467B126D5EE"
			rewards: [{ id: "121C1B76AC1BE722", type: "xp", xp: 120 }]
