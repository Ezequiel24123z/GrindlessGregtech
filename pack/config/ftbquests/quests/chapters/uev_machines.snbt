		}
		{
			dependencies: ["5BD47CE42EDF75A2"]
			description: ["The &6Single-Crystal Foundry&r pulls a metal blade as one grain, with no boundaries to fail. A UHV hull, the heatproof casing and pure metal from the beam furnace. The single-crystal blade: a turbine wheel of these survives a hot core. Pure metal by ME; keep a stock of blanks and send blades on by ME."]
			icon: "gtceu:single_crystal_foundry"
			id: "7674F530D0218D45"
