			y: 32.25d
		}
		{
			dependencies: ["3BD8AB33F973A029"]
			description: ["The &6Spectral Hole Burner&r burns a comb of holes into a europium-doped YSO crystal slab with superfluid helium, so it remembers light for hours. A UIV hull and the cryostat casing, on superfluid helium. The slab of the six-hour memory. Crystals by ME and helium by pipe; it gives off nothing else."]
			icon: "gtceu:spectral_hole_burner"
			id: "5EA79DAD9574D598"
			rewards: [{ id: "7495E19AEDFFF02B", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "323FFE550EC1A8CB", item: "gtceu:spectral_hole_burner", type: "item" }
				{ id: "5D1FAC1C9CB912B6", item: "grindless:cryostat_casing", type: "item" }
			]
			title: "Spectral Hole Burner"
			x: 16.0d
			y: 32.25d
		}
		{
			dependencies: ["5EA79DAD9574D598"]
			description: ["The &6STM Lithography Cell&r peels hydrogen off silicon one atom at a time with a scanning tip, and a second step doses the holes with phosphine. A UIV hull, the UEV casing and the photonic casing around an ultra-high vacuum chamber. The patterned wafer; the P:Si die follows in molecular beam epitaxy. Phosphine is contained, then scrubbed to phosphoric acid; run two cells, the tip is slow."]
			icon: "gtceu:stm_lithography_cell"
			id: "7C69DFF0AE7530B7"
			rewards: [{ id: "52F31FA5843D6624", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
