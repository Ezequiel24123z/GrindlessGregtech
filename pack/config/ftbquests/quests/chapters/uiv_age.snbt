			x: 16.0d
			y: 32.25d
		}
		{
			dependencies: ["5EA79DAD9574D598"]
			description: ["The &6STM Lithography Cell&r writes a pattern on silicon one atom at a time with a scanning tip, and fills it with phosphorus. A UIV hull, the UEV casing and the photonic casing around an ultra-high vacuum chamber. The patterned wafer and the P:Si die. Phosphine is contained, then scrubbed to phosphoric acid; run two cells, the tip is slow."]
			icon: "gtceu:stm_lithography_cell"
			id: "7C69DFF0AE7530B7"
			rewards: [{ id: "52F31FA5843D6624", type: "xp", xp: 150 }]
