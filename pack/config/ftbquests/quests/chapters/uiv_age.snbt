			x: 3.0d
			y: -3.0d
		}
		{
			dependencies: ["13765E3D3D991767"]
			description: ["Shock graphite and you get lonsdaleite, a harder cousin of diamond. Race and bearing are cut from it for the UIV piston."]
			icon: "grindless:lonsdaleite_bearing"
