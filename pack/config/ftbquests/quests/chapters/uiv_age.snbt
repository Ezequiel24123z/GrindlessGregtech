		}
		{
			dependencies: ["57862F697D22D7F2"]
			description: ["The &6Mk5 Fusion Ring&r has an octagon of casing round an empty channel, lined with metallic hydrogen coils. It holds a very large buffer and takes sixteen hatches. A UIV hull, UIV components, UIV circuits, the Mk5 fusion casing, metallic hydrogen coil blocks and sixteen UIV energy hatches. The three polarised burns, and the direct energy converter that turns plasma into power. Build the fuel plant before you light the ring; helium-3 and protons return to their lines."]
			icon: "gtceu:uiv_fusion_reactor"
			id: "72D797E3DDE7ED0E"
			rewards: [{ id: "1FC1422722F775DB", type: "xp", xp: 250 }]
