				{ id: "10AC710B2A5136A2", item: "grindless:element_119_recoil", type: "item" }
			]
			title: "Einsteinium Target and Element 119"
			x: 21.0d
			y: 4.0d
		}
		{
			dependencies: ["3B27271078AAEDC7"]
			description: [
				"Pulsers, levitation, polarised sources and the shell machine."
				"The machines of this age start here."
			]
			icon: "gtceu:ramp_compression_pulser"
			id: "50ED516A490F0DF7"
