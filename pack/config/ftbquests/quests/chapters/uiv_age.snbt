			y: 22.5d
		}
		{
			dependencies: ["5E947FF2A2CF1FC2"]
			description: ["The &6TFLN Fab&r slices thin lithium niobate onto silicon nitride, and also makes silicon-28 wafers, poled niobate and the electro-optic comb, in a cleanroom. A UIV hull, the UEV casing and the photonic casing. The LN-on-Si3N4 wafer on the UIV circuits page. LNOI and nitride wafers by ME; the donor silicon goes back to refining."]
			icon: "gtceu:tfln_fab"
			id: "512711409DE69322"
			rewards: [{ id: "73647ED04344133A", type: "xp", xp: 150 }]
			shape: "gear"
