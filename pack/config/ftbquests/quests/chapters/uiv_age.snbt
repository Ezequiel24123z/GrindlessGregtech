		{
			dependencies: ["702BC74A807FB921", "5252C7B0FBB2EE93"]
			description: ["The assembly line joins 2 UIV casings, 3 metallic hydrogen cables, 6 RHEA plates, 3 FFKM seals (compressed from FFKM dust, and the research) with soldering alloy, lubricant and neutronium. It takes no circuit. Every UIV controller, hatch and the circuit assembler is built on it."]
			icon: "gtceu:uiv_machine_hull"
			id: "54AF39C42293C4E7"
			rewards: [{ id: "1BDFEC70063CB73B", type: "xp", xp: 150 }]
