		{
			dependencies: ["7BA44754AA7803E8"]
			description: ["Polarised helium-3 on helium-3 gives two protons and a helium nucleus. The plasma is the energy: a direct converter takes it as current. A formed Mk5 ring, polarised helium-3 from the polariser, and a buffer big enough for the start energy. The first of three Mk5 power sources for the gate to UXV. Helium-3 in by bus; the protons go back to the polarised source."]
			icon: "gtceu:he3he3_plasma_bucket"
			id: "5CFB2BEA56673819"
			rewards: [{ id: "7242FEAF7C398654", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7FD9137C86733640", item: "gtceu:helium3_polariser", type: "item" }
				{ id: "161B4F9F1C4EDC23", item: "gtceu:he3he3_plasma_bucket", type: "item" }
			]
			title: "First Mk5 Burn"
			x: 10.0d
			y: 53.25d
		}
		{
			dependencies: ["5CFB2BEA56673819"]
			description: ["Polarised lithium hydride pellets burn to helium and a second plasma. The ash still holds helium-3, so it goes through the superfluid plant once more. The same ring and converter, and polarised lithium-6 hydride pellets. A second source that burns no helium-3. Pellets by bus from the polarised source; the helium-3 in the ash returns to the first burn."]
			icon: "gtceu:pli6_plasma_bucket"
			id: "302777116673DBF1"
