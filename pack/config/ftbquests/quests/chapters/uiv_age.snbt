			x: 32.5d
			y: 2.0d
		}
		{
			dependencies: ["12FFA92FECF3F365"]
			description: ["Drop a sled into the ergosphere and it splits: one half falls in, the other comes out with more energy than it took. The &6Recovered Half-Sled&r goes back to the bay for a refit."]
			icon: "grindless:recovered_half_sled"
			id: "162EE3C9E5DE3F97"
			rewards: [{ id: "1477D08938E518E1", type: "xp", xp: 300 }]
