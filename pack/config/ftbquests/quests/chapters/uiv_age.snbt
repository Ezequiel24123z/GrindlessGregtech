			]
			title: "Millikelvin Cryostat Works"
			x: 21.0d
			y: 32.25d
		}
		{
			dependencies: ["50ED516A490F0DF7"]
			description: ["Fuse nuclei with their spins lined up and you get about half as much again. The &6Polarised Proton Source&r freezes hydrogen, lithium hydride and ammonia into pellets that remember. A UIV hull, the cryostat casing and metallic hydrogen coil blocks for the polarising magnet. Polarised pellets, the fuel of the Mk5 ring. Gas by pipe; depolarised gas returns to the source, so close the loop."]
			icon: "gtceu:polarised_proton_source"
			id: "57862F697D22D7F2"
