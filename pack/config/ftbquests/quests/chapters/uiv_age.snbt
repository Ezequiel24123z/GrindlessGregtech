			x: 10.5d
			y: 21.5d
		}
		{
			dependencies: ["50ED516A490F0DF7"]
			description: ["A melt held in the air by a magnetic field never touches a crucible, so nothing dissolves into it. The &6Levitation Melter&r pours RHEA and the alloys that crucibles ruin. A UEV machine hull, three UEV pistons, UEV circuits, halbach arrays, impregnated GdBCO and iridium crucibles; the UEV casing and a levitation trap. The RHEA ingot, and the glass and tile lines that start from it. Alloy powders by ME; the beryllium fume is captured, so route the scrubber output."]
			icon: "gtceu:levitation_melter"
			id: "386B4A8A0B37927E"
			rewards: [{ id: "1424676B3192C7DE", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1C06CBDA9422C0AD", item: "gtceu:levitation_melter", type: "item" }
				{ id: "19E73159176EBA3B", item: "gtceu:uev_machine_casing", type: "item" }
			]
			title: "Levitation Melter"
			x: 8.0d
			y: 23.5d
		}
		{
			dependencies: ["386B4A8A0B37927E"]
			description: ["Five refractory metals melted together without a crucible. The UIV parts are cased in it."]
			icon: "gtceu:rhea_ingot"
			id: "5252C7B0FBB2EE93"
			rewards: [{ id: "176E8DB15880E1FD", type: "xp", xp: 100 }]
