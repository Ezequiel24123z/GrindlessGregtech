				{ id: "54AF6A72F00217EC", item: "gtceu:uiv_conveyor_module", type: "item" }
				{ id: "7D2C24DA6D33B204", item: "gtceu:uiv_electric_pump", type: "item" }
				{ id: "5B252114B6F91E09", item: "gtceu:uiv_electric_piston", type: "item" }
				{ id: "57B642F3EC7C6479", item: "gtceu:uiv_electric_motor", type: "item" }
			]
			title: "UIV Parts"
			x: 20.0d
			y: 16.0d
		}
		{
			dependencies: ["17C0F46C21B9CD13", "54AF39C42293C4E7"]
			description: ["The &6UIV Circuit Assembler&r puts the UIV controllers together from the circuits of this page. A UIV machine hull, a UIV robot arm, an emitter and two conveyor modules, with a circuit of a high tier and red alloy cable. The UIV hatches and the controllers of this era. Boards and chips come from the cleanroom by ME; stock what it returns."]
			icon: "gtceu:uiv_circuit_assembler"
			id: "5F0ADBEB1F3839D6"
			rewards: [{ id: "5501DBD81F3DF096", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
