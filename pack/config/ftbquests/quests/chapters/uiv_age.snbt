		{
			dependencies: ["32309B41A96F01BE"]
			description: ["A thin crystal of lithium niobate bonded onto silicon nitride makes the &6LN-on-SiN Wafer&r: one wafer that steers light and tunes it. The TFLN fab, a lithium niobate boule and silicon nitride wafers, in the cleanroom. The comb that the optical mainframe is built round. Boules and nitride wafers by ME; the fab returns wafers to a chest."]
			icon: "grindless:ln_on_sin_wafer"
			id: "5F3FD5DD9FD7DBAA"
			rewards: [{ id: "3CA2E756FC79E223", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "71264424E4B1A667", item: "grindless:ln_on_sin_wafer", type: "item" }]
			title: "Lithium Niobate on Nitride"
			x: 7.0d
			y: 10.5d
		}
		{
			dependencies: ["3B27271078AAEDC7"]
			description: ["A wafer exposed at 6.7 nanometres holds finer lines than any light before it: the &6BEUV Exposed Wafer&r. The BEUV scanner, a resist-coated wafer and clean mirrors. The terbium debris is caught and recycled. The driver ASIC next to it, and through it the P:Si processor. Wafers by ME; send the fouled mirrors to the cleaning line, not to the bin."]
			icon: "grindless:beuv_exposed_wafer"
			id: "127106AB450BDD99"
			rewards: [{ id: "1EF0814AE2DDE468", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "30D318F8CE4D52FA", item: "grindless:beuv_exposed_wafer", type: "item" }]
			title: "BEUV Exposure"
			x: 7.5d
			y: 13.5d
		}
		{
			dependencies: ["127106AB450BDD99"]
			description: ["Cut from the exposed wafer, the &6BEUV Driver ASIC&r is the logic that steers the single-atom writer. A BEUV exposed wafer and a circuit 1 program in the cleanroom. The P:Si processor. One wafer yields many chips; stock them in a chest by ME."]
			icon: "grindless:beuv_driver_asic"
			id: "1667D9ECE9C63D16"
			rewards: [{ id: "3344372EEA8AEA05", type: "xp", xp: 140 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "11C43C43F0D51D7D", item: "grindless:beuv_driver_asic", type: "item" }]
			title: "Driver ASIC"
			x: 11.5d
			y: 13.5d
		}
		{
			dependencies: ["3B27271078AAEDC7"]
			description: ["A laser pulse a millionth of a millionth of a second long writes inside glass. The &65D Data Crystal&r keeps what it holds longer than the Sun will shine. The femtosecond writer and a block of fused silica. The research data that Matrioshka runs and the six-hour memory. Silica blanks by ME; written crystals go to the research store."]
			icon: "grindless:data_crystal_5d"
			id: "5F6361D2A096AE06"
			rewards: [{ id: "10D504AFB6BB5530", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "73EA794520B79B4C", item: "grindless:data_crystal_5d", type: "item" }]
			title: "Five-Dimensional Crystal"
			x: 7.5d
			y: 16.0d
		}
		{
			dependencies: ["5F6361D2A096AE06"]
			description: ["A crystal of one europium isotope remembers a light pulse for hours when the right comb is burned in. That is the &6Six-Hour Memory&r. The spectral hole burner, a 5D crystal and superfluid helium. The P:Si processor, which holds its state in this memory. Crystals by ME, helium by pipe; a few stocked memories are enough."]
			icon: "grindless:six_hour_memory"
			id: "53A536B775F9CA25"
			rewards: [{ id: "3DBE1A212FF60EE2", type: "xp", xp: 140 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5224BA951F8FF24A", item: "grindless:six_hour_memory", type: "item" }]
			title: "Six-Hour Memory"
			x: 10.0d
			y: 16.0d
		}
		{
			dependencies: ["3B27271078AAEDC7"]
			description: ["A scanning tip peels hydrogen off silicon one atom at a time. The &6STM-Patterned Wafer&r is the silicon with the holes ready. The STM lithography cell, a clean silicon wafer and ultra-high vacuum. The P:Si die, once phosphine fills the holes. Wafers by ME; the cell is slow, so run two."]
			icon: "grindless:stm_patterned_wafer"
			id: "32D6BBEFBFA91930"
			rewards: [{ id: "17AF2F6E34C9BFB3", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "155D7B8A6158F5CE", item: "grindless:stm_patterned_wafer", type: "item" }]
			title: "STM-Patterned Wafer"
			x: 7.5d
			y: 18.5d
		}
		{
			dependencies: ["32D6BBEFBFA91930"]
			description: ["Phosphine fills the holes and a cap seals them. The &6P:Si Die&r holds qubits made of single phosphorus atoms. A patterned wafer in the STM lithography cell. The excess phosphine is scrubbed and kept. The cryostat module and the P:Si processor. Phosphine by pipe in a contained loop; dies back by ME."]
			icon: "grindless:p_si_die"
			id: "5DB68611D99B3EB9"
			rewards: [{ id: "72A4D6369184985F", type: "xp", xp: 140 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7F0A9CC9D347E680", item: "grindless:p_si_die", type: "item" }]
			title: "P:Si Die"
			x: 10.0d
			y: 18.5d
		}
		{
			dependencies: ["5DB68611D99B3EB9"]
			description: ["The die has to be cold before it works. The &6mK Cryostat Module&r wets a rare-earth stage with helium-3 and holds the die at millikelvin. The millikelvin cryostat works, a P:Si die and helium-3. The P:Si processor. The helium mixture returns to the works; send finished modules on by ME."]
			icon: "grindless:mk_cryostat_module"
			id: "741A4E00415BD039"
			rewards: [{ id: "115633C9C90A480F", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5E6D3465F76B4438", item: "grindless:mk_cryostat_module", type: "item" }]
			title: "Millikelvin Cryostat Module"
			x: 12.5d
			y: 18.5d
		}
		{
			dependencies: ["1667D9ECE9C63D16", "53A536B775F9CA25", "741A4E00415BD039"]
			description: ["A cooled die, a driver and a memory make the &6P:Si Processor&r. It is the logic of the UIV circuit. The millikelvin cryostat works, a cryostat module, a driver ASIC and a six-hour memory. The optical mainframe. Parts in matched counts by ME; keep one processor per mainframe."]
			icon: "grindless:p_si_processor"
			id: "5F5A39AD463A9E68"
			rewards: [{ id: "306A140944DC4CA9", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3A63AF8E8D0E294B", item: "grindless:p_si_processor", type: "item" }]
			title: "P:Si Processor"
			x: 15.0d
			y: 16.0d
		}
		{
			dependencies: ["5F5A39AD463A9E68"]
			description: ["A processor, a crossbar, a glass interposer and a comb on a LN-on-SiN wafer make the &6Optical Mainframe&r, the UIV circuit. The photonic integration hall, a P:Si processor and a LN-on-SiN wafer. The controllers of Mk5, Matrioshka and every dead-star machine, and the gate store. Keep a dedicated chest and never a big stock; one processor and one wafer go into each."]
			icon: "gtnn:optical_mainframe"
			id: "58A76179A3648724"
			rewards: [{ id: "18518FAE64E1C23C", type: "xp", xp: 250 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "35FB3D880CCE335E", item: "gtnn:optical_mainframe", type: "item" }]
			title: "Optical Mainframe"
			x: 17.5d
			y: 16.0d
		}
		{
			dependencies: ["32309B41A96F01BE"]
			description: ["Extreme light, ASIC wafers and five dimensional storage, step by step."]
			icon: "grindless:beuv_exposed_wafer"
			id: "3B27271078AAEDC7"
			rewards: [ ]
			shape: "circle"
