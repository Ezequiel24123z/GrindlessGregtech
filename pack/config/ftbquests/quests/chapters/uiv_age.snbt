			y: 0.0d
		}
		{
			dependencies: ["1A781FD07AF49721"]
			description: ["A tether down to the poles and the star's own electric field carry a little of the crust up. The &6Crust Lift&r is fiction: no tether survives that gravity, and the yield is a game number."]
			icon: "gtceu:crust_lift"
			id: "3DF069B74A45CB2C"
