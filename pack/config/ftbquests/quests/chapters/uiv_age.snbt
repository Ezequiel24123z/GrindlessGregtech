			]
			title: "TFLN Fab"
			x: 8.5d
			y: 32.25d
		}
		{
			dependencies: ["512711409DE69322"]
			description: ["A laser pulse a millionth of a millionth of a second long can write inside glass. The &6Femtosecond Writer&r etches the 5D crystal and prints lattices. A UIV hull, the UEV casing and the photonic casing for the air-bearing stage. The 5D crystal, and printed parts that no mill can reach. Silica blanks by ME; solvent recovery takes the uncured resin."]
			icon: "gtceu:femtosecond_writer"
			id: "1BE7613A33089960"
			rewards: [{ id: "3FDC583BABA9474C", type: "xp", xp: 150 }]
