		}
		{
			dependencies: ["50ED516A490F0DF7"]
			description: ["The &6Ramp Compression Pulser&r squeezes cold hydrogen until it turns metallic. The squeeze is real; the quench is fiction, as nobody has kept metallic hydrogen once the pressure is gone. A UEV machine hull, three UEV pistons, UEV circuits, three balanced RHEA impellers, two strain-wave gears and three FFKM seals; the UEV casing and the coilgun coil casing that pulses the pressure. Metallic hydrogen, and lonsdaleite and cubic gauche nitrogen beside it. Hydrogen by pipe; spent shards return to the cryogenic plant, so loop them."]
			icon: "gtceu:ramp_compression_pulser"
			id: "13765E3D3D991767"
			rewards: [{ id: "331AA54A80D9B591", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1DC5B07407AA12E3", item: "gtceu:ramp_compression_pulser", type: "item" }
				{ id: "11FD54CBB96D72FF", item: "gtceu:uev_machine_casing", type: "item" }
				{ id: "757A4357EAC5C2B9", item: "grindless:coilgun_coil_casing", type: "item" }
			]
			title: "Ramp Compression"
			x: 8.0d
			y: 21.5d
		}
		{
			dependencies: ["13765E3D3D991767"]
			description: ["An ingot of metallic hydrogen. The UIV Lines chart shows how far one run stretches it, and what the cable and the coil take."]
			icon: "gtceu:metallic_hydrogen_ingot"
			id: "702BC74A807FB921"
			rewards: [{ id: "70F7C032E7FA3297", type: "xp", xp: 100 }]
			tasks: [{ id: "5BC5FFFBB3FA8C57", item: "gtceu:metallic_hydrogen_ingot", type: "item" }]
