			x: 8.0d
			y: 25.5d
		}
		{
			dependencies: ["57862F697D22D7F2"]
			description: ["Frozen hydrogen that remembers its spin. Mk5 burns three fuels, and each one starts at this source."]
			icon: "grindless:polarised_h_pellet"
