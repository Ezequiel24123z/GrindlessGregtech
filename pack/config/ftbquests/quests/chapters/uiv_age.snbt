		}
		{
			dependencies: ["7B6BAE4236338966"]
			description: ["The &6Neutronium Compression Hall&r reads the pellets in its bus as parallels, and the pellets are never used up. Its implosion mode keeps the explosive, so switch the hall to implosion in its own window first."]
			icon: "gtceu:neutronium_compression_hall"
