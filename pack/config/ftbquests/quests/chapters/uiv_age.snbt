				{ id: "53974ECD2276BB18", item: "grindless:activated_target_wheel", type: "item" }
			]
			title: "Californium Wheel and Titanium Beam"
			x: 17.5d
			y: 2.0d
		}
		{
			dependencies: ["74344BCAC847556C"]
			description: ["Element 119 takes einsteinium on a wheel blank, struck by a calcium-48 beam. It is the other half of Census II. Einsteinium dust and a wheel blank in an assembler for the target; in the factory, the target, a calcium-48 beam charge, an SRF cavity and helium (circuit 8) make the gas, and a membrane (circuit 7) separates the atoms. The chemistry lab then seals them in a capsule for Census II (circuit 3). The Element 119 Recoil Record and Census II, which the journey chapter asks for. Einsteinium by ME from the decompressor; send the atoms straight to the chemistry lab."]
			icon: "grindless:element_119_recoil"
			id: "1392BE9A8EB66BAC"
			rewards: [{ id: "3150E00B1DC9BA33", type: "xp", xp: 240 }]
