			tasks: [{ id: "3A63AF8E8D0E294B", item: "grindless:p_si_processor", type: "item" }]
			title: "P:Si Processor"
			x: 12.5d
			y: 18.5d
		}
		{
			dependencies: ["5F5A39AD463A9E68", "53A536B775F9CA25", "3F6512C5FF0EBF55"]
			description: ["A processor, a memory, a comb-fed tensor core and two optical assemblies make the &6Optical Mainframe&r, the UIV circuit. The photonic integration hall (a circuit 5 program): a Characterised P:Si Processor, a Six-Hour Quantum Memory, a Comb-Fed Tensor Core, two optical assemblies and three UEV circuits. The assemblies come from the photonic foundry (optical processors and quantum memory chips, with ultrapure water). The UIV parts, the controllers of Mk5 and Matrioshka and the stored proof of the gate. Keep a dedicated chest and never a big stock; every part goes into each."]
			icon: "gtnn:optical_mainframe"
			id: "58A76179A3648724"
			rewards: [{ id: "18518FAE64E1C23C", type: "xp", xp: 250 }]
			shape: "hexagon"
