				{ id: "7CDEE0EEBF355CAF", item: "grindless:metallic_hydrogen_coil_block", type: "item" }
			]
			title: "Mk5 Fusion Ring"
			x: 10.5d
			y: 25.5d
		}
		{
			dependencies: ["50ED516A490F0DF7"]
			description: ["A computer built in shells, in nine times Earth's sunlight, running logic that makes barely any heat. The &6Matrioshka Computer&r is where UIV research is written. A UIV hull, UIV components, UIV circuits and the UIV casing. Its chart and research rows run in Mercury orbit. Verified writes, the Kerr and equation of state charts, and the radiators that carry its heat. Logic tiles are among the longest builds here: stock them by ME and send the waste heat to the radiators."]
			icon: "gtceu:matrioshka_computer"
			id: "7E2EF99503F9DB02"
			rewards: [{ id: "79DC492E9F485905", type: "xp", xp: 250 }]
