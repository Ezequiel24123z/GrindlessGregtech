			]
			title: "Kerr Chart"
			x: 32.5d
			y: 0.0d
		}
		{
			dependencies: ["1E0EB4DDEE39CB3B"]
			description: ["A compacted waste canister, a charge of cg-N and a hull. Every era's waste goes in: it is the last place anything is put."]
			icon: "grindless:split_charge_sled"
			id: "12FFA92FECF3F365"
			rewards: [{ id: "195721532747940F", type: "xp", xp: 250 }]
			tasks: [{ id: "7655385072E8E0DC", item: "grindless:split_charge_sled", type: "item" }]
			title: "Split-Charge Sled"
			x: 32.5d
			y: 2.0d
		}
		{
			dependencies: ["12FFA92FECF3F365", "566EAB127E413589"]
			description: ["Drop a sled into the ergosphere (the Penrose extraction needs the Kerr Chart) and it splits: one half falls in, the other comes out with more energy than it took. The &6Recovered Half-Sled&r goes back to the bay for a refit."]
			icon: "grindless:recovered_half_sled"
			id: "162EE3C9E5DE3F97"
			rewards: [{ id: "1477D08938E518E1", type: "xp", xp: 300 }]
			tasks: [{ id: "165309B7E58626AC", item: "grindless:recovered_half_sled", type: "item" }]
			title: "Half a Sled Back"
			x: 35.0d
			y: 2.0d
		}
		{
			dependencies: ["1724E39CDD53C2A2"]
			description: ["Run the warp gate's Cygnus hold in Cygnus X-1 orbit: it lasts 60 seconds and takes the stored proof. The gate leaves no item, so tick this box when it ends. Plan your power first: the Penrose engine is the cheaper way to pay for it, not the only one."]
			icon: "gtceu:warp_gate"
			id: "58ADF60AC2BD2DD7"
			rewards: [{ id: "17D1275E9DB77E3C", type: "xp", xp: 25 }]
			shape: "diamond"
			size: 1.75d
			tasks: [{ id: "58A3BA5AB23D6BF4", type: "checkmark" }]
			title: "Open the Cygnus Gate"
			x: 40.0d
			y: 0.0d
		}
		{
			dependencies: ["162EE3C9E5DE3F97", "7722F5C4A39F92D7"]
			description: ["Put a neutronium pellet, Census II, the equation of state chart, a half-sled and four UIV circuits of any kind in the gate's store. The hold in the next quest needs all of them at once and uses up the pellet."]
			icon: "grindless:neutronium_pellet"
			id: "1724E39CDD53C2A2"
