		{
			dependencies: ["5E947FF2A2CF1FC2"]
			description: ["The cell, the network and the metal row."]
			icon: "gtceu:uiv_parallel_hatch"
			id: "17B06879E2354DD6"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
