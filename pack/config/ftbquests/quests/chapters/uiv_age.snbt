		{
			dependencies: ["58ADF60AC2BD2DD7"]
			description: ["The &6Kerr Chart&r is the research for the UXV machine casing: the assembly line joins 2 UIV casings, 2 UIV field generators, 4 UIV emitters and 2 UIV circuits. Build it and the next voltage is open."]
			icon: "gtceu:uxv_machine_casing"
