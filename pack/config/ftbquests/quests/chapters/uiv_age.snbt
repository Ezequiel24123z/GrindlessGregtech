			x: 26.5d
			y: 4.5d
		}
		{
			dependencies: ["7149EBF20BBEB79E"]
			description: ["A bucket of electrons and positrons held in a field. It annihilates if the field fails, so keep it sealed."]
			icon: "gtceu:pair_plasma_bucket"
