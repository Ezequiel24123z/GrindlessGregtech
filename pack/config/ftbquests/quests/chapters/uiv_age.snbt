			title: "Crust Lift"
			x: 23.5d
			y: 0.0d
		}
		{
			dependencies: ["3DF069B74A45CB2C"]
			description: ["Deep in the crust the nuclei are so crowded that neutrons leak out between them. The &6Neutron Drip Separator&r takes them away before the matter relaxes. They decay if you wait, so don't."]
			icon: "gtceu:neutron_drip_separator"
