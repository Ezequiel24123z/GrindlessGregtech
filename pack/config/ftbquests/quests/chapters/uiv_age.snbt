		}
		{
			dependencies: ["386B4A8A0B37927E"]
			description: ["Tungsten fibre in an RHEA matrix, sprayed as plasma into a tile that can face a fusion fire. It is the first &6First Wall Tile&r of the Mk5 casing."]
			icon: "grindless:first_wall_tile"
