			y: -5.0d
		}
		{
			dependencies: ["79F47DC75835B292"]
			description: ["A melt held in the air by a magnetic field never touches a crucible, so nothing dissolves into it. The &6Levitation Melter&r pours the RHEA ingot and a few worse-tempered alloys."]
			icon: "gtceu:levitation_melter"
