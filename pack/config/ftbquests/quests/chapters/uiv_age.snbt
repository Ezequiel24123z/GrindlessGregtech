	quest_links: [ ]
	quests: [
		{
			dependencies: ["5316E435F8496672"]
			description: [
				"The warp gate left you the &6UIV Machine Hull&r and a stack of casings. The stars you can reach now are the ones that already died: a neutron star, a pulsar and a black hole."
				"Home first. Nothing out there is built without metallic hydrogen and a very hard alloy."
			]
			icon: "gtceu:uiv_machine_hull"
			id: "7B955176F4E8579C"
			rewards: [{ id: "71F6AAE8444EDFE3", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [
				{ id: "3260891837D92C37", item: "gtceu:uiv_machine_hull", type: "item" }
				{ id: "1848D2F73920097E", item: "gtceu:uiv_machine_casing", type: "item" }
			]
			title: "Dead Stars"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7B955176F4E8579C"]
			description: ["Most of UIV is built at home. The jumps, the stations and the gate all need what three home lanes make, so the machine tabs come before the rockets."]
			icon: "gtceu:uiv_machine_hull"
			id: "5DFADD2C1B09AF2E"
			rewards: [{ id: "7EDEBE78DFC06BD2", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "528CC21D87EF1218", type: "checkmark" }]
			title: "Home First"
			x: 2.5d
			y: 0.0d
		}
		{
			dependencies: ["5DFADD2C1B09AF2E"]
			description: ["Hydrogen squeezed until it conducts, a melt held in the air so nothing touches it, and a heavier element for the census. The metals and the cable come first; the parts follow."]
			icon: "gtceu:ramp_compression_pulser"
			id: "1463A1F1F2C3378A"
			rewards: [{ id: "53886C8F8A111C99", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "36A19A6811B3A70B", type: "checkmark" }]
			title: "Squeezed and Alloyed"
			x: 5.0d
			y: -2.0d
		}
		{
			dependencies: ["5DFADD2C1B09AF2E"]
			description: ["A crystal that keeps data for ever, a scanner for a shorter wavelength and a chip cold enough to think. They end in the optical mainframe the gate asks for."]
			icon: "gtceu:beuv_scanner"
			id: "3544A39EF6B5C5FF"
			rewards: [{ id: "1264530A4D37F249", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "1E2E2320B6C7553A", type: "checkmark" }]
			title: "Computers of Light"
			x: 5.0d
			y: 2.0d
		}
		{
			dependencies: ["5DFADD2C1B09AF2E"]
			description: ["Fuse nuclei with their spins lined up and you get about half as much again. The Mk5 ring burns polarised fuel, and a direct converter turns its plasma into the current the gate asks for."]
			icon: "gtceu:uiv_fusion_reactor"
			id: "70CDF47116DF3319"
			rewards: [{ id: "5533A86CB119589D", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "70C7E3E795427381", type: "checkmark" }]
			title: "A Polarised Ring"
			x: 5.0d
			y: 4.0d
		}
		{
			dependencies: ["5DFADD2C1B09AF2E"]
			description: ["The planet nearest the Sun gets nine times Earth's light. Park in &6Mercury&r orbit: the Matrioshka computer and its radiators are built here."]
			icon: "gtceu:matrioshka_computer"
			id: "1BFA42734E29F4A9"
			rewards: [{ id: "30CE1918F42F5658", type: "xp", xp: 200 }]
			tasks: [{ dimension: "gcyr:mercury_orbit", id: "7883CF02571422E3", type: "dimension" }]
			title: "Mercury Orbit"
			x: 7.5d
			y: 0.0d
		}
		{
			dependencies: ["1BFA42734E29F4A9"]
			description: ["Each shell of the computer runs on the heat of the one inside it. Heat has nowhere to go in space but out, so the radiators are as big as the logic."]
			icon: "gtceu:droplet_radiator_works"
			id: "5AFA17B917F8FB6C"
			rewards: [{ id: "7C3838BDC310BF83", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "1A5554BD90E5A09A", type: "checkmark" }]
			title: "A Computer in Shells"
			x: 10.0d
			y: -2.0d
		}
		{
			dependencies: ["1BFA42734E29F4A9"]
			description: ["A tile of indium gallium arsenide antimonide turns hot glow into power. Enough of them wrapped round a computer make the &6Matrioshka TPV Shell&r."]
			icon: "grindless:matrioshka_tpv_shell"
			id: "510D744971D43851"
			rewards: [{ id: "1DBFC26233C2E133", type: "xp", xp: 200 }]
			tasks: [
				{ id: "71971E9DFB28F03C", item: "grindless:tpv_tile", type: "item" }
				{ id: "1423C71B6B6CAB1E", item: "grindless:matrioshka_tpv_shell", type: "item" }
			]
			title: "Thermophotovoltaic Shell"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["510D744971D43851"]
			description: ["The three stars are hundreds of light years away and no drive crosses that. A seed rides the warp gate along the chart, one jump to each place, and the orbit is real only in the game."]
			icon: "gtceu:warp_gate"
			id: "540014628249AE32"
			rewards: [{ id: "56DDA1A7B1B1EA77", type: "xp", xp: 50 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "51EDABF818EDFA6F", type: "checkmark" }]
			title: "Jumps Are Fiction"
			x: 12.5d
			y: 0.0d
		}
		{
			dependencies: ["540014628249AE32"]
			description: [
				"The first jump. A seed carries a probe to a lone neutron star and opens a ring there."
				"The jump is fiction, as every jump is. The star, a cold X-ray emitter, is real."
			]
			icon: "grindless:neutron_star_site_casing"
			id: "1A781FD07AF49721"
			rewards: [{ id: "38A31944C93F515E", type: "xp", xp: 250 }]
			tasks: [{ dimension: "grindless:rx_j1856_orbit", id: "7CC771BCEE5E29E2", type: "dimension" }]
			title: "RX J1856.5-3754"
			x: 15.0d
			y: 0.0d
		}
		{
			dependencies: ["1A781FD07AF49721"]
			description: ["A neutron star packs a Sun into a ball a few miles wide. Its crust is the thinnest skin of matter anywhere, and everything this orbit makes comes from it. The crust lift and the neutronium pellet are fiction, and say so."]
			icon: "gtceu:crust_lift"
			id: "5C19AB7DCF02FFCB"
			rewards: [{ id: "386981FDAA188ACB", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "5EFCB15DD9477839", type: "checkmark" }]
			title: "A Star Gone Out"
			x: 17.5d
			y: -2.0d
		}
		{
			dependencies: ["1A781FD07AF49721"]
			description: ["A spoonful of neutron matter held at ordinary pressure by a field is fiction: it is not the neutronium of the other mods. A &6Neutronium Pellet&r goes in the stored proof at the gate."]
			icon: "grindless:neutronium_pellet"
			id: "11F139AEE6C06EAA"
			rewards: [{ id: "5DFED322F33B281D", type: "xp", xp: 300 }]
			tasks: [{ id: "3190B670347061D2", item: "grindless:neutronium_pellet", type: "item" }]
			title: "Neutronium Pellet"
			x: 17.5d
			y: 0.0d
		}
		{
			dependencies: ["1A781FD07AF49721"]
			description: ["Neutrons leaking out of the crust build the heavy elements, as in a kilonova. The &6Element 119 Recoil&r and &6Census II&r are the proof that the chain made new atoms."]
			icon: "grindless:superheavy_census_ii"
			id: "7722F5C4A39F92D7"
			rewards: [{ id: "3B480CA24FC3435C", type: "xp", xp: 300 }]
			tasks: [
				{ id: "3FC75613D5EA0915", item: "grindless:element_119_recoil", type: "item" }
				{ id: "3B9F051A93467905", item: "grindless:superheavy_census_ii", type: "item" }
			]
			title: "Census II"
			x: 17.5d
			y: 2.0d
		}
		{
			dependencies: ["7722F5C4A39F92D7"]
			description: ["A titanium beam on a californium wheel leaves a few atoms of something new. The &6Element 120 Recoil&r is one more entry for the census. Real element 120 has never been made, so this one is a recipe and a hope."]
			icon: "grindless:element_120_recoil"
			id: "15768CF69A20F736"
			rewards: [{ id: "789CAAB84BD0C8B7", type: "xp", xp: 200 }]
			tasks: [{ id: "5A3A79B88B9907F6", item: "grindless:element_120_recoil", type: "item" }]
			title: "Element 120"
			x: 20.0d
			y: 2.0d
		}
		{
			dependencies: ["11F139AEE6C06EAA"]
			description: ["The second jump: a pulsar close enough to time. A seed rides there on a course worked out with the neutron star, and the jump is fiction here too."]
			icon: "grindless:rad_hard_controller"
			id: "5E8A4728A85047DF"
			rewards: [{ id: "5278320F4FD6E8F7", type: "xp", xp: 250 }]
			tasks: [{ dimension: "grindless:psr_j0437_orbit", id: "14379713FBEE2CA9", type: "dimension" }]
			title: "PSR J0437-4715"
			x: 20.0d
			y: 0.0d
		}
		{
			dependencies: ["5E8A4728A85047DF"]
			description: ["A pulsar blinks hundreds of times a second, steadier than a clock, and blows a wind of electrons and positrons. The wind makes positronium; the blinks make a position."]
			icon: "gtceu:pulsar_wind_trap"
			id: "528C775C1F6648D5"
			rewards: [{ id: "317B3F91F755AC31", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "52135762CC095F70", type: "checkmark" }]
			title: "A Lighthouse"
			x: 22.5d
			y: -2.0d
		}
		{
			dependencies: ["5E8A4728A85047DF"]
			description: ["A pulse profile folded from the blinks and timed against a clock at home. Four of them fix a place in space."]
			icon: "grindless:xray_pulse_timed"
			id: "19A46B977973EEEB"
			rewards: [{ id: "1426D59B9230E0B5", type: "xp", xp: 250 }]
			tasks: [{ id: "5C8DD88D3FDBC4BB", item: "grindless:xray_pulse_timed", type: "item" }]
			title: "A Timed Profile"
			x: 22.5d
			y: 0.0d
		}
		{
			dependencies: ["19A46B977973EEEB"]
			description: ["Let a positronium condensate annihilate all at once and you get a gamma-ray laser. It is fiction: nobody has built one. The &6Gamma Laser Cavity&r is the core of the UIV emitter."]
			icon: "grindless:gamma_laser_cavity"
			id: "7D914530B001FB81"
			rewards: [{ id: "75D45F75D6883283", type: "xp", xp: 300 }]
			tasks: [{ id: "167C8FC101B420C5", item: "grindless:gamma_laser_cavity", type: "item" }]
			title: "Gamma Laser Cavity"
			x: 26.25d
			y: 2.0d
		}
		{
			dependencies: ["19A46B977973EEEB"]
			description: ["Pulse profiles go into the Matrioshka, and the &6Neutron Star EOS Chart&r comes out. It tells you how hard a star pushes back. The computer decides on a long run."]
			icon: "grindless:ns_eos_chart"
			id: "13EE47D6E75307D4"
			rewards: [{ id: "3FFDC8CF597C8D76", type: "xp", xp: 250 }]
			tasks: [{ id: "577A0FC574DF3E4B", item: "grindless:ns_eos_chart", type: "item" }]
			title: "Equation of State"
			x: 25.0d
			y: 0.0d
		}
		{
			dependencies: ["13EE47D6E75307D4"]
			description: ["Four timed profiles and the equation of state give a position in space. The &6Pulsar Navigation Solution&r is what points the seed at the black hole."]
			icon: "grindless:pulsar_navigation_solution"
			id: "7DFD7F7638FC1526"
			rewards: [{ id: "5AF6E557BAB52582", type: "xp", xp: 300 }]
			tasks: [{ id: "56B40613D8B8E921", item: "grindless:pulsar_navigation_solution", type: "item" }]
			title: "Navigation Solution"
			x: 27.5d
			y: 0.0d
		}
		{
			dependencies: ["7DFD7F7638FC1526", "7D914530B001FB81"]
			description: ["The last jump: a black hole of many Suns, spinning fast enough to matter. The jump is fiction, and the black hole is real."]
			icon: "grindless:probe_bay_casing"
			id: "1E0EB4DDEE39CB3B"
			rewards: [{ id: "37702A5CBB519885", type: "xp", xp: 300 }]
			tasks: [{ dimension: "grindless:cygnus_x1_orbit", id: "7129BD4386E26A15", type: "dimension" }]
			title: "Cygnus X-1"
			x: 30.0d
			y: 0.0d
		}
		{
			dependencies: ["1E0EB4DDEE39CB3B"]
			description: ["A spinning black hole drags space round with it, and inside that skin, the ergosphere, a falling object can leave with more energy than it brought. The hole spins a little slower for it."]
			icon: "gtceu:ergosphere_probe_bay"
			id: "5B3808E94677B403"
			rewards: [{ id: "37A0B5507DAA3296", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "50E7D2F01DFF7B2D", type: "checkmark" }]
			title: "The Spinning Hole"
			x: 32.5d
			y: -2.0d
		}
		{
			dependencies: ["1E0EB4DDEE39CB3B"]
			description: ["The probe data goes home, and the gravitational-wave detector and the interferometer correlate it. The Matrioshka turns it into a &6Kerr Chart&r."]
			icon: "grindless:kerr_chart"
			id: "566EAB127E413589"
			rewards: [{ id: "367AAA4F4CA07FD8", type: "xp", xp: 300 }]
