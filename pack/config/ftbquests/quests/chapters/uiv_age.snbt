				{ id: "31AE930D6D7F4E0A", item: "gtceu:uiv_machine_casing", type: "item" }
			]
			title: "Droplet Radiators"
			x: 10.5d
			y: 29.25d
		}
		{
			dependencies: ["582C5EF34B1CF2D0"]
			description: ["A module of droplet radiator. The UIV Lines chart shows what it cools."]
			icon: "grindless:droplet_radiator_module"
			id: "5D28F8D529A7274F"
			rewards: [{ id: "56D6AD6ED8D998F9", type: "xp", xp: 100 }]
