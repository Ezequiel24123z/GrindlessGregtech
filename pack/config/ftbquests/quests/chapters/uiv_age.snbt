	quests: [
		{
			dependencies: ["5316E435F8496672"]
			description: [
				"The warp gate left you the &6UIV Machine Hull&r and a stack of casings. The stars you can reach now are the ones that already died: a neutron star, a pulsar and a black hole."
				"Home first. Nothing out there is built without metallic hydrogen and a very hard alloy."
			]
			icon: "gtceu:uiv_machine_hull"
			id: "7B955176F4E8579C"
			rewards: [{ id: "71F6AAE8444EDFE3", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [
				{ id: "3260891837D92C37", item: "gtceu:uiv_machine_hull", type: "item" }
				{ id: "1848D2F73920097E", item: "gtceu:uiv_machine_casing", type: "item" }
			]
			title: "Dead Stars"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7B955176F4E8579C"]
			description: ["Hydrogen squeezed until it conducts, drawn into wire and wrapped in a seal that survives it. The &6Metallic Hydrogen Cable&r carries the UIV hull and everything after it."]
			icon: "gtceu:metallic_hydrogen_single_cable"
			id: "105026C81961076A"
			rewards: [{ id: "50B2B0E886915667", type: "xp", xp: 100 }]
			tasks: [{ id: "106FB619A1669286", item: "gtceu:metallic_hydrogen_single_cable", type: "item" }]
			title: "Metallic Hydrogen Cable"
			x: 2.5d
			y: 0.0d
		}
		{
			dependencies: ["105026C81961076A"]
			description: ["The same wire, wound on a refractory former and soaked in resin, makes the &6Metallic Hydrogen Coil Block&r. It lines the Mk5 ring, and a lot of magnets besides."]
			icon: "grindless:metallic_hydrogen_coil_block"
			id: "1EEF7433993D39D5"
			rewards: [{ id: "53102691DAB49A6C", type: "xp", xp: 100 }]
			tasks: [{ id: "53DDD2D2DE525364", item: "grindless:metallic_hydrogen_coil_block", type: "item" }]
			title: "Metallic Hydrogen Coil"
			x: 5.0d
			y: 0.0d
		}
		{
			dependencies: ["1EEF7433993D39D5"]
			description: ["Five refractory metals melted together in a cold crucible and forged flat: the &6RHEA Plate&r. It is what the UIV parts are cased in."]
			icon: "gtceu:rhea_plate"
			id: "79F47DC75835B292"
			rewards: [{ id: "56542E783C030BED", type: "xp", xp: 100 }]
			tasks: [{ id: "17A5E3D58CC66CB3", item: "gtceu:rhea_plate", type: "item" }]
			title: "RHEA Plate"
			x: 7.5d
			y: 0.0d
		}
		{
			dependencies: ["79F47DC75835B292"]
			description: ["The &6UIV Electric Pump&r has a printed impeller, pressed at a megabar and balanced by hand-me-down machines. The other UIV parts wait for stars further out."]
			icon: "gtceu:uiv_electric_pump"
			id: "17C0F46C21B9CD13"
			rewards: [{ id: "366424FA6A7C7F5A", type: "xp", xp: 150 }]
			tasks: [{ id: "3B02C0C3C5703B00", item: "gtceu:uiv_electric_pump", type: "item" }]
			title: "UIV Parts"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["17C0F46C21B9CD13"]
			description: ["The &6UIV SMES Cell&r holds four times what the UEV cell does, in metallic hydrogen windings. It is what the wireless grid stores its surplus in from here on."]
			icon: "grindless:uiv_smes_cell"
			id: "5FB006B879741A02"
			rewards: [{ id: "34D47AB6E85C7F74", type: "xp", xp: 100 }]
