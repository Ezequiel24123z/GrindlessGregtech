		}
		{
			dependencies: ["3BD8AB33F973A029"]
			description: ["The &6Spectral Hole Burner&r burns a comb of holes into a rare-earth crystal, so it remembers light for hours. A UIV hull and the cryostat casing, on superfluid helium. The six-hour memory. Crystals by ME and helium by pipe; it gives off nothing else."]
			icon: "gtceu:spectral_hole_burner"
			id: "5EA79DAD9574D598"
