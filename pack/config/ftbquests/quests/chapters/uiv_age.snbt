				{ id: "3B4C6B61DE3A18BD", item: "gtceu:uev_machine_casing", type: "item" }
				{ id: "314899C77A9A89C1", item: "grindless:photonic_casing", type: "item" }
			]
			title: "STM Lithography Cell"
			x: 18.5d
			y: 32.25d
		}
		{
			dependencies: ["7C69DFF0AE7530B7"]
			description: ["Colder than the superfluid helium plant ever gets. The &6Millikelvin Cryostat Works&r makes the mK cryostat module and finishes the P:Si processor. A UIV hull, the cryostat casing and metallic hydrogen coil blocks for the magnet. The cryostat module and the P:Si processor. The helium mixture returns to the works; send modules on by ME."]
			icon: "gtceu:millikelvin_cryostat_works"
			id: "5B6546A94A7A177E"
			rewards: [{ id: "575ABBA6D471C1AF", type: "xp", xp: 180 }]
