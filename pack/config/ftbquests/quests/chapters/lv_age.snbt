			x: 12.0d
			y: 4.5d
		}
		{
			dependencies: ["29B4717D718C6BB5"]
			description: [
				"Both models print at LV, but the creeper and the blaze only run in an MV simulator. Make them now and they'll be waiting."
			]
			icon: "grindless:creature_model_creeper"
			id: "47892302FAEA3244"
