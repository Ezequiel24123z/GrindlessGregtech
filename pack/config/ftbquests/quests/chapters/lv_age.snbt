		{
			dependencies: ["5F2D3E9A2F35D8E0"]
			description: [
				"Realgar splits in the electrolyzer into arsenic and sulfur; arsenic and gallium blend in the mixer into gallium arsenide."
				"Spin that into copper wire and glass in the assembler and you get a diode - the last part the MV circuit is waiting on."
			]
			icon: "gtceu:diode"
			id: "0785A341666D046E"
