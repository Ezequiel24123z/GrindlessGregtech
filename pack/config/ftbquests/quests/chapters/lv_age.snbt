			tasks: [{ id: "149106CCB19946CB", item: "gtceu:optical_observatory", type: "item" }]
			title: "Optical Observatory"
			x: 18.0d
			y: -4.5d
		}
		{
			dependencies: ["3D32B4FC8AEE49CE"]
			description: ["The plates come back with crater chains, cracks and long shadows along the terminator, and for the first time you can tell flat ground from rough. The same run gives you the ephemeris too."]
			icon: "grindless:lunar_map"
			id: "101BAA038F0ACAA6"
			rewards: [{ id: "763B0BB08C2440D6", type: "xp", xp: 40 }]
			tasks: [{ id: "341C3A1BD14B42D1", item: "grindless:lunar_map", type: "item" }]
