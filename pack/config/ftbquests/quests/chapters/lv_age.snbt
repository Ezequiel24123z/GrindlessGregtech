	quest_links: [ ]
	quests: [
		{
			dependencies: ["4996827E4BFC339E"]
			description: [
				"Steam turns into current. Machines want a cable now instead of a firebox, and the Nether stops being a quick raid: its veins end up in your drills."
				"Up top, the Moon gets its first proper photograph, taken with the chart you drew by hand."
			]
			icon: "gtceu:lv_machine_hull"
			id: "1AC672110DFD0C14"
			rewards: [{ id: "4786320F4045B988", type: "xp", xp: 40 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "63D4DB568C704834", type: "checkmark" }]
			title: "LV Factory"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["5795EAFBAB034E45"]
			description: [
				"The &6Assembler&r puts parts together into finished pieces, and here it builds a surprising amount: the blast furnace's coils, the heliostat mirrors, the creature models and AE2's network blocks. It rarely sits idle."
			]
			icon: "gtceu:lv_assembler"
			id: "6D668A4CB9B8384A"
			rewards: [{ id: "1B81E3E9597DAE9B", type: "xp", xp: 30 }]
			tasks: [{ id: "35B04A0D13C90131", item: "gtceu:lv_assembler", type: "item" }]
			title: "LV Assembler"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["6D668A4CB9B8384A"]
			description: [
				"They make the blast furnace's heating ring. The coil decides how hot the furnace gets, and the heat decides what it can make. Cupronickel is the first and coolest of them; you'll be back for better ones."
			]
			icon: "gtceu:cupronickel_coil_block"
			id: "5C7A2E94B1D03F68"
			rewards: [{ id: "2B8E4D1A7C09F356", type: "xp", xp: 35 }]
			tasks: [{ count: 16L, id: "4E0A9C2D6B3F1785", item: "gtceu:cupronickel_coil_block", type: "item" }]
			title: "Cupronickel Coils"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["1AC672110DFD0C14"]
			description: [
				"Motor, piston, pump, conveyor and robot arm. Nearly every LV machine is some mix of the five, so keep a few of each in a chest and you'll walk to the crafting table a lot less."
			]
			icon: "gtceu:lv_electric_motor"
			id: "5795EAFBAB034E45"
			rewards: [{ id: "4B9A14388EC1DE1F", type: "xp", xp: 35 }]
			tasks: [
				{ id: "6191C496F3440A30", item: "gtceu:lv_electric_motor", type: "item" }
				{ id: "593F87E0E6962621", item: "gtceu:lv_electric_piston", type: "item" }
				{ id: "02B134D9B3C59D42", item: "gtceu:lv_electric_pump", type: "item" }
				{ id: "422B9B071F8AE818", item: "gtceu:lv_conveyor_module", type: "item" }
				{ id: "3922B6EA6ABAD1D2", item: "gtceu:lv_robot_arm", type: "item" }
			]
			title: "LV Components"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["5795EAFBAB034E45"]
			description: [
				"The steam macerator's electric replacement. It still gives only the first output until HV, so in this row the byproducts come from the washer and the centrifuges."
				"Everything after it starts from crushed ore."
			]
			icon: "gtceu:lv_macerator"
			id: "3822BE3A45F1C474"
			rewards: [{ id: "398BF14CA6CAFA1E", type: "xp", xp: 30 }]
			tasks: [{ id: "55E3030426D27EC5", item: "gtceu:lv_macerator", type: "item" }]
			title: "Macerator"
			x: 4.0d
			y: -3.0d
		}
		{
			dependencies: ["3822BE3A45F1C474"]
			description: [
				"Rinses crushed ore into purified ore and shakes loose some of the first byproduct. Distilled water does it faster than plain water."
				"For some ores a sodium persulfate soak in the chemical bath gives a lot more; that is how bauxite gives up its gallium."
			]
			icon: "gtceu:lv_ore_washer"
			id: "766C58FC4FAC6D61"
			rewards: [{ id: "3F8A3B9EF346D7A9", type: "xp", xp: 30 }]
			tasks: [{ id: "68276F11F073D951", item: "gtceu:lv_ore_washer", type: "item" }]
			title: "Ore Washer"
			x: 6.0d
			y: -3.0d
		}
		{
			dependencies: ["766C58FC4FAC6D61"]
			description: [
				"Bakes and spins washed ore into refined ore, and a second byproduct falls out on the way. The macerator then grinds the refined ore into clean dust."
			]
			icon: "gtceu:lv_thermal_centrifuge"
			id: "18D60FF391B2F8DC"
			rewards: [{ id: "7C387B8FD56D62F2", type: "xp", xp: 30 }]
			tasks: [{ id: "5E478CDE07E1C692", item: "gtceu:lv_thermal_centrifuge", type: "item" }]
			title: "Thermal Centrifuge"
			x: 8.0d
			y: -3.0d
		}
		{
			dependencies: ["18D60FF391B2F8DC"]
			description: [
				"Spins dusts, fluids and even air apart into what they're made of. It's the last stop of the ore line, and air from the gas collector comes out as nitrogen and oxygen."
				"It also splits realgar into arsenic and sulfur, so rubber stops costing you a trip to the Nether."
			]
			icon: "gtceu:lv_centrifuge"
			id: "5ECDAA1F9811AC0A"
			rewards: [{ id: "4E54241FEC649BA9", type: "xp", xp: 35 }]
			tasks: [{ id: "71F985CEEB82AD09", item: "gtceu:lv_centrifuge", type: "item" }]
			title: "Centrifuge"
			x: 10.0d
			y: -3.0d
		}
		{
			dependencies: ["5795EAFBAB034E45"]
			description: [
				"Same samples and bits as the steam drill, only electric and quicker, and a second energy hatch makes it quicker again. It runs every steam drill recipe as well."
				"It also has a fluid hatch, which matters more than it sounds."
			]
			icon: "gtceu:lv_vein_drill"
			id: "2235038DEB4D9870"
			rewards: [
				{ id: "7D49D8C7E78B9686", type: "xp", xp: 60 }
				{ count: 16, id: "1C05E3ECFA795ECC", item: "minecraft:torch", type: "item" }
			]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "31B8E7F41955B3AC", item: "gtceu:lv_vein_drill", type: "item" }]
			title: "LV Vein Drill"
			x: 4.0d
			y: 1.5d
		}
		{
			dependencies: ["2235038DEB4D9870"]
			description: [
				"The drill's own stone dust, mixed with lubricant and water, comes back as drilling fluid. With it in the hatch the drill brings up more ore and wears its bits slower."
				"The Nether veins won't drill without it, and the steam drill has nowhere to put it. The lubricant comes from the creosote your coke ovens have been hoarding."
			]
			icon: "grindless:empty_vein_probe"
			id: "3C4B301F348411BF"
			rewards: [{ id: "25F806C232F0B708", type: "xp", xp: 30 }]
			tasks: [{ id: "1157F014AE90D968", type: "checkmark" }]
			title: "Drilling Fluid"
			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["3C4B301F348411BF"]
			description: [
				"The Nether has veins of its own, certus quartz, beryllium and saltpeter among them. Bring back raw ore from the vein you want and make its sample at home."
				"One trip per vein. After that the drill does the visiting."
			]
			icon: "grindless:vein_sample_certus_quartz"
			id: "65FE680CCF2D67C5"
			optional: true
			rewards: [{ id: "6D4BD4D9D3258F3A", type: "xp", xp: 25 }]
			tasks: [{ id: "4818390ABECA1D36", type: "checkmark" }]
			title: "Nether Veins"
			x: 8.0d
			y: 1.5d
		}
		{
			dependencies: ["5795EAFBAB034E45"]
			description: [
				"An electric greenhouse with a water hatch, and water lets it grow what the steam one can't: mushrooms, berries, vines, kelp and a whole bed of flowers."
				"It still runs everything the steam greenhouse did, only faster."
			]
			icon: "gtceu:lv_greenhouse"
			id: "73CA53E9E02D4639"
			rewards: [
				{ id: "3A8B6F69F89E37B8", type: "xp", xp: 60 }
				{ count: 4, id: "6E8ED069BA128CD5", item: "minecraft:wheat_seeds", type: "item" }
			]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "517E334F5EDF0822", item: "gtceu:lv_greenhouse", type: "item" }]
			title: "LV Greenhouse"
			x: 4.0d
			y: 4.5d
		}
		{
			dependencies: ["73CA53E9E02D4639"]
			description: [
				"Fertilizer and the right programmed circuit in the greenhouse's bus double the harvest and halve the time."
				"The mixer makes it from dirt, wood dust and sand. The chemical reactor makes it from calcite or apatite with ash, which is where the ash from your furnaces ends up."
			]
			icon: "gtceu:fertilizer"
			id: "47283300070CD8C2"
			rewards: [{ id: "446F9500700968E8", type: "xp", xp: 30 }]
			tasks: [{ count: 8L, id: "68E554C92C5B3A0C", item: "gtceu:fertilizer", type: "item" }]
			title: "Fertilizer"
			x: 6.0d
			y: 4.5d
		}
		{
			dependencies: ["47283300070CD8C2"]
			description: [
				"Mob drops without the mob. The &6Creature Simulator&r turns a model, some biomass and the creature's own mineral into drops, and nothing has to die."
				"The programmed circuit picks the roll: circuit 1 gives the full set, the others a single kind of drop."
			]
			icon: "gtceu:lv_creature_simulator"
			id: "15D34CE9F5FCE6B3"
			rewards: [{ id: "391C99C4924378FE", type: "xp", xp: 40 }]
