			title: "Forming Press"
			x: 18.0d
			y: 7.5d
		}
		{
			dependencies: ["2C50918B882FA400"]
			description: [
				"Graphite dust from the diamond vein, pressed around a steel rod. The arc furnace burns through one now and then, the way the drill eats bits, so keep spares in its bus."
			]
			icon: "grindless:graphite_electrode"
			id: "4767E74EF8428F44"
			rewards: [{ id: "4BD45FED6F5C4863", type: "xp", xp: 30 }]
			tasks: [{ count: 2L, id: "6322BDD620B9ABED", item: "grindless:graphite_electrode", type: "item" }]
			title: "Graphite Electrode"
			x: 20.0d
			y: 7.5d
		}
		{
			dependencies: ["4767E74EF8428F44"]
			description: [
				"An arc under quartz sand and coke makes AE2's silicon at LV, while GregTech's own silicon waits for an MV blast furnace. It takes exactly two energy hatches and an electrode."
				"It also turns cobblestone and water into obsidian and bakes sky dust, so all of AE2 is within reach this early."
			]
			icon: "gtceu:submerged_arc_furnace"
			id: "62D5FBAC11D478E9"
			rewards: [{ id: "74420A10ED35F67C", type: "xp", xp: 70 }]
