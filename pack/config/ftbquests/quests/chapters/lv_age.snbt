			title: "Steam for the Night"
			x: 10.0d
			y: -1.5d
		}
		{
			dependencies: ["6D668A4CB9B8384A"]
			description: ["The heliostat tower needs a whole field of these behind it, each angled to throw sunlight at the top. They're silvered glass. Get the silver going before you start on them."]
			icon: "grindless:heliostat_mirror"
			id: "2F6B1D9A8C4E0527"
			rewards: [{ id: "7B1F4C8E2D05A930", type: "xp", xp: 40 }]
