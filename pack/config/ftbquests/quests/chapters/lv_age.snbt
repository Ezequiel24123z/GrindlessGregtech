			title: "Centrifuge"
			x: 15.0d
			y: 3.0d
		}
		{
			dependencies: ["5795EAFBAB034E45", "731F761B242263ED"]
			description: [
				"The &6LV Vein Drill&r is the steam derrick's electric twin: same sample, same bit, more bores at once and room for a second hatch to push it further."
				"Every Steam Vein Drill recipe still runs here too - nothing you already built stops working."
			]
			icon: "gtceu:lv_vein_drill"
			id: "2235038DEB4D9870"
			rewards: [
				{ id: "7D49D8C7E78B9686", type: "xp", xp: 60 }
