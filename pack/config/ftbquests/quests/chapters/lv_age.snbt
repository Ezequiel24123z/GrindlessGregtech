			title: "Certus Quartz Crystal"
			x: 24.0d
			y: 9.0d
		}
		{
			dependencies: ["3D374AE4AF789B83"]
			description: ["AE2's own &6Inscriber&r and &6Charger&r, built in the assembler from GregTech parts instead of a handful of iron. Once they're down they work exactly like they do anywhere else."]
			icon: "ae2:inscriber"
			id: "28CA19174EBE8705"
			rewards: [{ id: "3EDF966589041684", type: "xp", xp: 35 }]
