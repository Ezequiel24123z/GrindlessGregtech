			x: 18.0d
			y: -6.0d
		}
		{
			dependencies: ["365B9E86E3AA4894", "10F6A7BFB476944C"]
			description: [
				"A refractor in a dome that tracks the Moon for long plate exposures. Photographic plates and your steam-age draft chart, which it reads and hands back. Lunar maps, and the ephemeris that later eras read. Plates by bus; it still wants a clear night, at any height."
				"Build it anywhere you like."
			]
			icon: "gtceu:optical_observatory"
			id: "3D32B4FC8AEE49CE"
			rewards: [{ id: "72DE2BE97D294BA3", type: "xp", xp: 60 }]
