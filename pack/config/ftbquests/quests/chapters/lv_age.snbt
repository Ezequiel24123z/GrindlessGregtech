			tasks: [{ id: "2AF30FE5A1B67780", type: "checkmark" }]
			title: "First Pearl"
			x: 10.0d
			y: 4.5d
		}
		{
			dependencies: ["32CF7B11121B4DA9"]
			description: [
				"Print models for whatever you're short on. A blank model plus some of the creature's own material makes one, and the simulator never uses it up."
				"Any one of them counts here."
			]
			icon: "grindless:blank_creature_model"
			id: "29B4717D718C6BB5"
			rewards: [{ id: "782162B7F4EAE965", type: "xp", xp: 30 }]
