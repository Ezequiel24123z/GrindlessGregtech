			x: 22.0d
			y: 7.5d
		}
		{
			dependencies: ["62D5FBAC11D478E9"]
			description: ["Silicon is in hand, so the storage network is within reach. The row below walks it from crystal to terminal."]
			icon: "ae2:controller"
			id: "4B8D2F6A1C7E9035"
			rewards: [{ id: "6F2B8D4A1E7C3095", type: "xp", xp: 30 }]
