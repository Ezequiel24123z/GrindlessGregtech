			x: 20.0d
			y: -4.5d
		}
		{
			dependencies: ["101BAA038F0ACAA6"]
			description: ["Tables of where the Moon will be on any night, worked out from the same plates as the map. The radio telescope in MV reads both and never uses them up."]
			icon: "grindless:lunar_ephemeris"
			id: "1EEB24C2AB3EF4B0"
			rewards: [{ id: "3F3B1C55D2A048F1", type: "xp", xp: 40 }]
