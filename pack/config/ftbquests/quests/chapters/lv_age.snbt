			x: 20.0d
			y: 7.5d
		}
		{
			dependencies: ["4767E74EF8428F44"]
			description: [
				"An arc under quartz sand and coke makes AE2's silicon at LV. Two energy hatches and a graphite electrode. Silicon for AE2, obsidian from cobblestone and water, and sky dust. Sand and coke by bus, spare electrodes in the bus."
				"GregTech's own silicon waits for an MV blast furnace."
			]
			icon: "gtceu:submerged_arc_furnace"
			id: "62D5FBAC11D478E9"
