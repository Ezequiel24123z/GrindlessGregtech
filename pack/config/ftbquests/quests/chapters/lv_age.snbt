				{ id: "422B9B071F8AE818", item: "gtceu:lv_conveyor_module", type: "item" }
				{ id: "3922B6EA6ABAD1D2", item: "gtceu:lv_robot_arm", type: "item" }
			]
			title: "LV Components"
			x: 5.0d
			y: 3.0d
		}
		{
			dependencies: ["5795EAFBAB034E45"]
			description: [
				"The electric &6Macerator&r does what the steam one did, just faster and always on. Raw ore to crushed ore, crushed to dust."
				"Every machine down the ore line expects crushed ore to start from, not raw."
			]
			icon: "gtceu:lv_macerator"
			id: "3822BE3A45F1C474"
			rewards: [{ id: "398BF14CA6CAFA1E", type: "xp", xp: 30 }]
			tasks: [{ id: "55E3030426D27EC5", item: "gtceu:lv_macerator", type: "item" }]
			title: "Macerator"
			x: 7.5d
			y: 3.0d
		}
		{
			dependencies: ["3822BE3A45F1C474"]
			description: [
				"The proper washing steam age promised: the &6Ore Washer&r cleans crushed ore in water and keeps the secondary material whole instead of losing it to chance."
				"A few ores wash better in sodium persulfate than plain water - check the recipe viewer for which."
			]
			icon: "gtceu:lv_ore_washer"
			id: "766C58FC4FAC6D61"
			rewards: [{ id: "3F8A3B9EF346D7A9", type: "xp", xp: 30 }]
