			title: "Ore Washer"
			x: 10.0d
			y: 3.0d
		}
		{
			dependencies: ["766C58FC4FAC6D61"]
			description: ["The &6Thermal Centrifuge&r bakes washed ore to pull out one more secondary dust before the final crush. Heat does what a hammer can't."]
			icon: "gtceu:lv_thermal_centrifuge"
			id: "18D60FF391B2F8DC"
			rewards: [{ id: "7C387B8FD56D62F2", type: "xp", xp: 30 }]
