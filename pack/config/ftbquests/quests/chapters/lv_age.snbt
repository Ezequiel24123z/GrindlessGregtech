			x: 22.0d
			y: -4.5d
		}
		{
			dependencies: ["3C89167418EA462B"]
			description: [
				"The sulfide roaster's catalyst, vanadium on diatomite, from the mixer. It wears out now and then, so keep a few in the roaster's bus."
				"For the vanadium, smelt raw vanadium magnetite into dust and let the centrifuge split it."
			]
			icon: "grindless:contact_catalyst"
			id: "30B1A00EBEC54B6D"
			rewards: [{ id: "124DE9A929364C39", type: "xp", xp: 30 }]
			tasks: [{ count: 4L, id: "3FF1A8EC8D614951", item: "grindless:contact_catalyst", type: "item" }]
			title: "Contact Catalyst"
			x: 12.0d
			y: 3.0d
		}
		{
			dependencies: ["30B1A00EBEC54B6D"]
			description: [
				"It burns sulfide ores in air and turns the sulfur into sulfuric acid. Sulfide ore, air and a contact catalyst. Acid without a cloud, silver from galena, and steam from the waste heat. Ore by bus, acid by pipe, heat back to your turbines."
				"The heat comes back as steam for your turbines."
			]
			icon: "gtceu:sulfide_roaster"
			id: "5A176E45F8E64ED7"
			rewards: [{ id: "6A1E3C0D9B2F4E58", type: "xp", xp: 35 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5B51E7ED80874170", item: "gtceu:sulfide_roaster", type: "item" }]
			title: "Sulfide Roaster"
			x: 14.0d
			y: 3.0d
		}
		{
			dependencies: ["5A176E45F8E64ED7"]
			description: [
				"Sulfuric acid makes bisulfate, and electrolysis turns that into the etching bath for circuit boards. Sulfuric acid, salt, a reactor and an electrolyzer. Etched boards, and the gallium bath. Acid and salt in by pipe and bus, bath out by pipe."
				"Boards are etched in it, with silver foil for the traces."
			]
			icon: "gtceu:sodium_persulfate_bucket"
			id: "427041EFB45AE2E6"
			rewards: [{ id: "1F3B5D7A9C2E4068", type: "xp", xp: 25 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "286C9327A8DABC2C", item: "gtceu:sodium_persulfate_bucket", type: "item" }]
			title: "Sodium Persulfate"
			x: 14.0d
			y: 4.5d
		}
		{
			dependencies: ["3C89167418EA462B"]
			description: [
				"The semiconductor behind diodes, and the dopant every silicon boule needs. Gallium recovered from the sulfide byproducts, and arsenic, in the mixer. Diodes here, and boules in MV. Both dusts by bus, crystal out by bus."
				"Make plenty; MV spends it faster than it looks."
			]
			icon: "gtceu:gallium_arsenide_dust"
			id: "2A4C6E8B1D3F5097"
			rewards: [{ id: "5D7F9B1A3C2E4086", type: "xp", xp: 25 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3B5D7F9A1C2E4086", item: "gtceu:gallium_arsenide_dust", type: "item" }]
			title: "Gallium Arsenide"
			x: 12.0d
			y: 4.5d
		}
		{
			dependencies: ["5A176E45F8E64ED7"]
			description: ["Roast galena and silver nuggets drop out with the lead oxide. The heliostat mirrors and the photographic plates both want silver."]
			icon: "gtceu:silver_nugget"
			id: "2B7D9F41C0E83A65"
			rewards: [{ id: "34D2F60B19C7E853", type: "xp", xp: 35 }]
			tasks: [{ count: 6L, id: "3E1C4A7D35B20F96", item: "gtceu:silver_nugget", type: "item" }]
			title: "Silver from Galena"
			x: 16.0d
			y: 3.0d
		}
		{
			dependencies: ["3A7E2C5F1B9D4061"]
			description: ["A steel multiblock tank soaks up the tower's daytime steam so the turbines keep turning after dark. A long night with a lot of turbines needs more than one."]
			icon: "gtceu:steel_multiblock_tank"
			id: "1D9C4B27E05F8A36"
			rewards: [{ id: "5E0A7C93D2B14F68", type: "xp", xp: 35 }]
