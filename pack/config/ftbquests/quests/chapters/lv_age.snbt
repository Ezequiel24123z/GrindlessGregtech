	quests: [
		{
			dependencies: ["4996827E4BFC339E"]
			description: [
				"Steam turns into current for good. Past this gate every machine in the factory expects a plug, not a firebox."
				"Hatches feed the big multiblocks, hulls carry the small stuff. Wire the grid first - everything else in this chapter waits on it."
			]
			icon: "gtceu:lv_machine_hull"
			id: "1AC672110DFD0C14"
			rewards: [{ id: "4786320F4045B988", type: "xp", xp: 40 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "63D4DB568C704834", type: "checkmark" }]
			title: "LV Factory"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["1AC672110DFD0C14"]
			description: [
				"The &6Energy Hatch&r is how a multiblock controller eats power - no controller takes a cable straight to its hull."
				"The &6Battery Buffer&r smooths the grid for single-block machines: charge it off the turbines, draw from it steady."
			]
			icon: "gtceu:lv_energy_input_hatch"
			id: "731F761B242263ED"
			rewards: [{ id: "001BEA86BA7E7B9D", type: "xp", xp: 30 }]
			tasks: [
				{ count: 2L, id: "00C1332B2F38EA10", item: "gtceu:lv_energy_input_hatch", type: "item" }
				{ id: "5B6C51DD6515E79B", item: "gtceu:lv_battery_buffer_4x", type: "item" }
			]
			title: "LV Grid"
			x: 2.5d
			y: 0.0d
		}
		{
			dependencies: ["731F761B242263ED"]
			description: [
				"The &6Assembler&r puts two or three parts together into one finished piece - plates into frames, cores into network blocks."
				"Most of what gets built this chapter, from circuits to the AE2 network, passes through this machine at some point."
			]
			icon: "gtceu:lv_assembler"
			id: "6D668A4CB9B8384A"
			rewards: [{ id: "1B81E3E9597DAE9B", type: "xp", xp: 30 }]
			tasks: [{ id: "35B04A0D13C90131", item: "gtceu:lv_assembler", type: "item" }]
			title: "LV Assembler"
			x: 5.0d
			y: -3.0d
		}
		{
			dependencies: ["731F761B242263ED"]
			description: [
				"Motor, piston, pump, conveyor and robot arm: the five moving parts behind every single-block LV machine."
				"Keep a stock of each. Ore machines, presses and everything after all ask for a different mix of them."
			]
			icon: "gtceu:lv_electric_motor"
			id: "5795EAFBAB034E45"
			rewards: [{ id: "4B9A14388EC1DE1F", type: "xp", xp: 35 }]
