			title: "LV Vein Drill"
			x: 7.5d
			y: 6.0d
		}
		{
			dependencies: ["2235038DEB4D9870"]
			description: [
				"Mix the drill's own stone dust with lubricant and water in a mixer and you get drilling fluid: feed it to the drill's hatch for more ore per run and less bit wear."
				"Nether veins only drill with it in the tank - the steam drill never had a hatch to carry it."
			]
			icon: "grindless:empty_vein_probe"
			id: "3C4B301F348411BF"
			rewards: [{ id: "25F806C232F0B708", type: "xp", xp: 30 }]
