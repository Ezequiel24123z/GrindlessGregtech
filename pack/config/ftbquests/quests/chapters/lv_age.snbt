			title: "The AE2 Branch"
			x: 22.0d
			y: 9.0d
		}
		{
			dependencies: ["4B8D2F6A1C7E9035"]
			description: ["The autoclave grows certus dust into crystals in water, and distilled water does it faster and never fails. GregTech's machines hand out AE2's crystal here, so the ore line and the network share one pile."]
			icon: "ae2:certus_quartz_crystal"
			id: "3D374AE4AF789B83"
