			]
			tasks: [{ id: "2AF30FE5A1B67780", type: "checkmark" }]
			title: "First Pearl"
			x: 10.0d
			y: 7.5d
		}
		{
			dependencies: ["32CF7B11121B4DA9"]
			description: [
				"Print models for whatever you're short on. A blank model plus some of the creature's own material makes one, and the simulator never uses it up."
				"Any one of them counts here."
			]
			icon: "grindless:blank_creature_model"
			id: "29B4717D718C6BB5"
			rewards: [{ id: "782162B7F4EAE965", type: "xp", xp: 30 }]
			tasks: [
				{ id: "6B39783669D5AE2E", item: "grindless:creature_model_skeleton", optional_task: true, type: "item" }
				{ id: "705082C0BE79BADE", item: "grindless:creature_model_spider", optional_task: true, type: "item" }
				{ id: "1E56DA4C00BE6A2F", item: "grindless:creature_model_slime", optional_task: true, type: "item" }
				{ id: "36F184755D8092CC", item: "grindless:creature_model_sheep", optional_task: true, type: "item" }
				{ id: "2961A704C29317BA", item: "grindless:creature_model_cow", optional_task: true, type: "item" }
				{ id: "19BD855ED20A96BD", item: "grindless:creature_model_chicken", optional_task: true, type: "item" }
				{ id: "785BE405026B5CDF", item: "grindless:creature_model_enderman", optional_task: true, type: "item" }
			]
			title: "Creature Models"
			x: 12.0d
			y: 7.5d
		}
		{
			dependencies: ["29B4717D718C6BB5"]
			description: ["Both models print at LV, but the creeper and the blaze only run in an MV simulator. Make them now and they'll be waiting."]
			icon: "grindless:creature_model_creeper"
			id: "47892302FAEA3244"
			optional: true
			rewards: [{ id: "4E622AC6A0F97D24", type: "xp", xp: 25 }]
