			title: "Forming Press"
			x: 18.0d
			y: 7.5d
		}
		{
			dependencies: ["2C50918B882FA400"]
			description: ["Graphite dust from the diamond vein, pressed around a steel rod. The arc furnace burns through one now and then, the way the drill eats bits. Spares go in its bus."]
			icon: "grindless:graphite_electrode"
			id: "4767E74EF8428F44"
			rewards: [{ id: "4BD45FED6F5C4863", type: "xp", xp: 30 }]
