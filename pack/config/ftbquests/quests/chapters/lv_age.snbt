			title: "Thermal Centrifuge"
			x: 12.5d
			y: 3.0d
		}
		{
			dependencies: ["18D60FF391B2F8DC"]
			description: [
				"The &6Centrifuge&r spins dusts, fluids, even air apart into what they're actually made of."
				"It is the last stop of the ore line - and the first place nitrogen and oxygen come from, once air goes in."
			]
			icon: "gtceu:lv_centrifuge"
			id: "5ECDAA1F9811AC0A"
			rewards: [{ id: "4E54241FEC649BA9", type: "xp", xp: 35 }]
