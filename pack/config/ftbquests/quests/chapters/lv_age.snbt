		{
			dependencies: ["220C6C2F1D568194"]
			description: [
				"Wood dust and glue press into a phenolic board; silver foil and a splash of sodium persulfate - or iron chloride, your call - finish it into a good circuit board."
				"Better than the resin one steam age taught you, and the salt chemistry you just unlocked is what makes it."
			]
			icon: "gtceu:phenolic_printed_circuit_board"
