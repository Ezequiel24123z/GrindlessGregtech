			title: "Drilling Fluid"
			x: 10.0d
			y: 6.0d
		}
		{
			dependencies: ["3C4B301F348411BF"]
			description: [
				"A dozen more veins wait in the Nether - certus quartz, beryllium, saltpeter and others the Overworld table doesn't carry."
				"Dunk the probe in two raw ores of the vein you want, same as any sample. One trip is exploration, not grind - the drill never runs it dry."
			]
			icon: "grindless:vein_sample_certus_quartz"
			id: "65FE680CCF2D67C5"
			optional: true
			rewards: [{ id: "6D4BD4D9D3258F3A", type: "xp", xp: 25 }]
