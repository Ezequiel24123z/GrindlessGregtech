	order_index: 0
	quest_links: [ ]
	quests: [
		{
			dependencies: ["3207813527EE1FBD"]
			description: [
				"Still on Earth, still no electricity. Fire boils water here, and the steam drives bronze machines."
				"By the end, drills and greenhouses do the gathering and your first generator is turning. Until then, the pickaxe still has work to do."
			]
			icon: "gtceu:lp_steam_solid_boiler"
			id: "3041A191AB566E3E"
			rewards: [{ id: "52D5B636AC2AFE95", type: "xp", xp: 20 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "410D4E9D93B2590D", type: "checkmark" }]
			title: "Steam Age"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["3041A191AB566E3E"]
			description: [
				"Smelt clay into bricks. The boiler and the bricked casings of the steam machines are built on them, and the clay you got for finishing bronze was meant for exactly this."
			]
			icon: "minecraft:bricks"
			id: "2504804D432C502B"
			rewards: [{ id: "2A35AC3AAAB1DF17", type: "xp", xp: 20 }]
			tasks: [{ count: 16L, id: "71F99DC62AF5BF3C", item: "minecraft:brick", type: "item" }]
			title: "Clay and Bricks"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["3041A191AB566E3E"]
			description: [
				"The coke oven wants its own bricks, and they take a few more steps than the plain kind: a carved wooden form, coke clay, then the furnace. The form never leaves the grid, so one carving lasts forever."
			]
			icon: "gtceu:coke_oven_bricks"
			id: "2FF295FBA78AF335"
			rewards: [{ id: "6A7800690D415A43", type: "xp", xp: 25 }]
			tasks: [
				{ id: "1375061D838CBA5C", item: "gtceu:empty_wooden_form", type: "item" }
				{ id: "798F691F46884A2A", item: "gtceu:brick_wooden_form", type: "item" }
				{ id: "4089C686D0D31180", item: "gtceu:compressed_coke_clay", type: "item" }
				{ id: "40B754DC855D6933", item: "gtceu:coke_oven_brick", type: "item" }
				{ count: 25L, id: "46BC785D13A069E4", item: "gtceu:coke_oven_bricks", type: "item" }
			]
			title: "Coke Oven Bricks"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["2FF295FBA78AF335"]
			description: [
				"Your first multiblock, and a gentle one: a hollow cube of bricks with the controller in one face. EMI shows the shape on the controller's page."
				"It turns coal into coke and logs into charcoal, which a furnace won't do here. The creosote that collects inside burns in boilers, or soaks planks into treated wood."
			]
			icon: "gtceu:coke_oven"
			id: "20A9578F6F706702"
			rewards: [
				{ id: "2F8316F0B18FE31A", type: "xp", xp: 30 }
				{ count: 8, id: "4CEF32FF034FD548", item: "minecraft:coal", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "74AB3375CC84D045", item: "gtceu:coke_oven", type: "item" }
				{ count: 8L, id: "160AC0E4D073488B", item: "gtceu:coke_gem", type: "item" }
			]
			title: "Coke Oven"
			x: 4.0d
			y: -1.5d
		}
		{
			dependencies: ["20A9578F6F706702"]
			description: [
				"The &6Coke Battery&r cokes like a row of coke ovens and also keeps the coal gas they let escape. Tank the gas; LV has plans for it."
				"No steam part can pull fluid out of a multiblock. Here you can hand-craft the ULV output hatch instead, and a screwdriver turns it into the input version."
			]
			icon: "gtceu:coking_battery"
			id: "3A7C5E1D9B2F6048"
			rewards: [{ id: "6A2D9F4C1E8B5073", type: "xp", xp: 40 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5F1E8B2C4A9D7063", item: "gtceu:coking_battery", type: "item" }]
			title: "Coke Battery"
			x: 6.0d
			y: -1.5d
		}
		{
			dependencies: ["20A9578F6F706702"]
			description: [
				"The pump makes its own water, a little faster in wet biomes, so no bucket or lake is needed."
				"Give it a ULV fluid output hatch instead of its own pump hatch and it pumps twice as much. The large steam ore washer is built around one later, too."
			]
			icon: "gtceu:primitive_pump"
			id: "0E2E13522BA2A323"
			rewards: [{ id: "413042DF78D6A4F5", type: "xp", xp: 20 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "4AAD651868C2E72F", item: "gtceu:primitive_pump", type: "item" }]
			title: "Primitive Pump"
			x: 6.0d
			y: -3.0d
		}
		{
			dependencies: ["2504804D432C502B"]
			description: [
				"Your first steam. Fill it with water before the first fuel goes in: a dry, hot boiler that suddenly gets water doesn't stay a boiler for long."
				"Boilers here make far more steam than in stock GregTech, and one goes a long way. Steam leaves through the top, back and sides, never the bottom or the front. Feed the water in from below."
			]
			icon: "gtceu:lp_steam_solid_boiler"
			id: "6D923ADC90127182"
			rewards: [
				{ id: "0348F0407B42C093", type: "xp", xp: 30 }
				{ count: 8, id: "31391282AEDC2039", item: "minecraft:charcoal", type: "item" }
			]
			tasks: [{ id: "4753776446D60E4F", item: "gtceu:lp_steam_solid_boiler", type: "item" }]
			title: "Low-Pressure Boiler"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["6D923ADC90127182"]
			description: [
				"Each steam machine starts from a &6Bronze Machine Casing&r or a &6Bricked Bronze Casing&r and drinks steam from a boiler or pipe beside it."
				"After every cycle it vents a puff of steam out of the back. Wall that side off and the machine stops, and it'll wait there as long as you will. The bronze ones also run at half the speed of the steel versions."
			]
			icon: "gtceu:bronze_machine_casing"
			id: "4F0049B2E382BA8E"
			rewards: [{ id: "3584CC34BCFF6E54", type: "xp", xp: 25 }]
			tasks: [
				{ id: "25ADC88A15337AD3", item: "gtceu:bronze_machine_casing", type: "item" }
				{ id: "5EFEA10D880CB812", item: "gtceu:bronze_brick_casing", type: "item" }
			]
			title: "Steam Machines"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"GregTech's miner chews through the ore under it, block by block, until there's nothing left. Don't scrap it when it runs dry; the steam vein drill is built around one."
			]
			icon: "gtceu:lp_steam_miner"
			id: "3E65A226A598A301"
			rewards: [{ id: "000E98439123F51B", type: "xp", xp: 30 }]
			tasks: [{ id: "07D15B562DFB45B0", item: "gtceu:lp_steam_miner", type: "item" }]
			title: "Steam Miner"
			x: 8.0d
			y: -3.0d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"The mortar's job without the elbow grease. It only gives the first output, so byproducts wait for the large steam macerator or an HV one. It still doubles your ore, though: raw ore comes out as crushed ore, and crushed ore smelts too."
				"It wants diamonds from the deep veins."
			]
			icon: "gtceu:lp_steam_macerator"
			id: "0238F574F77C30E5"
			rewards: [{ id: "5B2F25CCB1188B32", type: "xp", xp: 30 }]
			tasks: [{ id: "482297E9CDFF2C7C", item: "gtceu:lp_steam_macerator", type: "item" }]
			title: "Steam Macerator"
			x: 8.0d
			y: -1.5d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"GregTech won't let you pack nuggets into ingots by hand, so the compressor does it. It also presses wood dust into the wood plates the first circuit boards start from, and fireclay dust into bricks ready for the furnace."
			]
			icon: "gtceu:lp_steam_compressor"
			id: "6BB23A9836716A37"
			rewards: [{ id: "1D0789B0F2987E54", type: "xp", xp: 25 }]
			tasks: [{ id: "3CC85B833FE429F6", item: "gtceu:lp_steam_compressor", type: "item" }]
			title: "Steam Compressor"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"Copper and tin go in and bronze comes out, with less waste than mixing dust by hand. Red alloy comes from here too, and once you have molds it casts glass, glass tubes and rubber sheets."
				"The steam furnace is its plainer cousin, if you want one."
			]
			icon: "gtceu:lp_steam_alloy_smelter"
			id: "0B3A5E0D83643882"
			rewards: [{ id: "6C4BDF67A0491A0F", type: "xp", xp: 35 }]
			tasks: [
				{ id: "568FAC5542664DE3", item: "gtceu:lp_steam_alloy_smelter", type: "item" }
				{ id: "2708C54E534B1E99", item: "gtceu:lp_steam_furnace", optional_task: true, type: "item" }
			]
			title: "Steam Alloy Smelter"
			x: 8.0d
			y: 1.5d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"With water on one side and lava on the other, it breaks out cobblestone and stone for as long as you like. Neither fluid gets used up, so the first bucket of lava is also the last."
			]
			icon: "gtceu:lp_steam_rock_crusher"
			id: "68EB76B726CD7484"
			optional: true
			rewards: [{ id: "00D8E81A9DDF7BA9", type: "xp", xp: 25 }]
			size: 0.75d
			tasks: [{ id: "4BA8B69D840E07D5", item: "gtceu:lp_steam_rock_crusher", type: "item" }]
			title: "Steam Rock Crusher"
			x: 8.0d
			y: 3.0d
		}
		{
			dependencies: ["68EB76B726CD7484"]
			description: [
				"It gets more plates out of your ingots than the hand hammer, and it smashes cobblestone into gravel and gravel into sand. Put it behind the rock crusher and you never dig sand again."
			]
			icon: "gtceu:lp_steam_forge_hammer"
			id: "15187E005F30E142"
			optional: true
			rewards: [{ id: "33ECC7FB7F419BC9", type: "xp", xp: 25 }]
			size: 0.75d
			tasks: [{ id: "3E50605DD26A6BFC", item: "gtceu:lp_steam_forge_hammer", type: "item" }]
			title: "Steam Forge Hammer"
			x: 10.0d
			y: 3.0d
		}
		{
			dependencies: ["0238F574F77C30E5"]
			description: [
				"The &6Steam Grinder&r and &6Steam Oven&r are GregTech's macerator and furnace in multiblock form, working on several items per cycle from one steam hatch. Like the small macerator, the grinder skips the byproducts."
				"It won't go to waste later, either: the large steam macerator is built around a grinder."
			]
			icon: "gtceu:steam_grinder"
			id: "67124C424660DDAE"
			optional: true
			rewards: [{ id: "5F282F1DCDBBE785", type: "xp", xp: 30 }]
			size: 0.75d
			tasks: [
				{ id: "430BBAA23DA7FB8D", item: "gtceu:steam_grinder", optional_task: true, type: "item" }
				{ id: "733A302F2C306579", item: "gtceu:steam_oven", optional_task: true, type: "item" }
			]
			title: "Steam Multis"
			x: 10.0d
			y: -3.0d
		}
		{
			dependencies: ["6BB23A9836716A37", "0238F574F77C30E5"]
			description: [
				"The primitive blast furnace runs hot enough to ruin ordinary bricks. Firebricks can take it. They start as ground clay and brick, and the compressor and a furnace do the rest."
			]
			icon: "gtceu:firebricks"
			id: "7E4FF9E6FF9F495C"
			rewards: [{ id: "6162F57F24166A2C", type: "xp", xp: 30 }]
			tasks: [
				{ id: "0042B4B912A67298", item: "gtceu:clay_dust", type: "item" }
				{ id: "745EA8BD32C82370", item: "gtceu:brick_dust", type: "item" }
				{ id: "596503EAECB53F55", item: "gtceu:fireclay_dust", type: "item" }
				{ id: "058E00150C410DCB", item: "gtceu:compressed_fireclay", type: "item" }
				{ id: "05EE67E923A1F3C0", item: "gtceu:firebrick", type: "item" }
				{ count: 32L, id: "30FE470093309B75", item: "gtceu:firebricks", type: "item" }
			]
			title: "Firebricks"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["6BB23A9836716A37"]
			description: [
				"Smelt iron nuggets and they come out as wrought iron nuggets. It surprises everyone the first time. The compressor packs them into ingots, and those turn into steel faster than plain iron. LV hulls wear its plates, too."
			]
			icon: "gtceu:wrought_iron_ingot"
			id: "2985D1F260EE851E"
			rewards: [{ id: "77068FD9291EF2AB", type: "xp", xp: 20 }]
			tasks: [
				{ id: "44EC529548F6EB36", item: "gtceu:wrought_iron_nugget", type: "item" }
				{ id: "4086942D4962E24A", item: "gtceu:wrought_iron_ingot", type: "item" }
			]
			title: "Wrought Iron"
			x: 10.0d
			y: 1.5d
		}
		{
			dependencies: ["7E4FF9E6FF9F495C"]
			description: [
				"Iron and coke, or coal, make steel in here, slowly. Wrought iron speeds it up. When one furnace can't keep up, build the next against it; they're happy to share a wall."
			]
			icon: "gtceu:primitive_blast_furnace"
			id: "376295DE4FA3B31E"
			rewards: [{ id: "2C462FC0FC9B6EA1", type: "xp", xp: 35 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "74759AA68CA79F1D", item: "gtceu:primitive_blast_furnace", type: "item" }]
			title: "Primitive Blast Furnace"
			x: 12.0d
			y: 0.0d
		}
		{
			dependencies: ["376295DE4FA3B31E"]
			description: [
				"A second road to steel that takes iron ore straight from the drill, with coke and some calcite from the lapis vein. One of these out-produces half a dozen primitive furnaces, and it drinks steam to do it."
			]
			icon: "gtceu:steam_blast_furnace"
			id: "4B8E2D6A1F9C3057"
			rewards: [{ id: "5D9B3F7A1C2E6048", type: "xp", xp: 40 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7C1A4E9D2B6F3081", item: "gtceu:steam_blast_furnace", type: "item" }]
			title: "Steam Blast Furnace"
			x: 12.0d
			y: 1.5d
		}
		{
			dependencies: ["376295DE4FA3B31E"]
			description: [
				"Through the eyepiece the Moon shows dark seas, bright highlands and big craters with long rays. The &6Clockwork Observatory&r only works at night under a clear sky, with the controller at Y 100 or higher, above the haze and the smoke from your coke ovens."
			]
			icon: "gtceu:steam_observatory"
			id: "1253203E620BE055"
			rewards: [{ id: "1F6D3B9E4A2C8075", type: "xp", xp: 45 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "2E8C5A1F9D4B7036", item: "gtceu:steam_observatory", type: "item" }]
			title: "Clockwork Observatory"
			x: 12.0d
			y: -3.0d
		}
		{
			dependencies: ["1253203E620BE055"]
			description: [
				"Your first map of the Moon, drawn by hand at the eyepiece. Hold on to it: the optical observatory in LV reads it on every run and never uses it up. If you ever want a second one, a copy is cheap."
			]
			icon: "grindless:lunar_chart_draft"
			id: "10F6A7BFB476944C"
			rewards: [{ id: "6E2A8C4F1D9B3072", type: "xp", xp: 45 }]
			tasks: [{ id: "3B9E6D2F8A1C4057", item: "grindless:lunar_chart_draft", type: "item" }]
			title: "Lunar Chart (Draft)"
			x: 14.0d
			y: -3.0d
		}
		{
			dependencies: ["376295DE4FA3B31E"]
			description: [
				"Steel goes into the high-pressure steam machines, the casting molds and the steel drill bit, and it stays in your recipes from then on. Leave a blast furnace running and let the ingots pile up."
			]
			icon: "gtceu:steel_ingot"
			id: "33AF6A368B3587E0"
			rewards: [{ id: "57EE27EA8875AE38", type: "xp", xp: 40 }]
			tasks: [{ count: 16L, id: "2CA3C60C99A47B84", item: "gtceu:steel_ingot", type: "item" }]
			title: "Steel"
			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["33AF6A368B3587E0"]
			description: [
				"Molds turn the alloy smelter into a caster. The block mold makes glass, the plate mold rubber sheets and the ball mold glass tubes."
				"They all start as the same empty steel mold, and where the hammer sits next to it in the grid picks the shape."
			]
			icon: "gtceu:plate_casting_mold"
			id: "6D95C40FFB75ABEB"
			rewards: [{ id: "71A316942CE7B93D", type: "xp", xp: 30 }]
			tasks: [
				{ id: "55F67293B20529C3", item: "gtceu:empty_mold", type: "item" }
				{ id: "05FBB202FAB1D73D", item: "gtceu:block_casting_mold", type: "item" }
				{ id: "4F220D6CFE4C1956", item: "gtceu:plate_casting_mold", type: "item" }
				{ id: "0E1D8ED73159C325", item: "gtceu:ball_casting_mold", type: "item" }
			]
			title: "Casting Molds"
			x: 16.0d
			y: 0.0d
		}
		{
			dependencies: ["6D95C40FFB75ABEB"]
			description: [
				"Sand won't smelt into glass here. It takes the long way round, through quartz sand and glass dust, and the alloy smelter casts it with the block mold."
				"Worth it, because the extractor, the vein probe and the greenhouse all want glass."
			]
			icon: "minecraft:glass"
			id: "64A0425E87F233F6"
			rewards: [{ count: 4, id: "47736A6945ECE04C", item: "minecraft:glass", type: "item" }]
			tasks: [
				{ id: "018B744EC3166BF6", item: "gtceu:quartz_sand_dust", type: "item" }
				{ id: "573CDB7EADF7589F", item: "gtceu:glass_dust", type: "item" }
				{ id: "21A61C6D87C21AE2", item: "minecraft:glass", type: "item" }
			]
			title: "Glass"
			x: 18.0d
			y: 0.0d
		}
		{
			dependencies: ["64A0425E87F233F6"]
			description: [
				"Squeezes sticky resin into raw rubber pulp. Rubber logs and saplings work too, only slower. Rubber also wants sulfur, and that's a trip."
			]
			icon: "gtceu:lp_steam_extractor"
			id: "64373EE5BFA62739"
			rewards: [{ id: "29189781B581B2F3", type: "xp", xp: 25 }]
			tasks: [{ id: "234AE2D4FC820309", item: "gtceu:lp_steam_extractor", type: "item" }]
			title: "Steam Extractor"
			x: 20.0d
			y: 0.0d
		}
		{
			dependencies: ["64373EE5BFA62739"]
			description: [
				"This early, the only sulfur is sulfur ore in the Nether. Your steel makes a flint and steel: light a portal, grab some ore and smelt it into dust."
				"Bring back extra. At home, sulfur comes out of the realgar in the copper-tin vein, once you have a centrifuge to split it."
			]
			icon: "gtceu:sulfur_dust"
			id: "221A824594716C2E"
			rewards: [{ id: "4DA6B3951C5CCE1C", type: "xp", xp: 30 }]
			tasks: [{ id: "20696957C9820316", item: "gtceu:sulfur_dust", type: "item" }]
			title: "Sulfur from the Nether"
			x: 22.0d
			y: 0.0d
		}
		{
			dependencies: ["221A824594716C2E"]
			description: [
				"The alloy smelter turns raw rubber pulp and sulfur into rubber ingots, and the plate mold presses those into sheets."
				"Wrap a wire in a sheet and you have a cable. Tin cable carries LV power, and the hull and the turbine both want some."
			]
			icon: "gtceu:rubber_plate"
			id: "61E429627580A285"
			rewards: [{ id: "411B97BDD0C19199", type: "xp", xp: 30 }]
			tasks: [
				{ id: "4DD8562ADA32AC7D", item: "gtceu:raw_rubber_dust", type: "item" }
				{ id: "1FF0BFF4B9C41FFA", item: "gtceu:rubber_ingot", type: "item" }
				{ id: "737DC382A1303573", item: "gtceu:rubber_plate", type: "item" }
			]
			title: "Rubber Sheets"
			x: 24.0d
			y: 0.0d
		}
		{
			dependencies: ["61E429627580A285"]
			description: [
				"A magnetic iron rod wrapped in copper wire does most of the work in a motor. Most LV machines have one inside, and so does the turbine."
			]
			icon: "gtceu:lv_electric_motor"
			id: "2AEFA5A96D5BA55D"
			rewards: [{ id: "27376BB009545BF4", type: "xp", xp: 30 }]
