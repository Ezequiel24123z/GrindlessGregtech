			x: 10.0d
			y: -3.0d
		}
		{
			dependencies: ["3207813527EE1FBD"]
			description: [
				"No electric pump yet, so the &6Primitive Pump&r pulls water straight out of the world and into your boiler."
				"Set it next to a lake or river and forget about buckets."
			]
			icon: "gtceu:primitive_pump"
			id: "0E2E13522BA2A323"
			rewards: [{ id: "413042DF78D6A4F5", type: "xp", xp: 20 }]
