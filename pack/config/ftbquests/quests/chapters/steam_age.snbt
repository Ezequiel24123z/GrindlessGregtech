			]
			title: "Steam Alloy Smelter"
			x: 8.0d
			y: 1.5d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"With water on one side and lava on the other it makes cobblestone and stone without digging. EMI lists what else it can break out."
			]
