			title: "Steam Compressor"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"Copper and tin in, bronze out, at a better ratio than mixing dust. It also makes red alloy, and with the right mold it casts glass, glass tubes and rubber sheets."
				"The steam furnace is the plain smelter of the set."
			]
			icon: "gtceu:lp_steam_alloy_smelter"
			id: "0B3A5E0D83643882"
			rewards: [{ id: "6C4BDF67A0491A0F", type: "xp", xp: 35 }]
