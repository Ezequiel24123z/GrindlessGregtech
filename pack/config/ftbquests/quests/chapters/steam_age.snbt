	quest_links: [ ]
	quests: [
		{
			dependencies: ["3207813527EE1FBD"]
			description: [
				"Still on Earth, still no electricity. Fire boils water and steam drives bronze machines. By the end of this tab the drills and greenhouses work on their own and the first generator turns."
				"Hand mining is fine until then; nothing after this tab needs it."
			]
			icon: "gtceu:lp_steam_solid_boiler"
			id: "3041A191AB566E3E"
			rewards: [{ id: "52D5B636AC2AFE95", type: "xp", xp: 20 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "410D4E9D93B2590D", type: "checkmark" }]
			title: "Steam Age"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["3041A191AB566E3E"]
			description: [
				"Clay balls smelt into bricks; craft them into brick blocks. The boiler and the bronze casings of the steam machines are built on them."
			]
			icon: "minecraft:bricks"
			id: "2504804D432C502B"
			rewards: [{ id: "2A35AC3AAAB1DF17", type: "xp", xp: 20 }]
			tasks: [{ count: 16L, id: "71F99DC62AF5BF3C", item: "minecraft:brick", type: "item" }]
			title: "Clay and Bricks"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["3041A191AB566E3E"]
			description: [
				"Saw a plank into a wooden form and cut a brick shape into it with the knife; the form stays in the grid. With it, clay and sand become coke clay. Smelt that into coke oven bricks and pack them into blocks."
			]
			icon: "gtceu:coke_oven_bricks"
			id: "2FF295FBA78AF335"
			rewards: [{ id: "6A7800690D415A43", type: "xp", xp: 25 }]
			tasks: [
				{ id: "1375061D838CBA5C", item: "gtceu:empty_wooden_form", type: "item" }
				{ id: "798F691F46884A2A", item: "gtceu:brick_wooden_form", type: "item" }
				{ id: "4089C686D0D31180", item: "gtceu:compressed_coke_clay", type: "item" }
				{ id: "40B754DC855D6933", item: "gtceu:coke_oven_brick", type: "item" }
				{ count: 25L, id: "46BC785D13A069E4", item: "gtceu:coke_oven_bricks", type: "item" }
			]
			title: "Coke Oven Bricks"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["2FF295FBA78AF335"]
			description: [
				"Your first multiblock: a hollow cube of bricks with the controller in one face. The controller's EMI page shows the shape."
				"Coal becomes coke and logs become charcoal; a furnace can't make charcoal here. &6Creosote&r collects inside: boilers burn it and it soaks planks into treated wood."
			]
			icon: "gtceu:coke_oven"
			id: "20A9578F6F706702"
			rewards: [
				{ id: "2F8316F0B18FE31A", type: "xp", xp: 30 }
				{ count: 8, id: "4CEF32FF034FD548", item: "minecraft:coal", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "74AB3375CC84D045", item: "gtceu:coke_oven", type: "item" }
				{ count: 8L, id: "160AC0E4D073488B", item: "gtceu:coke_gem", type: "item" }
			]
			title: "Coke Oven"
			x: 4.0d
			y: -1.5d
		}
		{
			dependencies: ["20A9578F6F706702"]
			description: [
				"Water without buckets. The pump makes it inside, a little faster in wet biomes, so no lake is needed."
				"It is a small multiblock of treated wood with a pump hatch and pump decks; the controller's EMI page has the shape."
			]
			icon: "gtceu:primitive_pump"
			id: "0E2E13522BA2A323"
			rewards: [{ id: "413042DF78D6A4F5", type: "xp", xp: 20 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "4AAD651868C2E72F", item: "gtceu:primitive_pump", type: "item" }]
			title: "Primitive Pump"
			x: 6.0d
			y: -3.0d
		}
		{
			dependencies: ["2504804D432C502B"]
			description: [
				"Bronze plates, bricks and a furnace. Fill it with water before the first fuel goes in: water poured into a dry, hot boiler blows it up."
				"Steam comes out of every side except the bottom, so pipe the water in from below."
			]
			icon: "gtceu:lp_steam_solid_boiler"
			id: "6D923ADC90127182"
			rewards: [
				{ id: "0348F0407B42C093", type: "xp", xp: 30 }
				{ count: 8, id: "31391282AEDC2039", item: "minecraft:charcoal", type: "item" }
			]
			tasks: [{ id: "4753776446D60E4F", item: "gtceu:lp_steam_solid_boiler", type: "item" }]
			title: "Low-Pressure Boiler"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["6D923ADC90127182"]
			description: [
				"Every steam machine starts from a &6Bronze Machine Casing&r or a &6Bricked Bronze Casing&r, and drinks steam from a boiler or pipe next to it."
				"After each cycle it vents steam out of the back: keep that side clear or it stops. Low-pressure machines run at half speed; the steel ones don't."
			]
			icon: "gtceu:bronze_machine_casing"
			id: "4F0049B2E382BA8E"
			rewards: [{ id: "3584CC34BCFF6E54", type: "xp", xp: 25 }]
			tasks: [
				{ id: "25ADC88A15337AD3", item: "gtceu:bronze_machine_casing", type: "item" }
				{ id: "5EFEA10D880CB812", item: "gtceu:bronze_brick_casing", type: "item" }
			]
			title: "Steam Machines"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"GregTech's miner digs out the ore under it, block by block, until the area is empty. Keep it: the vein drill later in this tab is built around one."
			]
			icon: "gtceu:lp_steam_miner"
			id: "3E65A226A598A301"
			rewards: [{ id: "000E98439123F51B", type: "xp", xp: 30 }]
			tasks: [{ id: "07D15B562DFB45B0", item: "gtceu:lp_steam_miner", type: "item" }]
			title: "Steam Miner"
			x: 8.0d
			y: -3.0d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"Grinds what the mortar did, much faster, but only the first output comes out. Ore byproducts wait for an HV macerator, so keep smelting raw ore for now."
				"Its recipe needs diamonds from the deep veins."
			]
			icon: "gtceu:lp_steam_macerator"
			id: "0238F574F77C30E5"
			rewards: [{ id: "5B2F25CCB1188B32", type: "xp", xp: 30 }]
