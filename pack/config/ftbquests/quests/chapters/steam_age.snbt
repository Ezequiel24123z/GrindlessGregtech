			]
			title: "Bronze"
			x: 7.5d
			y: 0.0d
		}
		{
			dependencies: ["3207813527EE1FBD"]
			description: [
				"Coal or charcoal in, steam out. The &6Low-Pressure Solid Boiler&r is the heart of every machine you're about to build."
				"Keep it fed and the whole line runs on its own."
			]
			icon: "gtceu:lp_steam_solid_boiler"
			id: "ED923ADC90127182"
			rewards: [{ id: "0348F0407B42C093", type: "xp", xp: 30 }]
