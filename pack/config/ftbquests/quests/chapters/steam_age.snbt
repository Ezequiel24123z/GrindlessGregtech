		}
		{
			dependencies: ["64A0425E87F233F6"]
			description: [
				"Sticky resin goes in and raw rubber pulp comes out; rubber logs and saplings work too, more slowly. Rubber also needs sulfur, which is the next step."
			]
			icon: "gtceu:lp_steam_extractor"
			id: "64373EE5BFA62739"
