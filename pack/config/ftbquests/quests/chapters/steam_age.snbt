			title: "Steam Macerator"
			x: 8.0d
			y: -1.5d
		}
		{
			dependencies: ["4F0049B2E382BA8E"]
			description: [
				"GregTech turns off packing nuggets into ingots or dust into plates by hand; the compressor does it. Wood dust becomes wood plates and fireclay becomes bricks ready to fire."
			]
			icon: "gtceu:lp_steam_compressor"
			id: "6BB23A9836716A37"
			rewards: [{ id: "1D0789B0F2987E54", type: "xp", xp: 25 }]
