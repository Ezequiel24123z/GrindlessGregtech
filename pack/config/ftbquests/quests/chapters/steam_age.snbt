			y: 3.0d
		}
		{
			dependencies: ["ED923ADC90127182", "0E2E13522BA2A323"]
			description: [
				"The &6Macerator&r turns raw ore into crushed ore - better yield than a straight smelt, sometimes with a bonus material too."
				"Crush it again for dust. Proper washing for the clean stuff is an upgrade for later."
			]
			icon: "gtceu:lp_steam_macerator"
