	quests: [
		{
			description: [
				"No electricity yet. GregTech's own tools and a little pickaxe work get the first batch of ore, logs and sand moving."
				"This is the only time you will ever need to dig for something just because the game asked. Past this point, every resource gets a machine."
			]
			icon: "minecraft:raw_iron"
			id: "B041A191AB566E3E"
			rewards: [{ id: "52D5B636AC2AFE95", type: "xp", xp: 20 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "410D4E9D93B2590D", type: "checkmark" }]
			title: "First Steps"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["B041A191AB566E3E"]
			description: ["Ordinary bricks hold the first ovens and boilers together. Any furnace turns clay into brick, steam-powered or not."]
			icon: "minecraft:brick"
			id: "A504804D432C502B"
			rewards: [{ id: "2A35AC3AAAB1DF17", type: "xp", xp: 20 }]
			tasks: [{ count: 16L, id: "71F99DC62AF5BF3C", item: "minecraft:brick", type: "item" }]
			title: "Clay and Bricks"
			x: 2.5d
			y: 0.0d
		}
		{
			dependencies: ["A504804D432C502B"]
			description: [
				"The &6Coke Oven&r bakes coal into coke and logs into charcoal, no power needed. &6Creosote&r drips out as a bonus - keep it, it burns well in the liquid boiler."
				"Build it once and it keeps feeding the rest of the line: coke goes straight into the blast furnace later on."
			]
			icon: "gtceu:coke_oven"
			id: "20A9578F6F706702"
			rewards: [{ id: "AF8316F0B18FE31A", type: "xp", xp: 30 }]
			shape: "gear"
			tasks: [
				{ id: "F4AB3375CC84D045", item: "gtceu:coke_oven", type: "item" }
				{ count: 8L, id: "160AC0E4D073488B", item: "gtceu:coke_gem", type: "item" }
			]
			title: "Coke Oven"
			x: 5.0d
			y: 0.0d
		}
		{
			dependencies: ["20A9578F6F706702"]
			description: [
				"Bronze is just copper and tin, nothing exotic. A mortar and a casting mold get you plates and gears before you ever touch a real press."
				"Every steam machine in this era is built out of it."
			]
			icon: "gtceu:bronze_ingot"
			id: "3207813527EE1FBD"
			rewards: [{ id: "128F3700BF8645B9", type: "xp", xp: 30 }]
