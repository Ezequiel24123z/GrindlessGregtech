			y: 2.5d
		}
		{
			dependencies: ["7B955176F4E8579C"]
			description: ["A wafer exposed at 6.7 nanometres holds finer lines than any light before it: the &6BEUV Exposed Wafer&r. The BEUV scanner, a resist-coated wafer and clean mirrors. The terbium debris is caught and recycled. The driver ASIC next to it, and through it the P:Si processor. Wafers by ME; send the fouled mirrors to the cleaning line, not to the bin."]
			icon: "grindless:beuv_exposed_wafer"
			id: "127106AB450BDD99"
			rewards: [{ id: "1EF0814AE2DDE468", type: "xp", xp: 120 }]
