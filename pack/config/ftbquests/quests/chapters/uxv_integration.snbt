		}
		{
			dependencies: ["5D9EECDCAB8F0156"]
			description: ["The &6Ergosphere Probe Bay&r slings a relay seed, the &6Neutronium Cage&r makes a cage for each pasta phase, and the &6Warp Gate&r takes two new destinations and a heavier hold. The &6Antimatter Trap&r, &6Tether Ribbon Works&r, &6Europium Reductor&r, &6R-Process Decompressor&r and &6Levitation Melter&r take their own rows. Every controller from earlier eras, and the seed and shield from the sling. The two jumps, caged phases, positron stacks, Whipple shields and the spintronic melts. Seeds, shields and cages ride the relay between sites."]
			icon: "gtceu:ergosphere_probe_bay"
			id: "1E1EC4C589AD0CA0"
			rewards: [{ id: "528A86ECD6144A22", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "1D18863968FFE8E6", item: "gtceu:ergosphere_probe_bay", type: "item" }
				{ id: "1DD0DC815642E389", item: "gtceu:neutronium_cage", type: "item" }
