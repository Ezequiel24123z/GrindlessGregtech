				{ id: "70126973B9CCFCA0", item: "gtceu:fluorspar_kiln", type: "item" }
			]
			title: "Separations and Strip"
			x: 2.0d
			y: 13.0d
		}
		{
			dependencies: ["71359F03B137FB0B"]
			description: ["The &6Fuel Fabrication Plant&r, &6Hot Cell&r, &6Actinide Partitioning Plant&r, &6Waste Retrieval Plant&r and &6Transuranium Facility&r take an ion-source charge, a sealed core, new fragments, recovered curium and plated targets. The reactors you already own and the debris of the heavy-ion lanes. The feed of the collider and the targets of element 121 and 122. Targets and cuts move by bus; the spent core gives back its calcium."]
			icon: "gtceu:hot_cell"
			id: "569494D2E35E9052"
			rewards: [{ id: "3BF51FE89AC2A363", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "19E255393E446892", item: "gtceu:fuel_fabrication_plant", type: "item" }
				{ id: "328E67D24144E21B", item: "gtceu:hot_cell", type: "item" }
