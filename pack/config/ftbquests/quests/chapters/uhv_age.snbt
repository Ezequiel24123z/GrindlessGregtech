		{
			dependencies: ["74E5CDD1317012FB", "7DB98960A4C2D2E8"]
			description: ["Optical processors and quantum memory chips make the &6Optical Assembly&r, the largest circuit this era builds. In the photonic foundry: three optical processors, three quantum memory chips and ultrapure water. The wetware mainframe, whose recipe in the organoid array asks for two. Two assemblies per mainframe batch: keep a small stock by ME and never more."]
			icon: "gtnn:optical_assembly"
			id: "18F76220739031F7"
			rewards: [{ id: "7E16A892A92D78E3", type: "xp", xp: 200 }]
