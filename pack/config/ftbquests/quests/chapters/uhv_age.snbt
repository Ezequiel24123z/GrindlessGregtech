			title: "Under Six Suns"
			x: 10.0d
			y: -2.0d
		}
		{
			dependencies: ["79AAE037161EDE29"]
			description: ["A swarm needs aluminium, magnesium and silicon. Mercury's surface has all three and almost no gravity to climb out of. The segments are built in orbit, where the light is strongest."]
			icon: "grindless:swarm_segment"
