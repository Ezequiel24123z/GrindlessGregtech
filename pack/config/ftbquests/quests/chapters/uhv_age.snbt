	quests: [
		{
			dependencies: ["183EEB9BF7A06AC5"]
			description: [
				"The &6Proxima Approach Data&r says the nearest star has a rocky planet in its habitable zone. The &6Heavy Curium Oxide&r in store is what the next isotopes start from."
				"Home first: heavier isotopes, light and silicon carbide. Then Mercury, and a gate."
			]
			icon: "grindless:proxima_approach_data"
			id: "7547756221DFC688"
			rewards: [{ id: "346612C938791C98", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [
				{ id: "76869EAD54A7755D", item: "grindless:proxima_approach_data", type: "item" }
				{ id: "15D4A858D3559C38", item: "grindless:heavy_curium_oxide", type: "item" }
			]
			title: "Proxima and Beyond"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7547756221DFC688"]
			description: ["The &6High Flux Reactor&r is a small, dense core with a very high neutron flux, cooled by a heavy water loop. Targets go in, and a driver element keeps the flux up."]
			icon: "gtceu:high_flux_reactor"
			id: "17FFD22B68F2339B"
			rewards: [{ id: "559EF99482D99DA4", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "321282FBBF012C2F", item: "gtceu:high_flux_reactor", type: "item" }
				{ id: "5AA4CF919E9B0F00", item: "grindless:hfir_driver_element", type: "item" }
			]
			title: "High Flux"
			x: 2.0d
			y: -4.0d
		}
		{
			dependencies: ["17FFD22B68F2339B"]
			description: ["Curium targets soaked in neutrons become heavier elements. The &6Transuranium Facility&r separates the liquor and hands you &6Berkelium-249&r, with the fission products set apart and the solvent cleaned for the next run."]
			icon: "gtceu:transuranium_facility"
			id: "36C7A1B9DB6512D7"
			rewards: [{ id: "12243468CFF9573A", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
