			size: 1.0d
			tasks: [{ id: "50CDA312A390ADCD", item: "gtnn:optical_assembly", type: "item" }]
			title: "Optical Assembly"
			x: 18.0d
			y: 5.5d
		}
		{
			dependencies: ["357A03FF61BCC69C"]
			description: ["An &6Indium Phosphide Wafer&r is the substrate a mid-infrared laser is grown on. Its lattice matches the layers the molecular beam reactor lays down. An InP boule from the crystal growth furnace, indium and red phosphorus, and the cleanroom. The quantum cascade laser next to it. The boule is slow. Keep indium and phosphorus topped up by ME and stock the wafers."]
			icon: "grindless:inp_wafer"
			id: "5432C6DC48ECC9A5"
			rewards: [{ id: "5B4F99C30AA8F734", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "1EAA87C2C0AB6F30", item: "grindless:inp_wafer", type: "item" }]
			title: "Indium Phosphide Wafer"
			x: 8.0d
			y: 7.0d
		}
		{
			dependencies: ["5432C6DC48ECC9A5"]
			description: ["An electron falls down a staircase of thin layers and gives up a photon at every step. The &6Quantum Cascade Laser&r is hundreds of those layers on InP. The MBE reactor: a quantum cascade superlattice wafer and gold dust make eight lasers. Arsenic is contained. The optical processor, and the sensors of the astrometer and the swarm. Contain the arsenic loop; stock lasers by ME."]
			icon: "grindless:quantum_cascade_laser"
			id: "34795C9D86BC364D"
			rewards: [{ id: "1C75B01990D303EC", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "59C897DA3DE0C603", item: "grindless:quantum_cascade_laser", type: "item" }]
			title: "Quantum Cascade Laser"
			x: 12.0d
			y: 7.0d
		}
		{
			dependencies: ["357A03FF61BCC69C"]
			description: ["Europium in an yttrium orthosilicate crystal stores the state of a photon for hours. The &6Eu:YSO Boule&r is where memory chips start. The crystal growth furnace and its iridium crucible. The quantum memory chip beside it. Boules are slow to pull; keep the melt stocked by ME and stock slabs."]
			icon: "grindless:eu_yso_boule"
			id: "7CE22CED63CCF1E9"
			rewards: [{ id: "54FC95EE4F8B1A6F", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "1D84C000676A5624", item: "grindless:eu_yso_boule", type: "item" }]
			title: "Europium-Doped Crystal"
			x: 8.0d
			y: 8.5d
		}
		{
			dependencies: ["7CE22CED63CCF1E9"]
			description: ["A slab cut from the boule and patterned in the photonic foundry becomes a &6Quantum Memory Chip&r that holds light as an excitation. An Eu:YSO boule and the photonic foundry: one boule and ultrapure water make four chips. The optical assembly, which takes three. One boule cuts several slabs; send chips on by ME."]
			icon: "grindless:quantum_memory_chip"
			id: "7DB98960A4C2D2E8"
			rewards: [{ id: "18D536D634351D78", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7770F2958FB93EDD", item: "grindless:quantum_memory_chip", type: "item" }]
			title: "Quantum Memory Chip"
			x: 12.0d
			y: 8.5d
		}
		{
			dependencies: ["357A03FF61BCC69C"]
			description: ["Neurons grown on a chitosan scaffold in ultrapure water make an &6Organoid Processor&r, tissue that learns on a board. The organoid array, stem cells from UV's vat, a scaffold, ultrapure water and sterile growth medium. It runs only in the Overworld. The wetware mainframe, four organoids at a time. Medium and water by pipe; a tissue line fed by ME runs without a hand."]
			icon: "grindless:organoid_processor"
			id: "104D06696418C335"
			rewards: [{ id: "1425D7B94CCEED26", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "560B8C7143E5E82F", item: "grindless:organoid_processor", type: "item" }]
			title: "Organoid Processor"
			x: 8.0d
			y: 10.0d
		}
		{
			dependencies: ["104D06696418C335", "18F76220739031F7"]
			description: ["The &6Wetware Processor Mainframe&r is the UHV circuit. The organoid array makes four at once from organoid processors, neuro processing units and optical assemblies. Per batch of four: six organoid processors, six neuro processing units, two SiC power modules and two optical assemblies. Like the organoid, it runs only in the Overworld. Every UHV controller, the UHV components and the UHV circuit assembler. Run the array in batches of four by ME and keep a dedicated mainframe chest."]
			icon: "gtceu:wetware_processor_mainframe"
			id: "5EF940CA680ECC5C"
			rewards: [{ id: "7E1ABB63C063E9A2", type: "xp", xp: 220 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 4L, id: "582C9A6B4F20EBEA", item: "gtceu:wetware_processor_mainframe", type: "item" }]
			title: "Four Mainframes"
			x: 18.0d
			y: 8.5d
		}
		{
			dependencies: ["554C7C99AD5FBAC0"]
			description: ["The cell, the network and the fabricator at the UHV tier."]
			icon: "grindless:sic_power_module"
			id: "105E4880E4ADC4FD"
