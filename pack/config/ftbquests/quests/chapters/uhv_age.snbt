			y: 14.5d
		}
		{
			dependencies: ["36C7A1B9DB6512D7"]
			description: ["One more neutron capture and berkelium becomes &6Californium-252&r, a source that emits neutrons by itself. It is the catalyst of cold-trap drilling and of YBCO irradiation, and it is not used up."]
			icon: "grindless:californium_252_source"
