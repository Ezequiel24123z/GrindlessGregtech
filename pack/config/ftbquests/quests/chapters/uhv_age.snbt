			title: "Thorium-229"
			x: 8.0d
			y: -4.0d
		}
		{
			dependencies: ["1CD9068EF0888D7B"]
			description: ["Thorium-229 changes state with a vacuum-ultraviolet photon, and a crystal that holds it keeps time better than any electron can. The &6Nuclear Clock Lab&r builds the &6Nuclear Clock&r that the wireless network syncs to."]
			icon: "gtceu:nuclear_clock_lab"
