			title: "The Gate Opens"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["53A07A3FD419957D"]
			description: ["The Casimir force is real and tiny. Nobody has made negative energy from it. Here it holds a gate open, and that is a story the pack tells, not physics."]
			icon: "gtceu:casimir_array"
