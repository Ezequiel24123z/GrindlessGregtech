				{ id: "5F19B47C7782A13A", item: "grindless:field_ring_casing", type: "item" }
			]
			title: "The Warp Gate"
			x: 25.5d
			y: 38.0d
		}
		{
			dependencies: ["3400C076975BABD5"]
			description: [
				"The ring is a magnet, and its wire is &6magnesium diboride&r: Mercury's magnesium mixed with boron, packed in an iron tube and drawn by the powder-in-tube line."
				"Braid it into cable in the Naquadria Magnet Works. Automate it with powder by ME and keep the draw line on its own bus."
			]
			icon: "gtceu:magnesium_diboride_single_wire"
			id: "578E129AD9735B5E"
			rewards: [{ id: "3AB935462299C81E", type: "xp", xp: 100 }]
