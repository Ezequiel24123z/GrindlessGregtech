			x: 15.0d
			y: 60.0d
		}
		{
			dependencies: ["196AF7B23C8B0529"]
			description: ["The &6Superlattice Wafer&r: Hundreds of InGaAs/AlInAs layers, each a few atoms thick, on an indium phosphide wafer. Made in the &6Molecular Beam Epitaxy&r from the InP Wafer and Indium, with liquid nitrogen, in the cleanroom. Grown in the MBE reactor (circuit 1); cleaved into eight quantum cascade lasers (circuit 2). The Quantum Cascade Laser in the Molecular Beam Epitaxy. Stock it by ME and let the next step pull it; nothing here needs a hand."]
			icon: "grindless:qcl_superlattice_wafer"
			id: "1BD96E121F1108E0"
			rewards: [{ id: "5DC51A456EC16650", type: "xp", xp: 50 }]
