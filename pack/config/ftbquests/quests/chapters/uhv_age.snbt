				{ id: "75C2CB17134C60BC", item: "gtceu:platinum_plant", type: "item" }
				{ id: "14B88CD68D841270", item: "gtceu:ruthenium_trinium_americium_neutronate_single_wire", type: "item" }
			]
			title: "RTAN"
			x: 12.0d
			y: 39.0d
		}
		{
			dependencies: ["1338B882BFAB5DF8"]
			description: ["The &6Swarm Control Station&r steers a cloud of segments round the Sun and sends the power down as a beam. Two stations feed one bank, and the bank loses a little on the way. Swarm segments from the foundry and oganesson propellant pods, with the station in Mercury orbit itself. UHV power, and the swarm half of the gate to UEV. Each run burns pods and a segment. Segments and pods ride the Mercury AE2 pair; worn segments and empty propellant tanks come back out of each run."]
			icon: "gtceu:swarm_control_station"
			id: "7AAE7008AA466590"
			rewards: [{ id: "163E8662FE869F6E", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "105E5722D91D5E94", item: "gtceu:swarm_control_station", type: "item" }]
			title: "The Swarm"
			x: 14.0d
			y: -9.5d
		}
		{
			dependencies: ["7AAE7008AA466590"]
			description: ["A probe that dips into the corona comes back with the &6Coronal Field Map&r. The swarm points itself with it. The solar probe bay in Mercury orbit, and a probe for every run. Aimed beams, and the map the Gate to UEV asks for. The bay builds probes from ME; the map goes back to the network."]
			icon: "grindless:coronal_field_map"
			id: "10329AFF72FD580B"
			rewards: [{ id: "1B6AB5FBDA3A9AAB", type: "xp", xp: 150 }]
