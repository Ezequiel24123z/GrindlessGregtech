			x: 15.5d
			y: 38.0d
		}
		{
			dependencies: ["3BF2564F433347F8"]
			description: [
				"Heated at about 973 K in the electric blast furnace under argon, the powder reacts and the coil turns &6superconducting&r. It is brittle now."
				"Automate it with windings by ME and argon by pipe."
			]
			icon: "grindless:reacted_gate_coil"
