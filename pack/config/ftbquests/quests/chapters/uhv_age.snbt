		}
		{
			dependencies: ["3B434AB6BB53478D"]
			description: ["The &6Spark Plasma Sinterer&r fuses ultra-high-temperature ceramics in seconds under pulsed current. Its controller, robust and heatproof machine casing and tungstensteel pipe casing. One Terminal pass builds it. UHTC tiles and nozzles for the rocket motor. Powders by ME; the dies cool before the tiles leave."]
			icon: "gtceu:spark_plasma_sinterer"
			id: "31E7259B9EAE8F28"
			rewards: [{ id: "3BBD2B50F7285913", type: "xp", xp: 120 }]
