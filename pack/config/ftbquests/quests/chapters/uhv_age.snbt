			x: 8.0d
			y: 2.0d
		}
		{
			dependencies: ["1F6A7661A3F34B33"]
			description: ["The &6Warp Gate&r is a ring built at both ends: one in Earth orbit, one at Proxima b. A first run opens it, a second holds it open. Exotic matter and antihydrogen cartridges for the opening, and the warp gate casing. The second station and the base at Proxima b. Antihydrogen and exotic matter by pipe and bus from their own lines; the shells come back after each run."]
			icon: "gtceu:warp_gate"
			id: "53A07A3FD419957D"
			rewards: [{ id: "13D9DC95FA10AF87", type: "xp", xp: 250 }]
			shape: "gear"
