			x: 6.0d
			y: 2.0d
		}
		{
			dependencies: ["1F6A7661A3F34B33"]
			description: ["An antimatter-catalysed fission motor behind a heat-proof nozzle. The &6ICAN Rocket Motor&r is the engine that makes a four-year trip possible at all."]
			icon: "grindless:ican_rocket_motor"
			id: "5E37EDBD4D78FD91"
			rewards: [{ id: "3B1BE6F3961BB36E", type: "xp", xp: 150 }]
