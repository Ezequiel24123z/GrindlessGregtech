				{ id: "76869EAD54A7755D", item: "grindless:proxima_approach_data", type: "item" }
				{ id: "15D4A858D3559C38", item: "grindless:heavy_curium_oxide", type: "item" }
			]
			title: "Proxima and Beyond"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7547756221DFC688"]
			description: ["Most of UHV is built at home: isotopes, light, silicon carbide, life. The gate and the stations need all of it, so the machine tabs come before the rockets."]
			icon: "gtceu:uhv_machine_hull"
			id: "7B1B3520DA69C5CF"
			rewards: [{ id: "53D90EEEA849ABAD", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "1F3499C554481644", type: "checkmark" }]
			title: "Home First"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["7B1B3520DA69C5CF"]
			description: ["Berkelium, californium, nickel-63 and thorium-229 all come from one very hot reactor and its chemistry. They feed the clock, the batteries and the gate."]
			icon: "gtceu:high_flux_reactor"
			id: "383F71E7F4EB2E04"
			rewards: [{ id: "3E44794CC518E9C1", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "7A5CE6BD3D42771F", type: "checkmark" }]
			title: "Heavier Isotopes"
			x: 4.0d
			y: -2.0d
		}
		{
			dependencies: ["7B1B3520DA69C5CF"]
			description: ["Crystals, lasers and optical chips replace a lot of electronics from here on. The glass that carries them is pulled in orbit."]
			icon: "gtceu:photonic_foundry"
			id: "11110AB468E36B0D"
			rewards: [{ id: "707289F81CD31075", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "33359CAB99CB0CB9", type: "checkmark" }]
			title: "Light Does the Work"
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["7B1B3520DA69C5CF"]
			description: ["The &6Space Elevator&r is a base, a cable and a lift: payload reaches the stations without a rocket. A tether climber on a ribbon long enough to reach orbit, and the elevator's own casings. Station level 8 and the kits for Mercury and Proxima b. Load the lift from ME and let it send payload on a schedule."]
			icon: "gtca:space_elevator"
			id: "35742EE8AEFA05B1"
			rewards: [{ id: "39ABAC61C7FA58B4", type: "xp", xp: 200 }]
