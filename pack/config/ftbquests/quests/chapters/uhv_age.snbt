			y: 36.0d
		}
		{
			dependencies: ["7CCCD2EE6106A6AC"]
			description: ["The &6Casimir Array&r holds plates a few nanometres apart and squeezes energy from the vacuum between them. Its controller, station truss casing and cryostat casing. Casimir cavity stacks for the warp gate. Plates by ME; the stacks leave by ME to the gate."]
			icon: "gtceu:casimir_array"
			id: "3400C076975BABD5"
