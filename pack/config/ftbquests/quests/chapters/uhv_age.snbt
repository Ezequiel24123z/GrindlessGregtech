			]
			title: "Three Thousand Degrees"
			x: 9.5d
			y: 34.0d
		}
		{
			dependencies: ["31E7259B9EAE8F28"]
			description: [
				"A &6UHTC Tile&r is an ultra-high-temperature ceramic that survives a heat that melts steel. The &6UHTC Nozzle&r is the same ceramic cast as the throat of a rocket motor."
				"Both come from the spark plasma sinterer, from ceramic powders pressed under pulsed current. The tile lines the reentry capsule and the nozzle goes into the ICAN rocket motor. Automate it with powders by ME and let the dies cool before the parts leave."
			]
			icon: "grindless:uhtc_tile"
			id: "5EF22F1229258335"
			rewards: [{ id: "3A9DCF3E7CD2C36E", type: "xp", xp: 80 }]
			tasks: [
				{ id: "3CC874F217D2D469", item: "grindless:uhtc_tile", type: "item" }
				{ id: "738CA9EFD44A34A8", item: "grindless:uhtc_nozzle", type: "item" }
			]
			title: "A Tile for Reentry"
			x: 11.5d
			y: 34.0d
		}
		{
			dependencies: ["554C7C99AD5FBAC0"]
			description: ["The &6Positron Accumulator&r collects antimatter in a trap and fills a cartridge. Its controller, UV machine casing and a UHV hull. Positron cartridges and, from them, antihydrogen. Cartridges leave by ME; never let a full trap sit unwatched."]
			icon: "gtceu:positron_accumulator"
			id: "1F9136892DB0B05E"
