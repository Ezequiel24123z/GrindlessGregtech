				{ id: "1BBB4266434F82D1", item: "gtceu:transuranium_facility", type: "item" }
				{ id: "560FA4D28A3E5FEE", item: "grindless:berkelium_249", type: "item" }
			]
			title: "Berkelium"
			x: 4.0d
			y: -4.0d
		}
		{
			dependencies: ["36C7A1B9DB6512D7"]
			description: ["One more neutron capture and berkelium becomes &6Californium-252&r, a source that emits neutrons by itself. It starts the reactors that cannot start alone."]
			icon: "grindless:californium_252_source"
			id: "7365DAF24CBF4955"
			rewards: [{ id: "3CCD239C7E71855D", type: "xp", xp: 120 }]
			tasks: [
				{ id: "3CF01264916B6ACA", item: "grindless:californium_252", type: "item" }
				{ id: "51330584E194724D", item: "grindless:californium_252_source", type: "item" }
			]
			title: "A Californium Source"
			x: 6.0d
			y: -4.0d
		}
		{
			dependencies: ["17FFD22B68F2339B"]
			description: ["A spent driver element is not waste: it holds &6uranium-233&r bred in the flux. Reprocess it and a fresh driver goes back in the reactor."]
			icon: "grindless:spent_hfir_driver_element"
			id: "18F323E6ABB96566"
			rewards: [{ id: "5A54780E9A6372E6", type: "xp", xp: 100 }]
			tasks: [{ id: "570DE607AA2ABB44", item: "grindless:spent_hfir_driver_element", type: "item" }]
			title: "Back to the Driver"
			x: 4.0d
			y: -2.0d
		}
		{
			dependencies: ["7365DAF24CBF4955"]
			description: ["A trace of &6thorium-229&r comes out of the uranium-233 line. It is rare, and it has the lowest nuclear excited state known."]
			icon: "grindless:thorium_229"
			id: "1CD9068EF0888D7B"
			rewards: [{ id: "3AE08C2CF2304B86", type: "xp", xp: 120 }]
