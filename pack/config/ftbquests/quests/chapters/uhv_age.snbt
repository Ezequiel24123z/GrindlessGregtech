			x: 14.0d
			y: -7.5d
		}
		{
			dependencies: ["53952D3743F151DD"]
			description: ["Proxima b has no bridge of its own: only the gate makes the &6Proxima Gate Seed&r, and its catalysts are the approach data, the nuclear clock and the organoid processor. Samples then arrive through ME, never by hand."]
			icon: "grindless:proxima_gate_seed"
