			tasks: [{ id: "22508DCBFF3F0DE6", type: "checkmark" }]
			title: "Ore Veins"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["345C4D73090CB5E2"]
			description: [
				"Coal veins sit high in the stone, so you'll find one early. Smelt the raw ore and burn the coal in your furnaces for now. The boilers and the coke oven will be asking for it soon enough."
			]
			icon: "minecraft:coal"
			id: "117BE5D9218C383A"
			rewards: [{ id: "385CC1FDE44EF6FD", type: "xp", xp: 10 }]
