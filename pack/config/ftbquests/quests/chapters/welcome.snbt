		{
			dependencies: ["047B55ED9C952BC9"]
			description: [
				"&6Hammer&r for plates, &6file&r for rods and screws, &6saw&r for bolts and wooden forms, &6mortar&r for dust, &6knife&r for cutting forms."
				"&6Wrench&r for gears and casings, and it sets a machine's output side. &6Wire cutter&r for wire and linking cables, &6screwdriver&r for covers and settings."
				"The &6crowbar&r pries covers off, the &6soft mallet&r pauses a machine and the &6plunger&r empties its tanks. The &6mining hammer&r and &6spade&r dig 3x3."
			]
			icon: "gtceu:neutronium_screwdriver"
			id: "060C9714FE2661C1"
			rewards: [{ id: "4C408857ED386D07", type: "xp", xp: 10 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "2F84D9694342448E", type: "checkmark" }]
			title: "Tool Cheat Sheet"
			x: 12.0d
			y: -1.5d
		}
		{
			dependencies: ["047B55ED9C952BC9"]
			description: [
				"Diamonds and redstone live deep. Diamond shares its vein with graphite and coal, and redstone shares one with ruby and cinnabar. The steam macerator wants diamonds, and redstone ends up as red alloy and magnetic rods before the steam age is out."
			]
			icon: "minecraft:diamond"
