		{
			dependencies: ["3BB2DAC36CB01A7B"]
			description: [
				"Rubber trees grow in forests, jungles and swamps, and breaking a rubber log usually drops &6sticky resin&r. It becomes rubber, circuit boards and torches."
				"Gather some by hand now; the steam greenhouse grows it for you later."
			]
			icon: "gtceu:sticky_resin"
			id: "5DCCA11440887F89"
			rewards: [{ id: "60A4085073C91D4B", type: "xp", xp: 25 }]
