			title: "Coal"
			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["345C4D73090CB5E2"]
			description: [
				"Iron goes by several names here. Goethite, yellow limonite and hematite share the iron vein, and magnetite has a vein of its own with a little gold in it. Whichever you find, it smelts straight into iron ingots."
			]
			icon: "minecraft:iron_ingot"
			id: "436EF55FE0284C3E"
