			title: "Key to the Void"
			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["69BDA9FBB0EB66F2"]
			description: [
				"The &6Flatland Key&r opens a flat stone world with nothing in the way: room for a factory on level ground. It works like the Void Key, and flint, a stick and dirt make a spare."
			]
			icon: "grindless:flat_key"
