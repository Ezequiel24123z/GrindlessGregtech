	quests: [
		{
			description: [
				"You start on Earth with nothing. Far ahead, past the last era, sits &6Sagittarius A*&r, the black hole at the centre of the galaxy. Every tab of this book is one step closer."
				"Nothing here locks a recipe. Lost the book? Paper and any plank make a new one."
			]
			icon: "ftbquests:book"
			id: "69BDA9FBB0EB66F2"
			rewards: [
				{ count: 8, id: "21A6FB493B3D6DA8", item: "minecraft:bread", type: "item" }
