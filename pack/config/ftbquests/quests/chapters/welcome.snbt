	quests: [
		{
			description: [
				"Diamond tools and lunch are waiting in the rewards. The destination is Sagittarius A*, the black hole at the galaxy's centre. Each age gets you closer."
				"Nothing in it locks a recipe. EMI covers the how: R on an item shows how it's made, U what it's used in. Lost the book? Paper and a plank make another."
			]
			icon: "ftbquests:book"
			id: "69BDA9FBB0EB66F2"
			rewards: [
				{ count: 8, id: "21A6FB493B3D6DA8", item: "minecraft:bread", type: "item" }
