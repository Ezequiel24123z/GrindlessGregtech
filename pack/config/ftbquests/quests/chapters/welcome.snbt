			title: "Key to the Flatlands"
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["69BDA9FBB0EB66F2"]
			description: [
				"Your diamond tools handle the first wood, stone and ore. GregTech's crafting tools are a few quests away; the pickaxe won't hammer plates for you."
			]
			icon: "minecraft:oak_log"
			id: "3BB2DAC36CB01A7B"
