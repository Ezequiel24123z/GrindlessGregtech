		{
			dependencies: ["69BDA9FBB0EB66F2"]
			description: [
				"Hover an item in EMI: &6R&r shows how it is made, &6U&r what it is used for. GregTech recipes name the machine that runs them."
				"A multiblock shows its whole structure on its controller's EMI page."
			]
			icon: "minecraft:enchanted_book"
			id: "71CCAD27C64BD720"
