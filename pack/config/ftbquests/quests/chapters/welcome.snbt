		}
		{
			dependencies: ["69BDA9FBB0EB66F2"]
			description: [
				"The &6Horizon Collector&r was in your pack when you arrived. Nobody remembers building it, and nobody can make another."
				"Its shard hums at the pitch of the black hole at the end of the journey. Something ordinary leaks out of a horizon the size of a pin."
				"Put a solar cover on top and pick a circuit; the circuit decides what comes through."
			]
			icon: "gtceu:lv_horizon_collector"
			id: "3E1C0D04479070D2"
			rewards: [
				{ id: "7A4EA4331D45813F", item: "gtceu:lv_horizon_collector", type: "item" }
				{ id: "59CB02D975542719", item: "grindless:horizon_shard", type: "item" }
				{ count: 2, id: "5942E056E1AF13B0", item: "gtceu:lv_solar_panel", type: "item" }
			]
			tasks: [{ id: "5D417825FEC2B0C1", type: "checkmark" }]
			title: "The Horizon Collector"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["69BDA9FBB0EB66F2"]
			description: [
				"The &6Void Key&r takes you to an empty dimension and leaves a small platform under your feet, which beats falling forever. Use it again to land back where you left the Overworld."
				"Lose it and a spare is cheap; EMI has the recipe."
			]
			icon: "grindless:void_key"
			id: "7194C28F070B38A2"
			optional: true
			rewards: [{ id: "36BF9B1736D3E98E", item: "grindless:void_key", type: "item" }]
			size: 0.75d
			tasks: [{ id: "62E189D85E4FDE7D", type: "checkmark" }]
			title: "Key to the Void"
			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["69BDA9FBB0EB66F2"]
			description: [
				"The &6Flatland Key&r opens a world of flat stone that runs to the horizon. A sprawling factory won't find better ground. It works like the Void Key, and a spare is just as easy to make."
			]
			icon: "grindless:flat_key"
			id: "0348DB79BD43D043"
