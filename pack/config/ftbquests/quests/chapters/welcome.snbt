		{
			dependencies: ["047B55ED9C952BC9"]
			description: [
				"&6Hammer&r: plates. &6File&r: rods and screws. &6Saw&r: bolts and wooden forms. &6Mortar&r: dust. &6Knife&r: cuts forms."
				"&6Wrench&r: gears and casings; right-click sets a machine's output side, sneak-click turns it. &6Wire cutter&r: wire, and it links cables. &6Screwdriver&r: covers and machine settings."
				"&6Crowbar&r: takes covers off. &6Soft mallet&r: pauses a machine. &6Plunger&r: empties a machine's tank. &6Mining hammer&r and &6spade&r dig a 3x3 area."
			]
			icon: "gtceu:neutronium_screwdriver"
			id: "060C9714FE2661C1"
			rewards: [{ id: "4C408857ED386D07", type: "xp", xp: 10 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "2F84D9694342448E", type: "checkmark" }]
			title: "Tool Cheat Sheet"
			x: 12.0d
			y: -1.5d
		}
		{
			dependencies: ["047B55ED9C952BC9"]
			description: [
				"Diamonds come from deep veins with graphite and coal, redstone from deep veins with ruby and cinnabar. The steam macerator and miner need a few diamonds; redstone becomes red alloy and magnetic rods before LV."
			]
			icon: "minecraft:diamond"
			id: "4E808BA706D1C241"
			rewards: [{ id: "039DBB2398D51872", type: "xp", xp: 20 }]
			tasks: [
				{ id: "1D2DB24017032927", item: "minecraft:diamond", type: "item" }
				{ id: "75B1126220CA3B27", item: "minecraft:redstone", type: "item" }
			]
			title: "Deep Veins"
			x: 12.0d
			y: 1.5d
		}
		{
			dependencies: ["047B55ED9C952BC9"]
			description: [
				"Both sit in the copper-tin vein, from deep caves up to the hills: chalcopyrite for copper, cassiterite for tin. A cassiterite vein is almost all tin. The raw ores smelt straight into ingots."
				"Tooltips carry the formula: Cu is copper, Sn is tin."
			]
			icon: "minecraft:copper_ingot"
			id: "66595C41CAF3204F"
			rewards: [{ id: "7812CDBC628F8768", type: "xp", xp: 20 }]
			tasks: [
				{ id: "4D8A44F363C30D38", item: "minecraft:copper_ingot", type: "item" }
				{ id: "4EBAE9B6B66896B1", item: "gtceu:tin_ingot", type: "item" }
			]
			title: "Copper and Tin"
			x: 12.0d
			y: 0.0d
		}
		{
			dependencies: ["66595C41CAF3204F"]
			description: ["Put an ingot above the mortar and it comes out as dust. Slow by hand; the steam macerator takes over soon."]
			icon: "gtceu:copper_dust"
			id: "3760F1805DB4C916"
			rewards: [{ id: "3806CC9F9C1E06AC", type: "xp", xp: 15 }]
