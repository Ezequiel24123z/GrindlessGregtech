			y: -1.5d
		}
		{
			dependencies: ["3BB2DAC36CB01A7B"]
			description: [
				"Vanilla ores don't spawn here. All ore sits in big GregTech veins a few chunks apart, each with its own mix of metals."
				"Small rocks on the ground name the vein underneath; right-click one to put it on your map. A raw ore's EMI page shows its vein: depth, neighbours and how common it is."
			]
			icon: "gtceu:prospector.lv"
			id: "345C4D73090CB5E2"
			rewards: [{ id: "2489A56E439E1302", type: "xp", xp: 10 }]
