		{
			dependencies: ["69BDA9FBB0EB66F2"]
			description: [
				"The &6Void Key&r takes you to an empty dimension and puts a small platform under your feet. Use it again to come back to where you left the Overworld."
				"Lose it and you can craft another from flint, a stick and glass."
			]
			icon: "grindless:void_key"
			id: "7194C28F070B38A2"
			optional: true
			rewards: [{ id: "36BF9B1736D3E98E", item: "grindless:void_key", type: "item" }]
