			title: "Polar Cap Tap"
			x: 9.5d
			y: 15.0d
		}
		{
			dependencies: ["5A539FCEC01451BA"]
			description: ["The star's core was thrown out in clumps still rich in what it made as it died. The &6Ejecta Knot Sweeper&r sweeps them up, behind a shield bow. A UIV hull, the Whipple shield casing and a filter collector. Ejecta knot dust, and titanium-44 from it. Shield weave by ME; the dust comes back by hopper."]
			icon: "gtceu:ejecta_knot_sweeper"
			id: "12376A5961A338E7"
			rewards: [{ id: "56D9BE7C40325044", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "32CE7A9CD71B6B2E", item: "gtceu:ejecta_knot_sweeper", type: "item" }
				{ id: "1CFA9454DF74F43F", item: "grindless:whipple_shield_casing", type: "item" }
