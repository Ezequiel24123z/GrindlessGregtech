				{ id: "33DF6F56B9115400", item: "gtceu:pasta_laminator", type: "item" }
				{ id: "564E04C38B269476", item: "grindless:neutron_star_site_casing", type: "item" }
				{ id: "7E54036D6B84BDB0", item: "gtceu:robust_machine_casing", type: "item" }
			]
			title: "Pasta Laminator"
			x: 7.0d
			y: 16.5d
		}
		{
			dependencies: ["3CCB6C8A5332CADD"]
			description: ["The plate every UXV hull and part is cut from."]
			icon: "grindless:lasagna_plate"
			id: "34D1D9ED3F6FBC67"
