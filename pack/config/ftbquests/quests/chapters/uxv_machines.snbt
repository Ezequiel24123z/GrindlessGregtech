				{ id: "303ABC678F712DA7", item: "gtceu:clean_machine_casing", type: "item" }
			]
			title: "vdW Stacking Cell"
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["7C3E8D47479787F5"]
			description: ["The &6YIG LPE Furnace&r dips a wafer into a molten bath and draws it out coated in a garnet film that carries spin waves almost without loss. A UIV hull, the robust casing, three heater bands and a platinum crucible. The magnonic bus the spintronic mainframe is wired with. Wafers and charge by ME; films take time, so run it in a stack of machines."]
			icon: "gtceu:yig_lpe_furnace"
			id: "7486DF37973BED77"
			rewards: [{ id: "5AEFFDB492571336", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
