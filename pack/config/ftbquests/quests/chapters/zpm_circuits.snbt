	quests: [
		{
			dependencies: ["7B0EFFD4E295AFAD"]
			description: ["The &6ZPM Circuit Assembler&r is the first assembler that can build the circuits ZPM machines are made of. ZPM components for its hull, a cleanroom you already run, and the LuV circuits that feed it. The crystal computer and the quantum mainframe below, and every controller of this era. Boards and chips arrive by ME from the cleanroom; keep a stock of what it returns."]
			icon: "gtceu:zpm_circuit_assembler"
			id: "77DE04F713EEBE61"
			rewards: [{ id: "5FC15E60BB7CE99E", type: "xp", xp: 100 }]
