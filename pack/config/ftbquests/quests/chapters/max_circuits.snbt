		}
		{
			dependencies: ["18197070E4168342"]
			description: ["The &6MAX Sensor&r reads gravity from atoms, so it waits for the atom interferometer works to make the gradiometer. Until then, every MAX machine that wants one waits too."]
			icon: "grindless:max_sensor"
			id: "14F8810FFFD16F9C"
			rewards: [{ id: "5EF24D3053494F2A", type: "xp", xp: 120 }]
			tasks: [{ id: "1DC0F611B6A04C80", item: "grindless:max_sensor", type: "item" }]
			title: "Sensor"
			x: 15.0d
			y: 3.0d
		}
		{
			dependencies: ["3FC8F0795380E0E2"]
			description: ["A belt that carries the load on a film one atom thick. The &6MAX Conveyor Module&r needs the membrane line, and the buses need the conveyor."]
			icon: "grindless:max_conveyor_module"
			id: "389ED54791286682"
			rewards: [{ id: "5B23EFF10DE69E16", type: "xp", xp: 120 }]
