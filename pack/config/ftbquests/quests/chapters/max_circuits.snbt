			x: 15.0d
			y: 4.5d
		}
		{
			dependencies: ["3FC8F0795380E0E2"]
			description: ["The part that bends space: an emitter, two field coils, a superconducting membrane and a pinch of stable exotic matter. The &6MAX Field Generator&r is the last component and the one every big machine asks for most."]
			icon: "grindless:max_field_generator"
			id: "7FDC7DC697D09839"
			rewards: [{ id: "32CBC11FF4BFA1DE", type: "xp", xp: 150 }]
