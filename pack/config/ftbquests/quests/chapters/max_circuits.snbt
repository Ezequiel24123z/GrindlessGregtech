			title: "Emitter"
			x: 12.5d
			y: 1.5d
		}
		{
			dependencies: ["1E1DCCA995ABBA6C"]
			description: ["Two motors, a piston and a circuit: the &6MAX Robot Arm&r. It is also what the belt seed and the Rydberg works are built around."]
			icon: "grindless:max_robot_arm"
			id: "5E0E8820A0ECD4C2"
