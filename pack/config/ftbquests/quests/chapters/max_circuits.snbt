			title: "Fluid Regulator"
			x: 20.0d
			y: 0.0d
		}
		{
			dependencies: ["34FED870BAF8944F"]
			description: ["A squeezed-light chip behind an optical isolator, so the light goes out and nothing comes back. The &6MAX Emitter&r goes into the field generator and most controllers."]
			icon: "grindless:max_emitter"
			id: "1474BC43B0215EB5"
