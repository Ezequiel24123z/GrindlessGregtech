			]
			title: "Fusion"
			x: 12.0d
			y: 13.5d
		}
		{
			dependencies: ["34BE2C5053E7572B"]
			description: ["The &6Cryobot&r melts its way down through the ice, paying out its tether as it sinks. A base of sulfur concrete, so Io comes first, and probes to send down. A living ocean sample, and after that brine by the tank. Probes are single use. Keep them stocked by ME."]
			icon: "gtceu:cryobot"
			id: "377C157965B3A560"
			rewards: [{ id: "77BA838176319E5B", type: "xp", xp: 100 }]
