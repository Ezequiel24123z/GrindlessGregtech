		}
		{
			dependencies: ["5904BFC41192005D", "103CB25094617064"]
			description: ["A wireless dynamo hatch feeds the network from the platform. A fraction is lost on the way, so build more than you need. The &6wireless dynamo hatch&r, on every plant. The network at home. Power flows without a cable, but not without cost."]
			icon: "gtceu:max_wireless_dynamo_hatch_16a"
			id: "39270E38F40EA6A2"
