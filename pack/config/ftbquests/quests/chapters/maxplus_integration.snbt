			title: "The Hole Row: Beams and Pairs"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["13C38AC31B1221D5"]
			description: ["The plasma mass filter and the FRC former turn the lift's raw wind into confined plasma, the same way at this scale as before. Both controllers, on the platform at 30 Doradus. Nickel-56 and every plasma line after it. The filter's waste leaves in its own pipe."]
			icon: "gtceu:plasma_mass_filter"
