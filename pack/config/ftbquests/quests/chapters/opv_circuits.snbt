			tasks: [{ id: "562FAE7CE1E2707A", item: "gtceu:opv_sensor", type: "item" }]
			title: "OpV Sensor"
			x: 12.0d
			y: 0.0d
		}
		{
			dependencies: ["59A06A2C9ADDA9E4", "7FD656811E00D002"]
			description: ["The &6OpV Electric Motor&r runs on a superconducting winding in a cooled housing, and the &6OpV Electric Pump&r moves fluid with a travelling field. The piston and conveyor run on composite rods and lamina stacks, the robot arm turns on the harmonic drive, and the emitter, sensor and field generator close the set with the fluid regulator."]
			icon: "gtceu:opv_electric_motor"
