			title: "Nanoprocessor"
			x: 16.0d
			y: 1.5d
		}
		{
			dependencies: ["115A9664BF3CF352"]
			description: ["The &6Nanoprocessor Assembly&r is the nano line's EV circuit, and it sits on an epoxy circuit board, so HV's epoxy line still has work to do. The supercomputer is built from these."]
			icon: "gtceu:nano_processor_assembly"
			id: "368E5D61D5E5572B"
