				{ id: "5F998A4F472AB2CF", item: "gtceu:titanium_ingot", type: "item" }
			]
			title: "Titanium"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["14DF849D657D6AEF"]
			description: [
				"Your first lunar titanium goes into the &6EV Machine Hull&r."
				"EV energy hatches come much later, and until then two HV energy hatches on a multiblock run EV recipes just fine."
			]
			icon: "gtceu:ev_machine_hull"
			id: "61ECF6270ECCE3C2"
			rewards: [{ id: "6DE5A471269B3A5D", type: "xp", xp: 40 }]
