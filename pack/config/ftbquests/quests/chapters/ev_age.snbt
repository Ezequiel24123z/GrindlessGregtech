		{
			dependencies: ["2897E3EB8159710C"]
			description: [
				"Titanium only exists up here. This tab makes the Moon work without you, then finds the way to Mars."
				"Ender chests and ender tanks work between Earth and the Moon: the cheap link for a few stacks. A whole factory crosses over the AE2 bridge."
			]
			icon: "gcyr:lunar_mare_regolith"
			id: "7E510A95C066D14C"
			rewards: [{ id: "073D0AACCEB758A2", type: "xp", xp: 40 }]
