	quest_links: [ ]
	quests: [
		{
			dependencies: ["2897E3EB8159710C"]
			description: ["Every bit of titanium in this pack is up here, under grey dust and a black sky. First the Moon learns to run without you. Then you point a rocket at Mars."]
			icon: "gcyr:lunar_mare_regolith"
			id: "7E510A95C066D14C"
			rewards: [{ id: "073D0AACCEB758A2", type: "xp", xp: 40 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "1C694669AF199258", type: "checkmark" }]
			title: "Lunar Base"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7E510A95C066D14C"]
			description: [
				"Same as on Earth: an empty probe dipped in both raw ores of a vein makes its sample. Raw ilmenite and raw olivine make the first."
				"The second takes the two kinds of regolith, scooped straight off the ground."
			]
			icon: "grindless:vein_sample_ilmenite_moon"
			id: "65FD970F8628E474"
			rewards: [{ id: "16857AADAB1453ED", type: "xp", xp: 40 }]
			tasks: [
				{ id: "050FFA47CAA5050F", item: "grindless:vein_sample_ilmenite_moon", type: "item" }
				{ id: "5AB7933E30EF63DD", item: "grindless:vein_sample_regolith_moon", type: "item" }
			]
			title: "Lunar Samples"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["65FD970F8628E474"]
			description: [
				"Craft the &6Lunar Drill&r at home and build it up here: it forms anywhere but only drills on the Moon. A sample and a stainless steel bit go in its input bus."
				"Until there's a bridge to Earth, it runs on the batteries you packed. You did pack batteries."
			]
			icon: "gtceu:lunar_drill"
			id: "246C8ADBADA728E9"
			rewards: [{ id: "7451BE7DAFCDCDCC", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "5B07A5D98BA69B39", item: "gtceu:lunar_drill", type: "item" }]
			title: "Lunar Drill"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["246C8ADBADA728E9", "53D1CE971F63D842"]
			description: ["The Moon's ilmenite is the only titanium you'll ever get. Back home it takes the long way round: the EBF twice, a chlorine bath and the vacuum freezer. Clear your afternoon."]
			icon: "gtceu:titanium_ingot"
			id: "14DF849D657D6AEF"
			rewards: [{ id: "7EF3030512FB7BB2", type: "xp", xp: 55 }]
			tasks: [
				{ id: "7D8636FA23850C39", item: "gtceu:raw_ilmenite", type: "item" }
				{ id: "570EBC0CBD0365D1", item: "gtceu:rutile_dust", type: "item" }
				{ id: "5F998A4F472AB2CF", item: "gtceu:titanium_ingot", type: "item" }
			]
			title: "Titanium"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["14DF849D657D6AEF"]
			description: [
				"Your first lunar titanium goes into the &6EV Machine Hull&r."
				"Machines of EV size need circuits the nano line makes, and the halls of the Moon base each have their own gear in the sections beside the journey."
			]
			icon: "gtceu:ev_machine_hull"
			id: "61ECF6270ECCE3C2"
			rewards: [{ id: "6DE5A471269B3A5D", type: "xp", xp: 40 }]
			tasks: [{ id: "13B7784B22044D02", item: "gtceu:ev_machine_hull", type: "item" }]
			title: "EV Machine Hull"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["61ECF6270ECCE3C2"]
			description: [
				"The EV motor is built around titanium rods, and every other part here needs a motor, so the Moon is officially in your supply chain."
				"The motor's neodymium magnet comes from the monazite vein in the Nether."
			]
			icon: "gtceu:ev_electric_motor"
			id: "164F0808EF9DF557"
			rewards: [{ id: "1B2016D2F9628E2F", type: "xp", xp: 70 }]
			tasks: [
				{ id: "0CB11B272083BF4F", item: "gtceu:ev_electric_motor", type: "item" }
				{ id: "01D849EAF82915F5", item: "gtceu:ev_electric_pump", type: "item" }
				{ id: "3FC827F4C82F8B11", item: "gtceu:ev_electric_piston", type: "item" }
				{ id: "19CA491E1535D0D1", item: "gtceu:ev_robot_arm", type: "item" }
				{ id: "3EB895FBD4951335", item: "gtceu:ev_conveyor_module", type: "item" }
			]
			title: "EV Components"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["246C8ADBADA728E9"]
			description: [
				"With the regolith sample, the lunar drill pumps &6Helium-3&r into an output hatch, by lunar day only. Nothing burns it yet."
				"The quantum seeds need some, and the rest is worth keeping for the day something does."
			]
			icon: "grindless:vein_sample_regolith_moon"
			id: "1DC956E9F071636A"
			rewards: [{ id: "3B994EBAA2AF1405", type: "xp", xp: 40 }]
			tasks: [{ id: "3FFC2A59AF730E83", type: "checkmark" }]
			title: "Helium-3"
			x: 4.0d
			y: -1.5d
		}
		{
			dependencies: ["246C8ADBADA728E9"]
			description: [
				"Cobblestone from the drill, or any lunar stone you dig up, grinds into &6Lunar Regolith Dust&r in any macerator."
				"An electric furnace bakes that into &6Sintered Regolith Bricks&r, slowly, and it works anywhere once you have the dust. Nearly the whole Moon base stands on these bricks."
			]
			icon: "grindless:sintered_regolith"
			id: "33EFC07080657F50"
			rewards: [
				{ id: "12E9B79D096C02EA", type: "xp", xp: 35 }
				{ count: 16, id: "3AB895BCA0F1FF7D", item: "gtceu:lunar_regolith_dust", type: "item" }
			]
			tasks: [
				{ id: "35C7DD57A884640E", item: "gtceu:lunar_regolith_dust", type: "item" }
				{ count: 16L, id: "7504084A6B44AD55", item: "grindless:sintered_regolith", type: "item" }
			]
			title: "Bricks from the Ground"
			x: 6.0d
			y: -1.5d
		}
		{
			dependencies: ["61ECF6270ECCE3C2"]
			description: ["The &6Advanced Creature Simulator III&r runs models the HV one can't, like the wither. It's built with an HV emitter and sensor, because the EV ones need a quantum eye and that waits for IV."]
			icon: "gtceu:ev_creature_simulator"
			id: "1F57B2083B56B2BA"
			rewards: [{ id: "5B4FA8CE917B791D", type: "xp", xp: 40 }]
			tasks: [{ id: "1869942F7008236A", item: "gtceu:ev_creature_simulator", type: "item" }]
			title: "Advanced Creature Simulator III"
			x: 8.0d
			y: 1.5d
		}
		{
			dependencies: ["1F57B2083B56B2BA"]
			description: [
				"Skip the fortress. Nether bricks and bone blocks print a &6Wither Skeleton&r model, and any simulator from HV up runs it on biomass and tricalcium phosphate."
				"Skulls drop now and then; circuit 2 gives nothing but skulls."
			]
			icon: "grindless:creature_model_wither_skeleton"
			id: "561EADDBC1373853"
			rewards: [
				{ id: "5B634D8FFCAF0786", type: "xp", xp: 35 }
				{ count: 4, id: "70052057802E0E94", item: "gtceu:tricalcium_phosphate_dust", type: "item" }
			]
			tasks: [{ id: "3554ADB692D9075E", item: "grindless:creature_model_wither_skeleton", type: "item" }]
			title: "Wither Skeletons"
			x: 8.0d
			y: 3.0d
		}
		{
			dependencies: ["561EADDBC1373853"]
			description: [
				"Wither skeleton skulls print a &6Wither&r model, and only the EV simulator runs it. Each run hands back a Nether Star, no boss fight required."
				"Keep a stock, because IV turns them into quantum stars."
			]
			icon: "minecraft:nether_star"
			id: "73D14393C00DE14D"
			rewards: [{ id: "14A92A496BAA46E1", type: "xp", xp: 60 }]
			tasks: [
				{ id: "56A559EC98B8D9CA", item: "grindless:creature_model_wither", type: "item" }
				{ id: "1D42A20C7B41C7DF", item: "minecraft:nether_star", type: "item" }
			]
			title: "Nether Stars"
			x: 8.0d
			y: 4.5d
		}
		{
			dependencies: ["1F70EF41E5F8ED95"]
			description: [
				"Circuit 1 leaches purified pentlandite or chalcopyrite into &6Platinum Group Sludge&r, with nickel or copper on the side. Circuit 2 turns the sludge into &6Platinum&r, gold and slag."
				"That second run is long and hungry, so put a battery buffer on the plant. Its nitrogen dioxide goes back to nitric acid."
			]
			icon: "gtceu:platinum_dust"
			id: "791D4E94384E12AB"
			rewards: [{ id: "37FF74FD63247BE6", type: "xp", xp: 60 }]
			tasks: [
				{ id: "776F10F0174DD518", item: "gtceu:platinum_group_sludge_dust", type: "item" }
				{ id: "725A2FE2FC260568", item: "gtceu:platinum_dust", type: "item" }
			]
			title: "Platinum"
			x: 14.0d
			y: 3.0d
		}
		{
			dependencies: ["791D4E94384E12AB"]
			description: [
				"The platinum slag still has &6Rhodium&r and &6Ruthenium&r in it, and this run gets them out. The toxic ruthenium tetroxide stays inside the plant, which is where you want it."
				"It fills all four output hatches, so give every fluid somewhere to go."
			]
			icon: "gtceu:ruthenium_dust"
			id: "74BC8201D518D3BA"
			rewards: [{ id: "7F86CFDEDA853216", type: "xp", xp: 55 }]
			tasks: [
				{ id: "7BD232212828FBA3", item: "gtceu:rhodium_dust", type: "item" }
				{ id: "3E3FF44F46764B58", item: "gtceu:ruthenium_dust", type: "item" }
			]
			title: "Rhodium and Ruthenium"
			x: 16.0d
			y: 3.0d
		}
		{
			dependencies: ["791D4E94384E12AB"]
			description: [
				"The platinum run also lets go of palladium-rich ammonia. Feed it back with more ammonia and formic acid and out comes &6Palladium&r."
				"Keep the palladium metal dust the platinum run drops, because this one needs it too."
			]
			icon: "gtceu:palladium_dust"
			id: "31410FFA71DAFA0F"
			rewards: [{ id: "3A7A69EE74073864", type: "xp", xp: 40 }]
			tasks: [{ id: "37DDC43E6EF22757", item: "gtceu:palladium_dust", type: "item" }]
			title: "Palladium"
			x: 16.0d
			y: 4.5d
		}
		{
			dependencies: ["74BC8201D518D3BA"]
			description: [
				"Ruthenium on alumina pellets makes the &6Ruthenium Catalyst&r, which turns carbon dioxide and hydrogen into methane."
				"Mars's atmosphere processor wears them out slowly, so pack a few for the trip."
			]
			icon: "grindless:ruthenium_catalyst"
			id: "169F778007DE0484"
			rewards: [{ id: "5067394C445994B8", type: "xp", xp: 60 }]
			tasks: [{ count: 4L, id: "7CD60D931DAFDC14", item: "grindless:ruthenium_catalyst", type: "item" }]
			title: "Ruthenium Catalyst"
			x: 18.0d
			y: 3.0d
		}
		{
			dependencies: ["5940CA99055BAF42"]
			description: [
				"At night the antenna takes radio fixes on Mars, works out the next transfer window and marks a landing ellipse on the northern plains."
				"Your landing-site chart stays in the bus, and a data stick comes out as the &6Mars Transfer Chart&r. The tier 2 rocket parts are built with it, and it's never used up."
			]
			icon: "grindless:mars_chart"
			id: "319C39AD99B5E4A8"
			rewards: [{ id: "1641701EDE841626", type: "xp", xp: 60 }]
			tasks: [{ id: "3A236F3B926B3BD2", item: "grindless:mars_chart", type: "item" }]
			title: "The Way to Mars"
			x: 14.0d
			y: -1.5d
		}
		{
			dependencies: ["319C39AD99B5E4A8", "164F0808EF9DF557"]
			description: [
				"Mars needs a tier 2 rocket, and the game averages your parts: a single basic motor or tank left on board keeps you at the Moon. Swap every one for an &6Advanced Rocket Motor&r or &6Advanced Fuel Tank&r, made in the EV assembler with the Mars chart."
				"Two advanced tanks hold exactly one trip. Set the ID chip to Mars."
			]
			icon: "gcyr:advanced_rocket_motor"
			id: "5A84C7A4F1A7F2D9"
			rewards: [
				{ id: "17E645C4A771E50C", type: "xp", xp: 80 }
				{ id: "7E14DC7E71F53E24", item: "waystones:waystone", type: "item" }
			]
			tasks: [
				{ count: 2L, id: "1325820C09A0B5F9", item: "gcyr:advanced_fuel_tank", type: "item" }
				{ count: 6L, id: "311C26C14AF5C9FE", item: "gcyr:advanced_rocket_motor", type: "item" }
			]
			title: "A Rocket for Mars"
			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["5A84C7A4F1A7F2D9"]
			description: [
				"Mars is cold and its air is thin carbon dioxide, but your HV suit copes. Bring a waystone: it's your ride home."
				"Pack sintered-brick footings, the bridge parts, a chemical reactor with ender pearls and helium-3, and charged batteries. Sunlight is weak here, so the solar array wants circuit 2 and gives under a third."
			]
			icon: "gcyr:mars_regolith"
			id: "3C5189B47D70D762"
			rewards: [
				{ id: "59052BD0D36A5824", type: "xp", xp: 150 }
				{ count: 3, id: "1B2D6B69B1579CD9", item: "grindless:empty_vein_probe", type: "item" }
			]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ dimension: "gcyr:mars", id: "5A92C623281A6694", type: "dimension" }]
			title: "Red Horizon"
			x: 16.0d
			y: 0.0d
		}
		{
			dependencies: ["3C5189B47D70D762"]
			description: [
				"Mars has only three veins: scheelite, merrillite and ice. None of them exists anywhere else, and small rocks on the surface give each one away."
				"Dip a probe in both raw ores of each vein. Scheelite sits deepest, so expect a long dig."
			]
			icon: "grindless:vein_sample_scheelite_mars"
			id: "5EFC42884771D00C"
			rewards: [{ id: "30C28952047E5D65", type: "xp", xp: 60 }]
			tasks: [
				{ id: "19C4B5C81E5E5DDC", item: "grindless:vein_sample_scheelite_mars", type: "item" }
				{ id: "5E50801BB633D859", item: "grindless:vein_sample_merrillite_mars", type: "item" }
				{ id: "11F2EA23D6358D4B", item: "grindless:vein_sample_ice_mars", type: "item" }
			]
			title: "Martian Samples"
			x: 18.0d
			y: 0.0d
		}
		{
			dependencies: ["5EFC42884771D00C"]
			description: [
				"Rare-earth ions are what real quantum memories store their states in, so merrillite gets the job here. A chemical reactor makes the &6Martian Quantum Seed&r from merrillite dust, an ender pearl and helium-3. The recipe works in any chemical reactor, so the dust can ship home."
				"Raw merrillite becomes dust in a plain furnace, which still works here."
			]
			icon: "grindless:martian_quantum_seed"
			id: "5301384885D78BAC"
			rewards: [{ id: "7BA522A8AA02443F", type: "xp", xp: 50 }]
			tasks: [{ id: "13C945C4547889F7", item: "grindless:martian_quantum_seed", type: "item" }]
			title: "A Seed from Mars"
			x: 18.0d
			y: -1.5d
		}
		{
			dependencies: ["5EFC42884771D00C"]
			description: [
				"Build a second EV Tripod Drill here and give it the scheelite sample and titanium bits. The solar wings don't do much in this weak sunlight."
				"Tungsten only comes from Mars, and from now on it reaches home without you."
			]
			icon: "gtceu:raw_scheelite"
			id: "56FFD4EF98A6C3B8"
			rewards: [{ id: "3977177DF1BB38B0", type: "xp", xp: 120 }]
			tasks: [{ count: 16L, id: "7391930490146D70", item: "gtceu:raw_scheelite", type: "item" }]
			title: "The Martian Tripod"
			x: 20.0d
			y: 0.0d
		}
		{
			dependencies: ["56FFD4EF98A6C3B8"]
			description: ["Mars lost most of its water to space, but the heavy kind tended to stay, so this ice holds about five times Earth's deuterium. Nothing uses it yet. Store it, because IV turns it into heavy water."]
			icon: "gtceu:raw_deuterium_rich_ice"
			id: "148A0854C671B0AC"
			optional: true
			rewards: [{ id: "34868A8CB47D7899", type: "xp", xp: 30 }]
			size: 0.75d
			tasks: [{ count: 16L, id: "39F11652861B7724", item: "gtceu:raw_deuterium_rich_ice", type: "item" }]
			title: "Deuterium-Rich Ice"
			x: 22.0d
			y: -1.5d
		}
		{
			dependencies: ["3FCCD81DE98DA9EF"]
			description: [
				"The cascade gives samarium, neodymium and mixed rare-earth chlorides, and hands most of the kerosene back. Any electrolyzer turns the chlorides into metal and chlorine."
				"&6Samarium&r only comes from Mars, and IV's superconductor and LuV's motor magnets both want it, so start a pile."
			]
			icon: "gtceu:samarium_dust"
			id: "72022B0ECDC3668B"
			rewards: [{ id: "5E60AB1D3DB8F6C6", type: "xp", xp: 60 }]
			tasks: [
				{ id: "5C5A45DA7E372E3D", item: "gtceu:samarium_chloride_dust", type: "item" }
				{ id: "1088F02E75EFC2DD", item: "gtceu:samarium_dust", type: "item" }
			]
			title: "Samarium"
			x: 22.0d
			y: -3.0d
		}
		{
			dependencies: ["56FFD4EF98A6C3B8"]
			description: [
				"Tungsten starts here with a bath. Ground scheelite sits in hydrochloric acid in a chemical bath and comes out as &6Tungstic Acid&r, with calcium chloride on the side."
				"Tungstic acid is not tungsten, and no electrolyzer will turn it into metal. The rest of the road is the real one: a salt first, then an oxide, then the metal. Keep the calcium chloride: the Moon's molten salt charge is made from it."
			]
			icon: "gtceu:tungstic_acid_dust"
			id: "1B1F34854FA33FC0"
			rewards: [{ id: "576B2EBF48B0FA1C", type: "xp", xp: 40 }]
			tasks: [
				{ id: "58E97DBACA5323D9", item: "gtceu:scheelite_dust", type: "item" }
				{ id: "68E995478B3EC62E", item: "gtceu:tungstic_acid_dust", type: "item" }
			]
			title: "Tungstic Acid"
			x: 22.0d
			y: 0.0d
		}
		{
			dependencies: ["1B1F34854FA33FC0"]
			description: [
				"A chemical reactor dissolves tungstic acid in ammonia and water, and the result is &6Ammonium Tungstate&r solution. Tungsten is now a salt in a tank, which is what makes it easy to clean."
				"A second pass with sodium sulfide drops the molybdenum out as molybdenite, and the solution stays. Keep the molybdenite: the line pays you back in molybdenum."
				"Ammonia is used and given back further down the line, so pipe it in a loop."
			]
			icon: "gtceu:ammonium_tungstate_bucket"
			id: "2990D44479185D0E"
			rewards: [{ id: "33E0D63BC00445C0", type: "xp", xp: 50 }]
			tasks: [
				{ id: "5BD91E39B6F4F8A1", item: "gtceu:ammonium_tungstate_bucket", type: "item" }
				{ id: "3661F777CB60AD88", item: "gtceu:molybdenite_dust", type: "item" }
			]
			title: "Ammonium Tungstate"
			x: 24.0d
			y: 0.0d
		}
		{
			dependencies: ["2990D44479185D0E"]
			description: [
				"A distillery boils the clean solution down, the ammonia leaves as gas and &6Ammonium Paratungstate&r crystallises. Industry calls it APT and trades tungsten in this form, because it is the purest way to carry it."
				"The ammonia goes back to the reactor. Hold some APT back, as it is the clean stock the rest of the line starts from."
			]
			icon: "gtceu:ammonium_paratungstate_dust"
			id: "5DAD033DFD7B7A35"
			rewards: [{ id: "634EEEAA0AD281B4", type: "xp", xp: 50 }]
			tasks: [{ id: "41FE9715ECF637EB", item: "gtceu:ammonium_paratungstate_dust", type: "item" }]
			title: "Ammonium Paratungstate"
			x: 26.0d
			y: 0.0d
		}
		{
			dependencies: ["5DAD033DFD7B7A35"]
			description: [
				"An electric blast furnace at a modest coil heat bakes APT into &6Tungsten Trioxide&r, the yellow oxide. Ammonia and steam leave, and the ammonia is the second return to the reactor."
				"This is the last step before the metal, and the next one needs hydrogen in volume."
			]
			icon: "gtceu:tungsten_trioxide_dust"
			id: "357CD781C4C5D08E"
			rewards: [{ id: "4AC10B3C7B17CD6A", type: "xp", xp: 50 }]
			tasks: [{ id: "770A380E75312DF8", item: "gtceu:tungsten_trioxide_dust", type: "item" }]
			title: "Yellow Oxide"
			x: 28.0d
			y: 0.0d
		}
		{
			dependencies: ["357CD781C4C5D08E"]
			description: [
				"Hydrogen takes the oxygen off the oxide in a hotter blast furnace and leaves &6Tungsten&r dust and water. The vacuum freezer casts the dust into an ingot."
				"Six scheelite still make one tungsten. The salt route costs more power than a shortcut would, so feed it scheelite from a belt and give hydrogen its own tank."
			]
			icon: "gtceu:tungsten_ingot"
			id: "5B6B5BE89721691A"
			rewards: [{ id: "3EDBCF351DEE2347", type: "xp", xp: 60 }]
			tasks: [
				{ id: "12F35AEF44226368", item: "gtceu:tungsten_dust", type: "item" }
				{ id: "71A6759B1111A3DC", item: "gtceu:tungsten_ingot", type: "item" }
			]
			title: "Tungsten"
			x: 30.0d
			y: 0.0d
		}
		{
			dependencies: ["5B6B5BE89721691A"]
			description: ["&6RTM Alloy&r takes shopping on three worlds: ruthenium from the platinum plant, tungsten from Mars and molybdenum from the Nether, with the molybdenite your tungsten line sets aside as a second source. A blast furnace lined with its coils runs hotter than nichrome ever could."]
			icon: "gtceu:rtm_alloy_coil_block"
			id: "3DB3729547372E91"
			rewards: [{ id: "58D020FF415A194C", type: "xp", xp: 80 }]
			tasks: [{ count: 4L, id: "56EE64CD3A69B9CA", item: "gtceu:rtm_alloy_coil_block", type: "item" }]
			title: "RTM Coils"
			x: 32.0d
			y: -1.5d
		}
		{
			dependencies: ["5B6B5BE89721691A"]
			description: ["&6Tungsten Steel&r is what IV machines are made of, so you'll want plenty. Tungsten and steel dust from the mixer take another trip through the blast furnace and the freezer."]
			icon: "gtceu:tungsten_steel_ingot"
			id: "11BD5A24AAF314BC"
			rewards: [{ id: "18399F59E4F03505", type: "xp", xp: 60 }]
			tasks: [
				{ id: "3D4D6BFA66540329", item: "gtceu:tungsten_steel_dust", type: "item" }
				{ id: "106C109CA8C652F8", item: "gtceu:tungsten_steel_ingot", type: "item" }
			]
			title: "Tungsten Steel"
			x: 32.0d
			y: 0.0d
		}
		{
			dependencies: ["11BD5A24AAF314BC", "72022B0ECDC3668B"]
			description: [
				"Venus and Mercury burn, and IV leans on what you stored here: liquid oxygen and helium, nether stars, samarium and the deuterium-rich ice."
				"Look over the tanks once before you leave."
			]
			icon: "gtceu:liquid_helium_bucket"
			id: "7CE9D103A0007F24"
			rewards: [{ id: "1766D84CBC88FE07", type: "xp", xp: 30 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "5BDA225F25F582FA", type: "checkmark" }]
			title: "Before IV"
			x: 34.0d
			y: -3.0d
		}
		{
			dependencies: ["11BD5A24AAF314BC", "1D65975B45CF7836"]
			description: [
				"The &6IV Machine Hull&r puts Martian tungsten steel, platinum cable and PTFE into one box."
				"Mars gave you tungsten. Venus and Mercury burn. That's next."
			]
			icon: "gtceu:iv_machine_hull"
			id: "7AF6FD3F4F3B06B4"
			rewards: [{ id: "77CC1D46CCA5BF7C", type: "xp", xp: 200 }]
			shape: "diamond"
			size: 1.75d
			tasks: [{ id: "165460090EBCFE61", item: "gtceu:iv_machine_hull", type: "item" }]
			title: "IV Machine Hull"
			x: 36.0d
			y: 0.0d
		}
		{
			dependencies: ["1F70EF41E5F8ED95"]
			description: [
				"Rare earths are separated, not mined: no vein holds a clean lanthanide, and the platinum plant has shown you what a separation hall is for. The Nether's bastnasite vein holds all of them at once, in one mixed ore, and the next quests pull them apart."
				"Drill the Nether vein, then crush the raw ore in a macerator."
			]
			icon: "gtceu:raw_bastnasite"
			id: "3B09CD79B02F2EEB"
			rewards: [{ id: "3C97ACE45C0C055A", type: "xp", xp: 40 }]
			tasks: [
				{ id: "5C1E7FD2BFA13D6C", item: "gtceu:raw_bastnasite", type: "item" }
				{ id: "4134F04812BAE2B4", item: "gtceu:crushed_bastnasite_ore", type: "item" }
			]
			title: "Bastnasite"
			x: 10.0d
			y: 7.5d
		}
		{
			dependencies: ["3B09CD79B02F2EEB"]
			description: [
				"The &6Thermal Reactor&r cracks the crushed ore in nitric acid. Steam strips the mud, sodium fluorosilicate conditions it and water dilutes it. A centrifuge filters the silica and red zircon out, and a blast furnace calcines what is left into &6Bastnasite Rare Earth Oxides&r."
				"It is a long chain of small steps, each its own machine. Put every byproduct somewhere: silica goes to glass, red zircon waits for the zirconium line."
			]
			icon: "gtca:bastnasite_rare_earth_oxides_dust"
			id: "4928BA90F3A31156"
			rewards: [{ id: "71A03A89CF03DFFC", type: "xp", xp: 55 }]
			tasks: [
				{ id: "41E589CD151D8395", item: "gtca:thermal_reactor", type: "item" }
				{ id: "3075F357FAC8969E", item: "gtca:bastnasite_rare_earth_oxides_dust", type: "item" }
			]
			title: "Cracking the Ore"
			x: 12.0d
			y: 7.5d
		}
		{
			dependencies: ["4928BA90F3A31156"]
			description: [
				"A hydrochloric leach and a blast furnace roast with oxygen make &6Roasted Rare Earth Oxides&r. The roast is the trick: it oxidises cerium to the tetravalent state, which will not dissolve with the rest."
				"Wet the oxides in a mixer, then a large chemical reactor with fluorine finishes the oxidation and gives &6Cerium-Oxidised Oxides&r. The fluorine comes back as hydrofluoric acid, which the fluorspar kiln and the naquadah plant take."
			]
			icon: "gtca:roasted_rare_earth_oxides_dust"
			id: "23FAE54AF8624821"
			rewards: [{ id: "2428C3492CB002FF", type: "xp", xp: 55 }]
			tasks: [
				{ id: "3D9D3C823F2FAD0D", item: "gtca:roasted_rare_earth_oxides_dust", type: "item" }
				{ id: "7279872EAB11CFFE", item: "gtca:cerium_oxidised_rare_earth_oxides_dust", type: "item" }
			]
			title: "The Cerium Roast"
			x: 14.0d
			y: 7.5d
		}
		{
			dependencies: ["23FAE54AF8624821"]
			description: [
				"A centrifuge splits the oxidised oxides in two: &6Cerium Dioxide&r stays behind, and the rarer earths carry on. Cerium is now apart from the rest."
				"A long branch turns the dioxide into metal: chlorination with hydrogen, an oxalate made from sugar and nitric acid, a blast furnace with carbon, then the electrolyzer. Cerium has few uses yet; ZPM's naquadah fuel works takes it."
			]
			icon: "gtceu:cerium_dust"
			id: "5AED6C97552BC57C"
			rewards: [{ id: "71288C76F4AE5952", type: "xp", xp: 50 }]
			tasks: [
				{ id: "2D79BA20039E0DC8", item: "gtca:cerium_dioxide_dust", type: "item" }
				{ id: "62386CCF5D008E0E", item: "gtceu:cerium_dust", type: "item" }
			]
			title: "Cerium"
			x: 16.0d
			y: 9.0d
		}
		{
			dependencies: ["23FAE54AF8624821"]
			description: [
				"The rarer earths dissolve in nitric acid, an acetone solvent carries them as a suspension, and a centrifuge splits it into two concentrates: &6Samaric Concentrate&r, rich in the samarium-europium-gadolinium group, and a neodymium one."
				"The acetone circulates back to the reactor."
			]
			icon: "gtca:samaric_rare_earth_concentrate_dust"
			id: "1B5E2BD387897BA8"
			rewards: [{ id: "351296B42EF94177", type: "xp", xp: 55 }]
			tasks: [{ id: "2E8961B78931BEC8", item: "gtca:samaric_rare_earth_concentrate_dust", type: "item" }]
			title: "Samaric Concentrate"
			x: 16.0d
			y: 7.5d
		}
		{
			dependencies: ["1B5E2BD387897BA8"]
			description: [
				"The neodymium concentrate meets hydrochloric acid in a large chemical reactor and splits into neodymium oxide and lanthanum chloride. Electrolyzers turn each into metal."
				"Neodymium is the motors' magnet and lanthanum is stocked for later eras. Mars gives neodymium too, through the cascade."
			]
			icon: "gtceu:lanthanum_dust"
			id: "619BDEEE4DDF0666"
			rewards: [{ id: "528B166340BDEB5A", type: "xp", xp: 50 }]
			tasks: [
				{ id: "43CA39960093577B", item: "gtceu:neodymium_dust", type: "item" }
				{ id: "282C8554B24EE92F", item: "gtceu:lanthanum_dust", type: "item" }
			]
			title: "Neodymium and Lanthanum"
			x: 18.0d
			y: 9.0d
		}
		{
			dependencies: ["1B5E2BD387897BA8"]
			description: [
				"A large chemical reactor dissolves the samaric concentrate in hydrochloric acid, and the &6Extraction Cascade&r on circuit 28 splits the solution with kerosene. Europium is stripped off as chloride solution, and the heavy rare earths stay behind."
				"Europium has no use at EV. Keep the solution in a tank: ZPM's reductor wants it."
				"Hydrochloric acid and kerosene go round in loops, so give the cascade an output hatch for each fluid."
			]
			icon: "gtceu:europium_chloride_solution_bucket"
			id: "411701B2F06638B0"
			rewards: [{ id: "54F22FFEE93FF92C", type: "xp", xp: 70 }]
			tasks: [
				{ id: "65809AE51E988BE0", item: "gtceu:seg_chloride_solution_bucket", type: "item" }
				{ id: "5C4A9723F372AF22", item: "gtceu:europium_chloride_solution_bucket", type: "item" }
			]
			title: "The SEG Cut"
			x: 18.0d
			y: 7.5d
		}
		{
			dependencies: ["411701B2F06638B0"]
			description: [
				"Hydrofluoric acid precipitates the heavy rare earths as &6Fluorinated Samaric Concentrate&r, and the acid goes back to the dissolving step. Eight of them and calcium in a blast furnace at 1,200 K make one &6Holmium&r."
				"Holmium only comes from this line, and later tiers' wetware boards and foils need it."
			]
			icon: "gtceu:holmium_dust"
			id: "5309BC75ADAF248E"
			rewards: [{ id: "38821665C132E523", type: "xp", xp: 70 }]
			tasks: [
				{ id: "2674A4A3E6AD1324", item: "gtca:fluorinated_samaric_concentrate_dust", type: "item" }
				{ id: "2308431762A6F718", item: "gtceu:holmium_dust", type: "item" }
			]
			title: "Holmium"
			x: 20.0d
			y: 7.5d
		}
		{
			dependencies: ["164F0808EF9DF557"]
			description: ["The nano ladder: wafers, chips and the circuits an EV circuit assembler builds from them, up to the supercomputer that gates IV."]
			icon: "gtceu:nano_processor"
			id: "31929D82D6220E91"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "19775599692F69ED", type: "checkmark" }]
			title: "EV: Circuits"
			x: 11.0d
			y: 2.25d
		}
		{
			dependencies: ["164F0808EF9DF557"]
			description: ["The &6EV Circuit Assembler&r builds the nano circuits, which the HV assembler cannot. It asks for Microprocessor Mainframes, the micro line's last circuit, and an HV emitter, since the EV one waits for IV. Every nano circuit from here to the supercomputer. Feed circuit boards and chips from the cleanroom lines by ME, and keep a stock of mainframes."]
			icon: "gtceu:ev_circuit_assembler"
			id: "3C5EB45848DA6797"
			rewards: [{ id: "5BA2C540CC3F5FC0", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ count: 2L, id: "57A2C4C8EBDA842C", item: "gtceu:micro_processor_mainframe", type: "item" }
				{ id: "3304D08BC6374CB2", item: "gtceu:ev_circuit_assembler", type: "item" }
			]
			title: "EV Circuit Assembler"
			x: 19.0d
			y: 1.5d
		}
		{
			dependencies: ["3C5EB45848DA6797"]
			description: ["A CPU wafer treated in an EV chemical reactor becomes a &6Nano CPU Wafer&r,       and a cutter in the cleanroom slices it into chips. A working cleanroom, carbon fibers and the HV wafer line behind you. The nanoprocessor, and with it the whole nano ladder. Cleanroom hatches take wafers from the ME network and return chips to it."]
			icon: "gtceu:nano_cpu_wafer"
			id: "7ECBC918EE387EB6"
			rewards: [{ id: "396BB82FD12CBA44", type: "xp", xp: 50 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5A773A9F78311909", item: "gtceu:carbon_fibers", type: "item" }
				{ id: "190EFCF060448247", item: "gtceu:nano_cpu_wafer", type: "item" }
				{ id: "34CBD6EAD60BF665", item: "gtceu:nano_cpu_chip", type: "item" }
			]
			title: "Nano CPU Wafer"
			x: 22.0d
			y: 1.5d
		}
		{
			dependencies: ["3C5EB45848DA6797"]
			description: ["A phosphorus boule grows slowly in the blast furnace and is sliced into wafers. Patience: the boule takes its time, so start one before you need the chips. MPIC and NOR memory chips, and through them EV hatches and the supercomputer. Keep a boule always growing and let the cutter feed the wafer line."]
			icon: "gtceu:phosphorus_boule"
			id: "5AB977D135E31355"
			rewards: [{ id: "347E9F4BF5FA1ECB", type: "xp", xp: 50 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "75CAEB237023B4DA", item: "gtceu:phosphorus_boule", type: "item" }
				{ id: "5052EA3CD266243C", item: "gtceu:phosphorus_wafer", type: "item" }
			]
			title: "Phosphorus Boule"
			x: 19.0d
			y: 4.5d
		}
		{
			dependencies: ["5AB977D135E31355"]
			description: ["The phosphorus wafer becomes an &6MPIC Wafer&r       and a cutter slices the &6MPIC Chips&r out of it. A cutter in a working cleanroom. Real EV energy and dynamo hatches. A wafer in, chips out. Let ME feed the cutter and store the chips."]
			icon: "gtceu:mpic_chip"
			id: "75CF49B21980A604"
			rewards: [{ id: "3070107D3B5F2047", type: "xp", xp: 50 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5046C130B8EBB086", item: "gtceu:mpic_wafer", type: "item" }
				{ id: "32D3EEAF7698F208", item: "gtceu:mpic_chip", type: "item" }
			]
			title: "MPIC Chips"
			x: 24.0d
			y: 6.0d
		}
		{
			dependencies: ["75CF49B21980A604"]
			description: ["&6NOR Memory&r is the same boule engraved with a pink lens, which is a different chip from the same slice of rock. The pink glass lens and a free engraver. The Nanoprocessor Supercomputer. Keep a second engraver for this lens so the MPIC line never waits for a lens swap."]
			icon: "gtceu:nor_memory_chip"
			id: "7B21E54E59758551"
			rewards: [{ id: "7DC2C3D36E7FDE31", type: "xp", xp: 50 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "78003EF351D63B6A", item: "gtceu:nor_memory_wafer", type: "item" }
				{ id: "1A3C6DC3E65149A1", item: "gtceu:nor_memory_chip", type: "item" }
				{ id: "765572EF458E828B", item: "gtceu:pink_glass_lens", type: "item" }
			]
			title: "NOR Memory"
			x: 26.0d
			y: 6.0d
		}
		{
			dependencies: ["7B21E54E59758551"]
			description: [
				"The &6SMD Diode&r wants fine platinum wire, so the platinum plant comes before it. Past that it is another cleanroom assembler recipe."
				"The supercomputer wants plenty. Put it on a repeating pattern."
			]
			icon: "gtceu:smd_diode"
			id: "568EBF6639C3A93E"
			rewards: [{ id: "1D281B6BC830F2F8", type: "xp", xp: 40 }]
			tasks: [{ id: "1032E54258E1BA5A", item: "gtceu:smd_diode", type: "item" }]
			title: "SMD Diodes"
			x: 27.0d
			y: 7.5d
		}
		{
			dependencies: ["3C5EB45848DA6797", "7ECBC918EE387EB6"]
			description: ["The &6Nanoprocessor&r is the nano line's HV circuit, and only the EV circuit assembler can put one together. Nano CPU chips, the carbon fibers from the wafer quest and the usual SMD parts. The assembly, and every EV machine that wants circuits. Run it from the assembler's own pattern, with the chips delivered by ME."]
			icon: "gtceu:nano_processor"
			id: "115A9664BF3CF352"
			rewards: [{ id: "1D596DC95CD2B572", type: "xp", xp: 50 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "117EF754C79BC140", item: "gtceu:nano_processor", type: "item" }]
			title: "Nanoprocessor"
			x: 22.0d
			y: 3.0d
		}
		{
			dependencies: ["115A9664BF3CF352"]
			description: ["The &6Nanoprocessor Assembly&r is the nano line's EV circuit, built on an epoxy board. Nanoprocessors and the epoxy line from HV, which still has work to do. The supercomputer and the EV machines that ask for assemblies. Epoxy boards and nanoprocessors come from the network; the assembler repeats."]
			icon: "gtceu:nano_processor_assembly"
			id: "368E5D61D5E5572B"
			rewards: [{ id: "7624CE505F1A4895", type: "xp", xp: 50 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5EFB1E15AA8BFF6A", item: "gtceu:nano_processor_assembly", type: "item" }]
			title: "Nanoprocessor Assembly"
			x: 25.0d
			y: 4.5d
		}
		{
			dependencies: ["368E5D61D5E5572B", "7B21E54E59758551", "568EBF6639C3A93E"]
			description: ["The &6Nanoprocessor Supercomputer&r is the IV circuit and the real wall of EV. Assemblies, NOR memory and SMD diodes, which means the platinum plant and the slow boule. The IV machine hull, and the mainframe after it. Stock every input in the network first. This recipe is the one that stalls."]
			icon: "gtceu:nano_processor_computer"
			id: "1D65975B45CF7836"
			rewards: [{ id: "3BE3697CB13B80C4", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5B352F266F8BB3EA", item: "gtceu:nano_processor_computer", type: "item" }]
			title: "Nanoprocessor Supercomputer"
			x: 27.0d
			y: 4.5d
		}
		{
			dependencies: ["1D65975B45CF7836"]
			description: ["The &6Nanoprocessor Mainframe&r closes the nano ladder. Supercomputers, and the same cleanroom discipline, at a larger scale. Nothing in EV asks for it. Later eras do. A dedicated assembler line and a standing stock of supercomputers."]
			icon: "gtceu:nano_processor_mainframe"
			id: "37E7797A38CEA743"
			rewards: [{ id: "7B8C4541452E1975", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "7A52ED1E3EF07D17", item: "gtceu:nano_processor_mainframe", type: "item" }]
			title: "Nanoprocessor Mainframe"
			x: 30.0d
			y: 7.5d
		}
		{
			dependencies: ["7E510A95C066D14C"]
			description: ["The halls of the Moon base: oxygen, cold, power and the bridge home. Each machine here makes the next part of the journey work without you."]
			icon: "gtceu:regolith_cell"
			id: "31DCC90FAE7A31B4"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "12DE890C7FC65448", type: "checkmark" }]
			title: "EV: Machines"
			x: 1.0d
			y: -4.5d
		}
		{
			dependencies: ["164F0808EF9DF557"]
			description: ["The lunar drill was a visitor; the &6EV Tripod Drill&r moves in, on titanium legs with a solar wing on each side. It is crafted from the old lunar drill, and titanium bits off an EV lathe: a full cycle can wear out one per bore. It only drills the veins of the Moon and Mars, and it is where all your titanium and tungsten come from. Let a lathe keep bits flowing by ME, and ship the ore home."]
			icon: "gtceu:ev_vein_drill"
			id: "5107982325BE34B7"
			rewards: [{ id: "7D0D9D1EEC42BBEB", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ count: 16L, id: "31582C1C38CC314C", item: "grindless:titanium_drill_bit", type: "item" }
				{ count: 18L, id: "123430355F4FAED8", item: "grindless:solar_wing_panel", type: "item" }
				{ id: "1C53BF2915922005", item: "gtceu:ev_vein_drill", type: "item" }
			]
			title: "EV Tripod Drill"
			x: 10.0d
			y: -1.5d
		}
		{
			dependencies: ["5107982325BE34B7"]
			description: [
				"There's no water up here, so there's no drilling mud either, and a dry bit wears out fast. By day the solar wings cover half the bill; at night Earth pays all of it over the bridge."
				"Swap an output bus for an ME Output Bus and the ilmenite ships itself home."
			]
			icon: "gtceu:raw_ilmenite"
			id: "321540F2528D14FA"
			rewards: [{ id: "3C91B7DB655E3564", type: "xp", xp: 50 }]
			tasks: [{ count: 64L, id: "159814B37781817F", item: "gtceu:raw_ilmenite", type: "item" }]
			title: "Drilling Dry"
			x: 12.0d
			y: -1.5d
		}
		{
			dependencies: ["33EFC07080657F50", "70F4075BAF69DA99"]
			description: ["The &6Regolith Cell&r cooks moon dirt until it gives up oxygen and metal. A hall of sintered brick around a crucible ringed with nichrome coils, and a platinum electrode in the input bus as its anode. Circuit 1 releases solar wind gases, circuit 2 gives oxygen and iron, and on circuit 3 it bakes bricks faster than a furnace. Give each gas its own output hatch, or let one ME output hatch take the lot."]
			icon: "gtceu:regolith_cell"
			id: "5BEACE3F7A414F40"
