		{
			dependencies: ["37E7797A38CEA743"]
			description: ["The EV halls that sit outside the lines: boilers, engines, turbines, miners, drilling rigs and a reactor."]
			icon: "gtceu:large_combustion_engine"
			id: "5FF951B710CB1296"
			rewards: [ ]
