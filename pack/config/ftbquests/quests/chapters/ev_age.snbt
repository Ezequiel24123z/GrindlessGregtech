			x: 14.0d
			y: -1.5d
		}
		{
			dependencies: ["5BEACE3F7A414F40"]
			description: ["Billions of years of solar wind are stuck in the regolith grains. Circuit 1 heats them until they let go: mostly hydrogen and helium, some nitrogen and a pinch of helium-3."]
			icon: "gtceu:helium_bucket"
			id: "1F20597E41D764DE"
			rewards: [{ id: "5F5858D2E73DF3BF", type: "xp", xp: 35 }]
			tasks: [{ id: "394D8CD1CC1EBBF9", type: "checkmark" }]
			title: "Solar Wind, Bottled"
			x: 14.0d
			y: -4.5d
		}
		{
			dependencies: ["320CD85A4C8D87D5", "321540F2528D14FA"]
			description: [
				"Ilmenite dust in molten calcium chloride gives its oxygen to the anode and leaves titanium behind: no chlorine, no magnesium, no freezer. It runs on circuit 2 with the &6Molten Salt Charge&r in the bus, and the charge is never used up."
				"The platinum plant leaves plenty of calcium chloride behind."
			]
			icon: "grindless:molten_salt_charge"
			id: "33176DE8937B3BEE"
			rewards: [{ id: "125FC86C33CAA992", type: "xp", xp: 50 }]
