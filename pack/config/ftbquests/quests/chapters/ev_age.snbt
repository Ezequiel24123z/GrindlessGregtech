			title: "Titanium Large Boiler"
			x: 32.0d
			y: 12.0d
		}
		{
			dependencies: ["5769033B186E75D4"]
			description: ["Fuel burns in the &6Large Combustion Engine&r and turns into power at a fair rate. Oxygen makes it run harder. Its controller, with an EV piston, an EV motor and titanium gears. Power from diesel and other fuels, and the way up to the extreme engine. Fuel in by hatch. A pipe from the oxygen tank is all it needs."]
			icon: "gtceu:large_combustion_engine"
			id: "1BC02BDB52B93415"
			rewards: [{ id: "300C69C6AA5CA8E7", type: "xp", xp: 50 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7935F01E7F352345", item: "gtceu:large_combustion_engine", type: "item" }]
			title: "Large Combustion Engine"
			x: 34.0d
			y: 12.0d
		}
		{
			dependencies: ["1BC02BDB52B93415"]
			description: ["Gas goes through the &6Large Gas Turbine&r and comes out as power. Rotors do the work, so keep spares. Its controller, with stainless gears, EV circuits and a stainless fluid pipe, and a rotor holder. Power from natural gas and fuels, and a part of the combined-cycle plant. Gas in by hatch. Swap a worn rotor before it breaks."]
			icon: "gtceu:gas_large_turbine"
			id: "5C0CAE35F4AFCAEE"
			rewards: [{ id: "56E5AD9F359AFABC", type: "xp", xp: 50 }]
			shape: "gear"
