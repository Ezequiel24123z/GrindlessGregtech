			title: "RTM Coils"
			x: 24.0d
			y: -1.5d
		}
		{
			dependencies: ["5B6B5BE89721691A"]
			description: ["Tungsten and steel dust from the mixer take another trip through the blast furnace and the freezer. &6Tungsten Steel&r is what IV machines are made of, so you'll want plenty."]
			icon: "gtceu:tungsten_steel_ingot"
			id: "11BD5A24AAF314BC"
			rewards: [{ id: "18399F59E4F03505", type: "xp", xp: 60 }]
			tasks: [
				{ id: "3D4D6BFA66540329", item: "gtceu:tungsten_steel_dust", type: "item" }
				{ id: "106C109CA8C652F8", item: "gtceu:tungsten_steel_ingot", type: "item" }
