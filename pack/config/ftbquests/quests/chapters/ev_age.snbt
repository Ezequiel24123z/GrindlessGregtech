			x: 19.0d
			y: -6.75d
		}
		{
			dependencies: ["53893FAB153254B8"]
			description: ["The &6Atmosphere Processor&r breathes Martian air, splits water and joins the hydrogen to the carbon dioxide: three machines in one, and it only runs on Mars. Water sent from home and a ruthenium catalyst. Save the Martian ice for IV. Circuit 1 makes methane and oxygen; circuit 2 only collects carbon dioxide. Water over the bridge, products home by ME."]
			icon: "gtceu:atmosphere_processor"
			id: "58BBEC58FB5953BD"
			rewards: [{ id: "7A0B13C332E8056B", type: "xp", xp: 80 }]
