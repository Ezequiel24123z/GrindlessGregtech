		}
		{
			dependencies: ["5BEACE3F7A414F40"]
			description: ["Circuit 2 melts the regolith and splits it on the platinum anode: oxygen bubbles off, iron and silicon sink. The oxygen fills your suit and feeds the cryogenic plant."]
			icon: "gtceu:oxygen_bucket"
			id: "320CD85A4C8D87D5"
			rewards: [{ id: "79FE3323A8B1B780", type: "xp", xp: 35 }]
