			title: "Lunar Base"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7E510A95C066D14C"]
			description: ["Place and activate a &6Waystone&r at the base. From then on waystones and /home carry you between Earth and the Moon; the rocket was only for the first trip."]
			icon: "waystones:waystone"
			id: "72396893B6F91D23"
