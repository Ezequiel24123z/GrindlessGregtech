		{
			dependencies: ["5FF951B710CB1296"]
			description: ["The &6Titanium Large Boiler&r makes more steam than the steel one, from the same fuel. Its controller, with a titanium firebox casing, EV circuits and gold cable. Steam for the big turbine halls without a boiler farm. Fuel in by bus, water in by hatch, steam out by hatch."]
			icon: "gtceu:titanium_large_boiler"
			id: "5769033B186E75D4"
			rewards: [{ id: "5EEEF2948B2AAC19", type: "xp", xp: 50 }]
