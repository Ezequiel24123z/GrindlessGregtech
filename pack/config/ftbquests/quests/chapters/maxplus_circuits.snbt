			title: "Horizon Logic Die"
			x: 2.5d
			y: 9.0d
		}
		{
			dependencies: ["1009AE6C6D8D0887"]
			description: ["The board that joins the dies with light, written by a femtosecond laser and chilled in the cryostat. The &6Horizon Interposer&r carries the waveguides between them. Thin-film lithium niobate, the femtosecond writer, molecular-beam epitaxy for the piezo layer and the millikelvin cryostat. The horizon processor, one interposer per circuit. Keep one chest per interposer step; the cryostat is the slow one."]
			icon: "grindless:horizon_interposer"
			id: "10AB32F3FA89A75D"
			rewards: [{ id: "7CEEF9FB21DA5C33", type: "xp", xp: 250 }]
			shape: "hexagon"
