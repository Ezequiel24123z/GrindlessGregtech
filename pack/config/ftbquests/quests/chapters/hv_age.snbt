		}
		{
			dependencies: ["5C5D6FB9ECB7BC51"]
			description: [
				"Cobalt, molybdenum and silica from sand, crossed with three different ore lines, make the &6Hydrotreating Catalyst&r the refinery burns through by chance."
				"Cobalt rides the nickel vein, molybdenum the Nether one; keep both stocked."
			]
			icon: "grindless:hydrotreating_catalyst"
			id: "64F01001238ACD74"
			rewards: [{ id: "7BB92FDB97461071", type: "xp", xp: 30 }]
