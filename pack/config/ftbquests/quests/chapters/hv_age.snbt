			title: "Refinery"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["5C5D6FB9ECB7BC51"]
			description: [
				"The &6Syngas Plant&r turns steam and carbon into carbon monoxide and hydrogen. Carbon monoxide is toxic, so keep the plant's output away from the base until it has been shifted."
			]
			icon: "gtceu:syngas_plant"
			id: "4C18E0B7D5A92F61"
			rewards: [{ id: "47E2104B9F6D3A58", type: "xp", xp: 50 }]
