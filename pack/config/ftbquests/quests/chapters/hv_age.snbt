			title: "Hydrotreating Catalyst"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["64F01001238ACD74"]
			description: [
				"Circuit 3 and a splash of steam turn naphtha into ethylene, propene, butadiene and benzene in the same refinery, no separate cracker required."
				"Hydrogen cracking (circuit 2) is the other mode: feed it back whatever fraction is piling up."
			]
			icon: "gtceu:refinery"
			id: "1051C4B8835DB4A3"
