		{
			dependencies: ["5B595A919C80BFC0"]
			description: [
				"From CPU wafer to &6Workstation&r, the whole micro line runs on MV power, and only the last step needs the cleanroom."
				"The vacuum freezer wants these, and so does nearly everything in EV, so get the line running early."
			]
			icon: "gtceu:micro_processor_computer"
