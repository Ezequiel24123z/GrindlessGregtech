			y: 0.0d
		}
		{
			dependencies: ["1051C4B8835DB4A3"]
			description: [
				"Glycerol from MV's biodiesel line turns into epichlorohydrin. Cumene from benzene and propene splits into phenol and acetone, and the three combine into epoxy."
				"Styrene and butadiene make SBR. Epoxy goes into every composite part of the rocket."
			]
			icon: "gtceu:mv_mixer"
			id: "47895685D763AE65"
			rewards: [{ id: "4973030D0D5597E4", type: "xp", xp: 30 }]
