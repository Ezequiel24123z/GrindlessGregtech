			x: 10.0d
			y: 1.5d
		}
		{
			dependencies: ["64F01001238ACD74"]
			description: [
				"GTM never reforms naphtha. The &6Catalytic Reformer&r does, turning it into benzene, toluene and the hydrogen the refinery just spent."
				"Not required: without it, the electrolyzer alone keeps the refinery in hydrogen, just with less margin."
			]
			icon: "gtceu:reformer"
