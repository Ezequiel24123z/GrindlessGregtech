		}
		{
			dependencies: ["51DD45CBEDEE31D9"]
			description: [
				"The &6Vacuum Freezer&r is built with EV circuits, so it waits for the workstation. It cools the hottest ingots out of the blast furnace and turns air into liquid air."
				"Lunar titanium will need it the day you bring ilmenite home."
			]
			icon: "gtceu:vacuum_freezer"
