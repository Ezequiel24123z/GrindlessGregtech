		}
		{
			dependencies: ["74B6466FA603FC14"]
			description: ["Topaz, lepidolite or bastnasite give up fluorine. Fluorine and hydrogen react to hydrofluoric acid, which PTFE cannot do without."]
			icon: "gtceu:lv_chemical_reactor"
			id: "7267E269B84470FF"
			rewards: [{ id: "48E8AC75F8251D19", type: "xp", xp: 25 }]
