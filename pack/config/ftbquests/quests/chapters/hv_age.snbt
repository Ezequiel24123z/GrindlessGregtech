			x: 10.0d
			y: -1.5d
		}
		{
			dependencies: ["471A024EBFCA8459", "3B7E2C9A41D06F85"]
			description: [
				"An &6Overwrapped Tank&r is a stainless steel drum wrapped in para-aramid and cured in epoxy, light and very hard to burst. The rocket's fuel tanks are built around them."
			]
			icon: "grindless:composite_overwrapped_tank"
			id: "1F8C57E2A6D40B93"
			rewards: [{ id: "7F1A4D82B0E6C395", type: "xp", xp: 45 }]
