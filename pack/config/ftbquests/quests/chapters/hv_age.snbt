			]
			title: "Space Suit"
			x: 20.0d
			y: -1.5d
		}
		{
			dependencies: ["5C1D3FB96A9FB74A", "4A6E81ABD8026025", "7B21622AADB1E1D1"]
			description: [
				"Motors on the pad, tanks on the motors, the &6Seat&r on top, all in front of the &6Rocket Scanner&r. Right-click the scanner and press Build, and the pile of blocks becomes a rocket."
			]
			icon: "gcyr:rocket_scanner"
			id: "5151DE8D3623EDCF"
			rewards: [{ id: "6C490E4AB37CEB62", type: "xp", xp: 60 }]
