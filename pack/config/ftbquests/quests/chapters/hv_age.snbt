		{
			dependencies: ["5B595A919C80BFC0"]
			description: [
				"The &6Refinery&r takes crude and hydrogen in and gives every fraction out in one pass, desulfurized. GTM's own tower needs four passes and still leaves sulfur in."
				"A programmed circuit picks the job: plain refining, cracking with hydrogen, or cracking with steam into olefins and aromatics."
			]
			icon: "gtceu:refinery"
			id: "5C5D6FB9ECB7BC51"
			rewards: [
				{ id: "012A2C94D6BE9D69", type: "xp", xp: 90 }
