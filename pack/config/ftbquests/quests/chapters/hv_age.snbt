		}
		{
			dependencies: ["471A024EBFCA8459"]
			description: ["Starts the propellant line: coal tar distilled into &6naphthalene&r. Coal tar from the LV coke battery's gas, and a distillery. Phthalic anhydride, the first reagent of the peroxide cycle. Coal tar by pipe off the coke battery, naphthalene on to the reactor, the coke dust to the sinter."]
			icon: "gtceu:naphthalene_bucket"
			id: "5ADAD2566FD74648"
			rewards: [{ id: "3D45B1AC65E4F473", type: "xp", xp: 30 }]
			shape: "hexagon"
			size: 1.0d
