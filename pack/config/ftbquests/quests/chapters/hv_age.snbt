			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["4C18E0B7D5A92F61"]
			description: [
				"Carbon monoxide and steam over the &6Shift Catalyst&r give carbon dioxide and more hydrogen, the hydrogen the refinery and the reformer keep asking for."
				"The catalyst is a mix of magnetite and chromium dust."
			]
			icon: "grindless:shift_catalyst"
			id: "7B52A3F9E0C84D16"
			rewards: [{ id: "19B8F5D3A60E7C42", type: "xp", xp: 35 }]
