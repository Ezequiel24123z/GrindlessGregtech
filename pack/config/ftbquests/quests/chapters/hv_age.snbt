		{
			dependencies: ["5B595A919C80BFC0"]
			description: [
				"Nickel, black bronze and steel melt into &6Black Steel&r in the Kanthal furnace. Rose gold, brass, steel and black steel melt again into &6Red Steel&r. Both cool in a chemical bath."
				"Red steel is what the HV cutter's saw blade is made of."
			]
			icon: "gtceu:red_steel_ingot"
			id: "2EE2A70803F87897"
			rewards: [{ id: "37DF63D19831DAD3", type: "xp", xp: 35 }]
