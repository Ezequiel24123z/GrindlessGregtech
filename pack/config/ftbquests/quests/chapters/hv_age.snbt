			title: "Epoxy and SBR"
			x: 10.0d
			y: -1.5d
		}
		{
			dependencies: ["720331A06D7F2344"]
			description: [
				"The &6Large Chemical Reactor&r takes the PTFE you just made as inert casing and pipe."
				"Naphtha, refinery gas, methanol and acetone cook into raw gasoline, and a splash of toluene finishes it. Gasoline also takes over from creosote in the power plant."
			]
			icon: "gtceu:large_chemical_reactor"
			id: "35719B747A75F7B6"
