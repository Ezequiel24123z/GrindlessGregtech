		}
		{
			dependencies: ["35719B747A75F7B6"]
			description: [
				"The rocket stands on a square of &6Launch Pads&r with a short tower of stainless steel frames. The scanner's EMI page shows where every block goes."
			]
			icon: "gcyr:launch_pad"
			id: "7B21622AADB1E1D1"
