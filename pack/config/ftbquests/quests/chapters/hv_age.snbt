		}
		{
			dependencies: ["1051C4B8835DB4A3", "7267E269B84470FF", "74B6466FA603FC14"]
			description: [
				"Methane and chlorine make chloroform, chloroform and hydrofluoric acid make TFE, and TFE with oxygen makes &6PTFE&r."
				"Cast it into inert casing and large pipe, and the large chemical reactor finally has walls that will not melt."
			]
			icon: "gtceu:inert_machine_casing"
			id: "720331A06D7F2344"
			rewards: [{ id: "2BA86A8E9940CABD", type: "xp", xp: 35 }]
