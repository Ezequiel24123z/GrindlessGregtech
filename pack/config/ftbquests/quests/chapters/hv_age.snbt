		{
			dependencies: ["1051C4B8835DB4A3"]
			description: ["Topaz, lepidolite or bastnasite give up fluorine; mixed with hydrogen in the chemical reactor it becomes hydrofluoric acid - the one ingredient PTFE cannot do without."]
