		}
		{
			dependencies: ["471A024EBFCA8459"]
			description: ["Starts the UDMH branch: chlorine in water gives &6hypochlorous acid&r. Chlorine and water in the large chemical reactor. Monochloramine. The diluted hydrochloric acid goes to the distillery. Chlorine by pipe from the electrolyzer, the dilute acid distilled back to acid."]
			icon: "gtceu:hypochlorous_acid_bucket"
