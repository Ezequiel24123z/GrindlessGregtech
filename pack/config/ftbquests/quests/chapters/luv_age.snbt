			size: 1.25d
			tasks: [{ id: "58C04E5E9D308D22", item: "gtceu:luv_circuit_assembler", type: "item" }]
			title: "LuV Circuit Assembler"
			x: 12.5d
			y: -8.5d
		}
		{
			dependencies: ["158C3F87DFD585EC"]
			description: ["A raw crystal chip is a flawless crystal sliced thin, and baked with a gem plate and helium it becomes the &6Engraved Crystal Chip&r. Raw chips from the Zero-G Crystal Grower, an olivine or emerald plate, helium, and an electric blast furnace. The crystal CPU, and with it the crystal processor and the wetware circuits. The grower runs all day. Send its raw chips to the furnace by ME and stock the result."]
			icon: "gtceu:raw_crystal_chip"
			id: "5303863EE466805C"
			rewards: [{ id: "78E53F8E4EAF7085", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5D004FD3F75B2AF0", item: "gtceu:raw_crystal_chip", type: "item" }
				{ id: "150B5A488630452B", item: "gtceu:engraved_crystal_chip", type: "item" }
			]
			title: "Raw Crystal Chip"
			x: 14.0d
			y: -8.5d
		}
		{
			dependencies: ["5303863EE466805C"]
			description: ["A laser engraver and a lime lens turn the engraved crystal chip into a &6Crystal CPU&r. A cleanroom and a laser engraver. The crystal SoC is a later step that needs ZPM voltage. The crystal processor now, and the wetware circuits after it. A chip in, a CPU out. Let ME feed the engraver."]
			icon: "gtceu:crystal_cpu"
			id: "7B9C044203A16AAC"
			rewards: [{ id: "3E4BC207B021CACD", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "74742A732829DC1F", item: "gtceu:crystal_cpu", type: "item" }]
			title: "Crystal CPU"
			x: 21.5d
			y: -9.5d
		}
		{
			dependencies: ["7B9C044203A16AAC"]
			description: ["The LuV assembler puts crystal CPUs and nano CPU chips together into a &6Crystal Processor&r. A crystal SoC route exists too, at ZPM voltage. Circuit boards, crystal CPUs, nano CPU chips, advanced SMDs and plenty of cables. The crystal assembly, and the LuV machine hulls and components that ask for it. Keep a stock by ME so the component lines never wait."]
			icon: "gtceu:crystal_processor"
			id: "54F8FE564819F368"
			rewards: [{ id: "55272A5600F7FD8B", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7FB1605D05081347", item: "gtceu:crystal_processor", type: "item" }]
			title: "Crystal Processor"
			x: 23.5d
			y: -10.0d
		}
		{
			dependencies: ["54F8FE564819F368"]
			description: ["Processors joined on a bigger board make a &6Crystal Processor Assembly&r, the circuit LuV buildings run on. Several crystal processors for each, so the crystal route is a line, not a trickle. LuV hulls, hatches and the machines you will want at the gate to ZPM. Keep processors flowing from the circuit assembler to a second assembler."]
			icon: "gtceu:crystal_processor_assembly"
			id: "306B27B21FDCCE41"
			rewards: [{ id: "38481AAD1001F508", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "30A9D95AE9039BAA", item: "gtceu:crystal_processor_assembly", type: "item" }]
			title: "Crystal Assembly"
			x: 26.0d
			y: -10.0d
		}
		{
			dependencies: ["7C67E4A7D55ABED5"]
			description: ["A neural organoid grown in orbit, wired and packaged, becomes the &6Neuro Processing Unit&r. Organoids from the lab and LuV power for the assembler. The wetware processor. Nothing else makes an NPU before ZPM. Let ME feed the lab and keep a stock of units."]
			icon: "gtceu:neuro_processing_unit"
			id: "5C9BE8B72273AC40"
			rewards: [{ id: "533716D912213973", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "13094F3926D4B7CF", item: "gtceu:neuro_processing_unit", type: "item" }]
			title: "Neuro Processing Unit"
			x: 25.0d
			y: -6.0d
		}
		{
			dependencies: ["5C9BE8B72273AC40", "7B9C044203A16AAC"]
			description: ["GT--'s circuit assembly line puts NPUs and crystal CPUs together into &6Wetware Processors&r. A whole batch a run on a single LuV energy hatch, and organoids kept alive in between. ZPM goes through these like crisps, so the stock is the real bottleneck. Feed it from AE2 and let it keep a stock."]
			icon: "gtceu:wetware_processor"
			id: "18ABE94D897A9D41"
			rewards: [{ id: "3E1D1D0D9436F09A", type: "xp", xp: 150 }]
