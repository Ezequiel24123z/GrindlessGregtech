		{
			dependencies: ["76E167FD4B94F42F"]
			description: ["Behind a disc flying through orbit, the vacuum is emptier than any chamber you could build. The &6Wake Shield Facility&r grows its wafers there. A disc of Whipple shield casing, so the smelter goes first, and the same sources GregTech's own cleanroom asks for. HPIC and UHPIC wafers with half the source and half the time. Give it germanium and it grows solar wafers too. Let ME fill the sources and carry the wafers to the cleanroom."]
			icon: "gtceu:wake_shield_facility"
			id: "58EFB73E6DD24BDB"
			rewards: [
				{ id: "5917C4380DC0402D", type: "xp", xp: 100 }
				{ count: 4, id: "3AEEC37901F33633", item: "gtceu:indium_gallium_phosphide_dust", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "54780AE195859BCD", item: "gtceu:wake_shield_facility", type: "item" }]
			title: "In the Wake"
			x: 19.5d
			y: -4.5d
		}
		{
			dependencies: ["58EFB73E6DD24BDB"]
			description: ["The &6UHPIC Wafer&r is the purest slice of silicon the pack makes. The wake shield grows it from less naquadah and indium phosphide per wafer than a cleanroom reactor needs, and the ZPM chips will be cut from it."]
			icon: "gtceu:uhpic_wafer"
			id: "5D20D0252114492B"
			rewards: [{ id: "5D2ED935CBC7767E", type: "xp", xp: 80 }]
			tasks: [{ id: "52493E94E20E7A74", item: "gtceu:uhpic_wafer", type: "item" }]
			title: "Cleaner than Clean"
			x: 21.0d
			y: -5.5d
		}
		{
			dependencies: ["58EFB73E6DD24BDB"]
			description: ["Gallium indium phosphide over gallium arsenide over germanium, grown layer by layer in the wake, make a &6Triple-Junction Wafer&r. The Wake Shield Facility and germanium from Io, in a cleanroom. Four triple-junction cells from one wafer, cut by an ordinary cutter. Let ME carry the germanium in and the wafers to the cutter."]
			icon: "grindless:triple_junction_wafer"
			id: "567F7046411B8142"
			rewards: [{ id: "3D03A0C974921AFA", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3FDD82AF1A0CAB94", item: "grindless:triple_junction_wafer", type: "item" }]
			title: "Triple-Junction Wafer"
			x: 21.0d
			y: -3.5d
		}
		{
			dependencies: ["75745AD963ECB5C8"]
			description: ["With nothing stirring the melt, a crystal grows without flaws. The &6Zero-G Crystal Grower&r makes raw crystal chips every time instead of now and then. The same dopant GregTech asks for, and sapphire test masses cut from its own boules. The crystal circuit chain, much faster. The test masses are for later; EMI says what for. One grower, one ME bus for dopant, and the chips arrive on their own."]
			icon: "gtceu:zero_g_crystal_grower"
			id: "18A794C8BAA71D81"
			rewards: [
				{ id: "79A3343DDCAA87FC", type: "xp", xp: 100 }
				{ count: 16, id: "70CB42BE6A87A4A8", item: "gtceu:sapphire_dust", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "36BE5E6C87916B16", item: "gtceu:zero_g_crystal_grower", type: "item" }
				{ id: "5132B223B09F2DD4", item: "grindless:sapphire_test_mass", type: "item" }
			]
			title: "Perfect Crystal"
			x: 15.5d
			y: -3.0d
		}
		{
			dependencies: ["7F943A5682742ECD", "564E7FD4BAE63B55"]
			description: ["The belt's veins answer to one drill: the &6Harpoon Anchor Drill&r, pinned to the rock by harpoons while its HSS-S bit works. Bits and harpoons, which both wear slowly. No drilling fluid: it is vacuum, same as Mercury. Raw meteoric iron and the rest of the belt veins. A lathe and a press keep bits and harpoons in stock by ME."]
			icon: "gtceu:harpoon_anchor_drill"
			id: "7C258E5E568EE8F2"
			rewards: [{ id: "7591EE6013028AF0", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "58ED6E6D577F6699", item: "gtceu:harpoon_anchor_drill", type: "item" }]
			title: "Harpoon"
			x: 13.0d
			y: -2.0d
		}
		{
			dependencies: ["7C258E5E568EE8F2"]
			description: ["The &6HSS-S Drill Bit&r wears down a little with every bore, and the &6Anchor Harpoon&r stays in the rock until you pull it. Keep spares of both."]
			icon: "grindless:hss_s_drill_bit"
			id: "5F2EEA315A9E5CB3"
			rewards: [{ id: "351B287792B112D7", type: "xp", xp: 60 }]
			tasks: [
				{ id: "533C0813A5B92E29", item: "grindless:hss_s_drill_bit", type: "item" }
				{ id: "5792BD7C26385D0D", item: "grindless:anchor_harpoon", type: "item" }
			]
			title: "Bits and Harpoons"
			x: 14.5d
			y: -0.5d
		}
		{
			dependencies: ["5F2EEA315A9E5CB3"]
			description: ["The &6Asteroid Processor&r pulls tetrataenite ore apart by magnet: 16 crushed ore give 12 tetrataenite dust and 4 meteoric iron dust. Circuit 2 and crushed tetrataenite ore from the harpoon drill. The meteoric iron dust is the feed of the Mond line below, which ends in nickel-tungsten tape. Send the meteoric iron dust to the Large Chemical Reactor by ME and the loop closes itself."]
			icon: "gtceu:asteroid_processor"
			id: "5556DFCD2B6DD947"
			rewards: [{ id: "3E232CC68F44C448", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1C58AD65259FF192", item: "gtceu:asteroid_processor", type: "item" }
				{ id: "182FECCDBBCE8FBD", item: "gtceu:tetrataenite_dust", type: "item" }
			]
			title: "Mond"
			x: 16.0d
			y: -1.0d
		}
		{
			dependencies: ["5556DFCD2B6DD947", "564E7FD4BAE63B55"]
			description: ["The &6Rotating Hydroponic Ring&r spins for gravity, keeps the Sun on all the time and seals engineered crops away from the wild. A hub on magnetic bearings of tetrataenite from the processor, wound at the magnet works, and the engineered seeds from home. Neurotrophic factor from the barley and collagen from the tobacco. Neither seed gets eaten. Let ME replant nothing: the ring replants for you. Just drain the factor."]
			icon: "gtceu:hydroponic_ring"
			id: "569ED410C9F7ED07"
			rewards: [
				{ id: "7BBFDF8C1CE6C8A4", type: "xp", xp: 100 }
				{ count: 4, id: "5DFAA661A5D85B49", item: "gtceu:carbon_dioxide_bucket", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3030C275B47F38E4", item: "gtceu:hydroponic_ring", type: "item" }]
			title: "Molecular Farm"
			x: 18.0d
			y: -1.0d
		}
		{
			dependencies: ["7F943A5682742ECD"]
			description: ["&6Magnetic Bearings&r let a shaft turn with nothing touching, so nothing wears. The harpoon drill and the asteroid processor each take two, and the hydroponic ring later turns on them too. Make them at the magnet works."]
			icon: "grindless:magnetic_bearing"
			id: "564E7FD4BAE63B55"
			rewards: [{ id: "7499F9157AFA03AF", type: "xp", xp: 60 }]
			tasks: [{ count: 4L, id: "3AE097BD93E618FF", item: "grindless:magnetic_bearing", type: "item" }]
			title: "Bearings"
			x: 12.0d
			y: -3.5d
		}
		{
			dependencies: ["569ED410C9F7ED07"]
			description: ["In orbit, neurons grow in three dimensions without a scaffold. The &6Organoid Lab&r turns stem cells, growth medium and the ring's neurotrophic factor into a neural organoid. Stem cells from the biofoundry, and factor from the ring. The neuro processing unit, further along. Nothing else makes one before ZPM. Feed the lab by ME and let the organoids go straight to the assembler."]
			icon: "gtceu:organoid_lab"
			id: "7C67E4A7D55ABED5"
			rewards: [{ id: "1AB884D956CE2276", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "10DDD5BEE2DAB461", item: "gtceu:organoid_lab", type: "item" }]
			title: "Organoid"
			x: 23.5d
			y: -0.5d
		}
		{
			dependencies: ["7C67E4A7D55ABED5"]
			description: ["A &6Neural Organoid&r is living tissue wired up in orbit. It is only as good as the factor and medium that fed it, so check them before blaming the lab."]
			icon: "grindless:neural_organoid"
			id: "31DC0512EB49BCD2"
			rewards: [{ id: "32AFFB47DC78AB47", type: "xp", xp: 80 }]
			tasks: [{ id: "52BFDE40294BD2AD", item: "grindless:neural_organoid", type: "item" }]
			title: "Neural Organoid"
			x: 26.0d
			y: -0.5d
		}
		{
			dependencies: ["7F943A5682742ECD"]
			description: ["The &6Optical Miner&r bags crumbly carbon-rich boulders and bakes them with mirrors until water, carbon dioxide and a nitrogen-and-phosphorus extract boil off. Capture bags and the Sun on its receiver, and the Sun is faint out here, hence all the mirrors. Chondritic extract for the algae, water for the belt and, through its second recipe, the processor's carbon monoxide. Capture bags are returned empty. Send them back by ME."]
			icon: "gtceu:optical_miner"
			id: "1997FB952337C741"
			rewards: [{ id: "5908F6DB648D4ECB", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "74AB7FD3082AE1C5", item: "gtceu:optical_miner", type: "item" }
				{ id: "59B83BAC6052A234", item: "grindless:capture_bag", type: "item" }
			]
			title: "Sunlight on a Boulder"
			x: 12.5d
			y: -0.5d
		}
		{
			dependencies: ["715B44AABDAFBFAE"]
			description: ["The &6Fumarole Condenser&r sits over a field of vents and catches what the gas drops as it cools: sulfur dioxide, sulfur and a sublimate with germanium in it. Radiation vault casing round it, and the wireless hatch you brought. Ionian sublimate, the start of the germanium line below, and sulfur concrete, which needs no water. Jovian bases are built from it. Send the gas to the Volcanic Intake next door and ship the rest home."]
			icon: "gtceu:fumarole_condenser"
			id: "3448ADF675EDD8E7"
			rewards: [{ id: "5E7185555C94EB4E", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "73E53DF21AF01002", item: "gtceu:fumarole_condenser", type: "item" }
				{ id: "1BB94300375E1FB2", item: "grindless:ionian_sublimate", type: "item" }
			]
			title: "Fumarole"
			x: 12.0d
			y: 6.0d
		}
		{
			dependencies: ["3448ADF675EDD8E7"]
			description: ["Molten sulfur and Io's own dust cure into &6Sulfur Concrete Casing&r with no water at all, in any mixer. The Cryobot's base is made of it."]
			icon: "grindless:sulfur_concrete_casing"
			id: "3A2EA6FB4BE8146C"
			rewards: [{ id: "1482D2D6190D1BF3", type: "xp", xp: 60 }]
			tasks: [{ id: "18BAC72C410A3967", item: "grindless:sulfur_concrete_casing", type: "item" }]
			title: "Sulfur Concrete"
			x: 13.5d
			y: 6.5d
		}
		{
			dependencies: ["3A2EA6FB4BE8146C"]
			description: ["The &6Volcanic Intake&r stands on a patera's magma and runs sulfur dioxide through turbines, and the power goes home through the network. Its sulfur dioxide charge, which comes from the condenser next door, and heat exchanger bundles. Power that burns nothing. The bundles erode in hot sulfur and need replacing. Keep spare bundles in an ME chest on Io."]
			icon: "gtceu:volcanic_intake"
			id: "5BC4BFE9A199F5A1"
			rewards: [{ id: "100219E1DF0F24EC", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3163F820D8C80CCC", item: "gtceu:volcanic_intake", type: "item" }]
			title: "Patera"
			x: 15.0d
			y: 6.0d
		}
		{
			dependencies: ["5BC4BFE9A199F5A1"]
			description: ["A &6Heat Exchanger Bundle&r erodes in hot sulfur, a little with every cycle. Swap it before it fails, not after."]
			icon: "grindless:heat_exchanger_bundle"
			id: "36BD92C7A422CBA5"
			rewards: [{ id: "5AC06151D98E379C", type: "xp", xp: 60 }]
			tasks: [{ id: "586B1A6F21D5F992", item: "grindless:heat_exchanger_bundle", type: "item" }]
			title: "Exchanger Bundle"
			x: 16.5d
			y: 6.0d
		}
		{
			dependencies: ["36BD92C7A422CBA5"]
			description: ["Io orbits inside a ring of plasma that turns with Jupiter, much faster than Io moves. The &6Flux-Tube Tether&r hangs a wire into it from a second station and collects the current. Tether spools and a breath of Mars argon. No ground and no fuel. Power for the fusion ring, from a station in Io orbit. Spools wear out; keep them stocked by ME on the station."]
			icon: "gtceu:flux_tube_tether"
			id: "122BA3AB5BF6C0A8"
			rewards: [{ id: "15051E358546738E", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "544731B00313C131", item: "gtceu:flux_tube_tether", type: "item" }
				{ id: "375C9CA3408AF5A4", item: "grindless:tether_spool", type: "item" }
			]
			title: "Riding the Torus"
			x: 18.0d
			y: 6.5d
		}
		{
			dependencies: ["122BA3AB5BF6C0A8"]
			description: ["GregTech's &6Fusion Reactor Mk1&r, built round your own HTS coils. Plenty of LuV energy hatches: every hatch adds to the buffer that pays for a start, and europium needs a big start. Europium, and calcium plasma from magnesium and oxygen as its power recipe. The old transmutations that faked osmium and uranium are gone. Hydrogen from the iodine loop or a tank farm, and let ME carry the output."]
			icon: "gtceu:luv_fusion_reactor"
			id: "543F014BB97A45F4"
			rewards: [{ id: "533D64890831EDCA", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "325918310E498A2C", item: "gtceu:luv_fusion_reactor", type: "item" }
				{ count: 4L, id: "5A26D33DF72BC1E3", item: "gtceu:superconducting_coil", type: "item" }
			]
			title: "Fusion"
			x: 18.5d
			y: 8.0d
		}
		{
			dependencies: ["34BE2C5053E7572B"]
			description: ["The &6Cryobot&r melts its way down through the ice, paying out its tether as it sinks. A base of sulfur concrete, and probes to send down. A living ocean sample, and after that brine by the tank. Probes are single use. Keep them stocked by ME."]
			icon: "gtceu:cryobot"
			id: "377C157965B3A560"
			rewards: [{ id: "77BA838176319E5B", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "74A8951E8BD752F4", item: "gtceu:cryobot", type: "item" }
				{ id: "1E0E10CDA6C87AA0", item: "grindless:cryobot_probe", type: "item" }
			]
			title: "Cryobot"
			x: 16.5d
			y: 4.0d
		}
		{
			dependencies: ["377C157965B3A560"]
			description: ["Brine, hydrogen, peroxide and chondritic extract feed the ocean sample in the &6Algae Bioreactor&r, and out come bacteria. The sample from the Cryobot, and the belt's chondritic extract. The only living matter in the pack. The bioreactor refuses to void it. So should you. Every culture is a seed for the next; keep one back."]
			icon: "gtceu:algae_bioreactor"
			id: "5B8B17CDA9D43E9A"
			rewards: [{ id: "345A0915E28B4D98", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3CF3D8F95F3BA36A", item: "gtceu:algae_bioreactor", type: "item" }]
			title: "Something Alive"
			x: 18.5d
			y: 4.5d
		}
		{
			dependencies: ["107CFEA9014148F1"]
			description: ["The &6Gravitational-Wave Detector&r is an L of vacuum tubes buried in packed or blue ice, with your sapphire test masses for mirrors. IV's Sagittarius A* signal in its bus, where it stays. Plain ice won't do for the cover; it melts. A long observing run writes the catalogue: two black holes merging, heard as a rising chirp. Copy the catalogue with a data orb and let ME stock the masses."]
			icon: "gtceu:gravitational_wave_detector"
			id: "35A1D103C253B975"
			rewards: [{ id: "1DFB91A920604CAE", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "71F3EFA8ECC8E395", item: "gtceu:gravitational_wave_detector", type: "item" }
				{ count: 4L, id: "3EE1921ACF052EFF", item: "grindless:sapphire_test_mass", type: "item" }
			]
			title: "Chirp"
			x: 15.5d
			y: 7.5d
		}
		{
			dependencies: ["107CFEA9014148F1"]
			description: ["Out here mercury barium calcium cuprate superconducts on its own, so the magnet works' coils need no cryostat. String them into the barrel of the &6Coilgun Probe Launcher&r. Coilgun coil casing, wound at the magnet works, and a probe to fire. Probes off the moon with no rocket at all: the gas giant and the flyby both start here. Let ME load probes and keep the coil casing in stock."]
			icon: "gtceu:coilgun_launcher"
			id: "1770E32F925B4E73"
			rewards: [{ id: "58DCBF0F3BEC2E99", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7CFFD5635721B996", item: "gtceu:coilgun_launcher", type: "item" }]
			title: "Coilgun"
			x: 16.0d
			y: 11.5d
		}
		{
			dependencies: ["1770E32F925B4E73"]
			description: ["Each &6Coilgun Coil Casing&r is a ring of superconducting winding, and the barrel is a long row of them. Build it long enough, because speed is length."]
			icon: "grindless:coilgun_coil_casing"
			id: "31355CAB056CC9DC"
			rewards: [{ id: "71C6D9F29001B328", type: "xp", xp: 80 }]
			tasks: [{ id: "333DDF3EF5D13E7A", item: "grindless:coilgun_coil_casing", type: "item" }]
			title: "Barrel Casing"
			x: 18.0d
			y: 12.0d
		}
		{
			dependencies: ["3C825200F07FFF67"]
			description: ["Enriched naquadah becomes long rods for GT--'s &6Naquadah Reactor III&r, the fuel-burning half of LuV power. A spent rod isn't rubbish: macerate it and send the dust back to the plant's spent-fuel recipe, which squeezes some enriched naquadah back out. Not all of it, sadly."]
			icon: "gtnn:luv_naquadah_reactor"
			id: "3D5EC5039EBDE967"
			rewards: [{ id: "56651F15A5E42E03", type: "xp", xp: 80 }]
			tasks: [
				{ id: "3B8544C7C67CEA61", item: "gtnn:luv_naquadah_reactor", type: "item" }
				{ id: "3AF3F461B1F975EC", item: "gtceu:long_enriched_naquadah_rod", type: "item" }
			]
			title: "Reactor III"
			x: 4.5d
			y: 8.0d
		}
		{
			dependencies: ["3D5EC5039EBDE967"]
			description: ["The &6LuV Parallel Hatch&r fits the same slot as the IV one in every plant of ours, the naquadah plant included. Each copy still pays its own power, so it's your energy hatches that decide how many really run, and multi-amp hatches lift that cap."]
			icon: "gtceu:luv_parallel_hatch"
			id: "548A6D01CD361BD3"
			optional: true
			rewards: [{ id: "5120C35F3DE3D903", type: "xp", xp: 60 }]
			size: 0.75d
			tasks: [{ id: "305D8E0FD477DA5A", item: "gtceu:luv_parallel_hatch", type: "item" }]
			title: "Sixteen at Once"
			x: 6.0d
			y: 9.5d
		}
		{
			dependencies: ["1F4E8B2F7895A2B7"]
			description: ["The &6Mega Chemical Complex&r joins whole lines into one recipe: PTFE, epoxy and para-aramid each go from raw inputs to finished product without a single hand-off. The Coil Chemical Plants you built at HV go into it. Plastics and epoxy in bulk, which the magnet works and the cables both want. One ME input bus per raw material and the line runs itself."]
			icon: "gtceu:mega_chemical_complex"
			id: "3A90AC0F5D813B89"
			rewards: [
				{ id: "3F7E7EBCE074DC44", type: "xp", xp: 100 }
				{ count: 8, id: "5FF60EBA8289D2D2", item: "gtceu:polytetrafluoroethylene_ingot", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5FC8A4EEE57F6C4A", item: "gtceu:mega_chemical_complex", type: "item" }]
			title: "Chemical Complex"
			x: 8.5d
			y: -3.0d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: [
				"Each moon gets its own quantum bridge, paired with its quantum seed: the belt, Io, Europa and Ganymede all reach your home network. Keep one ring and one link at home for each."
				"Anything on those worlds can then ship by ME, the same as on the Moon."
			]
			icon: "ae2:quantum_link"
			id: "191B4A3DE689D533"
			rewards: [{ id: "7C92722390C1C2A6", type: "xp", xp: 100 }]
			tasks: [
				{ id: "349F5CD610B0E514", item: "ae2:quantum_link", type: "item" }
				{ id: "5BB51E88EF20D89A", item: "ae2:quantum_ring", type: "item" }
			]
			title: "The Bridge Reaches Out"
			x: 10.5d
			y: 2.0d
		}
		{
			dependencies: ["31DC0512EB49BCD2"]
			description: ["Carbon monoxide carries iron and nickel away from 16 crushed meteoric iron ore as a crude carbonyl gas. It leaves 20 iron dust, 1 cobalt dust and 1 platinum-metal concentrate behind. Crushed meteoric iron ore and carbon monoxide in the &6Large Chemical Reactor&r. Crude metal carbonyl, and the concentrate that feeds the platinum-group line. Feed the ore by ME and loop the carbon monoxide the next steps return."]
			icon: "gtceu:large_chemical_reactor"
