			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3163F820D8C80CCC", item: "gtceu:volcanic_intake", type: "item" }
				{ id: "59F1E1E7501F3521", item: "grindless:heat_exchanger_bundle", type: "item" }
			]
			title: "Patera"
			x: 18.0d
			y: 0.0d
		}
		{
			dependencies: ["5BC4BFE9A199F5A1"]
			description: ["Io orbits inside a ring of plasma that turns with Jupiter, much faster than Io moves. The &6Flux-Tube Tether&r hangs a wire into it from a second station and collects the current. No ground and no fuel, only spools and a breath of Mars argon."]
			icon: "gtceu:flux_tube_tether"
			id: "122BA3AB5BF6C0A8"
			rewards: [{ id: "15051E358546738E", type: "xp", xp: 120 }]
