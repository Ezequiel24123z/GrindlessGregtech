		{
			dependencies: ["7A00F7E4F256E45A"]
			description: ["The &6LuV Circuit Assembler&r builds the crystal circuits, which the IV one cannot. LuV components for its hull, and a cleanroom you already run for the IV line. The crystal chain, and through it the wetware chain that follows. Boards and chips come from the cleanroom by ME; keep a stock of the circuits it returns."]
			icon: "gtceu:luv_circuit_assembler"
			id: "158C3F87DFD585EC"
			rewards: [{ id: "370DF43C3E310D8E", type: "xp", xp: 60 }]
