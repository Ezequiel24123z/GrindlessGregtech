		{
			dependencies: ["34BE2C5053E7572B", "3448ADF675EDD8E7"]
			description: ["The &6Cryobot&r melts its way down through the ice, paying out its tether as it sinks. A probe brings back a living ocean sample; after that it just pumps brine. Its base is sulfur concrete, so Io comes first."]
			icon: "gtceu:cryobot"
			id: "377C157965B3A560"
			rewards: [{ id: "77BA838176319E5B", type: "xp", xp: 100 }]
