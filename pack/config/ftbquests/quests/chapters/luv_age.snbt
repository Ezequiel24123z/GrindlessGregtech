				{ id: "3AF3F461B1F975EC", item: "gtceu:long_enriched_naquadah_rod", type: "item" }
			]
			title: "Reactor III"
			x: 4.0d
			y: -4.5d
		}
		{
			dependencies: ["3C825200F07FFF67"]
			description: ["The &6LuV Parallel Hatch&r fits the same slot as the IV one in every plant of ours, the naquadah plant included. Each copy still pays its own power, so it's your energy hatches that decide how many really run, and multi-amp hatches lift that cap."]
			icon: "gtceu:luv_parallel_hatch"
			id: "548A6D01CD361BD3"
			optional: true
			rewards: [{ id: "5120C35F3DE3D903", type: "xp", xp: 60 }]
			size: 0.75d
			tasks: [{ id: "305D8E0FD477DA5A", item: "gtceu:luv_parallel_hatch", type: "item" }]
			title: "Sixteen at Once"
			x: 6.0d
			y: -3.0d
		}
		{
			dependencies: ["7A00F7E4F256E45A"]
			description: [
				"Every hot ingot in the vacuum freezer throws half its liquid helium away. The &6Helium Refrigerator&r keeps a helium charge in its own hatch and only tops it up, with liquid nitrogen doing the precooling."
				"The nitrogen leaves as gas: send it back to the Moon's cryogenic plant."
			]
			icon: "gtceu:helium_refrigerator"
			id: "1368397CE117ECD1"
			rewards: [
				{ id: "51143C2CFF164BCA", type: "xp", xp: 80 }
				{ count: 4, id: "32DEC6633BEFD989", item: "gtceu:liquid_nitrogen_bucket", type: "item" }
