				{ id: "504DAA691395A4F7", item: "gtceu:bacteria_bucket", type: "item" }
			]
			title: "Something Alive"
			x: 18.0d
			y: 1.5d
		}
		{
			dependencies: ["5B8B17CDA9D43E9A"]
			description: ["Back home the biofoundry finally has bacteria: sludge, mutagen, sterile growth medium and then &6Stem Cells&r, grown on osmiridium. The sludge they hand back goes round again."]
			icon: "gtceu:stem_cells"
			id: "712723D264B9CFED"
			rewards: [{ id: "59FA66D25D123051", type: "xp", xp: 80 }]
