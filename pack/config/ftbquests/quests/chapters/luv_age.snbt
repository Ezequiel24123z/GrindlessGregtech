			]
			title: "Living Circuits"
			x: 26.5d
			y: -8.5d
		}
		{
			dependencies: ["18ABE94D897A9D41"]
			description: ["Wetware processors on a bigger board make the &6Wetware Processor Assembly&r. Several processors for each. The tissue has to stay fed the whole way. The ZPM machine hull, and the machines that lean on it. Keep it in a dedicated ME stock chest; ZPM draws it by the stack."]
			icon: "gtceu:wetware_processor_assembly"
			id: "746C525E14815182"
			rewards: [{ id: "7AF03D1B9546A63F", type: "xp", xp: 150 }]
