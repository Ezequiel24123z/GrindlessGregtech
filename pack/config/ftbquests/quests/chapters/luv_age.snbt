			]
			title: "Star Metal"
			x: 20.0d
			y: -1.5d
		}
		{
			dependencies: ["7F943A5682742ECD"]
			description: [
				"The &6Optical Miner&r bags crumbly carbon-rich boulders and bakes them with mirrors until water, carbon dioxide and a nitrogen-and-phosphorus extract boil off. It only runs with the Sun on its receiver, and the Sun is faint out here, hence all the mirrors."
				"Its second recipe turns the carbon dioxide into the processor's CO."
			]
			icon: "gtceu:optical_miner"
			id: "1997FB952337C741"
			rewards: [
				{ id: "5908F6DB648D4ECB", type: "xp", xp: 100 }
				{ id: "7F1DFD24E69DF9E1", item: "grindless:capture_bag", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "74AB7FD3082AE1C5", item: "gtceu:optical_miner", type: "item" }
				{ id: "59B83BAC6052A234", item: "grindless:capture_bag", type: "item" }
				{ id: "59A164CB7238DA1B", item: "grindless:chondritic_extract", type: "item" }
			]
			title: "Sunlight on a Boulder"
			x: 16.0d
			y: -3.0d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: [
				"Io sits in Jupiter's radiation, and electronics there die young. Every machine on Io, on Europa and in Io's orbit carries &6Radiation Vault Casing&r: titanium, then tantalum, like Juno's vault. You'll be fine in the suit. The machines won't."
				"Brimstone dug on the spot makes the Ionian quantum seed."
			]
			icon: "grindless:radiation_vault_casing"
			id: "715B44AABDAFBFAE"
			rewards: [{ id: "3DA7D8892E1D521C", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:io", id: "13DE7A438FBEB6E4", type: "dimension" }
				{ id: "33A90E532642E87C", item: "grindless:radiation_vault_casing", type: "item" }
				{ id: "5F57B491BBE90BD8", item: "grindless:ionian_quantum_seed", type: "item" }
			]
			title: "Behind the Vault"
			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["715B44AABDAFBFAE"]
			description: [
				"The &6Fumarole Condenser&r sits over a field of vents and catches what the gas drops as it cools: sulfur dioxide, sulfur, and a sublimate with germanium and indium in it. It's the only germanium before ZPM, and it runs on the wireless hatch you brought."
				"It also casts sulfur concrete, which needs no water. Jovian bases are built from it."
			]
			icon: "gtceu:fumarole_condenser"
			id: "3448ADF675EDD8E7"
			rewards: [{ id: "5E7185555C94EB4E", type: "xp", xp: 100 }]
