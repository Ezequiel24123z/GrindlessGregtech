			title: "Level Four"
			x: 12.0d
			y: 0.0d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: ["A floor of rubble with boulders hanging over it, and metal that fell out of the sky. Raw meteoric iron dug on the spot goes into the &6Asteroid Quantum Seed&r, made there in a chemical reactor, and the AE2 bridge reaches the belt."]
			icon: "grindless:asteroid_quantum_seed"
			id: "7F943A5682742ECD"
			rewards: [{ id: "71DC0E5A054576F9", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:asteroid_belt", id: "5E812785C237D80A", type: "dimension" }
