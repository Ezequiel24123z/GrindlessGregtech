		}
		{
			dependencies: ["7C258E5E568EE8F2"]
			description: [
				"The &6Asteroid Processor&r runs the Mond process: carbon monoxide carries the iron and nickel away as gas and leaves the platinum metals behind as a concentrate. The CO stays in the machine. The concentrate exists nowhere else, so the processor won't void it."
				"It also pulls tetrataenite apart by magnet, and the meteoric iron dust that leaves goes back through Mond."
			]
			icon: "gtceu:asteroid_processor"
			id: "5556DFCD2B6DD947"
			rewards: [
				{ id: "3E232CC68F44C448", type: "xp", xp: 100 }
				{ count: 2, id: "162392BFEE00E911", item: "gtceu:carbon_monoxide_bucket", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1C58AD65259FF192", item: "gtceu:asteroid_processor", type: "item" }
				{ id: "3D07002F8CFDE71B", item: "grindless:asteroid_pgm_concentrate", type: "item" }
			]
			title: "Mond"
			x: 18.0d
			y: -1.5d
		}
		{
			dependencies: ["5556DFCD2B6DD947"]
			description: ["The platinum plant's fourth mode dissolves the asteroid concentrate into iridium, osmium and a sludge its old recipes already split into platinum, palladium, rhodium and ruthenium. All six in bulk, in roughly a meteorite's proportions, and Mercury gets a rest."]
			icon: "gtceu:platinum_group_sludge_dust"
			id: "183EF636D72AFDB0"
			rewards: [{ id: "572A6CDC0E710590", type: "xp", xp: 80 }]
