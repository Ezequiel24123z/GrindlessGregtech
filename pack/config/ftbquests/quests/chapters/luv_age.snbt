				{ id: "375C9CA3408AF5A4", item: "grindless:tether_spool", type: "item" }
			]
			title: "Riding the Torus"
			x: 20.0d
			y: 0.0d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: ["Europa is a shell of ice over an ocean nobody has ever seen. Blue ice dug on the spot makes the &6Europan Quantum Seed&r, and the AE2 bridge reaches the lid of that ocean."]
			icon: "grindless:europan_quantum_seed"
			id: "34BE2C5053E7572B"
			rewards: [{ id: "7448F9FA44C24D3F", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:europa", id: "3E538642FDC95BAC", type: "dimension" }
				{ id: "184431EA1D1B59C8", item: "grindless:europan_quantum_seed", type: "item" }
			]
			title: "Under the Ice"
			x: 14.0d
			y: 1.5d
		}
		{
			dependencies: ["34BE2C5053E7572B", "3448ADF675EDD8E7"]
			description: ["The &6Cryobot&r melts its way down through the ice, paying out its tether as it sinks. A probe brings back a living ocean sample; after that it just pumps brine. Its base is sulfur concrete, so Io comes first."]
			icon: "gtceu:cryobot"
			id: "377C157965B3A560"
			rewards: [{ id: "77BA838176319E5B", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "74A8951E8BD752F4", item: "gtceu:cryobot", type: "item" }
				{ id: "1E0E10CDA6C87AA0", item: "grindless:cryobot_probe", type: "item" }
				{ id: "74D51A33A3CCF12C", item: "grindless:europan_ocean_sample", type: "item" }
			]
			title: "Cryobot"
			x: 16.0d
			y: 1.5d
		}
		{
			dependencies: ["377C157965B3A560"]
			description: ["Brine, hydrogen, peroxide and the belt's chondritic extract feed the ocean sample in the &6Algae Bioreactor&r, and out come bacteria: the only living matter in the pack. The bioreactor refuses to void them. So should you."]
			icon: "gtceu:algae_bioreactor"
			id: "5B8B17CDA9D43E9A"
			rewards: [{ id: "345A0915E28B4D98", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3CF3D8F95F3BA36A", item: "gtceu:algae_bioreactor", type: "item" }
				{ id: "504DAA691395A4F7", item: "gtceu:bacteria_bucket", type: "item" }
			]
			title: "Something Alive"
			x: 18.0d
			y: 1.5d
		}
		{
			dependencies: ["5B8B17CDA9D43E9A"]
			description: ["Back home the biofoundry finally has bacteria: sludge, mutagen, sterile growth medium and then &6Stem Cells&r, grown on osmiridium. The sludge they hand back goes round again."]
			icon: "gtceu:stem_cells"
			id: "712723D264B9CFED"
			rewards: [{ id: "59FA66D25D123051", type: "xp", xp: 80 }]
			tasks: [
				{ id: "5A326A8E662615C4", item: "gtceu:sterilized_growth_medium_bucket", type: "item" }
				{ id: "5D19036714D06F1A", item: "gtceu:stem_cells", type: "item" }
			]
			title: "Stem Cells"
			x: 20.0d
			y: 1.5d
		}
		{
			dependencies: ["712723D264B9CFED"]
			description: ["In orbit, neurons grow in three dimensions without a scaffold. The &6Organoid Lab&r turns stem cells, growth medium and the ring's neurotrophic factor into a neural organoid, and that into a neuro processing unit at LuV power. Nothing else makes an NPU before ZPM."]
			icon: "gtceu:organoid_lab"
			id: "7C67E4A7D55ABED5"
			rewards: [{ id: "1AB884D956CE2276", type: "xp", xp: 120 }]
