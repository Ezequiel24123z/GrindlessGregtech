				{ id: "189C96108F1E755D", item: "gtceu:osmiridium_dust", type: "item" }
				{ id: "3B154EF1E4EABDD9", item: "gtceu:indium_tin_barium_titanium_cuprate_dust", type: "item" }
			]
			title: "Osmiridium"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["1F4E8B2F7895A2B7"]
			description: [
				"The &6Coated Conductor Line&r rolls nickel and Mars tungsten into a textured tape, then lays a film of ITBTC on it with a laser, oxygen and a silver cap. No ultra-hot EBF, no helium, and a fraction of the superconductor a cast wire eats."
				"The tape can't be melted back down, so make what you need."
			]
			icon: "gtceu:coated_conductor_line"
			id: "3A6139E43FC0C489"
			rewards: [
				{ id: "15BD08175D0C400B", type: "xp", xp: 80 }
				{ count: 16, id: "362792BD9DE36BAA", item: "gtceu:nickel_dust", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "120E1B3D50FBF348", item: "gtceu:coated_conductor_line", type: "item" }
				{ id: "17BFE170BAC0727E", item: "grindless:nickel_tungsten_tape", type: "item" }
				{ id: "59EA04A9BECA7F7A", item: "grindless:itbtc_coated_conductor", type: "item" }
			]
			title: "Tape"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["3A6139E43FC0C489", "7585FE5E7EF942A7"]
			description: [
				"The &6HTS Magnet Works&r winds tape round a mandrel, soaks it in epoxy and tests it cold before anything leaves the building. Its superconducting coil needs a sliver of the trinium GregTech's own coil asks for, and that's what makes a fusion ring affordable at LuV."
				"It also winds the network cells, coilgun coils and magnetic bearings."
			]
			icon: "gtceu:hts_magnet_works"
			id: "38F8454E1AEB4E72"
			rewards: [
				{ id: "1E5784757E175F5D", type: "xp", xp: 120 }
				{ count: 2, id: "7C80948DC6AE621F", item: "gtceu:epoxy_bucket", type: "item" }
			]
			shape: "gear"
			size: 1.5d
			tasks: [
				{ id: "5D111C4051210281", item: "gtceu:hts_magnet_works", type: "item" }
				{ id: "1A82B4FDD8759FA8", item: "gtceu:superconducting_coil", type: "item" }
			]
			title: "Winding"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["38F8454E1AEB4E72"]
			description: [
				"A &6LuV SMES Cell&r keeps its energy in a superconducting coil's field. The bank only hands out LuV once every formed tower holds LuV cells, so swap them all: one forgotten tower in the corner holds the whole network back."
				"Until then, two IV wireless hatches on a multiblock still reach LuV."
			]
			icon: "grindless:luv_smes_cell"
			id: "5933ADF51C8949BD"
			rewards: [{ id: "7376D9A25EC1B869", type: "xp", xp: 120 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [
				{ id: "58A6EF8140058C59", item: "grindless:luv_smes_cell", type: "item" }
				{ id: "19853885579FA26A", item: "gtceu:luv_wireless_energy_hatch", type: "item" }
			]
			title: "The Network Goes LuV"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["5586C75CAAF00986"]
			description: ["Trinium and enriched naquadah won't melt in anything short of an EBF wound with &6Naquadah Coil&r. Rewind your hottest one. Yes, it's another trip to the EBF."]
			icon: "gtceu:naquadah_coil_block"
			id: "3C1FA59D132F0415"
			rewards: [{ id: "72CF95D1EBBEDFD9", type: "xp", xp: 60 }]
