			tasks: [{ id: "55AB18DEB93C02CE", item: "gtceu:data_orb", type: "item" }]
			title: "First Research Orb"
			x: 23.5d
			y: -8.0d
		}
		{
			dependencies: ["306B27B21FDCCE41"]
			description: ["The &6QuarkTech Suit&r holds 100M EU. A charged chestplate flies like creative: 2,500 EU/t while flying, nothing on the ground, about 33 minutes per charge. Assembler recipes. The chestplate takes LuV circuits, a lapotronic orb, IV emitters and a field generator. Flight on your own power. The advanced chestplate (ZPM circuit) adds the jetpack. Recharge in a charger or battery buffer."]
			icon: "gtceu:quarktech_chestplate"
			id: "72AC733EAB629896"
			rewards: [{ id: "72C28BA0994435DA", type: "xp", xp: 200 }]
