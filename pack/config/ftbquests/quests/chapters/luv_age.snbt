			shape: "gear"
			size: 1.25d
			tasks: [{ id: "1C61E246579AA5DD", item: "gtceu:helium_refrigerator", type: "item" }]
			title: "Closed Loop"
			x: 4.0d
			y: 1.5d
		}
		{
			dependencies: ["7A00F7E4F256E45A"]
			description: [
				"GregTech's sterile chain normally waits for a ZPM cleanroom. The &6Biofoundry&r is a sealed hall with an airlock and a UV ceiling, and it runs the whole chain at LuV, starting from your creature simulators' meat and bone."
				"Collagen, gelatin and agar need nothing alive. Everything after them needs bacteria, and Earth hasn't got any you can use."
			]
			icon: "gtceu:biofoundry"
			id: "3B64E8E2A5FD37A0"
			rewards: [
				{ id: "3ABC85FC87C82788", type: "xp", xp: 80 }
				{ count: 16, id: "33AF14918A101674", item: "minecraft:bone", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5DA2D5A6129F14AA", item: "gtceu:biofoundry", type: "item" }
				{ id: "5110D841416DB276", item: "gtceu:gelatin_dust", type: "item" }
				{ id: "588877DE57E0E365", item: "gtceu:agar_dust", type: "item" }
			]
			title: "Biofoundry"
			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["3B64E8E2A5FD37A0"]
			description: ["Bacteria carry new genes into ordinary seeds: barley that makes a nerve growth factor and tobacco that makes human collagen. Real farms do both. Keep the &6Engineered Barley Seed&r and its tobacco cousin; the ring in orbit replants them instead of eating them."]
			icon: "grindless:engineered_barley_seed"
			id: "5FCC962F33654DD9"
