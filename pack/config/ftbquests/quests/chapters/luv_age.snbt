	quests: [
		{
			dependencies: ["5586C75CAAF00986"]
			description: ["The road of the era, from the first step to the gate that leads on. Everything else here hangs from it."]
			icon: "minecraft:writable_book"
			id: "726BAACB5415C46F"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "3410274FC8720EF1", type: "checkmark" }]
			title: "The Journey"
			x: 2.5d
			y: -1.0d
		}
		{
			dependencies: ["77B4DDD47050E3C7"]
			description: [
				"The interferometer's chart shows the asteroid belt and Jupiter's big moons: cold, dark and a very long way from a wall socket. Out there is metal that fell from the sky, a volcano that powers a grid, and the only living thing in the pack."
				"The trip is this page. The halls you build along the way are in LuV: Machines, and the circuits in LuV: Circuits."
			]
			icon: "grindless:outer_system_chart"
			id: "5586C75CAAF00986"
			rewards: [{ id: "1CAF15ECCC694E44", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "1239DDDDCFBAA5CF", type: "checkmark" }]
			title: "The Outer System"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["5586C75CAAF00986"]
			description: ["The IV assembly line makes the LuV parts, fed from AE2 as before. Motors, pumps, sensors and emitters turn up in nearly every controller from here on, so set the line to keep a stock instead of making them one at a time."]
			icon: "gtceu:luv_electric_motor"
			id: "7A00F7E4F256E45A"
			rewards: [{ id: "7751BF66383AED82", type: "xp", xp: 60 }]
			tasks: [
				{ id: "3BAA2A50A2257827", item: "gtceu:luv_electric_motor", type: "item" }
				{ id: "3503416D76C90302", item: "gtceu:luv_electric_pump", type: "item" }
				{ id: "7F8C12C2994413F2", item: "gtceu:luv_sensor", type: "item" }
				{ id: "33AB9D7B06E61892", item: "gtceu:luv_emitter", type: "item" }
			]
			title: "LuV Components"
			x: 4.0d
			y: -4.0d
		}
		{
			dependencies: ["7A00F7E4F256E45A"]
			description: ["The LuV mixer stirs Mercury's iridium and osmium into &6Osmiridium&r, and the same mixer makes the ITBTC dust your superconducting tape is coated with. Like every first machine of a tier, it lives on a transformer for a while."]
			icon: "gtceu:osmiridium_ingot"
			id: "1F4E8B2F7895A2B7"
			rewards: [
				{ id: "5DC9BC1101CC8C62", type: "xp", xp: 60 }
				{ count: 4, id: "759592C13A73CB28", item: "gtceu:indium_dust", type: "item" }
			]
			tasks: [
				{ id: "7B0EF99FA70E149A", item: "gtceu:luv_mixer", type: "item" }
				{ id: "189C96108F1E755D", item: "gtceu:osmiridium_dust", type: "item" }
				{ id: "3B154EF1E4EABDD9", item: "gtceu:indium_tin_barium_titanium_cuprate_dust", type: "item" }
			]
			title: "Osmiridium"
			x: 6.0d
			y: -1.0d
		}
		{
			dependencies: ["5586C75CAAF00986"]
			description: ["Trinium and enriched naquadah won't melt in anything short of an EBF wound with &6Naquadah Coil&r. Rewind your hottest one. Yes, it's another trip to the EBF."]
			icon: "gtceu:naquadah_coil_block"
			id: "3C1FA59D132F0415"
			rewards: [{ id: "72CF95D1EBBEDFD9", type: "xp", xp: 60 }]
			tasks: [{ count: 16L, id: "72FF5E49579EDFF4", item: "gtceu:naquadah_coil_block", type: "item" }]
			title: "Naquadah Coil"
			x: 1.5d
			y: 3.0d
		}
		{
			dependencies: ["5586C75CAAF00986"]
			description: [
				"The naquadah plant learns a second mode: GT--'s enriched line, but the xenon, gold, antimony and catalyst stay inside as charges instead of going down the drain. Fluorine and hydrogen are what it actually eats."
				"Out come &6Enriched Naquadah Sulfate&r, trinium sulfide and a little impure naquadria solution. Keep the naquadria in a tank; ZPM wants it, and it's not something you leave in a chest."
			]
			icon: "gtceu:enriched_naquadah_sulfate_dust"
			id: "3C825200F07FFF67"
			rewards: [
				{ id: "37F836E9B8027721", type: "xp", xp: 80 }
				{ count: 2, id: "5ECEA61EE502F5A9", item: "gtceu:fluorine_bucket", type: "item" }
			]
			tasks: [
				{ id: "7268148B419C05F0", item: "gtceu:enriched_naquadah_oxide_mixture_dust", type: "item" }
				{ id: "712CFD327EA24EF3", item: "gtceu:enriched_naquadah_sulfate_dust", type: "item" }
				{ id: "5DA0A72B5D2026F5", item: "gtceu:trinium_sulfide_dust", type: "item" }
			]
			title: "Full Recovery"
			x: 1.5d
			y: 6.0d
		}
		{
			dependencies: ["3C1FA59D132F0415", "3C825200F07FFF67"]
			description: ["Trinium sulfide and zinc go into the naquadah-coil EBF and come out as a hot ingot. &6Trinium&r is the wall GregTech builds in front of fusion, and this pack lowers it instead of knocking it down: the magnet works needs far less of it than you fear."]
			icon: "gtceu:trinium_ingot"
			id: "7585FE5E7EF942A7"
			rewards: [
				{ id: "561D5773DBE4EAF2", type: "xp", xp: 80 }
				{ count: 4, id: "19BEBC57E9C982BC", item: "gtceu:zinc_dust", type: "item" }
			]
			tasks: [
				{ id: "1279EE6E3E035D74", item: "gtceu:hot_trinium_ingot", type: "item" }
				{ id: "5DA8897D462037B9", item: "gtceu:trinium_ingot", type: "item" }
			]
			title: "Trinium"
			x: 3.0d
			y: 4.5d
		}
		{
			dependencies: ["7A00F7E4F256E45A"]
			description: ["Bacteria carry new genes into ordinary seeds: barley that makes a nerve growth factor and tobacco that makes human collagen. Real farms do both. Keep the &6Engineered Barley Seed&r and its tobacco cousin; the ring in orbit replants them instead of eating them."]
			icon: "grindless:engineered_barley_seed"
			id: "5FCC962F33654DD9"
			rewards: [{ id: "53372771066B5E95", type: "xp", xp: 60 }]
			tasks: [
				{ id: "16FD9A34CED29720", item: "grindless:engineered_barley_seed", type: "item" }
				{ id: "589D3D2B241295C7", item: "grindless:engineered_tobacco_seed", type: "item" }
			]
			title: "Engineered Seeds"
			x: 7.0d
			y: -4.5d
		}
		{
			dependencies: ["5FCC962F33654DD9"]
			description: ["&6Neurotrophic Factor&r is what the barley makes in the hydroponic ring: a protein that tells nerve cells to grow and stay. It is the one ingredient the organoid lab can't do without, so never let the ring run dry."]
			icon: "grindless:neurotrophic_factor"
			id: "50070CE845E22A79"
			rewards: [{ id: "7A73E76857B93545", type: "xp", xp: 80 }]
			tasks: [{ id: "1738F695393D03D5", item: "grindless:neurotrophic_factor", type: "item" }]
			title: "Nerve Growth"
			x: 9.5d
			y: -5.5d
		}
		{
			dependencies: ["1F4E8B2F7895A2B7", "3F76BCDB3BBA8FA4"]
			description: [
				"GCYR's &6Space Station Packager&r folds a whole station into one package small enough for a rocket. Pack it at home, fly it to Earth orbit and open it there; the GregTech machines go in once you've arrived."
				"Everything up there draws from the wireless network, which is why the network came first."
			]
			icon: "gcyr:space_station_packager"
			id: "531171ADA3A1A60B"
			rewards: [{ id: "705E817367653C3C", type: "xp", xp: 80 }]
			tasks: [
				{ id: "7378F46BB42CBD46", item: "gcyr:space_station_packager", type: "item" }
				{ id: "10E8129E34FC8F81", item: "gcyr:space_station_package", type: "item" }
			]
			title: "Packed and Launched"
			x: 10.5d
			y: -3.0d
		}
		{
			dependencies: ["531171ADA3A1A60B"]
			description: [
				"Earth orbit: no air, no night, and the coldest shade you'll ever stand in. Chunk-load the station, or its machines stop the moment you fly home."
				"The halls that belong up here are in LuV: Machines."
			]
			icon: "grindless:station_truss_casing"
			id: "75745AD963ECB5C8"
			rewards: [{ id: "349D03BE358D5C31", type: "xp", xp: 100 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ dimension: "gcyr:overworld_orbit", id: "5CA94CD95613248B", type: "dimension" }]
			title: "First Station"
			x: 12.0d
			y: -5.0d
		}
		{
			dependencies: ["1F4E8B2F7895A2B7", "5933ADF51C8949BD"]
			description: ["Elite motors and cryogenic fuel tanks make a level 4 rocket, and that reaches past Mars. Pack a landing kit every time: wireless energy covers and hatches, a couple of RTG cells in case, and a waystone."]
			icon: "grindless:cryogenic_fuel_tank"
			id: "3F76BCDB3BBA8FA4"
			rewards: [{ id: "1D93CCAEA2F82407", type: "xp", xp: 100 }]
			tasks: [
				{ id: "7BF94F974769F8AE", item: "grindless:cryogenic_fuel_tank", type: "item" }
				{ id: "7B25961FF0DB443E", item: "gcyr:elite_rocket_motor", type: "item" }
			]
			title: "Level Four"
			x: 9.0d
			y: 4.5d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: ["An &6RTG Cell&r keeps a landing kit running when the Sun is faint and the wireless link drops. Past Mars there is no air for ordinary fuel, so pack a spare for every world you visit."]
			icon: "gtceu:ev_rtg"
			id: "10F783A41A37140A"
			rewards: [{ id: "7549970953447ACA", type: "xp", xp: 60 }]
			tasks: [{ id: "781408D3633C64FB", item: "gtceu:ev_rtg", type: "item" }]
			title: "Packed for the Trip"
			x: 13.0d
			y: 4.5d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: ["A floor of rubble with boulders hanging over it, and metal that fell out of the sky. Raw meteoric iron goes into the &6Asteroid Quantum Seed&r in a chemical reactor, wherever you like, and that seed pairs the AE2 bridge that reaches the belt."]
			icon: "grindless:asteroid_quantum_seed"
			id: "7F943A5682742ECD"
			rewards: [{ id: "71DC0E5A054576F9", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:asteroid_belt", id: "5E812785C237D80A", type: "dimension" }
				{ id: "745CAB3FA6553E84", item: "grindless:asteroid_quantum_seed", type: "item" }
			]
			title: "The Belt"
			x: 10.5d
			y: 0.0d
		}
		{
			dependencies: ["7F943A5682742ECD"]
			description: ["&6Raw Meteoric Iron&r is nickel-rich and shaped by space, nothing like what's under your feet at home. The harpoon drill digs it by the stack, and the Mond process takes it from there."]
			icon: "gtceu:raw_meteoric_iron"
			id: "301E06D85F0DE23D"
			rewards: [{ id: "7BE67C3D9D21BE63", type: "xp", xp: 80 }]
			tasks: [{ id: "3965AFE24D12B6EB", item: "gtceu:raw_meteoric_iron", type: "item" }]
			title: "Fallen Metal"
			x: 12.0d
			y: 2.5d
		}
		{
			dependencies: ["7F943A5682742ECD"]
			description: ["&6Chondritic Extract&r is what the optical miner boils off a carbon-rich boulder: nitrogen, phosphorus and a bit of everything else the algae like. It's the belt's gift to the algae bioreactor."]
			icon: "grindless:chondritic_extract"
			id: "7888A1BCA05B3EC4"
			rewards: [{ id: "764638D7AA385F6A", type: "xp", xp: 80 }]
			tasks: [{ id: "39D263B92B23834B", item: "grindless:chondritic_extract", type: "item" }]
			title: "Chondrite Extract"
			x: 12.0d
			y: 1.0d
		}
		{
			dependencies: ["301E06D85F0DE23D"]
			description: ["The Mond process leaves the &6Asteroid PGM Concentrate&r behind: platinum metals in a meteorite's own proportions. It exists nowhere else in the pack, so keep it out of the void."]
			icon: "grindless:asteroid_pgm_concentrate"
			id: "179CEFF2065CBEA6"
			rewards: [{ id: "17CBF6E1F1A200CB", type: "xp", xp: 80 }]
			tasks: [{ id: "17E0C4E41057B88E", item: "grindless:asteroid_pgm_concentrate", type: "item" }]
			title: "Platinum Concentrate"
			x: 14.5d
			y: 1.0d
		}
		{
			dependencies: ["179CEFF2065CBEA6"]
			description: ["The platinum plant's fourth mode dissolves the asteroid concentrate into iridium, osmium and a sludge its old recipes already split into platinum, palladium, rhodium and ruthenium. All six in bulk, in roughly a meteorite's proportions, and Mercury gets a rest."]
			icon: "gtceu:platinum_group_sludge_dust"
			id: "183EF636D72AFDB0"
			rewards: [{ id: "572A6CDC0E710590", type: "xp", xp: 80 }]
			tasks: [
				{ id: "175830D12A4E604F", item: "gtceu:platinum_group_sludge_dust", type: "item" }
				{ id: "79C8BDF2C9AAB82A", item: "gtceu:iridium_dust", type: "item" }
				{ id: "5702C3DEC232D0CE", item: "gtceu:osmium_dust", type: "item" }
			]
			title: "Star Metal"
			x: 16.5d
			y: 0.5d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: [
				"Io sits in Jupiter's radiation, and electronics there die young. Every machine on Io, on Europa and in Io's orbit carries &6Radiation Vault Casing&r: titanium, then tantalum, like Juno's vault. You'll be fine in the suit. The machines won't."
				"Brimstone makes the Ionian quantum seed, in any chemical reactor."
			]
			icon: "grindless:radiation_vault_casing"
			id: "715B44AABDAFBFAE"
			rewards: [{ id: "3DA7D8892E1D521C", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:io", id: "13DE7A438FBEB6E4", type: "dimension" }
				{ id: "33A90E532642E87C", item: "grindless:radiation_vault_casing", type: "item" }
				{ id: "5F57B491BBE90BD8", item: "grindless:ionian_quantum_seed", type: "item" }
			]
			title: "Behind the Vault"
			x: 10.5d
			y: 5.0d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: ["Europa is a shell of ice over an ocean nobody has ever seen. Blue ice makes the &6Europan Quantum Seed&r in any chemical reactor, and the AE2 bridge it pairs reaches the lid of that ocean."]
			icon: "grindless:europan_quantum_seed"
			id: "34BE2C5053E7572B"
			rewards: [{ id: "7448F9FA44C24D3F", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:europa", id: "3E538642FDC95BAC", type: "dimension" }
				{ id: "184431EA1D1B59C8", item: "grindless:europan_quantum_seed", type: "item" }
			]
			title: "Under the Ice"
			x: 13.5d
			y: 3.0d
		}
		{
			dependencies: ["34BE2C5053E7572B"]
			description: ["The Cryobot's probe brings back the &6Europan Ocean Sample&r in a sealed vial. It is alive, there is only one, and everything bacterial in the pack begins with it. Don't spill it."]
			icon: "grindless:europan_ocean_sample"
			id: "7BF594268BCC2525"
			rewards: [{ id: "1FB7A6474A2D9696", type: "xp", xp: 100 }]
			tasks: [{ id: "1EC6026EB8882626", item: "grindless:europan_ocean_sample", type: "item" }]
			title: "A Sample of the Ocean"
			x: 16.5d
			y: 2.5d
		}
		{
			dependencies: ["7BF594268BCC2525"]
			description: ["The algae bioreactor turns the ocean sample, brine and the belt's extract into &6Bacteria&r: the only living matter in the pack. The bioreactor refuses to void it. So should you."]
			icon: "gtceu:bacteria_bucket"
			id: "517CCA12C8426216"
			rewards: [{ id: "3D9267795784235E", type: "xp", xp: 150 }]
			tasks: [{ id: "5CDAE726DA5ADDC7", item: "gtceu:bacteria_bucket", type: "item" }]
			title: "Bacteria"
			x: 18.0d
			y: 2.5d
		}
		{
			dependencies: ["517CCA12C8426216"]
			description: ["Back home the biofoundry finally has bacteria: sludge, mutagen, sterile growth medium and then &6Stem Cells&r, grown on osmiridium. The sludge they hand back goes round again."]
			icon: "gtceu:stem_cells"
			id: "712723D264B9CFED"
			rewards: [{ id: "59FA66D25D123051", type: "xp", xp: 80 }]
			tasks: [
				{ id: "5A326A8E662615C4", item: "gtceu:sterilized_growth_medium_bucket", type: "item" }
				{ id: "5D19036714D06F1A", item: "gtceu:stem_cells", type: "item" }
			]
			title: "Stem Cells"
			x: 20.5d
			y: 3.0d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: ["Ganymede has no quakes, its own magnetic field and ice deep enough to bury things in. It's also cold enough that an old HV superconductor works with no cryostat at all. Tuff makes the &6Ganymedean Quantum Seed&r in any chemical reactor."]
			icon: "grindless:ganymedean_quantum_seed"
			id: "107CFEA9014148F1"
			rewards: [{ id: "32DD58871C20FC1C", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:ganymede", id: "7E8439248B8F49D4", type: "dimension" }
				{ id: "74CC3480CC1F869D", item: "grindless:ganymedean_quantum_seed", type: "item" }
			]
			title: "Quiet Moon"
			x: 13.5d
			y: 9.5d
		}
		{
			dependencies: ["107CFEA9014148F1"]
			description: ["IV's &6Sagittarius A* Signal&r is the one thing you bring to the detector rather than make there. It stays in the bus for the whole run, so carry a spare."]
			icon: "grindless:sagittarius_a_star_signal"
			id: "74719BF24DB19C4D"
			rewards: [{ id: "7EB8A82D48B2E53C", type: "xp", xp: 80 }]
			tasks: [{ id: "355396B7DD702D1F", item: "grindless:sagittarius_a_star_signal", type: "item" }]
			title: "The Signal You Carried"
			x: 15.5d
			y: 10.0d
		}
		{
			dependencies: ["107CFEA9014148F1"]
			description: ["A long run at the detector writes the &6Gravitational-Wave Catalogue&r: two black holes merging, heard as a rising chirp. Copy it with a data orb, because the next era wants it and the detector keeps the original."]
			icon: "grindless:gravitational_wave_catalogue"
			id: "14F6B755A607E1AA"
			rewards: [{ id: "3C657DAA11D3E220", type: "xp", xp: 150 }]
			tasks: [{ id: "1CA3787D4DE22F7C", item: "grindless:gravitational_wave_catalogue", type: "item" }]
			title: "The Catalogue"
			x: 17.0d
			y: 8.5d
		}
		{
			dependencies: ["74719BF24DB19C4D"]
			description: ["A probe with a heat shield falls into Jupiter and radios back hydrogen, helium and helium-3 until it stops. Keep the &6Jovian Atmosphere Survey&r: nobody mines a gas giant by hand."]
			icon: "grindless:jovian_atmosphere_survey"
			id: "73EC7C3865D51181"
			rewards: [{ id: "11D8C52CBA144494", type: "xp", xp: 100 }]
			tasks: [
				{ id: "1C39812ADAE7682B", item: "grindless:jupiter_entry_probe", type: "item" }
				{ id: "10CB344F57ED24DD", item: "grindless:jovian_atmosphere_survey", type: "item" }
			]
			title: "Into the Clouds"
			x: 17.5d
			y: 10.0d
		}
		{
			dependencies: ["73EC7C3865D51181"]
			description: ["The flyby probe swings round Jupiter the way Pioneer and the Voyagers did and keeps going. It takes its time reporting back, and what it sends is the &6Saturn Transfer Chart&r: where you're going next, and this time you won't land. Copy it with a data orb and keep it for ZPM."]
			icon: "grindless:saturn_transfer_chart"
			id: "5D5C7D4E5CD14993"
			rewards: [{ id: "56772B69ED46FC07", type: "xp", xp: 150 }]
			tasks: [
				{ id: "7E4C01233284E5DA", item: "grindless:saturn_flyby_probe", type: "item" }
				{ id: "7D51527A02473581", item: "grindless:saturn_transfer_chart", type: "item" }
			]
			title: "Slingshot"
			x: 20.0d
			y: 10.5d
		}
		{
			dependencies: ["543F014BB97A45F4"]
			description: ["Mars's neodymium and plain hydrogen go in, &6Europium&r comes out. For now this fusion route is the way to make it. It leaves the ring as a very hot liquid, not a plasma, so pipe it accordingly. A metallothermic reduction in ZPM makes it from oxide later. The ZPM motor wants a lot of it as fine wire."]
			icon: "gtceu:europium_ingot"
			id: "1531C1737C6BE31B"
			rewards: [{ id: "78D7DB85185F24E8", type: "xp", xp: 100 }]
			tasks: [{ id: "3FA5997B75AD7194", item: "gtceu:europium_ingot", type: "item" }]
			title: "Europium"
			x: 20.5d
