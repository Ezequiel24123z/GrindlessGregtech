				{ id: "1483D95C2A357591", item: "gtceu:wetware_processor", type: "item" }
			]
			title: "Living Circuits"
			x: 24.0d
			y: 1.5d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: ["Ganymede has no quakes, its own magnetic field and ice deep enough to bury things in. It's also cold enough that an old HV superconductor works with no cryostat at all. Tuff dug on the spot makes the &6Ganymedean Quantum Seed&r."]
			icon: "grindless:ganymedean_quantum_seed"
			id: "107CFEA9014148F1"
			rewards: [{ id: "32DD58871C20FC1C", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:ganymede", id: "7E8439248B8F49D4", type: "dimension" }
				{ id: "74CC3480CC1F869D", item: "grindless:ganymedean_quantum_seed", type: "item" }
			]
			title: "Quiet Moon"
			x: 14.0d
			y: 3.0d
		}
		{
			dependencies: ["107CFEA9014148F1"]
			description: [
				"The &6Gravitational-Wave Detector&r is an L of vacuum tubes buried in packed or blue ice, with your sapphire test masses for mirrors. Put IV's Sagittarius A* signal in its bus, where it stays, and a long observing run writes the catalogue: two black holes merging, heard as a rising chirp."
				"Copy the catalogue with a data orb. Plain ice won't do for the cover; it melts."
			]
			icon: "gtceu:gravitational_wave_detector"
			id: "35A1D103C253B975"
			rewards: [
				{ id: "1DFB91A920604CAE", type: "xp", xp: 150 }
				{ count: 2, id: "11C25DDFC0BBB9AC", item: "gtceu:data_orb", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "71F3EFA8ECC8E395", item: "gtceu:gravitational_wave_detector", type: "item" }
				{ count: 4L, id: "3EE1921ACF052EFF", item: "grindless:sapphire_test_mass", type: "item" }
				{ id: "50B13639D0F432D9", item: "grindless:sagittarius_a_star_signal", type: "item" }
				{ id: "50424BD829866BAB", item: "grindless:gravitational_wave_catalogue", type: "item" }
			]
			title: "Chirp"
			x: 16.0d
			y: 3.0d
		}
		{
			dependencies: ["107CFEA9014148F1"]
			description: ["Out here mercury barium calcium cuprate superconducts on its own, so the magnet works' coils need no cryostat. String them into the barrel of the &6Coilgun Probe Launcher&r and throw probes off the moon with no rocket at all."]
			icon: "gtceu:coilgun_launcher"
			id: "1770E32F925B4E73"
			rewards: [{ id: "58DCBF0F3BEC2E99", type: "xp", xp: 120 }]
			shape: "gear"
