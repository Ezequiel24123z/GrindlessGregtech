		}
		{
			dependencies: ["7F943A5682742ECD"]
			description: ["The belt's veins answer to one drill: the &6Harpoon Anchor Drill&r, pinned to the rock by harpoons while its HSS-S bit works. Bits and harpoons both wear slowly. No drilling fluid, it's vacuum, same as Mercury."]
			icon: "gtceu:harpoon_anchor_drill"
			id: "7C258E5E568EE8F2"
			rewards: [
				{ id: "7591EE6013028AF0", type: "xp", xp: 100 }
