				{ id: "59B83BAC6052A234", item: "grindless:capture_bag", type: "item" }
				{ id: "59A164CB7238DA1B", item: "grindless:chondritic_extract", type: "item" }
			]
			title: "Sunlight on a Boulder"
			x: 16.0d
			y: -3.0d
		}
		{
			dependencies: ["5556DFCD2B6DD947"]
			description: [
				"The &6Rotating Hydroponic Ring&r spins for gravity, keeps the Sun on all the time and seals engineered crops away from the wild. The barley makes neurotrophic factor, the tobacco plant collagen, and neither seed gets eaten."
				"Its hub turns on magnetic bearings: tetrataenite from the processor, wound at the magnet works."
			]
			icon: "gtceu:hydroponic_ring"
			id: "569ED410C9F7ED07"
			rewards: [
				{ id: "7BBFDF8C1CE6C8A4", type: "xp", xp: 100 }
				{ count: 4, id: "5DFAA661A5D85B49", item: "gtceu:carbon_dioxide_bucket", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3030C275B47F38E4", item: "gtceu:hydroponic_ring", type: "item" }
				{ count: 4L, id: "52A3F55D50675212", item: "grindless:magnetic_bearing", type: "item" }
				{ id: "78575D16E11B112E", item: "grindless:neurotrophic_factor", type: "item" }
			]
			title: "Molecular Farm"
			x: 20.0d
			y: -3.0d
		}
		{
			dependencies: ["3F76BCDB3BBA8FA4"]
			description: [
				"Io sits in Jupiter's radiation, and electronics there die young. Every machine on Io, on Europa and in Io's orbit carries &6Radiation Vault Casing&r: titanium, then tantalum, like Juno's vault. You'll be fine in the suit. The machines won't."
				"Brimstone dug on the spot makes the Ionian quantum seed."
			]
			icon: "grindless:radiation_vault_casing"
			id: "715B44AABDAFBFAE"
			rewards: [{ id: "3DA7D8892E1D521C", type: "xp", xp: 100 }]
			tasks: [
				{ dimension: "grindless:io", id: "13DE7A438FBEB6E4", type: "dimension" }
				{ id: "33A90E532642E87C", item: "grindless:radiation_vault_casing", type: "item" }
				{ id: "5F57B491BBE90BD8", item: "grindless:ionian_quantum_seed", type: "item" }
			]
			title: "Behind the Vault"
			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["715B44AABDAFBFAE"]
			description: [
				"The &6Fumarole Condenser&r sits over a field of vents and catches what the gas drops as it cools: sulfur dioxide, sulfur, and a sublimate with germanium and indium in it. It's the only germanium before ZPM, and it runs on the wireless hatch you brought."
				"It also casts sulfur concrete, which needs no water. Jovian bases are built from it."
			]
			icon: "gtceu:fumarole_condenser"
			id: "3448ADF675EDD8E7"
			rewards: [{ id: "5E7185555C94EB4E", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "73E53DF21AF01002", item: "gtceu:fumarole_condenser", type: "item" }
				{ id: "599598C93A3EBE41", item: "gtceu:germanium_dust", type: "item" }
				{ id: "33E6398ECA3341A7", item: "grindless:sulfur_concrete_casing", type: "item" }
			]
			title: "Fumarole"
			x: 16.0d
			y: 0.0d
		}
		{
			dependencies: ["3448ADF675EDD8E7"]
			description: [
				"The &6Volcanic Intake&r stands on a patera's magma and runs sulfur dioxide through turbines, and the power goes home through the network. It burns nothing, but the exchanger bundles erode in hot sulfur and need replacing."
				"Its sulfur dioxide charge comes from the condenser next door."
			]
			icon: "gtceu:volcanic_intake"
			id: "5BC4BFE9A199F5A1"
			rewards: [
				{ id: "100219E1DF0F24EC", type: "xp", xp: 120 }
