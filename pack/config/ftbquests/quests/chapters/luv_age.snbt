		}
		{
			dependencies: ["3504AC546284B5BC"]
			description: ["A blank &6Data Orb&r is the storage the bank and the research station both need. Circuit assembler work with epoxy boards, circuits, RAM and platinum wire. The data bank, and later the orb that research is written onto. Keep a stock of blank orbs on the network."]
			icon: "gtceu:data_orb"
			id: "346720E37C5EF08F"
			rewards: [{ id: "1A67335F924FA7B2", type: "xp", xp: 60 }]
