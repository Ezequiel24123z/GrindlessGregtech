				{ id: "12E541587221B51A", item: "gtceu:neuro_processing_unit", type: "item" }
			]
			title: "Organoid"
			x: 22.0d
			y: 1.5d
		}
		{
			dependencies: ["7C67E4A7D55ABED5"]
			description: ["GT--'s circuit assembly line puts NPUs and crystal CPUs together into &6Wetware Processors&r, a whole batch a run on a single LuV energy hatch. Feed it from AE2 and let it keep a stock. ZPM goes through these like crisps."]
			icon: "gtceu:wetware_processor"
			id: "18ABE94D897A9D41"
			rewards: [{ id: "3E1D1D0D9436F09A", type: "xp", xp: 150 }]
