		{
			dependencies: ["38F8454E1AEB4E72"]
			description: ["The &6Mega Chemical Complex&r joins whole lines into one recipe: PTFE, epoxy and para-aramid each go from raw inputs to finished product without a single hand-off. The Coil Chemical Plants you built at HV go into it."]
			icon: "gtceu:mega_chemical_complex"
			id: "3A90AC0F5D813B89"
