		{
			dependencies: ["5586C75CAAF00986"]
			description: ["The wafers, chips and circuits of the era, from the first assembler to the mainframe, and the parts built from them."]
			icon: "minecraft:writable_book"
			id: "5B911D9F5DFB4F50"
