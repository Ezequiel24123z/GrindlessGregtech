			]
			title: "Into the Clouds"
			x: 18.0d
			y: 4.5d
		}
		{
			dependencies: ["1770E32F925B4E73"]
			description: ["The flyby probe swings round Jupiter the way Pioneer and the Voyagers did and keeps going. It takes its time reporting back, and what it sends is the &6Saturn Transfer Chart&r: where you're going next, and this time you won't land. Copy it with a data orb and keep it for ZPM."]
			icon: "grindless:saturn_transfer_chart"
