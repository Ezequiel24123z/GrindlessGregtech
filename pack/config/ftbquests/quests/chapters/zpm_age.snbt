			title: "ZPM Circuit Assembler"
			x: 5.5d
			y: -10.5d
		}
		{
			dependencies: ["7A980F3B74DBF079"]
			description: ["Crystal processor assemblies on a larger board make       the &6Crystal Processor Computer&r, a ZPM-tier circuit that the LuV assembler builds. Several crystal assemblies for each and a LuV circuit assembler or assembly line. The ZPM assembler is not needed. ZPM hulls and the controllers of this era that ask for a circuit. Crystal assemblies come from the LuV line by ME; let the LuV assembler draw them on demand."]
			icon: "gtceu:crystal_processor_computer"
			id: "1D98852F1AB675C2"
			rewards: [{ id: "17A9CB0334DE9233", type: "xp", xp: 120 }]
