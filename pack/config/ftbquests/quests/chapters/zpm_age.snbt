				{ id: "7A0241581441211F", item: "grindless:neptune_flyby_probe", type: "item" }
			]
			title: "Past Neptune"
			x: 27.0d
			y: 8.0d
		}
		{
			dependencies: ["1CDA67742969FBD5"]
			description: ["The &6Deep Space Network&r decodes what the probes send home. Its controller, the recordings and the &6Multimessenger Catalogue&r it makes. Flyby data, and the target list the Kuiper telescope uses. Feed recordings by ME; the network works without being watched."]
			icon: "gtceu:deep_space_network"
			id: "7566E1539187E10C"
			rewards: [{ id: "5C52F543E5E004D8", type: "xp", xp: 120 }]
