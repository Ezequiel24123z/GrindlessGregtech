				{ id: "7730CDADD3FF58B1", item: "grindless:neptune_flyby_data", type: "item" }
			]
			title: "Listening"
			x: 7.0d
			y: 14.0d
		}
		{
			dependencies: ["7566E1539187E10C"]
			description: ["The &6Kuiper Survey Telescope&r sees the small icy worlds beyond Neptune. Its controller, in Earth orbit, and the target list it produces. The Pluto-Kuiper Chart the next era starts from. It surveys all by itself; collect the chart when it is done."]
			icon: "gtceu:kuiper_survey_telescope"
			id: "32E94420EE8BE7BD"
			rewards: [{ id: "129A569BC5DC3F78", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "74C272BB5D402E36", item: "gtceu:kuiper_survey_telescope", type: "item" }
				{ id: "17C82639B2CFDCBA", item: "grindless:kuiper_target_list", type: "item" }
				{ id: "137288F6B23DA8B4", item: "grindless:pluto_kuiper_chart", type: "item" }
			]
			title: "Kuiper Targets"
			x: 9.5d
			y: 14.0d
		}
		{
			dependencies: ["1CDA67742969FBD5"]
			description: ["&6Tritanium&r is the first UV metal, made here early. Titanium and duranium fuse into it in the Mk2 reactor, so the Second Ring must be running with plenty of hatches. It unlocks darmstadtium, the assembly hall and the UV machine hulls. Feed the reactor by tank and pipe and pull the ingots by ME."]
			icon: "gtceu:tritanium_ingot"
			id: "7431D3D54AC9A142"
			rewards: [{ id: "53F5634B3871D39B", type: "xp", xp: 100 }]
			tasks: [{ id: "555E766B6667FAE3", item: "gtceu:tritanium_ingot", type: "item" }]
			title: "Tritanium"
			x: 7.5d
			y: 12.0d
		}
		{
			dependencies: ["7431D3D54AC9A142"]
			description: ["&6Darmstadtium&r is another UV metal you will need early. Arsenic and ruthenium fuse into it in the same Mk2 reactor, after tritanium. It unlocks the assembly hall and the metal parts of UV machines. Keep both feeds on tanks and send the ingots on by ME."]
			icon: "gtceu:darmstadtium_ingot"
			id: "3D0152B3D0D3DF99"
			rewards: [{ id: "7B5469AAD4B33388", type: "xp", xp: 100 }]
			tasks: [{ id: "186EABC836236E71", item: "gtceu:darmstadtium_ingot", type: "item" }]
			title: "Darmstadtium"
			x: 9.0d
			y: 12.5d
		}
		{
			dependencies: ["3D0152B3D0D3DF99"]
			description: ["The &6Assembly Hall&r runs assembler and circuit assembler recipes in parallel. Its controller, in a cleanroom; the circuit assembler recipes want molten tin on top. Mass production of the machines of this era. Feed it by ME and let the hall fill the output chests."]
			icon: "gtceu:assembly_hall"
			id: "7B30871B5D49A6B3"
			rewards: [{ id: "590A13406BA7CC08", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "313A1AFECD42BE67", item: "gtceu:assembly_hall", type: "item" }]
			title: "Assembly Hall"
			x: 11.0d
			y: 12.0d
		}
		{
			dependencies: ["1FBBE9E843BE90C3"]
			description: ["Europium chloride solution comes from the monazite froth and the SEG split. In the &6Europium Reductor&r, zinc, sulfuric acid and a little mercury reduce it to &6europium sulfate&r; the zinc sulfate and the leftover rare-earth solution go back to the extraction line. Pipe the solution in and stock the dust by ME."]
			icon: "gtceu:europium_sulfate_dust"
			id: "71B90D2208631C14"
			rewards: [{ id: "399B836B6CF3F78D", type: "xp", xp: 40 }]
			tasks: [{ id: "524245778E984D08", item: "gtceu:europium_sulfate_dust", type: "item" }]
			title: "Europium Sulfate"
			x: 20.5d
			y: 28.5d
		}
		{
			dependencies: ["71B90D2208631C14"]
			description: ["Roast the sulfate with oxygen and you get &6europium oxide&r and sulfur trioxide, which belongs in your sulfuric acid line. A final metallothermic reduction with lanthanum turns the oxide into metal. Nothing here is gathered by hand: every feed comes from a line you already run."]
			icon: "gtceu:europium_oxide_dust"
			id: "37A0E614C82EFFB9"
			rewards: [{ id: "5910E5D193C5E6A6", type: "xp", xp: 50 }]
			tasks: [
				{ id: "189339CE96641695", item: "gtceu:europium_oxide_dust", type: "item" }
				{ id: "3378EA1200584BCA", item: "gtceu:lanthanum_oxide_dust", type: "item" }
			]
			title: "Europium Oxide"
			x: 22.5d
			y: 28.5d
		}
		{
			dependencies: ["3691190A2A0269EB"]
			description: ["Naquadria is no longer a single step. The impure solution from the refinery is fluorinated into &6hexafluoride naquadria solution&r, then reacts with radon difluoride into &6radon naquadria octafluoride&r. Keep fluorine and radon on tanks; the residue solution is a byproduct, not waste."]
			icon: "gtceu:hexafluoride_naquadria_solution_bucket"
			id: "35A6C4E9C3CFB355"
			rewards: [{ id: "599A845D6CD45172", type: "xp", xp: 50 }]
			tasks: [
				{ id: "3285C236A843B4B5", item: "gtceu:impure_naquadria_solution_bucket", type: "item" }
				{ id: "5E8C80CD97F1DA7C", item: "gtceu:hexafluoride_naquadria_solution_bucket", type: "item" }
				{ id: "36FBCC76558B49C4", item: "gtceu:radon_naquadria_octafluoride_bucket", type: "item" }
			]
			title: "Naquadria, Stage One"
			x: 20.5d
			y: 24.0d
		}
		{
			dependencies: ["35A6C4E9C3CFB355"]
			description: ["The octafluoride becomes &6naquadria caesium xenonnonfluoride&r, and a second reaction frees nitryl fluoride and leaves &6naquadria caesium fluoride&r. Caesium and xenon cycle through this line, so build it as a loop and never as a one-way chain."]
			icon: "gtceu:naquadria_caesiumfluoride_bucket"
			id: "35005A1D26C980E3"
			rewards: [{ id: "54D1797FFA5272EB", type: "xp", xp: 60 }]
			tasks: [
				{ id: "3AD0308075576EE9", item: "gtceu:naquadria_caesium_xenonnonfluoride_bucket", type: "item" }
				{ id: "3780F4BF71B2A447", item: "gtceu:naquadria_caesiumfluoride_bucket", type: "item" }
			]
			title: "Naquadria, Stage Two"
			x: 22.5d
			y: 24.0d
		}
		{
			dependencies: ["35005A1D26C980E3"]
			description: ["Mix the caesium fluoride with sulfuric acid, then irradiate the &6acidic naquadria caesium fluoride&r in a neutron activator. Out come &6naquadria sulfate&r, caesium and fluorine: the caesium and fluorine return to the line."]
			icon: "gtceu:naquadria_sulfate_dust"
			id: "1FB1EF38D2A7B01B"
			rewards: [{ id: "169A851F862E0BB5", type: "xp", xp: 70 }]
			tasks: [
				{ id: "5F2AE8C305228E17", item: "gtceu:acidic_naquadria_caesiumfluoride_bucket", type: "item" }
				{ id: "32FEDF57AF21C08F", item: "gtceu:naquadria_sulfate_dust", type: "item" }
			]
			title: "Naquadria Sulfate"
			x: 24.5d
			y: 24.0d
		}
		{
			dependencies: ["1FB1EF38D2A7B01B"]
			description: ["The smelting complex reduces naquadria sulfate with hydrogen under liquid helium into a &6naquadria ingot&r, and returns the sulfuric acid. This is the slow, expensive route to the best fuel the era has: automate it once and let it run."]
			icon: "gtceu:naquadria_ingot"
			id: "1EEA7DBBF9379A7E"
			rewards: [{ id: "753CFC63EA24B919", type: "xp", xp: 80 }]
			tasks: [{ id: "5B0B26026E705D9E", item: "gtceu:naquadria_ingot", type: "item" }]
			title: "Naquadria Ingot"
			x: 26.5d
			y: 24.0d
		}
		{
			dependencies: ["35A6C4E9C3CFB355"]
			description: ["The residue solution from stage one is not thrown away: an electric blast furnace turns it into &6naquadria solution&r again and hands back indium phosphide as a byproduct. Pipe the solution back to the head of the line."]
			icon: "gtceu:naquadria_residue_solution_bucket"
			id: "551F1781195249BC"
			rewards: [{ id: "7FF99BC77F3D0D82", type: "xp", xp: 40 }]
			tasks: [
				{ id: "13FA422907DBA3DE", item: "gtceu:naquadria_residue_solution_bucket", type: "item" }
				{ id: "1F85086027366DAD", item: "gtceu:naquadria_solution_bucket", type: "item" }
			]
			title: "Residue Loop"
			x: 20.5d
			y: 25.5d
		}
		{
			dependencies: ["551F1781195249BC"]
			description: ["The plants burn &6excited&r naquadah fuel. When it is spent it returns as &6depleted fuel&r, which the Fuel Works processes into xenon, naquadah and europium dust. Close the loop with pipes so that nothing is ever dumped."]
			icon: "gtceu:naquadah_based_liquid_fuel_excited_bucket"
			id: "1FBBE9E843BE90C3"
			rewards: [{ id: "544A33F4DFB66D67", type: "xp", xp: 50 }]
			tasks: [
				{ id: "1A56265544515F12", item: "gtceu:naquadah_based_liquid_fuel_excited_bucket", type: "item" }
				{ id: "7B221A84F21398FA", item: "gtceu:naquadah_based_liquid_fuel_depleted_bucket", type: "item" }
			]
			title: "Excited Fuel"
			x: 20.5d
			y: 27.0d
		}
		{
			dependencies: ["71B90D2208631C14"]
			description: ["The Waste Retrieval Plant takes radioactive waste with nitric acid and yields &6radium&r, synroc, actinide raffinate and nitrogen dioxide. Send the raffinate to the partitioning plant, which splits the minor actinide strip into americium and curium oxide."]
			icon: "gtceu:radium_dust"
			id: "5649518F6FC2B6AC"
			rewards: [{ id: "7EFD187D496DED11", type: "xp", xp: 50 }]
