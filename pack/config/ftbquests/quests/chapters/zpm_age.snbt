			y: 3.0d
		}
		{
			dependencies: ["53764AAB65F5DEA2"]
			description: ["Uranus rolls round the Sun on its side, so its poles see years of daylight, then years of dark. The station doesn't care, but the chart did, which is why it took a seed of its own."]
			icon: "grindless:uranian_quantum_seed"
