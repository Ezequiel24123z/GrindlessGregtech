			size: 0.75d
			tasks: [{ id: "50D70059F9342925", type: "checkmark" }]
			title: "Organics Everywhere"
			x: 21.5d
			y: -2.5d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["Saturn's air splits into helium-3, deuterium and helium-4, and the helium-3 is the reason the trip is worth it. Bring a bucket of it home."]
			icon: "gtceu:helium_3_bucket"
			id: "38EB6FF76F02D332"
			rewards: [{ id: "56285F5A56C1CC39", type: "xp", xp: 100 }]
