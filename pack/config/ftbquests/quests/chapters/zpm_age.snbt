		{
			dependencies: ["14961D670920ACD5"]
			description: ["The &6Pluto-Kuiper Chart&r is where the next era sets off from. Nothing in ZPM goes that far, and that is by design."]
			icon: "grindless:pluto_kuiper_chart"
