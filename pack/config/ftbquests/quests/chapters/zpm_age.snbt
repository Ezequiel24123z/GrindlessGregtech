			title: "Silicon-28, Slowly"
			x: 8.5d
			y: 21.5d
		}
		{
			dependencies: ["7C205CBF99A79EFB"]
			description: ["The HV &6Composite Autoclave&r bakes carbon fibre and resin into a &6PICA Heat Shield&r, the skin a probe needs to survive a haze. Carbon fibre and phenolic resin, and the circuit for its new mode. Entry probes for Titan and flyby probes past Neptune. Shields are bulky: store them in ME and let the probe bays pull what they need."]
			icon: "grindless:pica_heat_shield"
			id: "3691190A2A0269EB"
			rewards: [{ id: "13E08D0C06B67475", type: "xp", xp: 100 }]
