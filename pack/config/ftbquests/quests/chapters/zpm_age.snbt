			y: 2.5d
		}
		{
			dependencies: ["51DE1101E3742508"]
			description: ["The rings ring like a bell when something hits them. Listen long enough and you get a &6Saturn Interior Model&r, and from it a &6Uranus Transfer Chart&r."]
			icon: "grindless:saturn_interior_model"
			id: "5934DC53BB683C7F"
