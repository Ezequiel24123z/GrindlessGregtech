			y: 3.0d
		}
		{
			dependencies: ["53764AAB65F5DEA2"]
			description: ["Under a hull rated for it, a siphon reaches far deeper than the one at Saturn. What it brings up includes an &6Ice Giant Atmosphere Sample&r, which a chemical reactor in orbit turns into the &6Uranian Quantum Seed&r."]
			icon: "grindless:ice_giant_atmosphere_sample"
