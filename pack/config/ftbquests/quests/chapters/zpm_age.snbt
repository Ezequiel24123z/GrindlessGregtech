			title: "Thin Sunlight"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["760580173FC8670D"]
			description: ["A &6Naquadah Fuel Tank&r and a &6Saturnian Quantum Seed&r are what the rocket to Saturn needs."]
			icon: "grindless:naquadah_fuel_tank"
