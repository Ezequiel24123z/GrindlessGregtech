			]
			title: "Ring Ice Sample"
			x: 15.5d
			y: 0.0d
		}
		{
			dependencies: ["1DC36D16DBF0BC03"]
			description: ["A heat-shielded probe falls through Titan's orange haze and radios back what it passes. The &6Titan Probe Recording&r is the proof it made it."]
			icon: "grindless:titan_probe_recording"
			id: "3F6D11BF4C2EAF0B"
			rewards: [{ id: "37A70C23AF76CDA4", type: "xp", xp: 100 }]
			tasks: [{ id: "5EE17B5AD57FCC6E", item: "grindless:titan_probe_recording", type: "item" }]
			title: "Titan's Haze"
			x: 17.0d
			y: 0.0d
		}
		{
			dependencies: ["3F6D11BF4C2EAF0B"]
			description: ["Titan's haze is organic: &6Tholin&r, a tarry mix of nitriles that the chemistry back home can use. The tholin reformer makes it from the Titan recording, so you need that line running first. It unlocks carbon fibre, bacteria food and the organics ahead. Keep the reformer fed by ME and store the output in a tank."]
			icon: "grindless:tholin"
			id: "160D1EB11990217E"
			rewards: [{ id: "114DEA61DA308FC4", type: "xp", xp: 100 }]
			tasks: [{ id: "71735701E16A7CEE", item: "grindless:tholin", type: "item" }]
			title: "Tholin Sample"
			x: 19.0d
			y: -1.0d
		}
		{
			dependencies: ["160D1EB11990217E"]
			description: ["Tholin turns up in carbon fibre, in bacteria food and in a few things you haven't met yet. A tank or two in ME is cheap insurance."]
			icon: "grindless:tholin"
			id: "180F4254F3E4D0C8"
			rewards: [{ id: "3353EA155FFD0706", type: "xp", xp: 40 }]
