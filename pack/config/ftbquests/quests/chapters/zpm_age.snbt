			title: "Neptune Sample"
			x: 20.5d
			y: 36.0d
		}
		{
			dependencies: ["7C205CBF99A79EFB"]
			description: ["Two ZPM halls that treat ore before it reaches a line: milling and flotation."]
			icon: "gtca:isamill"
			id: "59FA24D314B295D3"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "52A92CBE406B687D", type: "checkmark" }]
