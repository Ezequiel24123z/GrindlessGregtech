			]
			title: "Europium"
			x: 8.5d
			y: 9.0d
		}
		{
			dependencies: ["783B3D8BCDE41DB7"]
			description: ["The &6Waste Retrieval Plant&r digs what the reactors leave behind back out of its storage and sorts it. Its controller and the radiation vault; it also hands back a &6Radium Capsule&r. Radon for the quantum wafer, and the stock that feeds the partitioning plant. Pipe reactor waste straight in; send radon and capsules out by ME."]
			icon: "gtceu:waste_retrieval_plant"
			id: "7842367875A86D7D"
			rewards: [{ id: "70333973B75B2708", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "73761016998B19F3", item: "gtceu:waste_retrieval_plant", type: "item" }
				{ id: "7EDB7CD4E16E95CE", item: "grindless:radium_capsule", type: "item" }
			]
			title: "Waste Retrieval"
			x: 10.5d
			y: 9.0d
		}
		{
			dependencies: ["7842367875A86D7D"]
			description: ["Waste you cannot use is cast into a ceramic block that holds it sealed. &6Synroc&r is a place to put what is left, not a way to hide it."]
			icon: "grindless:synroc_block"
			id: "18D00DD290192BBF"
			rewards: [{ id: "175D843B4A946890", type: "xp", xp: 80 }]
			tasks: [{ id: "3398486368861082", item: "grindless:synroc_block", type: "item" }]
			title: "Synroc"
			x: 12.0d
			y: 7.5d
		}
		{
			dependencies: ["18D00DD290192BBF"]
			description: ["The &6Actinide Partitioning Plant&r splits waste into americium and curium so that very little of it needs burying. Its controller and the americium and curium it makes; the synroc you already cast takes the rest. Americium for the ZPM hulls and curium for the magnet works. Run it off the Waste Retrieval Plant by pipe and conveyor."]
			icon: "gtceu:actinide_partitioning_plant"
			id: "71F8D25601FD13DC"
			rewards: [{ id: "19C54AC1F336B92A", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "16B9D908D535693A", item: "gtceu:actinide_partitioning_plant", type: "item" }
				{ id: "7F3CA8CBFEA8DACD", item: "gtceu:americium_dust", type: "item" }
				{ id: "5D1671164B540A5A", item: "grindless:curium_oxide", type: "item" }
			]
			title: "Actinide Partitioning"
			x: 14.0d
			y: 7.5d
		}
		{
			dependencies: ["1CDA67742969FBD5"]
			description: ["The &6Naquadria Magnet Works&r winds the superconducting wire and insert the fusion hall and the large coils need. Its controller, naquadria and the cryostat casing from the circuits further up. Uranium rhodium dinaquadide wire, and the insert for the next hall. Slow and cold: keep the cryostat topped up and let it run beside the refinery."]
			icon: "gtceu:naquadria_magnet_works"
			id: "1E01844B88F24C23"
			rewards: [{ id: "5C536CBAA400CCB2", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "52848600E203664B", item: "gtceu:naquadria_magnet_works", type: "item" }
				{ id: "540E94A70B2FA2BE", item: "gtceu:uranium_rhodium_dinaquadide_single_wire", type: "item" }
			]
			title: "Magnet Works"
			x: 7.0d
			y: 8.5d
		}
		{
			dependencies: ["1E01844B88F24C23"]
			description: ["The &6Plasma Quench Caster&r drops plasma straight into a mould, so the metal never has time to cool in a way you did not choose. Its controller and a plasma supply; no new casing. Casting directly from plasma at the speed the Mk2 can feed. Plasma by pipe from the fusion hall, ingots out by conveyor."]
			icon: "gtceu:plasma_quench_caster"
			id: "1CADDA82F9A7F5A7"
			rewards: [{ id: "759397A18AD8C163", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "1ED4B41E6916E51C", item: "gtceu:plasma_quench_caster", type: "item" }]
			title: "Plasma Quench"
			x: 8.5d
			y: 7.5d
		}
		{
			dependencies: ["1CADDA82F9A7F5A7"]
			description: ["A high-temperature superconductor insert, wound by the magnet works and set into a coil block. It carries current with no loss."]
			icon: "grindless:hts_insert"
			id: "3F6117F6B2C380DC"
			rewards: [{ id: "353520BBCF2F928A", type: "xp", xp: 80 }]
			tasks: [{ id: "59E26C973FE54A72", item: "grindless:hts_insert", type: "item" }]
			title: "HTS Insert"
			x: 11.0d
			y: 6.0d
		}
		{
			dependencies: ["1CDA67742969FBD5"]
			description: ["The &6Methane Pyrolyser&r cracks methane into graphene and hydrogen, with the carbon coming out as a sheet. Its controller and methane from the gas network. Graphene for the diamond lattice and for the circuits further on. Methane by pipe; keep the hydrogen moving so it never blocks."]
			icon: "gtceu:methane_pyrolyser"
			id: "375C05ABC626E037"
			rewards: [{ id: "7DD936739291AC4F", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7D289EB5051DD675", item: "gtceu:methane_pyrolyser", type: "item" }
				{ id: "7ED667EB5DD1FFFB", item: "gtceu:graphene_dust", type: "item" }
			]
			title: "Pyrolysis"
			x: 12.5d
			y: 9.5d
		}
		{
			dependencies: ["375C05ABC626E037"]
			description: ["The &6Diamond Lattice Fab&r grows a flawless diamond plate from graphene, layer by layer. Its controller and graphene; the plate is the product. The NV diamond chip and the ion implanter. Slow by design: run two or three side by side."]
			icon: "gtceu:diamond_lattice_fab"
			id: "57B256A0532B609A"
			rewards: [{ id: "71A2E98ED4104367", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "33E86CC8982E9EEC", item: "gtceu:diamond_lattice_fab", type: "item" }
				{ id: "1243FA8351B31FE7", item: "grindless:cvd_diamond_plate", type: "item" }
			]
			title: "Diamond Lattice"
			x: 14.0d
			y: 9.5d
		}
		{
			dependencies: ["57B256A0532B609A"]
			description: ["The &6Ion Implanter&r fires single atoms into a wafer or plate and places them where a qubit has to sit. Its controller, a cleanroom and silicon-28 or doped diamond. The donor qubit wafer and the NV diamond chip, further along. One batch at a time: feed by ME and queue the output."]
			icon: "gtceu:ion_implanter"
			id: "74C7DC8E103131DB"
			rewards: [{ id: "113AF4BC0C22E6E1", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1377CD6770697ACB", item: "gtceu:ion_implanter", type: "item" }
				{ id: "7AAF53BE2354BC5B", item: "grindless:donor_qubit_wafer", type: "item" }
			]
			title: "Ion Implanter"
			x: 15.5d
			y: 9.5d
		}
		{
			dependencies: ["74C7DC8E103131DB"]
			description: ["The &6Qubit Fab&r assembles qubits into an array under cryogenic conditions. Its controller and the &6Cryostat Casing&r. The qubit array that the circuits further on use. Keep the cryostat topped up and send the arrays on by ME."]
			icon: "gtceu:qubit_fab"
			id: "32049634C73ABDE1"
			rewards: [{ id: "52EA48C2FB46B4F1", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7E76CA6055B80B5E", item: "gtceu:qubit_fab", type: "item" }
				{ id: "184E4ED215AB0FC9", item: "grindless:cryostat_casing", type: "item" }
			]
			title: "Qubit Fab"
			x: 18.0d
			y: 10.5d
		}
		{
			dependencies: ["1CDA67742969FBD5"]
			description: ["The &6Vent Bioreactor&r grows microbes that live by deep-sea heat and feed on what the vents give off. Its controller and the heat-resistant culture it grows. Archaeal culture for aerogel, and the organics for later lines. The culture is not consumed in small runs; keep a seed batch alive in ME."]
			icon: "gtceu:vent_bioreactor"
			id: "5018E9B05AD69E21"
			rewards: [{ id: "1E06586620A019AF", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7F5EDE9F49A0DBB9", item: "gtceu:vent_bioreactor", type: "item" }]
			title: "Vent Life"
			x: 7.0d
			y: 10.5d
		}
		{
			dependencies: ["5018E9B05AD69E21"]
			description: ["&6Archaea&r are a culture that thrives where nothing else survives, and the biology behind the aerogel recipes. The vent bioreactor makes four from Europa bacteria, Enceladus brine, hydrogen and carbon dioxide, and gives back a little methane for the pyrolyser. Make them once: the growth-medium run only borrows the culture."]
			icon: "grindless:archaeal_culture"
			id: "37F864D2D349BD17"
			rewards: [{ id: "1180ECF4D8FB7160", type: "xp", xp: 80 }]
			tasks: [{ id: "3F7D1DF15452CAD0", item: "grindless:archaeal_culture", type: "item" }]
			title: "Archaea"
			x: 10.0d
			y: 10.5d
		}
		{
			dependencies: ["50A2AC5A9FDD98C5"]
			description: ["The same bioreactor feeds a culture tholin, Enceladus brine and mutagen and brews &6raw growth medium&r, with a little salt water left over. The culture is not used up. The medium is the base of the stem cells that the organoid lines need, so tank it and send the salt water to the electrolyser."]
			icon: "gtceu:raw_growth_medium_bucket"
			id: "3105DFD503C8EAFA"
			rewards: [{ id: "5E781A4B8EAD93CF", type: "xp", xp: 60 }]
			tasks: [
				{ id: "3BEF0D74D1846FFF", item: "gtceu:raw_growth_medium_bucket", type: "item" }
				{ id: "72F9FBFD49216AA1", item: "gtceu:enceladus_brine_bucket", type: "item" }
			]
			title: "The Living Medium"
			x: 13.5d
			y: 14.5d
		}
		{
			dependencies: ["37F864D2D349BD17"]
			description: ["The &6Aerogel Works&r dries silica gel so slowly that it stays as a foam that is almost all air. Its controller and archaeal culture for the gel. Silica aerogel for the cryostat casing and the hulls that need to hold the cold. Slow and steady. Stock aerogel by ME."]
			icon: "gtceu:aerogel_works"
			id: "50A2AC5A9FDD98C5"
			rewards: [{ id: "5FC1A4ECD19D99F4", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1C3D7CE8E1C70A4B", item: "gtceu:aerogel_works", type: "item" }
				{ id: "54620AD904445E3B", item: "grindless:silica_aerogel", type: "item" }
			]
			title: "Aerogel"
			x: 13.0d
			y: 12.0d
		}
		{
			dependencies: ["50A2AC5A9FDD98C5"]
			description: ["The &6Neutrino Observatory&r waits for particles that pass through the planet and counts the rare one that stops. Its controller and the &6Photomultiplier Casing&r. The Solar Core Survey and, from it, the data the gate to UV asks for. It needs no tending. Collect the survey by ME when it finishes."]
			icon: "gtceu:neutrino_observatory"
			id: "54B3C436DF487119"
			rewards: [{ id: "73359B29DD498ED3", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1C89F537FB2519D0", item: "gtceu:neutrino_observatory", type: "item" }
				{ id: "1CA9E8F2CFFE2525", item: "grindless:photomultiplier_casing", type: "item" }
			]
			title: "Neutrinos"
			x: 15.0d
			y: 11.5d
		}
		{
			dependencies: ["54B3C436DF487119"]
			description: ["The neutrino count, written up as a map of the sun's core, is what the &6Solar Core Survey&r is for: it is the proof of work the gate to UV asks for. It is made from the neutrino detector's readings in the survey line, so keep the detector fed and running. Nothing else uses it, so make one and hand it in. Detector output reaches the line by ME, so the whole run can be left unattended."]
			icon: "grindless:solar_core_survey"
			id: "5E45678B3B8A8A65"
			rewards: [{ id: "3757A265E0E550EE", type: "xp", xp: 120 }]
			tasks: [{ id: "75F745E87DB91E92", item: "grindless:solar_core_survey", type: "item" }]
			title: "Solar Core Survey"
			x: 17.0d
			y: 12.0d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["The &6Ring Harvester&r sails through Saturn's rings and nets the ice, which is not the same as the ice at home. Its controller, the &6Station Truss Casing&r you already know, and a net for the sail. Ring ice samples for the plume sampler and the seismometer. A station-side buffer holds the ice; ME takes it home."]
			icon: "gtceu:ring_harvester"
			id: "19FA6D9CF0EE02C7"
			rewards: [{ id: "5CF688405C2A9B72", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "75E4D210EDC14021", item: "gtceu:ring_harvester", type: "item" }
				{ id: "745270EA3D0A5720", item: "grindless:ring_sail_net", type: "item" }
				{ id: "3ED316456037D44A", item: "grindless:ring_ice_sample", type: "item" }
			]
			title: "Ring Ice"
			x: 16.0d
			y: 4.0d
		}
		{
			dependencies: ["19FA6D9CF0EE02C7"]
			description: ["The &6Plume Sampler&r flies through the geysers of an icy moon and catches what comes out. Its controller and the &6Probe Bay Casing&r. The aerogel cartridge, the seismometer's other input. Probes are launched, not driven: stock them by ME."]
			icon: "gtceu:plume_sampler"
			id: "5330AC3948DAA01C"
			rewards: [{ id: "59D110DD5792601D", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "118FD82E395EECEA", item: "gtceu:plume_sampler", type: "item" }
				{ id: "3EE6DC9F9F47CD8A", item: "grindless:probe_bay_casing", type: "item" }
			]
			title: "Plumes"
			x: 18.5d
			y: 5.5d
		}
		{
			dependencies: ["5330AC3948DAA01C"]
			description: ["The &6Aerogel Cartridge&r seals a sample in aerogel so that it reaches home unchanged. It is made in an assembler from aerogel and polyethylene, with the aerogel works supplying the first. Every Saturn and Uranus sample asks for one, so it unlocks the whole sample run. Keep a stock in ME and let the assembler refill it on demand."]
			icon: "grindless:aerogel_cartridge"
			id: "386669836DB882A5"
			rewards: [{ id: "5C137F145CD5F90F", type: "xp", xp: 80 }]
			tasks: [{ id: "594FFD8FE69FD9BC", item: "grindless:aerogel_cartridge", type: "item" }]
			title: "Aerogel Cartridge"
			x: 20.0d
			y: 6.5d
		}
		{
			dependencies: ["386669836DB882A5"]
			description: ["The &6Ring Seismometer&r listens to the rings ring: tiny quakes in Saturn that tell you what is inside. Its controller, ring ice and cartridges, and the interior model it writes. The Saturn interior model and the Uranus transfer chart that leads onward. It listens for a long time. Leave it be."]
			icon: "gtceu:ring_seismometer"
			id: "32AF9CEF63EB677A"
			rewards: [{ id: "554B3230DA4BB183", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "54281A6610F69243", item: "gtceu:ring_seismometer", type: "item" }
				{ id: "361B5511110C4E19", item: "grindless:saturn_interior_model", type: "item" }
				{ id: "501B757DD6404D21", item: "grindless:uranus_transfer_chart", type: "item" }
			]
			title: "Ring Song"
			x: 22.5d
			y: 8.0d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["The &6Gas Giant Siphon&r lowers a scoop into the clouds and brings up gas from a planet that has no ground. Its controller and a &6Scoop Head&r for the clouds. Helium-3 for the clean fusion route, and hydrogen in bulk. Gas by pipe into a buffer tank; the head is worn and replaced."]
			icon: "gtceu:gas_giant_siphon"
			id: "578143AE95F4EB8D"
			rewards: [{ id: "1B8746FC90A470EC", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7F8FF6963AD46047", item: "gtceu:gas_giant_siphon", type: "item" }
				{ id: "38CAB2F038120FF0", item: "grindless:scoop_head", type: "item" }
			]
			title: "Siphon"
			x: 13.5d
			y: 6.0d
		}
		{
			dependencies: ["578143AE95F4EB8D"]
			description: ["The &6Isotope Column&r separates helium-3 from the gas the siphon brings up. Its controller and a stream of Saturn gas. Helium-3 for the aneutronic route later on and the cold of the cryostat. Run the column continuously; bucket or pipe the helium-3 off."]
			icon: "gtceu:isotope_column"
			id: "13DF11331D65FE28"
			rewards: [{ id: "5FA4622C1A460EA5", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "364D535FA7B5FB6D", item: "gtceu:isotope_column", type: "item" }
				{ id: "163E9F6FDACFE465", item: "gtceu:helium_3_bucket", type: "item" }
			]
			title: "Helium-3"
			x: 17.5d
			y: 7.0d
		}
		{
			dependencies: ["13DF11331D65FE28"]
			description: ["The &6Entry Probe Bay&r drops a probe through Titan's haze and records the way down. Its controller, the &6Probe Bay Casing&r and a titan entry probe. The recording the tholin reformer starts from. Probes are single use; build them by the dozen."]
			icon: "gtceu:entry_probe_bay"
			id: "73BBBB6062106F00"
			rewards: [{ id: "7A25F765E0078A10", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "347BA511CB79BF9B", item: "gtceu:entry_probe_bay", type: "item" }
				{ id: "565AEE848552A9CF", item: "grindless:probe_bay_casing", type: "item" }
				{ id: "32275F4A25DB29F7", item: "grindless:titan_entry_probe", type: "item" }
			]
			title: "Titan"
			x: 19.0d
			y: 8.5d
		}
		{
			dependencies: ["73BBBB6062106F00"]
			description: ["The &6Titan Recording&r is what the entry probe saw as it fell, stored for the lab. It comes from a probe launched through the Titan line, so you need a probe, a launch and a working station. It unlocks the tholin reformer, which needs the recording to work. Probes are single use, so automate probe building and let ME collect each recording."]
			icon: "grindless:titan_probe_recording"
			id: "14A8433C85449724"
			rewards: [{ id: "1182BDBFFD4628C0", type: "xp", xp: 80 }]
			tasks: [{ id: "3D2C1CB4D4F4D2C6", item: "grindless:titan_probe_recording", type: "item" }]
			title: "Titan Recording"
			x: 21.5d
			y: 10.5d
		}
		{
			dependencies: ["14A8433C85449724"]
			description: ["The &6Tholin Reformer&r turns the haze of Titan into tholin, a tar that is rich in carbon and nitrogen. Its controller and the recording from Titan. Tholin for the organics of the lines ahead. Feed from ME; the haze is a loop you keep."]
			icon: "gtceu:tholin_reformer"
			id: "36524835522A60A5"
			rewards: [{ id: "566F289FD725CD64", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7975CE7772CFEF01", item: "gtceu:tholin_reformer", type: "item" }
				{ id: "57A318CBE45A3F3D", item: "grindless:tholin", type: "item" }
			]
			title: "Tholins"
			x: 23.5d
			y: 10.0d
		}
		{
			dependencies: ["53764AAB65F5DEA2"]
			description: ["The &6Ice Giant Siphon&r reaches deeper than the Saturn one, under a hull rated for the pressure. Its controller, the &6Pressure Hull Casing&r and the atmosphere sample it brings up. Ice giant gases, and the diamond seed in the next quest. Gas by pipe into tanks; the hull is a one-time cost."]
			icon: "gtceu:ice_giant_siphon"
			id: "554FD6C632D87ADB"
			rewards: [{ id: "51A82BB16CB48C21", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1336E191014A23E5", item: "gtceu:ice_giant_siphon", type: "item" }
				{ id: "718F869D6B372A83", item: "grindless:pressure_hull_casing", type: "item" }
				{ id: "5E90702FDE2DA465", item: "grindless:ice_giant_atmosphere_sample", type: "item" }
			]
			title: "Deep Gas"
			x: 25.5d
			y: 8.0d
		}
		{
			dependencies: ["554FD6C632D87ADB"]
			description: ["The &6Slurry Separator&r filters the diamond slurry that forms where carbon is squeezed. Its controller and the &6Pressure Hull Casing&r. The ice giant diamond seed. It filters constantly. Let ME collect the seeds."]
			icon: "gtceu:slurry_separator"
			id: "186259C7F1818558"
			rewards: [{ id: "32C50832A67F673F", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3499571BE390855E", item: "gtceu:slurry_separator", type: "item" }
				{ id: "7F1BAC18128806CD", item: "grindless:pressure_hull_casing", type: "item" }
			]
			title: "Diamond Rain"
			x: 28.0d
			y: 9.5d
		}
		{
			dependencies: ["186259C7F1818558"]
			description: ["A seed that grows a flawless plate in the lattice fab. It gives a better qubit plate than anything from home."]
			icon: "grindless:ice_giant_diamond_seed"
			id: "55BFDE438A0240EB"
			rewards: [{ id: "16FC4E7C7653F6D2", type: "xp", xp: 80 }]
			tasks: [{ id: "37CC328CEB11386D", item: "grindless:ice_giant_diamond_seed", type: "item" }]
			title: "Diamond Seed"
			x: 30.5d
			y: 11.5d
		}
		{
			dependencies: ["554FD6C632D87ADB"]
			description: ["The &6Flyby Probe Bay&r launches probes that pass Neptune and Triton and never stop. Its controller, the &6Probe Bay Casing&r and a Neptune flyby probe. The data the Deep Space Network decodes, and the Pluto chart that leads out. Probes are one-way. Build a stock."]
			icon: "gtceu:flyby_probe_bay"
			id: "72B6F5C97902310C"
			rewards: [{ id: "7D73B7D61A4DF7F0", type: "xp", xp: 150 }]
			shape: "gear"
