				{ id: "1E5FADC71EA08547", item: "gtceu:minor_actinide_strip_bucket", type: "item" }
			]
			title: "Radium and Raffinate"
			x: 20.5d
			y: 30.0d
		}
		{
			dependencies: ["5649518F6FC2B6AC"]
			description: ["The Diamond Lattice and CVD line leave &6nanodiamond dust&r. Nothing mines diamonds any more: react four nanodiamond with hydrogen in a chemical reactor to get three diamond dust and methane, and send the methane back to the pyrolyser."]
			icon: "grindless:nanodiamond_dust"
			id: "51368383BE378464"
			rewards: [{ id: "329B3DFB40086300", type: "xp", xp: 40 }]
