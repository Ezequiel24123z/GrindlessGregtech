			x: 14.0d
			y: -0.5d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["A &6Aerogel Cartridge&r is the brine, flown home and set into silica. It is half of what the next fuel tank is built round."]
			icon: "grindless:aerogel_cartridge"
			id: "51DE1101E3742508"
