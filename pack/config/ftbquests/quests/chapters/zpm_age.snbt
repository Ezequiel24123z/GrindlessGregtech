			x: 8.0d
			y: -3.0d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["Nobody mines a ring by hand. A net sweeps through it and brings back a &6Ring Ice Sample&r, and the samples are the start of everything the rings teach you."]
			icon: "grindless:ring_ice_sample"
			id: "1DC36D16DBF0BC03"
