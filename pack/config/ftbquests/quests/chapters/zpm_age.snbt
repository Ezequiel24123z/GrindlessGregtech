			]
			title: "Nanodiamond Cleaning"
			x: 20.5d
			y: 31.5d
		}
		{
			dependencies: ["51368383BE378464"]
			description: ["A diamond plate doped with nitrogen is the base of the &6NV diamond chip&r. Grow it beside the lattice and automate it the same way."]
			icon: "grindless:nitrogen_doped_cvd_plate"
			id: "53A85CC495DDEE42"
			rewards: [{ id: "5175BDC7BE834126", type: "xp", xp: 50 }]
			tasks: [
				{ id: "1796C64DF6EF0BD6", item: "grindless:nitrogen_doped_cvd_plate", type: "item" }
				{ id: "3DF8F6A749E6D674", item: "grindless:nv_diamond_chip", type: "item" }
			]
			title: "Nitrogen-Doped Plate"
			x: 20.5d
			y: 33.0d
		}
		{
			dependencies: ["53A85CC495DDEE42"]
			description: ["Titan nitriles are distilled into acrylonitrile, which a large chemical reactor polymerises into polyacrylonitrile; the polymer is wet-spun into &6precursor fibre&r and stabilised with oxygen at 550 K. Keep oxygen and nitrogen on separate pipes."]
			icon: "grindless:pan_precursor_fibre"
			id: "523A7475AE50620B"
			rewards: [{ id: "746C5D7B53EA1D89", type: "xp", xp: 60 }]
			tasks: [
				{ id: "300F586F25168600", item: "grindless:pan_precursor_fibre", type: "item" }
				{ id: "7BB05D5D1FA60D79", item: "grindless:stabilised_pan_fibre", type: "item" }
			]
			title: "PAN Fibre"
			x: 20.5d
			y: 34.5d
		}
		{
			dependencies: ["523A7475AE50620B"]
			description: ["Stabilised fibre is carbonised in a blast furnace at 1,600 K under nitrogen, which is not used up. Eight stabilised fibres give sixteen &6carbon fibres&r and hydrogen cyanide. Send the cyanide to the chemical lines and never vent it."]
			icon: "gtceu:carbon_fibers"
			id: "1775F096931F74C2"
			rewards: [{ id: "1CF9BB767A378CB6", type: "xp", xp: 60 }]
			tasks: [{ id: "10549E47D117292B", item: "gtceu:carbon_fibers", type: "item" }]
			title: "Carbon Fibre"
			x: 22.5d
			y: 34.5d
		}
		{
			dependencies: ["1FBBE9E843BE90C3"]
			description: ["The &6UV SMES cell&r is wound from four ZPM cells, with sixteen wires and eight darmstadtium plates. It stores far more than a ZPM cell: build it only once the Big Reactor feeds the grid."]
			icon: "grindless:uv_smes_cell"
			id: "3AA19276029EE353"
			rewards: [{ id: "3C652F2815E7FBDC", type: "xp", xp: 60 }]
