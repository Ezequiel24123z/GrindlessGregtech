			title: "Quantum Wafer"
			x: 4.0d
			y: -9.0d
		}
		{
			dependencies: ["1000B35476B6FAC2"]
			description: ["Cut from the wafer, the &6Qubit CPU Chip&r is the part of a quantum circuit that does the counting. A cleanroom and a cutter fed with lubricant or water. The quantum mainframe. One wafer, many chips: keep a stock by ME so the assembler never waits."]
			icon: "gtceu:qbit_cpu_chip"
			id: "154A85EE43809FA1"
			rewards: [{ id: "79F1DA7C1CA9D838", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "355FAD82857C0EBB", item: "gtceu:qbit_cpu_chip", type: "item" }]
			title: "Quantum Chip"
			x: 5.5d
			y: -9.0d
		}
		{
			dependencies: ["154A85EE43809FA1"]
			description: ["The &6Quantum Processor Mainframe&r is a ZPM-tier circuit made from Quantum Processor Computers, frames and SMD parts. Its quantum chips come in through those computers. Quantum Processor Computers from the IV line, HSS-G frames and RAM, in a circuit assembler of IV tier or better. ZPM machine hulls and the hatches that open the gate to UV. Keep a stock of computers by ME; the assembler draws them and the mainframes go to a dedicated chest."]
			icon: "gtceu:quantum_processor_mainframe"
			id: "5353B2E6D14E53D3"
			rewards: [{ id: "31FA823ACF23F80F", type: "xp", xp: 180 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "79E221DF204A5F8D", item: "gtceu:quantum_processor_mainframe", type: "item" }]
			title: "Quantum Mainframe"
			x: 8.0d
			y: -9.5d
		}
		{
			dependencies: ["7A980F3B74DBF079"]
			description: ["Isotopically pure silicon is grown as a &6Silicon-28 Boule&r and cut into wafers. Ordinary silicon has too much magnetic noise for what comes next. Silicon-28 from the hot cell, an EBF for the boule and a cutter. The boule is the slow part. Donor qubits, and the silicon the qubit fab asks for. The hot cell runs all day. Send its silicon to the EBF by ME and stock the wafers."]
			icon: "grindless:silicon_28_wafer"
			id: "5D07EB0A82EEE479"
			rewards: [{ id: "5D72DCF3F381B59F", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5A39D0FF474899EA", item: "grindless:silicon_28_boule", type: "item" }
				{ id: "7742C9FE252CCFBD", item: "grindless:silicon_28_wafer", type: "item" }
			]
			title: "Silicon-28"
			x: 3.5d
			y: -7.5d
		}
		{
			dependencies: ["5D07EB0A82EEE479"]
			description: ["A single phosphorus atom in spin-free silicon holds a quantum state. The &6Donor Qubit Wafer&r is a silicon-28 wafer with them placed one at a time. The ion implanter, a silicon-28 wafer and phosphorus dust. The qubit array, by the donor route. Implantation is slow, so run several implanters and let ME collect the wafers."]
			icon: "grindless:donor_qubit_wafer"
			id: "1D7FE3922B3DBF22"
			rewards: [{ id: "16561E6518BA9165", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "394DF0F6F19CC29B", item: "grindless:donor_qubit_wafer", type: "item" }]
			title: "Donor Qubits"
			x: 5.0d
			y: -7.5d
		}
		{
			dependencies: ["7A980F3B74DBF079"]
			description: ["A nitrogen atom next to a gap in diamond is a qubit that works warm. The &6NV Diamond Chip&r is a doped diamond plate with them placed in it. Nitrogen-doped plates from the diamond lattice fab, then the ion implanter. The qubit array, by the slower diamond route. The doped plate is the slow step; give the fab its own nitrogen feed."]
			icon: "grindless:nv_diamond_chip"
			id: "5F0C09AC946B3ECA"
			rewards: [{ id: "3F118BCA0B5E4A1F", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5E012EA6434CDC82", item: "grindless:nitrogen_doped_cvd_plate", type: "item" }
				{ id: "5E94DFBC293D0FAA", item: "grindless:nv_diamond_chip", type: "item" }
			]
			title: "NV Diamond"
			x: 4.0d
			y: -6.0d
		}
		{
			dependencies: ["1D7FE3922B3DBF22", "5F0C09AC946B3ECA"]
			description: ["Qubits only hold their state when almost nothing is moving. The &6Cryostat Casing&r keeps the fab that cold. Aerogel and gold-plated copper for the casing,       and liquid helium to run the cold, with a little Saturn helium on top. The qubit fab, and every cryogenic hall that comes after. Every fab batch draws liquid helium and a little Saturn helium. Pipe both in."]
			icon: "grindless:cryostat_casing"
			id: "119B62380F5F76FC"
			rewards: [{ id: "1FAA0F12448553D4", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7B831BE9E559C9AB", item: "grindless:cryostat_casing", type: "item" }]
			title: "Millikelvin"
			x: 6.5d
			y: -7.5d
		}
		{
			dependencies: ["119B62380F5F76FC"]
			description: ["A &6Qubit Array&r stands in for a stack of circuits in the computation parts our alternative recipes build. A donor wafer or an NV chip in the qubit fab, which draws liquid helium and a little Saturn helium for every array. The computation components for the research station, at a fraction of the circuits. Keep a stock by ME; the fab is slow and the components draw them by the handful."]
			icon: "grindless:qubit_array"
			id: "5E3D46F05A5DC030"
			rewards: [{ id: "75301C117C95228C", type: "xp", xp: 150 }]
