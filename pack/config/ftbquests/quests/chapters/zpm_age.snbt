			x: 20.0d
			y: 2.0d
		}
		{
			dependencies: ["3F7C9D7577EC9E61"]
			description: ["Uranus orbit, tipped on its side and colder than Saturn. Same station, but anything dipping into the air needs a stronger hull."]
			icon: "grindless:station_truss_casing"
