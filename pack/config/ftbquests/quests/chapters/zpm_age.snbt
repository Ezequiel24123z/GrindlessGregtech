			title: "UV SMES Cell"
			x: 22.5d
			y: 27.0d
		}
		{
			dependencies: ["523A7475AE50620B"]
			description: ["The flyby bay brings back a recording on the first pass, and the sampling pass brings the &6Neptune sample&r. It is a research item: it is consumed by research and cannot be crafted."]
			icon: "grindless:neptune_sample"
			id: "5871ACC4D648BB04"
