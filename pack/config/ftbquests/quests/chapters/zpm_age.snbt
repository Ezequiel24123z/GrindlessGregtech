		}
		{
			dependencies: ["1753F1FE9C989F6C"]
			description: [
				"The &6Saturn Transfer Chart&r from the Jovian flyby points at rings, a hazy moon and two ice giants. Nothing out there is walkable, so the trip starts in orbit and stays there."
				"The machines, circuits and power for ZPM sit in the later quests. This branch keeps the trip."
			]
			icon: "grindless:saturn_transfer_chart"
			id: "7B0EFFD4E295AFAD"
			rewards: [{ id: "54CCF169C15A211E", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "1CE1F3E642B9C7FF", type: "checkmark" }]
			title: "Saturn and Beyond"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7B0EFFD4E295AFAD"]
			description: [
				"Out at Saturn the Sun gives about a hundredth and a half of what home gets, and at Uranus far less. Solar panels there are a joke nobody laughs at."
				"So both stations run on the wireless network. Get the ZPM tier of it built before you leave."
			]
			icon: "gtceu:zpm_wireless_energy_hatch"
			id: "760580173FC8670D"
			rewards: [{ id: "74965739C159BB6D", type: "xp", xp: 30 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "133B2FE4AAA569C2", type: "checkmark" }]
			title: "Thin Sunlight"
			x: 6.0d
			y: 0.5d
		}
		{
			dependencies: ["760580173FC8670D"]
			description: ["A &6Naquadah Fuel Tank&r is what the rocket to Saturn needs. Everything else out there is made on the spot, in orbit."]
			icon: "grindless:naquadah_fuel_tank"
			id: "7B7F696C0E4DF709"
			rewards: [{ id: "5CC2FE364CA17C96", type: "xp", xp: 100 }]
			tasks: [{ id: "5C9F7843BB96F43A", item: "grindless:naquadah_fuel_tank", type: "item" }]
			title: "Level Five"
			x: 8.0d
			y: 1.5d
		}
		{
			dependencies: ["7B7F696C0E4DF709"]
			description: ["Saturn orbit: no ground, no air, a very long way from the Sun. Chunk-load the station, or its machines stop the moment you leave."]
			icon: "grindless:station_truss_casing"
			id: "3CBBA765447C908A"
			rewards: [{ id: "5EA5752650290985", type: "xp", xp: 120 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ dimension: "grindless:saturn_orbit", id: "150CF4881DA5FB8F", type: "dimension" }]
			title: "Third Station"
			x: 12.5d
			y: 1.0d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["A station only works while its chunks are loaded. Claim and force-load them before you head home, and the far machines keep humming while you're away."]
			icon: "grindless:station_truss_casing"
			id: "5814F818795D795E"
			optional: true
			rewards: [{ id: "14F7C854353C553F", type: "xp", xp: 40 }]
			shape: "hexagon"
			size: 0.75d
			tasks: [{ id: "76D8BE65E7769F3D", type: "checkmark" }]
			title: "Keep the Lights On"
			x: 14.0d
			y: 1.0d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["Enceladus vents salt water into space, and a probe can fly straight through it. The brine feeds your living chemistry back home and starts the aerogel cartridge."]
			icon: "gtceu:plume_sampler"
			id: "755DFA4FA7E0454A"
			rewards: [{ id: "3DCD0A4D58821D44", type: "xp", xp: 40 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "1937E6B76DA1DA83", type: "checkmark" }]
			title: "The Salty Moon"
			x: 14.0d
			y: 3.0d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["Nobody mines a ring by hand. A net sweeps through it and brings back a &6Ring Ice Sample&r. A chemical reactor in orbit turns one, with an ender pearl and helium-3, into the &6Saturnian Quantum Seed&r, your half of the Saturn link."]
			icon: "grindless:ring_ice_sample"
			id: "1DC36D16DBF0BC03"
			rewards: [{ id: "5A019FB8D83F8FC5", type: "xp", xp: 100 }]
