			y: -1.5d
		}
		{
			dependencies: ["160D1EB11990217E"]
			description: ["Tholin turns up in carbon fibre, in bacteria food and in a few things you haven't met yet. A tank or two in ME is cheap insurance."]
			icon: "grindless:tholin"
