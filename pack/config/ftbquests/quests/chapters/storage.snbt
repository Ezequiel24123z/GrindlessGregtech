	quests: [
		{
			description: [
				"Every GregTech line makes more than one thing, and all of it needs a home. This tab covers the storage mods: drawers for bulk, Sophisticated chests and backpacks for the mixed stuff, ender storage for reach."
				"None of it is required - build what suits your base. The ME network has a tab of its own."
			]
			icon: "storagedrawers:oak_full_drawers_4"
			id: "55D3B1D14B8BCE80"
			rewards: [{ id: "175DFB3BE048E0BE", type: "xp", xp: 10 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "5EF4C6954C97F4DB", type: "checkmark" }]
			title: "Storage"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["55D3B1D14B8BCE80"]
			description: [
				"GregTech's own storage comes in every metal. A &6Drum&r holds one fluid and keeps it when you break it; a &6Crate&r keeps its items too, once you sneak-use tape on it."
				"Bronze and steel ones cover the early game. Super chests and tanks, millions of a single thing, come later."
			]
			icon: "gtceu:bronze_drum"
			id: "0E9F2E59FE951229"
			rewards: [{ id: "6F4D7965A6200230", type: "xp", xp: 15 }]
