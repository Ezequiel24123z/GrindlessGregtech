			y: -2.0d
		}
		{
			dependencies: ["55D3B1D14B8BCE80"]
			description: [
				"Storage before the ME network: an &6Inventory Connector&r joins every chest, drawer and barrel around it - and more through inventory cables - and a &6Storage Terminal&r searches all of them at once."
				"No power, no channels - a fine first step."
			]
			icon: "toms_storage:ts.storage_terminal"
