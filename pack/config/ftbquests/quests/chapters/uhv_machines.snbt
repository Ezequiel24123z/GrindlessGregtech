				{ id: "1C7E419D33DFF934", item: "gtceu:ptfe_pipe_casing", type: "item" }
			]
			title: "High Flux"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["17FFD22B68F2339B"]
			description: ["The &6Transuranium Facility&r separates the irradiated targets into berkelium and californium. Its controller, radiation-proof casing and tungstensteel pipe casing. Berkelium-249 and the californium-252 source the clock lab and the gate ask for. Keep the targets in sealed buses; leftovers go to the partitioning plant."]
			icon: "gtceu:transuranium_facility"
			id: "36C7A1B9DB6512D7"
			rewards: [{ id: "12243468CFF9573A", type: "xp", xp: 120 }]
