				{ id: "5A5A88AD5BFCCE48", item: "gtceu:tungstensteel_pipe_casing", type: "item" }
			]
			title: "Berkelium"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["36C7A1B9DB6512D7"]
			description: ["One more neutron capture and berkelium becomes &6Californium-252&r, a source that emits neutrons by itself. It starts the reactors that cannot start alone."]
			icon: "grindless:californium_252_source"
			id: "7365DAF24CBF4955"
			rewards: [{ id: "3CCD239C7E71855D", type: "xp", xp: 120 }]
