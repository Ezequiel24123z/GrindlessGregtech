	quests: [
		{
			dependencies: ["7547756221DFC688"]
			description: ["The &6High Flux Reactor&r bombards curium in a dense neutron flux and is the start of every transcurium chain. Its controller, a UHV hull and the &6Radiation-Proof Casing&r that holds the flux in. Berkelium and californium targets, and the driver elements that feed them. Targets and driver elements travel by ME; send spent drivers back to the reactor."]
			icon: "gtceu:high_flux_reactor"
			id: "17FFD22B68F2339B"
			rewards: [{ id: "559EF99482D99DA4", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
