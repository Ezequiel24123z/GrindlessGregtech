			x: 25.0d
			y: -1.0d
		}
		{
			dependencies: ["17623833C3E320FE", "1367407C3410944C"]
			description: ["The Matrioshka in Mercury orbit puts the elevator log, the Vela glitch record, the titanium-44 map and the Cygnus radio record together into the &6Arm Chart&r: our arm of the galaxy, mapped toward the centre."]
			icon: "grindless:arm_chart"
			id: "1351A1703766CFB3"
			rewards: [{ id: "58C44B087C376411", type: "xp", xp: 300 }]
			tasks: [{ id: "5F17D96620A152C3", item: "grindless:arm_chart", type: "item" }]
			title: "Arm Chart"
			x: 27.5d
			y: -1.0d
		}
		{
			dependencies: ["1351A1703766CFB3"]
			description: [
				"Hold the warp gate open at the full UXV load for sixty seconds in Cygnus X-1 orbit, then tick this box. Take care of your power first: the BZ dynamo with polar cap taps, or the Mk6 through the converter."
				"The gate burns an FRC cartridge and keeps census III, the island chart, the arm chart, a pasta core sample and UXV-tier circuit tags in its store."
			]
			icon: "gtceu:warp_gate"
			id: "5B7D80D05C71F861"
			rewards: [{ id: "18CA5B5627E91B2B", type: "xp", xp: 300 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ id: "33EF140B320839EC", type: "checkmark" }]
			title: "Open the Bulge Gate"
			x: 30.0d
			y: -2.5d
		}
		{
			dependencies: ["5B7D80D05C71F861"]
			description: ["Through the open gate the seed looks at the crowded centre of the galaxy. The run gives the &6Bulge Chart&r."]
			icon: "grindless:bulge_chart"
