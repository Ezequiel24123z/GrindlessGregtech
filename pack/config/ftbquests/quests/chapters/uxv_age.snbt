			]
			title: "Lift the Star"
			x: 2.5d
			y: 0.0d
		}
		{
			dependencies: ["195AB2A8BFFE1A97"]
			description: ["A spinning plasma flings its heavy ions outward. The &6Plasma Mass Filter&r cuts the star into hydrogen, helium, carbon-nitrogen-oxygen and heavy cuts, and cleans the disk plasma the same way."]
			icon: "gtceu:plasma_mass_filter"
			id: "1D6EA5E7B47D1D45"
			rewards: [{ id: "7D1448966778CAF0", type: "xp", xp: 200 }]
