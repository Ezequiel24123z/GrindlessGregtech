			title: "Element 121"
			x: 6.0d
			y: 6.0d
		}
		{
			dependencies: ["7F876A1037924C13", "75CFD23128DE819C"]
			description: ["The same beam on the fermium target makes element 122. With both atoms in hand, the superheavy lab writes &6Census III&r, which the gate keeps."]
			icon: "grindless:superheavy_census_iii"
			id: "5EB2A04DCE181C6C"
			rewards: [{ id: "57A03A9BC5DDF16B", type: "xp", xp: 250 }]
