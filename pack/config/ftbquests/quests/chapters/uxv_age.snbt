	quests: [
		{
			dependencies: ["7C3E8D47479787F5"]
			description: ["The road of the era, from the first step to the gate that leads on. Everything else in the era hangs from it."]
			icon: "minecraft:writable_book"
			id: "78B28FCF40BA6381"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "73961997F930D991", type: "checkmark" }]
			title: "The Journey"
			x: 2.5d
			y: 0.0d
		}
		{
			dependencies: ["1433B6EB4860DF3C"]
			description: [
				"The &6UXV Machine Casing&r is an assembly-line recipe researched with the Kerr chart. The hull waits for parts nobody has made yet."
				"Home builds logic that runs on electron spin. Out there, Cygnus X-1's companion is lifted, a pulsar's crust is mined and a supernova's ashes are swept."
			]
			icon: "gtceu:uxv_machine_casing"
			id: "7C3E8D47479787F5"
			rewards: [{ id: "373FC94AF5780E0A", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "3FA2149F0596E067", item: "gtceu:uxv_machine_casing", type: "item" }]
			title: "Spin and Strange Stars"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["78B28FCF40BA6381"]
			description: ["Magnets a few atoms thick make memory that keeps its bits with the power off, and a sensor made of superfluid feels the Earth turn. They lead to the spintronic mainframe, the UXV circuit."]
			icon: "gtnn:spintronic_mainframe"
			id: "3B0561CB951B62B9"
			rewards: [{ id: "3891F88D181F8072", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "1FE5768C3885F799", type: "checkmark" }]
			title: "Logic From Spin"
			x: 7.5d
			y: -2.0d
		}
		{
			dependencies: ["78B28FCF40BA6381"]
			description: ["The Mk6 ring burns as a massive star does: hydrogen, helium, carbon and oxygen, one after another, each fed by the ash of the last. A ring that runs these stages on demand is fiction; the stages are real."]
			icon: "gtceu:uxv_fusion_reactor"
			id: "14DD94C79F301330"
			rewards: [{ id: "7F300CA54B87E9A9", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "3BBC9242BDE1371E", type: "checkmark" }]
			title: "A Star's Whole Life"
			x: 5.0d
			y: -3.5d
		}
		{
			dependencies: ["78B28FCF40BA6381"]
			description: ["Fermium and einsteinium targets and a beam of titanium reach elements 121 and 122. They last moments, so the chemistry is built around speed. Census III and the island chart close the lane, and the gate keeps both."]
			icon: "gtceu:heavy_ion_cyclotron"
			id: "71359F03B137FB0B"
			rewards: [{ id: "1447C86916D9D40C", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "7D5D4F7D1B2A77C6", type: "checkmark" }]
			title: "Past the Last Element"
			x: 7.5d
			y: -3.5d
		}
		{
			dependencies: ["71359F03B137FB0B"]
			description: ["The calutron picks fermium-257 out of the fermium, the transuranium facility plates it, and the spark plasma sinterer fuses it into an &6Fm-257 Target&r."]
			icon: "grindless:fm257_target"
			id: "7F876A1037924C13"
			rewards: [{ id: "378B5E4D50DA47A9", type: "xp", xp: 150 }]
			tasks: [{ id: "5378BF521AB70593", item: "grindless:fm257_target", type: "item" }]
			title: "Fermium-257 Target"
			x: 12.5d
			y: -3.5d
		}
		{
			dependencies: ["7F876A1037924C13"]
			description: ["Einsteinium-254 is extracted from its solution and set into a target wheel. The &6Einsteinium-254 Target Wheel&r is the heavier half of element 121."]
			icon: "grindless:es254_target"
			id: "345D3A6AE9F52B89"
			rewards: [{ id: "50A46B3D1F665B91", type: "xp", xp: 150 }]
			tasks: [{ id: "581D4124E328D8A0", item: "grindless:es254_target", type: "item" }]
			title: "Einsteinium-254 Target"
			x: 15.0d
			y: -3.5d
		}
		{
			dependencies: ["345D3A6AE9F52B89"]
			description: ["Titanium-50 on einsteinium in the heavy ion cyclotron. The recoil is caught in the same Superheavy Factory and the superheavy lab seals them as an &6Element 121 Recoil&r."]
			icon: "grindless:element_121_recoil"
			id: "75CFD23128DE819C"
			rewards: [{ id: "5172D8694C05FADB", type: "xp", xp: 200 }]
			tasks: [{ id: "73381898FF54CFCB", item: "grindless:element_121_recoil", type: "item" }]
			title: "Element 121"
			x: 17.5d
			y: -3.5d
		}
		{
			dependencies: ["75CFD23128DE819C"]
			description: ["The same beam on the fermium target makes element 122. With both atoms in hand, the superheavy lab writes &6Superheavy Census III&r, which the gate keeps."]
			icon: "grindless:superheavy_census_iii"
			id: "5EB2A04DCE181C6C"
			rewards: [{ id: "57A03A9BC5DDF16B", type: "xp", xp: 250 }]
			tasks: [
				{ id: "7B9165510A81861B", item: "grindless:element_122_recoil", type: "item" }
				{ id: "5278C0C815FA9208", item: "grindless:superheavy_census_iii", type: "item" }
			]
			title: "Element 122"
			x: 20.0d
			y: -3.5d
		}
		{
			dependencies: ["5EB2A04DCE181C6C"]
			description: ["Collide uranium on curium and the two swap nucleons, leaving neutron-rich nuclei near the island of stability. Weigh them by flight time and the &6Island Chart&r comes out."]
			icon: "grindless:island_chart"
			id: "3B31B6CA6A29B354"
			rewards: [{ id: "3B8DD8A719BD7BB3", type: "xp", xp: 250 }]
			tasks: [
				{ id: "53E99955377898FD", item: "grindless:island_nuclide", type: "item" }
				{ id: "7DA854D50204BB5F", item: "grindless:island_chart", type: "item" }
			]
			title: "Island Chart"
			x: 22.5d
			y: -3.5d
		}
		{
			dependencies: ["78B28FCF40BA6381"]
			description: ["Back at Cygnus X-1 the black hole already pulls its companion apart. The stellar elevator heats the surface where the pull is strongest and catches the stream as &6Stellar Plasma&r. It works here and nowhere else."]
			icon: "gtceu:stellar_plasma_bucket"
			id: "195AB2A8BFFE1A97"
			rewards: [{ id: "388598F7D415F760", type: "xp", xp: 200 }]
			tasks: [{ id: "5046C0D10A438081", item: "gtceu:stellar_plasma_bucket", type: "item" }]
			title: "Lift the Star"
			x: 5.0d
			y: 0.0d
		}
		{
			dependencies: ["195AB2A8BFFE1A97"]
			description: ["A spinning plasma flings its heavy ions outward. The plasma mass filter cuts the star into hydrogen, helium, carbon-nitrogen-oxygen and heavy cuts. Take the &6Stellar CNO Cut&r home for the Mk6 and send the heavy one to the condensation tower."]
			icon: "gtceu:stellar_cno_cut_bucket"
			id: "1D6EA5E7B47D1D45"
			rewards: [{ id: "7D1448966778CAF0", type: "xp", xp: 200 }]
			tasks: [{ id: "1C88E209F77FF225", item: "gtceu:stellar_cno_cut_bucket", type: "item" }]
			title: "Stellar Cuts"
			x: 7.5d
			y: 0.0d
		}
		{
			dependencies: ["1D6EA5E7B47D1D45"]
			description: ["The gas falling into the hole spins in a disk hot enough to glow in X-rays. The accretion disk skimmer takes its edge, and the mass filter turns the catch into &6Filtered Disk Plasma&r."]
			icon: "gtceu:filtered_disk_plasma_bucket"
			id: "1F3DBB6C9063CBDB"
			rewards: [{ id: "12FE5E79478614E4", type: "xp", xp: 200 }]
			tasks: [{ id: "389537BC8CAD930A", item: "gtceu:filtered_disk_plasma_bucket", type: "item" }]
			title: "Skim the Disk"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["1F3DBB6C9063CBDB"]
			description: [
				"A field-reversed configuration is a smoke ring of plasma that holds its own field. The FRC former shoots one into a &6FRC Cartridge&r and keeps it there. Vela travel needs one, and so does the gate."
				"FRCs are real; one that sits in a cartridge until you need it is fiction."
			]
			icon: "grindless:frc_cartridge"
			id: "3A4C403FED5649E0"
			rewards: [{ id: "5FC5D87A2989C502", type: "xp", xp: 200 }]
			tasks: [{ id: "5201D12D70F5B07A", item: "grindless:frc_cartridge", type: "item" }]
			title: "FRC Cartridge"
			x: 12.5d
			y: 0.0d
		}
		{
			dependencies: ["3A4C403FED5649E0"]
			description: [
				"Swing a relay seed through the ergosphere and it leaves with some of the hole's spin. The ergosphere probe bay launches it as a &6Launched Relay Seed&r. The laser sail on the Moon launches the same seed, and either one opens the way."
				"The sling is fiction: nothing survives that close a pass, and no seed is this fast."
			]
			icon: "grindless:launched_relay_seed"
			id: "5D9EECDCAB8F0156"
			rewards: [{ id: "7E5A2171BC288563", type: "xp", xp: 200 }]
			tasks: [{ id: "7B7F5A1A5F192B01", item: "grindless:launched_relay_seed", type: "item" }]
			title: "The Kerr Sling"
			x: 15.0d
			y: 0.5d
		}
		{
			dependencies: ["5D9EECDCAB8F0156"]
			description: [
				"A thin bumper in front of a wall breaks up whatever hits it, so the wall only meets a spray. The &6CNT Whipple Shield&r carries a seed through the dust of a supernova remnant."
				"Whipple shields are real; one that survives that crossing at that speed is fiction."
			]
			icon: "grindless:cnt_whipple_shield"
			id: "58EDB9BA0BF842AF"
			rewards: [{ id: "1B3C125E0A4A0819", type: "xp", xp: 200 }]
			tasks: [{ id: "74777C367B47A23F", item: "grindless:cnt_whipple_shield", type: "item" }]
			title: "Whipple Shield"
			x: 17.5d
			y: -1.0d
		}
		{
			dependencies: ["5D9EECDCAB8F0156"]
			description: [
				"The first jump. The ring at Cygnus X-1 holds a launched seed and an FRC cartridge, and when the hold completes a platform appears at the Vela pulsar, a neutron star that spins eleven times a second and now and then speeds up."
				"The ring's output bus gets the platform's &6Relay Coordinates&r. Put them in the input bus of a ring that is holding and stand inside to ride there; step out of the platform's ring and back in to come home."
				"The jump is fiction, as every jump is. The pulsar and its glitches are real."
			]
			icon: "grindless:vela_glitch_timing"
			id: "586BAF51DA2477E3"
			rewards: [{ id: "5B4704B46BA18FC8", type: "xp", xp: 300 }]
			tasks: [{ dimension: "grindless:vela_pulsar_orbit", id: "3E86065FBFD39A5F", type: "dimension" }]
			title: "Vela Pulsar"
			x: 17.5d
			y: 2.0d
		}
		{
			dependencies: ["586BAF51DA2477E3"]
			description: ["Deep in a neutron star's crust the nuclei melt into rods, sheets and holes that physicists call pasta. A glitch shakes the crust loose; the pasta extractor times it and grows &6Raw Pasta&r from a neutronium pellet."]
			icon: "grindless:raw_pasta"
			id: "33D08C69A1A4AF87"
			rewards: [{ id: "1FE208E9444ADFE1", type: "xp", xp: 250 }]
			tasks: [{ id: "7A3E936C23703BE1", item: "grindless:raw_pasta", type: "item" }]
			title: "Raw Pasta"
			x: 20.0d
			y: 0.5d
		}
		{
			dependencies: ["33D08C69A1A4AF87"]
			description: ["The pasta phase sorter separates the rods from the sheets inside a cage that keeps each one squeezed. You get &6Spaghetti Phase&r and &6Lasagna Phase&r, and the anti-phase residue goes to the core sample the gate keeps."]
			icon: "grindless:lasagna_phase"
			id: "1367407C3410944C"
			rewards: [{ id: "798A29CB0DCE6D99", type: "xp", xp: 250 }]
			tasks: [
				{ id: "17E73682D97568C8", item: "grindless:spaghetti_phase", type: "item" }
				{ id: "71334617363E174F", item: "grindless:lasagna_phase", type: "item" }
			]
			title: "Caged Phases"
			x: 22.5d
			y: 0.5d
		}
		{
			dependencies: ["1367407C3410944C"]
			description: ["The Pasta Mill draws spaghetti into wire and presses lasagna into plate: the UXV cable and the UXV hull. Outside a neutron star both would fly apart at once. That is fiction; the crust is real."]
			icon: "gtceu:pasta_strand_single_wire"
			id: "3E5A5DB9F7B862E9"
			rewards: [{ id: "133CD5D55ADB2612", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "79E42C5D98AB437F", type: "checkmark" }]
			title: "Pasta as Cable"
			x: 25.0d
			y: 0.5d
		}
		{
			dependencies: ["58EDB9BA0BF842AF"]
			description: ["The second jump: the Cygnus ring holds a launched seed behind a Whipple shield, and when the hold completes a platform appears among the ejecta of one of the youngest supernova remnants in the galaxy. Ride its &6Relay Coordinates&r there as before. The jump is fiction; the remnant is real."]
			icon: "grindless:ejecta_knot_dust"
			id: "5A539FCEC01451BA"
			rewards: [{ id: "114ED1E43E3AC5FC", type: "xp", xp: 300 }]
			tasks: [{ dimension: "grindless:cas_a_remnant", id: "30A986BDE2DD3F5F", type: "dimension" }]
			title: "Cassiopeia A"
			x: 20.0d
			y: -1.0d
		}
		{
			dependencies: ["5A539FCEC01451BA"]
			description: ["The star's core was thrown out in clumps still rich in what it made as it died. The ejecta knot sweeper gathers &6Ejecta Knot Dust&r, and the X-ray pulse profiler maps its titanium-44."]
			icon: "grindless:ejecta_knot_dust"
			id: "74AAE7464DB346C0"
			rewards: [{ id: "14C7498610F3B608", type: "xp", xp: 250 }]
			tasks: [{ id: "3E0AC299C40CEA39", item: "grindless:ejecta_knot_dust", type: "item" }]
			title: "Knot Dust"
			x: 22.5d
			y: -1.0d
		}
		{
			dependencies: ["74AAE7464DB346C0"]
			description: ["Titanium-44 decays into a positron emitter and lives for decades. The cascade and the calutron take it out of the dust, and the hot cell seals it into a &6Ti-44 Core&r."]
			icon: "grindless:ti44_core"
			id: "17623833C3E320FE"
			rewards: [{ id: "783547992C6C3D7D", type: "xp", xp: 200 }]
			tasks: [{ id: "5FA00BF1D3337E18", item: "grindless:ti44_core", type: "item" }]
			title: "Titanium-44 Core"
			x: 25.0d
			y: -1.0d
		}
		{
			dependencies: ["17623833C3E320FE", "1367407C3410944C"]
			description: [
				"The Matrioshka computing array puts the elevator log, the Vela glitch record, the titanium-44 map and the Cygnus radio record together into the &6Arm Chart&r: our arm of the galaxy, mapped toward the centre."
				"The glitch record is read on Ganymede, where the gravitational-wave array listens against the Vela glitch timing the observatory decodes."
			]
			icon: "grindless:arm_chart"
			id: "1351A1703766CFB3"
			rewards: [{ id: "58C44B087C376411", type: "xp", xp: 300 }]
			tasks: [{ id: "5F17D96620A152C3", item: "grindless:arm_chart", type: "item" }]
			title: "Arm Chart"
			x: 27.5d
			y: -1.0d
		}
		{
			dependencies: ["1351A1703766CFB3"]
			description: [
				"Hold the warp gate open at the full UXV load for sixty seconds in Cygnus X-1 orbit, then tick this box. Plan your power first: a BZ dynamo and two polar cap taps come close, and a charged UXV cell covers the rest."
				"The gate burns an FRC cartridge and keeps census III, the island chart, the arm chart, a pasta core sample and UXV-tier circuits in its store."
			]
			icon: "gtceu:warp_gate"
			id: "5B7D80D05C71F861"
			rewards: [ ]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ id: "33EF140B320839EC", type: "checkmark" }]
			title: "Open the Bulge Gate"
			x: 30.0d
			y: -2.5d
		}
		{
			dependencies: ["5B7D80D05C71F861"]
			description: ["Through the open gate the seed looks at the crowded centre of the galaxy. The run gives the &6Bulge Chart&r."]
			icon: "grindless:bulge_chart"
			id: "12FAC9CC1F7D8215"
			rewards: [{ id: "5F6ED52C77A903F3", type: "xp", xp: 450 }]
			tasks: [{ id: "3D40587E02E27C43", item: "grindless:bulge_chart", type: "item" }]
			title: "Chart the Bulge"
			x: 32.5d
			y: -3.0d
		}
		{
			dependencies: ["12FAC9CC1F7D8215"]
			description: ["The &6Bulge Chart&r is the research for the OpV machine casing. Build it and the next voltage is open."]
			icon: "gtceu:opv_machine_casing"
			id: "3D7C8C36A2896D4E"
			rewards: [{ id: "1A231FFBAEAB69DA", type: "xp", xp: 400 }]
			shape: "diamond"
			size: 1.75d
			tasks: [{ id: "3D02E4B50E814A30", item: "gtceu:opv_machine_casing", type: "item" }]
			title: "Gate to OpV"
			x: 35.0d
			y: -3.0d
		}
		{
			dependencies: ["3BB0A93D15E3A2D3"]
			description: ["A shell of gum metal, a titanium alloy that bends without breaking, backed by a tungsten-184 preform. It is the plain wall of the age: the Spintronic Cluster Tool, the Mk6 ring and the polar cap tap are mostly made of it. An assembler (400 ticks): 8 gum metal billets, 4 tungsten-184 CVI preforms, 4 annealed mu-metal foils and 8 tungsten-184 single wires, with epoxy, for two casings. Most UXV structures: the Mk6 Fusion Reactor (about 2,000), the MNT Collider (about 2,000), the Stellar Fractionation Hall (about 1,800), the Pasta Mill (about 1,700), the BZ Dynamo (about 1,400), the Spintronic Cluster Tool (about 1,400), the Stellar Condensation Tower (about 860) and the FRC Former (about 690). Billets, preforms and foils by ME: a structure takes thousands, so build the casing a dedicated line."]
			hide_dependency_lines: true
			icon: "grindless:gum_metal_casing"
			id: "3AE94BE58677BDB5"
			rewards: [{ id: "5A27314B3FBA5B59", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 64L, id: "3532DA0C75BA4109", item: "grindless:gum_metal_casing", type: "item" }]
			title: "Gum Metal Casing"
			x: 22.5d
			y: 12.5d
		}
		{
			dependencies: ["3AE94BE58677BDB5"]
			description: ["A casing wound with metallic hydrogen cable and finemet cores that holds a field pulsed fast enough to steer a plasma, a beam or a stream of dense matter. The reactor, the collider and the elevator ring are lined with it. The naquadria magnet works, circuit 15: 12 metallic hydrogen windings, 6 Ga2O3 power dies, 3 finemet cores, 6 gum metal billets and 4 UIV emitters, for twelve casings. The Mk6 Fusion Reactor (about 1,300), the Pasta Mill (about 810), the MNT Collider (about 800), the BZ Dynamo (about 790), the Stellar Elevator (about 740), the FRC Former (about 460) and the Plasma Mass Filter (about 260). The windings are the bottleneck; send them and the dies to the works by ME and keep the power dies stocked."]
			icon: "grindless:pulsed_field_casing"
			id: "5EE4709C70DD7071"
			rewards: [{ id: "717CA54CEF3317C2", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 64L, id: "702ED9439810BD34", item: "grindless:pulsed_field_casing", type: "item" }]
			title: "Pulsed Field Casing"
			x: 26.0d
			y: 12.5d
		}
		{
			dependencies: ["3AE94BE58677BDB5"]
			description: ["A casing of annealed mu-metal that bends a magnetic field around what it covers. The magnetic layers of the spintronic fab would be erased by a stray field, so the Spintronic Cluster Tool is shielded with it. An assembler (500 ticks): 16 annealed mu-metal foils, 4 gum metal billets, 4 tungsten-184 CVI preforms and 2 UIV sensors, with epoxy, for eight casings. It takes UIV sensors, not UXV ones: the Cluster Tool makes the dies a UXV sensor is built from. The Spintronic Cluster Tool, which takes about 870 of them. Foils and billets by ME; the sensors are the costly part, so make them ahead of the batch."]
			icon: "grindless:mu_metal_shield_casing"
			id: "7D2B0B47005ABB49"
			rewards: [{ id: "7DB089483384F510", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 64L, id: "59E972733C1B9700", item: "grindless:mu_metal_shield_casing", type: "item" }]
			title: "Mu-Metal Shield Casing"
			x: 29.5d
			y: 12.5d
		}
		{
			dependencies: ["5EE4709C70DD7071"]
			description: ["A violet-black casing with magenta striations, built to hold nuclear pasta, the matter in a neutron star's crust. Each is a cage of field-reversed rings around a gum metal wall. An assembler (600 ticks): 32 FRC cartridges, 32 cage parts, 32 gum metal billets and a UIV field generator, with epoxy, for sixty-four casings. The pasta structures of Vela: the Pasta Extractor (about 260) and the Pasta Mill (about 1,670) are walled with it. Its FRC cartridges and cage parts are all made before Vela, so you can stock it before the jump. FRC cartridges by ME from the field-reversed line; the cage parts and billets by ME."]
			icon: "grindless:pasta_containment_casing"
			id: "7D76D64E0BDA52D9"
			rewards: [{ id: "140F8191648A1DE4", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 64L, id: "135EF589587E2369", item: "grindless:pasta_containment_casing", type: "item" }]
			title: "Pasta Containment Casing"
			x: 26.0d
			y: 15.0d
		}
		{
			dependencies: ["3AE94BE58677BDB5"]
			description: ["The first wall of the Mk6 ring: a refractory high-entropy tile on a tungsten-184 preform, wound with metallic hydrogen cable and framed in tritanium. It faces the plasma. An assembler (600 ticks): 12 tungsten-fibre RHEA billets, 12 tungsten-184 CVI preforms, 12 metallic hydrogen windings, 12 tritanium frames and a UXV field generator, with 6N helium, for twenty-four casings. The Mk6 Fusion Reactor, which takes about 250 of them. The ring is about 4,100 blocks, too large for one pass of GTM's Terminal, which places about 2,300 per pass, so it takes two. Billets, preforms and windings by ME; make the casings in a batch before you start the ring."]
			icon: "grindless:uxv_fusion_casing"
			id: "1A089D167C86B673"
			rewards: [{ id: "397814951D9611D4", type: "xp", xp: 160 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 64L, id: "70DF65D19A128483", item: "grindless:uxv_fusion_casing", type: "item" }]
			title: "UXV Fusion Casing"
			x: 22.5d
			y: 15.0d
		}
		{
			dependencies: ["78B28FCF40BA6381"]
			description: ["The wafers, chips and circuits of the era, from the first wafer to the mainframe, and the parts built from them."]
			icon: "minecraft:writable_book"
			id: "75CB408277AF9075"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "15265895EF281783", type: "checkmark" }]
			title: "Circuits"
			x: 5.0d
			y: 12.0d
		}
		{
			dependencies: ["77ECA9A3DDFB480D"]
			description: ["Cobalt, iron and boron melted in the levitation melter, atomised, printed and pressed into a bonded &6CoFeB Target&r. The magnesia, Heusler and SAF targets come the same way."]
			icon: "grindless:cofeb_target"
			id: "5A5BA6B9228A4383"
			rewards: [{ id: "184989028EF88168", type: "xp", xp: 100 }]
			tasks: [
				{ id: "7E0B29BF824D6628", item: "grindless:cofeb_ingot", type: "item" }
				{ id: "17F658071C44D8AF", item: "grindless:cofeb_target", type: "item" }
			]
			title: "CoFeB Target"
			x: 10.0d
			y: 12.0d
		}
		{
			dependencies: ["5A5BA6B9228A4383", "1595ABB6AB097B3E"]
			description: ["Two magnets with an insulator a few atoms thick between them: current tunnels through more easily when they point the same way. A wafer of them, cut up, gives the &6MTJ Die&r. The MTJ sputter cluster, a CoFeB target and a magnesia target, on silicon-28. The racetrack chip, the SHeQUID gyro and the mainframe itself, and later the UXV sensor, emitter and hatches. Targets wear out, so stock them by ME and send dies on to the foundry."]
			icon: "grindless:mtj_die"
			id: "7A0AB21F31B7820B"
			rewards: [{ id: "5F77A2DE046B6BE8", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "169FAB1A0BAC3061", item: "grindless:mtj_die", type: "item" }]
			title: "Magnetic Tunnel Junction Die"
			x: 12.5d
			y: 12.0d
		}
		{
			dependencies: ["7A0AB21F31B7820B"]
			description: ["The same junctions in a grid make memory that keeps its bits with the power off. The &6MRAM Wafer&r is sputtered, annealed and etched. The MTJ sputter cluster, the photonic foundry and a Heusler target. The spintronic mainframe, which takes the wafer whole as its fast memory. Dies and targets by ME; keep a few wafers waiting for the Spintronic Cluster Tool."]
			icon: "grindless:mram_wafer"
			id: "3B4ABEFD993C5FE7"
			rewards: [{ id: "56D11ACBBADAA1EC", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3F6717F34E6F2A02", item: "grindless:mram_wafer", type: "item" }]
			title: "MRAM Wafer"
			x: 15.0d
			y: 12.0d
		}
		{
			dependencies: ["7A0AB21F31B7820B"]
			description: ["Oxide films only grow well on a crystal whose spacing matches theirs. Dysprosium scandate is grown as a boule, sliced, polished and annealed into a &6DyScO3 Substrate&r. The crystal growth furnace from UHV, then slicing, polishing and an anneal. The MESO logic die, whose films need this crystal underneath. Boules are slow, so run two furnaces and stock substrates in a chest."]
			icon: "grindless:dysco3_substrate"
			id: "3044F5740EC5319D"
			rewards: [{ id: "37470CF7D9117F23", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3FB1CCB0BD50E23D", item: "grindless:dysco3_substrate", type: "item" }]
			title: "Scandate Substrate"
			x: 15.0d
			y: 13.5d
		}
		{
			dependencies: ["3B4ABEFD993C5FE7", "1595ABB6AB097B3E"]
			description: ["Push magnetic domains along a nanowire with current pulses and read them as they pass a head. The &6Racetrack Chip&r is the memory of the mainframe. The Spintronic Cluster Tool, an MTJ die and a patterned SAF track wafer. The spintronic mainframe, as its storage. Wafers by ME; the fab returns chips in a chest, so stock a few."]
			icon: "grindless:racetrack_chip"
			id: "33E470E07FDCB9C9"
			rewards: [{ id: "7F25BC2DB3F1FB4E", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3C41E39CEEAB7668", item: "grindless:racetrack_chip", type: "item" }]
			title: "Racetrack Chip"
			x: 17.5d
			y: 12.0d
		}
		{
			dependencies: ["3044F5740EC5319D", "1595ABB6AB097B3E"]
			description: ["One 28Si wafer carries the CMOS layer, the memory, the racetrack, the spin-wave bus and a multiferroic switch read by a spin-orbit stack. Cut in four, it makes the &6Spintronic Die&r. The MOCVD reactor, the photonic foundry, the vdW stacker, the MRAM wafer, the racetrack chip and the magnonic bus. The spintronic mainframe, as its logic, memory and bus in one. Run the wafer line as one chain by ME; the cutter returns four dies per wafer."]
			icon: "grindless:spintronic_die"
			id: "528E7523EDB83CC3"
			rewards: [{ id: "19F673989FBFE430", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "57198121A626161C", item: "grindless:spintronic_die", type: "item" }]
			title: "Spintronic Die"
			x: 17.5d
			y: 14.5d
		}
		{
			dependencies: ["33E470E07FDCB9C9", "528E7523EDB83CC3", "7486DF37973BED77"]
			description: ["Spin waves in a garnet film carry signals between the chips with almost no heat. Logic, memory and that bus together are the &6Spintronic Mainframe&r, the UXV circuit. The photonic integration hall, a racetrack chip, a MESO logic die, an MRAM wafer, an MTJ die, a shielded interposer and a magnonic bus from the YIG furnace. The UXV hull, emitter and hatches, the OpV casing and the controller of every UXV machine. They take any UXV circuit. One of each part per mainframe: keep a dedicated chest, never a big stock."]
			icon: "gtnn:spintronic_mainframe"
			id: "72D835B7C533F4A5"
			rewards: [{ id: "56300952C8BAFC35", type: "xp", xp: 250 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "36D8C64E88D967FC", item: "gtnn:spintronic_mainframe", type: "item" }]
			title: "Spintronic Mainframe"
			x: 20.0d
			y: 15.0d
		}
		{
			dependencies: ["75CB408277AF9075"]
			description: ["A silicon nitride membrane drilled with thousands of holes, each narrower than a virus, by the electron beam furnace. Superfluid helium leaks through the &6Nanoaperture Array&r in step, as one quantum object."]
			icon: "grindless:nanoaperture_array"
			id: "5562CBB4F6304BB1"
			rewards: [{ id: "5656D7361817B272", type: "xp", xp: 100 }]
			tasks: [{ id: "7EC448ED8DB5EA53", item: "grindless:nanoaperture_array", type: "item" }]
			title: "Nanoaperture Array"
			x: 7.5d
			y: 15.5d
		}
		{
			dependencies: ["5562CBB4F6304BB1", "7AE0BEC91F59A48B"]
			description: ["Two baths of superfluid helium joined by the array oscillate at a frequency set by the pressure across it. The &6Weak Link Cell&r is that pair, filled and sealed. The SHeQUID works, a nanoaperture array and superfluid helium. The SHeQUID gyro, which closes two of them into a loop. Helium by pipe; cells come out sealed, so send them straight on."]
			icon: "grindless:weak_link_cell"
			id: "1E406BA02A37205D"
			rewards: [{ id: "7615F33772CCE588", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5DA4F3874226E985", item: "grindless:weak_link_cell", type: "item" }]
			title: "Weak Link Cell"
			x: 10.0d
			y: 16.5d
		}
		{
			dependencies: ["1E406BA02A37205D"]
			description: ["Two weak links in a loop make an interferometer for superfluid, and it feels the rotation of the Earth. The &6SHeQUID Gyro&r is real physics. The SHeQUID works and two weak link cells. The UXV sensor. Cells arrive by ME; one gyro goes into each sensor."]
			icon: "grindless:shequid_gyro"
			id: "37DA616C29C996F0"
			rewards: [{ id: "7353C1E0DEE070E3", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "725EB4799D1D41A9", item: "grindless:shequid_gyro", type: "item" }]
			title: "SHeQUID Gyro"
			x: 12.5d
			y: 16.5d
		}
		{
			dependencies: ["37DA616C29C996F0"]
			description: ["The &6UXV Sensor&r feels rotation with superfluid and magnetic fields with diamond. The emitter, both new generators and most controllers need one. A SHeQUID gyro, an NV diamond chip, an MTJ die and a UIV sensor, with UIV circuits, on the assembly line. The UXV hull and emitter, and the controllers of the Cygnus, Vela and Cassiopeia machines. Gyros by ME in matched counts; keep sensors in a small stock."]
			icon: "gtceu:uxv_sensor"
			id: "103E024FEAF25DDC"
			rewards: [{ id: "195F84FA1ECDA9B1", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "539FFF875D152F3C", item: "gtceu:uxv_sensor", type: "item" }]
			title: "UXV Sensor"
			x: 25.0d
			y: 16.5d
		}
		{
			dependencies: ["586BAF51DA2477E3"]
			description: ["The &6UXV Machine Hull&r is the first thing Vela's lasagna plate goes into, with the UXV casing, a UXV voltage coil, a Ga2O3 power die and a UXV sensor. The UXV hatches and buses are built on it."]
			icon: "gtceu:uxv_machine_hull"
			id: "3BB0A93D15E3A2D3"
			rewards: [{ id: "5A674D4B87D5B74F", type: "xp", xp: 200 }]
			tasks: [{ id: "3AFD3095A3D2A6A7", item: "gtceu:uxv_machine_hull", type: "item" }]
			title: "UXV Machine Hull"
			x: 20.0d
			y: 7.5d
		}
		{
			dependencies: ["3BB0A93D15E3A2D3"]
			description: ["The &6UXV Electric Motor&r is wound with pasta strand stators and metallic hydrogen windings round a meteorite-iron rotor, and the &6UXV Electric Pump&r pushes liquid metal with a moving field. The piston and the conveyor move by metals that change shape in a magnetic field, the robot arm turns on a gear with no backlash, and the field generator projects from a plasma ring that holds its own field."]
			icon: "gtceu:uxv_electric_motor"
			id: "795E541822A26BC7"
			rewards: [{ id: "58CB8EF35A95FF71", type: "xp", xp: 200 }]
			tasks: [
				{ id: "3110BAE92ABD1A13", item: "gtceu:uxv_electric_motor", type: "item" }
				{ id: "571BE1FD19B39568", item: "gtceu:uxv_electric_pump", type: "item" }
				{ id: "30E135BF5379EBDE", item: "gtceu:uxv_electric_piston", type: "item" }
				{ id: "13721A0B14F115EE", item: "gtceu:uxv_conveyor_module", type: "item" }
				{ id: "35958CB7A5F49B19", item: "gtceu:uxv_robot_arm", type: "item" }
				{ id: "1DB17EFAA51AE3AB", item: "gtceu:uxv_field_generator", type: "item" }
			]
			title: "UXV Components"
			x: 25.0d
			y: 8.0d
		}
		{
			dependencies: ["795E541822A26BC7"]
			description: ["The &6UXV Circuit Assembler&r is the assembler that works at the voltage of the mainframe, for everything below it that still wants a board. A UXV hull and the UXV components, with the cleanroom you already run. Faster circuit rows at UXV voltage; the mainframe itself still comes from the photonic hall. Boards and chips by ME; keep a small stock of what it returns."]
			icon: "gtceu:uxv_circuit_assembler"
			id: "19524CCC00377A52"
			rewards: [{ id: "705E5DD5DE2AA7A6", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "125E963E8CFADECE", item: "gtceu:uxv_circuit_assembler", type: "item" }]
			title: "UXV Circuit Assembler"
			x: 27.5d
			y: 8.0d
		}
		{
			dependencies: ["103E024FEAF25DDC", "37FCF1CA912EC06F"]
			description: ["With a gamma laser in hand, the &6UXV Emitter&r can be built. The parallel hatch and the OpV casing both need it."]
			icon: "gtceu:uxv_emitter"
			id: "567A7CE091E678B6"
			rewards: [{ id: "70C7F98B85259420", type: "xp", xp: 250 }]
			tasks: [{ id: "39790D59FAA213DA", item: "gtceu:uxv_emitter", type: "item" }]
			title: "UXV Emitter"
			x: 32.5d
			y: 16.5d
		}
		{
			dependencies: ["567A7CE091E678B6"]
			description: [
				"The &6UXV Energy Input Hatch&r takes the full UXV voltage into a machine, and it is the door every UXV controller draws its power through."
				"It is built in the assembly line on a UXV hull with the emitter parts of this page, UXV circuits and the lasagna cable of the age. Without it the UXV machines of the next chapters do not run. Make hatches in small batches by ME: each machine needs one, and a multiblock with parallel hatches needs more."
			]
			icon: "gtceu:uxv_energy_input_hatch"
			id: "3E0AF625714AD8D6"
			rewards: [{ id: "57885FB68C9EBCF7", type: "xp", xp: 200 }]
			tasks: [{ id: "7CEE5FC8B78C80E0", item: "gtceu:uxv_energy_input_hatch", type: "item" }]
			title: "UXV Energy Hatch"
			x: 35.0d
			y: 16.5d
		}
		{
			dependencies: ["78B28FCF40BA6381"]
			description: ["Power, networks and processes that tie this era to the lines you already run."]
			icon: "minecraft:writable_book"
			id: "14B0B5EA38F22432"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "16CDBBB8397BFFB8", type: "checkmark" }]
			title: "Integration"
			x: 5.0d
			y: -12.0d
		}
		{
			dependencies: ["14DD94C79F301330"]
			description: ["The first burn of the &6Mk6 Fusion Reactor&r runs on the stellar hydrogen and CNO cuts and gives CNO ash plasma, which the converter takes as current. A formed Mk6 ring on UXV hatches and both cuts from Cygnus X-1. The ring refuses a run when its start energy is above what it stores. Current for the gate, and a little CNO cut back from the converter for the next run. Cuts arrive over AE2 from the filter; the ash goes straight to the converter."]
			icon: "gtceu:cno_ash_plasma_bucket"
			id: "7B79626CA22F70D0"
			rewards: [{ id: "7C4F2045F1A34DAA", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "76FCBE2DBD2CF30B", item: "gtceu:cno_ash_plasma_bucket", type: "item" }]
			title: "Hot CNO"
			x: 7.5d
			y: -10.0d
		}
		{
			dependencies: ["7B79626CA22F70D0"]
			description: ["Three helium nuclei make carbon, and carbon takes a fourth to make oxygen. The ring burns triple-alpha fuel, which the cryogenic plant on the Moon makes from the stellar helium cut. Triple-alpha fuel from the Moon's cryogenic plant, and the same ring and converter as before. Carbon-12 and oxygen-16, the fuels of the next two burns. Send the carbon and oxygen to their own lines. Both are fuel, not waste."]
			icon: "gtceu:helium_burning_ash_plasma_bucket"
			id: "7884A0887B1AEAF8"
			rewards: [{ id: "5A063CAF977A16D5", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5DEB7122722E6FF3", item: "gtceu:helium_burning_ash_plasma_bucket", type: "item" }]
			title: "Triple Alpha"
			x: 10.0d
			y: -11.0d
		}
		{
			dependencies: ["7884A0887B1AEAF8"]
			description: ["The third burn lights carbon vapour from the electron beam furnace and leaves neon, sodium and magnesium once the converter is done. Carbon-12 vapour by pipe, and a quench caster to catch the ash. Ordinary neon, sodium and magnesium for stock. Ash goes to storage; nothing in it is dangerous."]
			icon: "gtceu:carbon_burning_ash_plasma_bucket"
			id: "58CBCB43698A8853"
			rewards: [{ id: "15BC98CD6BFF4289", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "527015E16C32AE3C", item: "gtceu:carbon_burning_ash_plasma_bucket", type: "item" }]
			title: "Carbon Burning"
			x: 12.5d
			y: -11.0d
		}
		{
			dependencies: ["58CBCB43698A8853"]
			description: ["The fourth burn is the last stage the ring runs. Its ash leaves silicon, sulfur and phosphorus once the converter and the quench caster are done with it. Oxygen-16 fuel, liquefied by the cryogenic plant on the Moon, and a ring that has survived the stages before. Silicon-28 for the next era and the biggest plasma payout of the ring. Keep oxygen on its own line from the plant, and send the silicon to storage."]
			icon: "gtceu:oxygen_burning_ash_plasma_bucket"
			id: "556B77B76C999DD0"
			rewards: [{ id: "3B9EFB22B1DC4A2D", type: "xp", xp: 250 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "57D0C572D5862A62", item: "gtceu:oxygen_burning_ash_plasma_bucket", type: "item" }]
			title: "Oxygen Burning"
			x: 15.0d
			y: -11.0d
		}
		{
			dependencies: ["556B77B76C999DD0"]
			description: ["The &6Direct Energy Converter&r takes four Mk6 plasmas and returns current plus ash, and the &6Plasma Quench Caster&r splits that ash into stock. Both are older machines with new rows. The plasma buckets of the four burns. The converter's output is not doubled by a generator array. Current from the Mk6 burns, and ash for stock. Plasma by pipe from the ring; leave the converter's hatches free of anything else."]
			icon: "gtceu:direct_energy_converter"
			id: "1CB676F7EAC74DA9"
			rewards: [{ id: "3C6DF5E366D1C4D7", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "1301D119C95C248A", item: "gtceu:direct_energy_converter", type: "item" }
				{ id: "5B53E1B7AB1CCC13", item: "gtceu:plasma_quench_caster", type: "item" }
			]
			title: "Ash Into Power"
			x: 17.5d
			y: -11.0d
		}
		{
			dependencies: ["3A4C403FED5649E0"]
			description: [
				"A spinning black hole threaded by a magnetic field drives a current, and the hole slows to pay for it. The &6BZ Dynamo&r burns flux-loaded plasma, which the FRC former makes from filtered disk plasma, at Cygnus X-1 only. Flux-loaded plasma from the FRC former and a 16 A UXV dynamo hatch. It works in orbit at Cygnus X-1 and nowhere else. The largest single source of the era, a good part of the gate's draw. Cartridges and plasma come from the same line at Cygnus; the power rides the wireless network home."
				"The dynamo is fiction: nobody has tapped a black hole's spin. The Blandford-Znajek process it is named for is real."
			]
			icon: "gtceu:bz_dynamo"
			id: "35B76894EE56CE9E"
			rewards: [{ id: "30C86D8351CE8C6B", type: "xp", xp: 250 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "16BC00FB573790F3", item: "gtceu:flux_loaded_plasma_bucket", type: "item" }]
			title: "Spin Down a Black Hole"
			x: 15.0d
			y: -1.0d
		}
		{
			dependencies: ["586BAF51DA2477E3"]
			description: ["Above a pulsar's magnetic poles the field tears charges off the surface. The &6Polar Cap Tap&r lowers a &6Lasagna Electrode&r into that current and burns through it, at Vela only. A fresh electrode for each run, and a place on the Vela platform. It has no sunlight to spare and does not need any. The second source of the gate's draw, and one that costs no fuel but the electrode. Electrodes are laminated on the spot; the output rides the wireless network."]
			icon: "gtceu:polar_cap_tap"
			id: "3CB2242D767833B2"
			rewards: [{ id: "5B10434E6FAEC481", type: "xp", xp: 250 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "14B612B31A5BD25A", item: "grindless:lasagna_electrode", type: "item" }]
			title: "Tap the Polar Cap"
			x: 20.0d
			y: 2.0d
		}
		{
			dependencies: ["14B0B5EA38F22432"]
			description: ["The &6Extreme Parallel Control Hatch&r lets a machine that takes parallel hatches run up to 65,536 copies of one recipe at once, each at its own EU/t. It is the most expensive hatch of the era. A UXV hull, UXV circuits, a field generator, an emitter, metallic hydrogen cable, RHEA plates and FFKM seals on the assembly line, researched on the Insane hatch. Then power for every copy. The stellar fractionation hall at full width. Give the machine a bus wide enough for the copies it will run."]
			icon: "gtceu:uxv_parallel_hatch"
			id: "5B064A6634A46338"
			rewards: [{ id: "331AA67E06D12EDC", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
