				{ id: "53588EB6E5331C42", item: "gtceu:uxv_wireless_dynamo_hatch", type: "item" }
				{ id: "10E9A7C5E5209478", item: "grindless:pasta_strand_repeater", type: "item" }
			]
			title: "The Network Goes UXV"
			x: 10.0d
			y: -14.5d
		}
		{
			dependencies: ["13386736693D927A"]
			description: ["The gate to OpV holds the full UXV load for a minute; EMI shows the draw. A BZ dynamo and two polar cap taps make about that much before the network takes its cut, so add a source or let a charged UXV cell carry the rest. Tick this box once your sources are in place."]
			icon: "gtceu:uxv_wireless_energy_hatch"
			id: "151A6D1089A0C953"
			rewards: [{ id: "5CA3FDF5A8919FB8", type: "xp", xp: 25 }]
