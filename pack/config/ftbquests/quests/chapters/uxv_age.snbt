				{ id: "7E9952DE7FF64984", item: "gtceu:accretion_disk_skimmer", type: "item" }
				{ id: "151A07DE12463F31", item: "grindless:pulsed_field_casing", type: "item" }
			]
			title: "Accretion Disk Skimmer"
			x: 20.0d
			y: 9.0d
		}
		{
			dependencies: ["344ECF8428D0E972"]
			description: ["Cool a star slowly and its metals come out in the order a young solar system makes them. The &6Stellar Condensation Tower&r draws off refractory, metal and silicate condensates, and lets the volatiles out as gas. A UIV hull, about 860 gum metal and 180 pulsed field casings, and a draw-off pipe for every stage. The shape is about 13 by 31 by 13 and about 1,480 blocks. The condensates that go to the heavy cut, and syngas for the plants at home. A chest or tank per draw-off; the volatile gas needs somewhere to go."]
			icon: "gtceu:stellar_condensation_tower"
			id: "110D7283172BA400"
			rewards: [{ id: "778CC442DB2C58E4", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7845A4775B5A634D", item: "gtceu:stellar_condensation_tower", type: "item" }
				{ id: "3CF53EBC3B6E3497", item: "grindless:gum_metal_casing", type: "item" }
				{ id: "1A0F6E339CBE19F5", item: "grindless:pulsed_field_casing", type: "item" }
			]
			title: "Stellar Condensation Tower"
			x: 20.0d
			y: 10.5d
		}
		{
			dependencies: ["110D7283172BA400"]
			description: ["The first thing to come out of the tower, and the hardest to melt. The UXV Lines chart shows what it becomes."]
			icon: "grindless:refractory_condensate"
