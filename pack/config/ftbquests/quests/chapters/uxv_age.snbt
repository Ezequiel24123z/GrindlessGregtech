				{ id: "58870364B8D50034", item: "grindless:cryostat_casing", type: "item" }
			]
			title: "SHeQUID Works"
			x: 7.5d
			y: 14.0d
		}
		{
			dependencies: ["77ECA9A3DDFB480D"]
			description: ["Collide uranium on curium and the two swap nucleons, leaving neutron-rich nuclei near the island of stability. The &6MNT Collider&r stops them in gas and weighs them by flight time. A UIV hull, the high power casing, a long beamline and a gas catcher. Island nuclides, and with them the island chart the OpV research asks for. Targets and ion sources by ME; the yield is a trickle, so send it straight to the chart."]
			icon: "gtceu:mnt_collider"
			id: "112452274F3E9096"
			rewards: [{ id: "73062A763AF5AE20", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "328576CEF538773F", item: "gtceu:mnt_collider", type: "item" }
				{ id: "7FCA4799590A84A5", item: "gtceu:high_power_casing", type: "item" }
			]
			title: "MNT Collider"
			x: 10.0d
			y: 9.0d
		}
		{
			dependencies: ["77ECA9A3DDFB480D"]
			description: ["The black hole already pulls its companion apart. The &6Stellar Elevator&r heats the star's surface where the pull is strongest and catches the stream as plasma. It works at Cygnus X-1 only. A UIV hull, the UXV machine casing and a stack of coil rings, with power for the heating. Stellar plasma, which the mass filter cuts and the condensation tower cools. The plasma goes by pipe to the filter; a tank in between keeps the lift steady."]
			icon: "gtceu:stellar_elevator"
			id: "1F198C897B7C73D8"
			rewards: [{ id: "132D17CCC398E465", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "30E9DF75D366723A", item: "gtceu:stellar_elevator", type: "item" }
				{ id: "1772800E567F1E1D", item: "gtceu:uxv_machine_casing", type: "item" }
			]
			title: "Stellar Elevator"
			x: 12.5d
			y: 9.5d
		}
		{
			dependencies: ["1F198C897B7C73D8"]
			description: ["A spinning plasma flings its heavy ions outward. The &6Plasma Mass Filter&r cuts the star into hydrogen, helium, carbon-nitrogen-oxygen and heavy cuts, and cleans disk plasma the same way. A UIV hull, the high power casing and the radial ports. The cuts that feed the Mk6 ring and the condensation tower. One tank per cut, each on its own pipe; the filter does not forgive a mixed line."]
			icon: "gtceu:plasma_mass_filter"
			id: "344ECF8428D0E972"
			rewards: [{ id: "33A27B0F41FAB8AF", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1D91DE28ABFA9088", item: "gtceu:plasma_mass_filter", type: "item" }
				{ id: "351C9F4D367448E1", item: "gtceu:high_power_casing", type: "item" }
			]
			title: "Plasma Mass Filter"
			x: 17.5d
			y: 9.5d
		}
		{
			dependencies: ["344ECF8428D0E972"]
			description: ["The gas falling into the hole spins in a disk hot enough to glow in X-rays. The &6Accretion Disk Skimmer&r skims its edge and sends the catch to the mass filter. A UIV hull, the UXV machine casing and a rim of coils round the bowl. Filtered disk plasma, the fuel of the FRC former and the BZ dynamo. Route the catch by pipe to the filter and keep the surplus in a tank."]
			icon: "gtceu:accretion_disk_skimmer"
			id: "1887C02641FE7714"
			rewards: [{ id: "5F1B3C559EA8C45A", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7E9952DE7FF64984", item: "gtceu:accretion_disk_skimmer", type: "item" }
				{ id: "733253DDA8C281CA", item: "gtceu:uxv_machine_casing", type: "item" }
			]
			title: "Accretion Disk Skimmer"
			x: 20.0d
			y: 9.0d
		}
		{
			dependencies: ["344ECF8428D0E972"]
			description: ["Cool a star slowly and its metals come out in the order a young solar system makes them. The &6Stellar Condensation Tower&r draws off refractory, metal and silicate condensates, and lets the volatiles out as gas. A UIV hull, the UXV machine casing and a draw-off pipe for every stage. The condensates that rule 3 sends to the heavy cut, and syngas for the plants at home. A chest or tank per draw-off; the volatile gas needs somewhere to go."]
			icon: "gtceu:stellar_condensation_tower"
			id: "110D7283172BA400"
			rewards: [{ id: "778CC442DB2C58E4", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7845A4775B5A634D", item: "gtceu:stellar_condensation_tower", type: "item" }
				{ id: "3896B93FD6DFDD95", item: "gtceu:uxv_machine_casing", type: "item" }
			]
			title: "Stellar Condensation Tower"
			x: 20.0d
			y: 10.5d
		}
		{
			dependencies: ["110D7283172BA400"]
			description: ["The first thing to come out of the tower, and the hardest to melt. The UXV Lines chart shows what it becomes."]
			icon: "grindless:refractory_condensate"
			id: "3139714CCC049908"
			rewards: [{ id: "767E7C5D5EEE5D15", type: "xp", xp: 80 }]
			tasks: [{ id: "3CEAAB651BEF7351", item: "grindless:refractory_condensate", type: "item" }]
			title: "Refractory Condensate"
			x: 22.5d
			y: 10.5d
		}
		{
			dependencies: ["1887C02641FE7714"]
			description: ["A field-reversed configuration is a smoke ring of plasma that holds its own field. The &6FRC Former&r shoots one into a cartridge and keeps it there. A UIV hull, the high power casing, a formation tube and a capacitor bank. The FRC cartridge: travel to Vela, the field generator and the gate all use one. Disk plasma by pipe; cartridges are consumed, so stock a generous chest."]
			icon: "gtceu:frc_former"
			id: "518B1C106BB5136F"
			rewards: [{ id: "11396B852BA09281", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "133660D591D495A2", item: "gtceu:frc_former", type: "item" }
				{ id: "1EBCDDE069DDDBC3", item: "gtceu:high_power_casing", type: "item" }
				{ id: "5B782C13EA8BFF8F", item: "grindless:cryostat_casing", type: "item" }
			]
			title: "FRC Former"
			x: 22.5d
			y: 9.0d
		}
		{
			dependencies: ["518B1C106BB5136F"]
			description: ["A spinning black hole threaded by a magnetic field drives a current, and the hole slows down to pay for it. The &6BZ Dynamo&r burns flux-loaded plasma that way. A UIV hull, the UXV machine casing and a flux loop inside the torus. Power at Cygnus X-1, with no fuel but the plasma. Feed flux-loaded plasma by pipe and ship the power home over the wireless link."]
			icon: "gtceu:bz_dynamo"
			id: "3611A4EAC7D055C3"
			rewards: [{ id: "1615166934B28465", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "17889A5DB785D254", item: "gtceu:bz_dynamo", type: "item" }
				{ id: "5BBFE15D6E67C4C8", item: "gtceu:uxv_machine_casing", type: "item" }
			]
			title: "BZ Dynamo"
			x: 25.0d
			y: 9.5d
		}
		{
			dependencies: ["795E541822A26BC7", "344ECF8428D0E972"]
			description: ["The &6Mk6 Fusion Ring&r burns as a star does: hot CNO, then helium, carbon and oxygen. A direct converter takes the power off each ash, and one burn's ash is quenched into the next one's fuel. A UXV hull, UXV components, the UXV fusion casing, the Mk5 coil and fusion glass. The plasma and burn quests of the integration chapter. Fuel and coolant by pipe; a ring that runs a star's burning stages on demand is fiction, so plan the ash chain first."]
			icon: "gtceu:uxv_fusion_reactor"
			id: "5CE1C18D40A0B8E2"
			rewards: [{ id: "13D1BD31FCFD288E", type: "xp", xp: 250 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5C330717261B2CB1", item: "gtceu:uxv_fusion_reactor", type: "item" }
				{ id: "504F99CB405FBA6C", item: "grindless:uxv_fusion_casing", type: "item" }
				{ id: "5255BED4DDC68445", item: "gtceu:fusion_glass", type: "item" }
			]
			title: "Mk6 Fusion Ring"
			x: 27.5d
			y: 10.5d
		}
		{
			dependencies: ["586BAF51DA2477E3"]
			description: ["Deep in a neutron star's crust the nuclei melt into rods, sheets and holes that physicists call pasta. A glitch shakes the crust loose, and the &6Pasta Extractor&r times it. A UIV hull, the neutron star site casing and a receiver cage. Raw pasta, the start of every pasta item. Neutronium pellets by ME; wait for a glitch and collect the haul."]
