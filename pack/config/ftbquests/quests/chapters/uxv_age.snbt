		}
		{
			dependencies: ["7C3E8D47479787F5"]
			description: ["The black hole already pulls its companion apart. The &6Stellar Elevator&r heats the star's surface where the pull is strongest and catches the stream as &6Stellar Plasma&r. It works at Cygnus X-1 only."]
			icon: "gtceu:stellar_elevator"
			id: "195AB2A8BFFE1A97"
			rewards: [{ id: "388598F7D415F760", type: "xp", xp: 200 }]
