			]
			title: "Condensation"
			x: 7.5d
			y: 2.5d
		}
		{
			dependencies: ["1D6EA5E7B47D1D45"]
			description: ["The gas falling into the hole spins in a disk hot enough to glow in X-rays. The &6Accretion Disk Skimmer&r skims its edge, and the mass filter turns the catch into &6Filtered Disk Plasma&r."]
			icon: "gtceu:accretion_disk_skimmer"
