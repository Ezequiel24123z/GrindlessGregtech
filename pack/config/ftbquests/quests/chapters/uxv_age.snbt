				{ id: "7F3A5AD491D6BAC7", item: "gtceu:mtj_sputter_cluster", type: "item" }
				{ id: "7153D7373D23E2BD", item: "gtceu:plascrete", type: "item" }
			]
			title: "MTJ Sputter Cluster"
			x: 10.0d
			y: 10.5d
		}
		{
			dependencies: ["1595ABB6AB097B3E"]
			description: ["The &6Racetrack Fab&r patterns nanowires where magnetic domains slide, in a cleanroom with an electron beam over it. A UIV hull, the plascrete shell and the cleanroom parts, plus MRAM wafers to cut. The racetrack chip, which is the mainframe's storage. Wafers by ME; send chips on to the photonic hall."]
			icon: "gtceu:racetrack_fab"
			id: "780482A9BF2D46A1"
			rewards: [{ id: "7645678A25BE453A", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
