	quests: [
		{
			dependencies: ["1433B6EB4860DF3C"]
			description: [
				"The Kerr chart gave you the &6UXV Machine Casing&r. The hull waits for parts nobody has made yet."
				"Home builds logic that runs on electron spin. Out there, Cygnus X-1's companion is lifted, a pulsar's crust is mined and a supernova's ashes are swept."
			]
			icon: "gtceu:uxv_machine_casing"
			id: "7C3E8D47479787F5"
			rewards: [{ id: "373FC94AF5780E0A", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "3FA2149F0596E067", item: "gtceu:uxv_machine_casing", type: "item" }]
			title: "Spin and Strange Stars"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7C3E8D47479787F5"]
			description: ["Cobalt, iron and boron melted in the levitation melter, atomised, printed and pressed into a bonded &6CoFeB Target&r. The magnesia, Heusler and SAF targets come the same way."]
			icon: "grindless:cofeb_target"
			id: "5A5BA6B9228A4383"
			rewards: [{ id: "184989028EF88168", type: "xp", xp: 100 }]
			tasks: [
				{ id: "7E0B29BF824D6628", item: "grindless:cofeb_ingot", type: "item" }
				{ id: "17F658071C44D8AF", item: "grindless:cofeb_target", type: "item" }
			]
			title: "Sputter Targets"
			x: 2.5d
			y: -2.5d
		}
		{
			dependencies: ["5A5BA6B9228A4383"]
			description: ["Two magnets with an insulator a few atoms thick between them: current tunnels through more easily when they point the same way. The &6MTJ Sputter Cluster&r lays the stack on silicon-28, and the wafer ends as an &6MTJ Die&r."]
			icon: "gtceu:mtj_sputter_cluster"
			id: "1595ABB6AB097B3E"
			rewards: [{ id: "1835656A2A02BB85", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7F3A5AD491D6BAC7", item: "gtceu:mtj_sputter_cluster", type: "item" }
				{ id: "1DA0EA6A20272C99", item: "grindless:mtj_die", type: "item" }
			]
			title: "Magnetic Tunnel Junction"
			x: 5.0d
			y: -2.5d
		}
		{
			dependencies: ["1595ABB6AB097B3E"]
			description: ["The same junctions in a grid make memory that keeps its bits with the power off. The &6MRAM Wafer&r is sputtered, annealed, etched and finished in the photonic foundry."]
			icon: "grindless:mram_wafer"
			id: "3B4ABEFD993C5FE7"
			rewards: [{ id: "56D11ACBBADAA1EC", type: "xp", xp: 100 }]
			tasks: [{ id: "3F6717F34E6F2A02", item: "grindless:mram_wafer", type: "item" }]
			title: "Magnetic Memory"
			x: 7.5d
			y: -2.5d
		}
		{
			dependencies: ["3B4ABEFD993C5FE7"]
			description: ["Push magnetic domains along a nanowire with current pulses and read them as they pass a head. The &6Racetrack Fab&r patterns the track and cuts the &6Racetrack Chip&r."]
			icon: "gtceu:racetrack_fab"
			id: "780482A9BF2D46A1"
			rewards: [{ id: "7645678A25BE453A", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "379CB9B017C1ADE8", item: "gtceu:racetrack_fab", type: "item" }
				{ id: "72F0A9D6C9BE2C75", item: "grindless:racetrack_chip", type: "item" }
			]
			title: "Racetrack Memory"
			x: 10.0d
			y: -2.5d
		}
		{
			dependencies: ["1595ABB6AB097B3E"]
			description: ["Oxide films only grow well on a crystal whose spacing matches theirs. Dysprosium scandate is grown as a boule, sliced, polished and annealed into a &6DyScO3 Substrate&r."]
			icon: "grindless:dysco3_substrate"
			id: "3044F5740EC5319D"
			rewards: [{ id: "37470CF7D9117F23", type: "xp", xp: 100 }]
			tasks: [{ id: "3FB1CCB0BD50E23D", item: "grindless:dysco3_substrate", type: "item" }]
			title: "Scandate Substrate"
			x: 7.5d
			y: -5.0d
		}
		{
			dependencies: ["3044F5740EC5319D"]
			description: ["A multiferroic film flips a magnet with voltage instead of current, and a spin-orbit stack reads it back. The &6Oxide PLD Chamber&r grows the films, the &6vdW Stacking Cell&r builds the readout, and the photonic foundry joins them into a &6MESO Logic Die&r."]
			icon: "gtceu:oxide_pld_chamber"
			id: "17F1BEE08FE87731"
			rewards: [{ id: "74B3E11427024DEE", type: "xp", xp: 200 }]
