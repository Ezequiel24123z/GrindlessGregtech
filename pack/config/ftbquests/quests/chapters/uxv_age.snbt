			y: -13.0d
		}
		{
			dependencies: ["14B0B5EA38F22432"]
			description: ["The nitride magnet works winds the &6UXV SMES Cell&r from four UIV cells, strand tape and superfluid helium. Four UIV SMES Cells, strand tape, superfluid helium and a UXV-tier circuit, in the nitride magnet works. The UXV wireless tier. Nothing to feed. Size the towers for your busiest hour."]
			icon: "grindless:uxv_smes_cell"
			id: "3F5ABDEF2254EC50"
			rewards: [{ id: "1E7EFD50A6261DA8", type: "xp", xp: 200 }]
