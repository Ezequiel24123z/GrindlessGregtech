				{ id: "1ED4F9AD90E4FA46", item: "grindless:meso_logic_die", type: "item" }
			]
			title: "MESO Logic"
			x: 10.0d
			y: -5.0d
		}
		{
			dependencies: ["780482A9BF2D46A1", "17F1BEE08FE87731"]
			description: ["Spin waves in a garnet film carry signals between the chips with almost no heat. The &6YIG LPE Furnace&r grows that film, and the Photonic Integration Hall puts logic, memory and bus together into a &6Spintronic Mainframe&r."]
			icon: "gtnn:spintronic_mainframe"
			id: "72D835B7C533F4A5"
			rewards: [{ id: "56300952C8BAFC35", type: "xp", xp: 250 }]
			tasks: [
				{ id: "38BB50747B67BC04", item: "gtceu:yig_lpe_furnace", type: "item" }
				{ id: "70A2624738EC6A57", item: "gtnn:spintronic_mainframe", type: "item" }
			]
			title: "Spintronic Mainframe"
			x: 12.5d
			y: -3.75d
		}
		{
			dependencies: ["72D835B7C533F4A5"]
			description: ["A silicon nitride membrane drilled with thousands of holes, each narrower than a virus, by the electron beam furnace. Superfluid helium leaks through the &6Nanoaperture Array&r in step, as one quantum object."]
			icon: "grindless:nanoaperture_array"
			id: "5562CBB4F6304BB1"
			rewards: [{ id: "5656D7361817B272", type: "xp", xp: 100 }]
			tasks: [{ id: "7EC448ED8DB5EA53", item: "grindless:nanoaperture_array", type: "item" }]
			title: "Nanoaperture Array"
			x: 15.0d
			y: -5.5d
		}
		{
			dependencies: ["5562CBB4F6304BB1"]
			description: ["Two baths of superfluid helium joined by the array oscillate at a frequency set by the pressure across it. The &6SHeQUID Works&r fills and seals the &6Weak Link Cell&r."]
			icon: "gtceu:shequid_works"
			id: "7AE0BEC91F59A48B"
			rewards: [{ id: "52B703A60683FA50", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
