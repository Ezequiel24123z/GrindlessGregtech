			x: 18.0d
			y: -2.0d
		}
		{
			dependencies: ["17623833C3E320FE", "1367407C3410944C"]
			description: ["The Matrioshka in Mercury orbit puts the elevator log, the Vela glitch record, the titanium-44 map and the Cygnus radio record together into the &6Arm Chart&r: our arm of the galaxy, mapped toward the centre."]
			icon: "grindless:arm_chart"
			id: "1351A1703766CFB3"
