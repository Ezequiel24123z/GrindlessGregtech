			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["3A4C403FED5649E0"]
			description: ["A spinning black hole threaded by a magnetic field drives a current, and the hole slows down to pay for it. The &6BZ Dynamo&r burns &6Flux-Loaded Plasma&r from the FRC former that way, at Cygnus X-1 only."]
			icon: "gtceu:bz_dynamo"
			id: "3611A4EAC7D055C3"
			rewards: [{ id: "1615166934B28465", type: "xp", xp: 250 }]
			shape: "gear"
			size: 1.25d
