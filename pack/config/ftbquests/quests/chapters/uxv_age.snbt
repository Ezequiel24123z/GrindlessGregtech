		{
			dependencies: ["795E541822A26BC7", "344ECF8428D0E972"]
			description: ["The &6Mk6 Fusion Reactor&r burns as a star does: hot CNO, then helium, carbon and oxygen. A direct converter takes the power off each ash, and one burn's ash is quenched into the next one's fuel. A UXV hull, UXV components, the UXV fusion casing, the Mk5 coil and fusion glass. The plasma and burn quests that follow. Fuel and coolant by pipe; a ring that runs a star's burning stages on demand is fiction, so plan the ash chain first."]
			icon: "gtceu:uxv_fusion_reactor"
			id: "5CE1C18D40A0B8E2"
			rewards: [{ id: "13D1BD31FCFD288E", type: "xp", xp: 250 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5C330717261B2CB1", item: "gtceu:uxv_fusion_reactor", type: "item" }
				{ id: "504F99CB405FBA6C", item: "grindless:uxv_fusion_casing", type: "item" }
				{ id: "5255BED4DDC68445", item: "gtceu:fusion_glass", type: "item" }
			]
			title: "Mk6 Fusion Reactor"
			x: 27.5d
			y: 10.5d
		}
		{
			dependencies: ["586BAF51DA2477E3"]
			description: ["Deep in a neutron star's crust the nuclei melt into rods, sheets and holes that physicists call pasta. A glitch shakes the crust loose, and the &6Pasta Extractor&r times it. A UIV hull, the neutron star site casing and a receiver cage. Raw pasta, the start of every pasta item. Neutronium pellets by ME; wait for a glitch and collect the haul."]
			icon: "gtceu:pasta_extractor"
			id: "1C34EDB89AD1F5C9"
			rewards: [{ id: "1121096DA82C1238", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "184DA14CA333EC3E", item: "gtceu:pasta_extractor", type: "item" }
				{ id: "138DF982719F160B", item: "grindless:neutron_star_site_casing", type: "item" }
			]
			title: "Pasta Extractor"
			x: 20.0d
			y: 5.0d
		}
		{
			dependencies: ["1C34EDB89AD1F5C9"]
			description: ["The &6Pasta Phase Sorter&r separates the rods from the sheets inside a cage that keeps each one squeezed. The anti-phase residue goes to the core sample the gate keeps. A UIV hull, the neutron star site casing and five cryostat cage bays. Spaghetti phase for wire and lasagna phase for plate. Raw pasta by ME; send each phase to its own line."]
			icon: "gtceu:pasta_phase_sorter"
			id: "353D67B60E559EE1"
			rewards: [{ id: "75883048E114CE67", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "58C6F95474C92833", item: "gtceu:pasta_phase_sorter", type: "item" }
				{ id: "345D9E94876CC187", item: "grindless:neutron_star_site_casing", type: "item" }
				{ id: "1BD7837B7573FCFE", item: "grindless:cryostat_casing", type: "item" }
			]
			title: "Pasta Phase Sorter"
			x: 22.5d
			y: 5.0d
		}
		{
			dependencies: ["353D67B60E559EE1"]
			description: ["The &6Pasta Draw Bench&r pulls spaghetti phase through aerogel into strand wire, the UXV wire. Pasta as wire is fiction: outside a neutron star it would fly apart at once. A UIV hull, the neutron star site casing and a long, straight bed. Pasta strand wire, which the motor, the field generator and the SMES cell are wound with. Spaghetti phase by ME; wire leaves on a spool, so stock a few."]
			icon: "gtceu:pasta_draw_bench"
			id: "7A933F3FF611A461"
			rewards: [{ id: "56230F56D11FD48C", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "530F7D2774C484EF", item: "gtceu:pasta_draw_bench", type: "item" }
				{ id: "5FC390036EB5BEB2", item: "grindless:neutron_star_site_casing", type: "item" }
			]
			title: "Pasta Draw Bench"
			x: 25.0d
			y: 5.0d
		}
		{
			dependencies: ["353D67B60E559EE1"]
			description: ["The &6Pasta Laminator&r presses lasagna phase onto a tungsten-fibre billet as a plate, the plate of the UXV hull and parts. Pasta as plate is fiction, for the same reason as the wire. A UIV hull, the neutron star site casing and a robust platen. Lasagna plate, then the UXV hull. Phase and billets by ME; plates stack up, so send them on."]
			icon: "gtceu:pasta_laminator"
			id: "3CCB6C8A5332CADD"
			rewards: [{ id: "193A8B97013D719C", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "33DF6F56B9115400", item: "gtceu:pasta_laminator", type: "item" }
				{ id: "564E04C38B269476", item: "grindless:neutron_star_site_casing", type: "item" }
				{ id: "7E54036D6B84BDB0", item: "gtceu:robust_machine_casing", type: "item" }
			]
			title: "Pasta Laminator"
			x: 25.0d
			y: 6.5d
		}
		{
			dependencies: ["3CCB6C8A5332CADD"]
			description: [
				"The &6Lasagna Plate&r is the structural plate of the UXV hull and of every UXV part: a tungsten-fibre billet with a lasagna phase pressed onto it."
				"The Pasta Laminator makes it from the phase and a billet, which the sorting row supplies. It unlocks the UXV hull and, through it, every UXV machine. Plates stack quickly, so feed phase and billets by ME and send the plates on to the hull line."
			]
			icon: "grindless:lasagna_plate"
			id: "34D1D9ED3F6FBC67"
			rewards: [{ id: "16164FF0FF0A3286", type: "xp", xp: 80 }]
			tasks: [{ id: "503BA155D586710D", item: "grindless:lasagna_plate", type: "item" }]
			title: "Lasagna Plate"
			x: 27.5d
			y: 6.5d
		}
		{
			dependencies: ["7A933F3FF611A461"]
			description: ["Above a pulsar's magnetic poles the field tears charges off the surface. The &6Polar Cap Tap&r lowers an electrode into that current and burns through it, at Vela only. A UIV hull, the neutron star site casing and a mast of insulator rings. Power at Vela, for the gate hold and the machines out there. Electrodes by ME; the voltage is real, a way to collect it is not."]
			icon: "gtceu:polar_cap_tap"
			id: "50C6BE5A52F4F9A0"
			rewards: [{ id: "71D74C5B44B540E7", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "30987312A1343006", item: "gtceu:polar_cap_tap", type: "item" }
				{ id: "536FA95DF771C4F8", item: "grindless:neutron_star_site_casing", type: "item" }
			]
			title: "Polar Cap Tap"
			x: 27.5d
			y: 5.0d
		}
		{
			dependencies: ["5A539FCEC01451BA"]
			description: ["The star's core was thrown out in clumps still rich in what it made as it died. The &6Ejecta Knot Sweeper&r sweeps them up, behind a shield bow. A UIV hull, the Whipple shield casing and a filter collector. Ejecta knot dust, and titanium-44 from it. Shield weave by ME; the dust comes back by hopper."]
			icon: "gtceu:ejecta_knot_sweeper"
			id: "12376A5961A338E7"
			rewards: [{ id: "56D9BE7C40325044", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "32CE7A9CD71B6B2E", item: "gtceu:ejecta_knot_sweeper", type: "item" }
				{ id: "1CFA9454DF74F43F", item: "grindless:whipple_shield_casing", type: "item" }
			]
			title: "Ejecta Knot Sweeper"
			x: 27.5d
			y: 3.5d
		}
		{
			dependencies: ["12376A5961A338E7"]
			description: ["Slow a core's positrons into positronium, cool it, then let it annihilate all at once into a beam. The &6Annihilation Laser Works&r makes the gamma laser module. A UIV hull, the robust casing as a gamma shield and a Penning trap. The gamma laser module, and the UXV emitter built round it. Titanium-44 cores by ME; the modules are few, so keep them in a chest."]
			icon: "gtceu:annihilation_laser_works"
			id: "37FCF1CA912EC06F"
			rewards: [{ id: "3D80D2BB89E2FB14", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "371ACA9B6E1D5853", item: "gtceu:annihilation_laser_works", type: "item" }
				{ id: "3D5BB3952F16DA90", item: "gtceu:robust_machine_casing", type: "item" }
			]
			title: "Annihilation Laser Works"
			x: 30.0d
			y: 7.5d
		}
		{
			dependencies: ["37FCF1CA912EC06F"]
			description: ["A gamma-ray laser is fiction: nobody has built one. This one goes into the UXV emitter."]
			icon: "grindless:gamma_laser_module"
			id: "1E256F6A845C72DE"
			rewards: [{ id: "3AFF455A942A356F", type: "xp", xp: 80 }]
