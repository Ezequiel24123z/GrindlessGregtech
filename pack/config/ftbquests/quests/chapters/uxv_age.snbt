			]
			title: "Racetrack Fab"
			x: 15.0d
			y: 10.5d
		}
		{
			dependencies: ["77ECA9A3DDFB480D"]
			description: ["The &6Oxide PLD Chamber&r fires a laser at a ceramic target and grows the plume as a crystal film, one oxide layer after another. A UIV hull, the plascrete shell, a heater under the chamber and a scandate substrate to grow on. The multiferroic films of the MESO logic die. Targets by ME and oxygen by pipe; films are fragile, so keep them in the chamber until the foundry needs them."]
			icon: "gtceu:oxide_pld_chamber"
			id: "17F1BEE08FE87731"
			rewards: [{ id: "74B3E11427024DEE", type: "xp", xp: 150 }]
