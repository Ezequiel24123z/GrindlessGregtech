				{ id: "5C75BA5455C94CB6", item: "gtceu:plascrete", type: "item" }
				{ id: "76B59BF64EA9BED2", item: "gtceu:tritanium_coil_block", type: "item" }
			]
			title: "Oxide PLD Chamber"
			x: 10.0d
			y: 13.5d
		}
		{
			dependencies: ["77ECA9A3DDFB480D"]
			description: ["The &6vdW Stacking Cell&r picks single atomic layers with a stamp and presses them into a stack, in a glovebox that is flushed with argon. A UIV hull, the clean casing and a filter column for the argon. The spin-orbit readout of the MESO logic die. Layers by ME; stacks come out one at a time, so run two cells."]
			icon: "gtceu:vdw_stacking_cell"
			id: "7E9BF22B379A4CEB"
			rewards: [{ id: "3785B23E8D650F68", type: "xp", xp: 120 }]
