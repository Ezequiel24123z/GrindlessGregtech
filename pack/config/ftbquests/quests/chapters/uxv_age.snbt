			x: 20.0d
			y: -5.5d
		}
		{
			dependencies: ["37DA616C29C996F0"]
			description: ["The &6UXV Sensor&r feels rotation with superfluid and magnetic fields with diamond. The hull, the emitter and both new generators need it."]
			icon: "gtceu:uxv_sensor"
			id: "103E024FEAF25DDC"
