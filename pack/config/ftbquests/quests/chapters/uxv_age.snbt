			]
			title: "Stellar Cuts"
			x: 5.0d
			y: 0.0d
		}
		{
			dependencies: ["1D6EA5E7B47D1D45"]
			description: ["Cool a star slowly and its metals come out in the order a young solar system makes them. The &6Stellar Condensation Tower&r drops refractory, metal and silicate condensates, and lets the volatiles out as a gas."]
			icon: "gtceu:stellar_condensation_tower"
			id: "110D7283172BA400"
