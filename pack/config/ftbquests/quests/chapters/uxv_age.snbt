			tasks: [{ id: "3F72A32DFC24D6F2", item: "grindless:uxv_smes_cell", type: "item" }]
			title: "The UXV Cell"
			x: 7.5d
			y: -14.5d
		}
		{
			dependencies: ["3F5ABDEF2254EC50"]
			description: ["Move your towers onto &6UXV SMES Cells&r and the wireless network carries UXV to every platform, Cygnus X-1, Vela and Cassiopeia A included. The &6Pasta Strand Repeater&r, pasta strand wire on a pulsar-timed repeater and an MTJ die, links the wireless hatches and goes into the 2 A UXV dynamo hatch. One formed tower holding a UXV cell: the network runs at its strongest cell, so until then it stays at UIV. The wireless hatches at UXV. Add cells when the network dips at your busiest hour."]
			icon: "gtceu:uxv_wireless_energy_hatch"
			id: "13386736693D927A"
			rewards: [{ id: "5CF66D4F358430AC", type: "xp", xp: 200 }]
