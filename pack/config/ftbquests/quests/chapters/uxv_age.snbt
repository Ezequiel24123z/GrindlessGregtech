				{ id: "303ABC678F712DA7", item: "gtceu:clean_machine_casing", type: "item" }
			]
			title: "vdW Stacking Cell"
			x: 7.5d
			y: 8.5d
		}
		{
			dependencies: ["77ECA9A3DDFB480D"]
			description: ["The &6YIG LPE Furnace&r dips a wafer into a molten bath and draws it out coated in a garnet film that carries spin waves almost without loss. A UIV hull, the robust casing, three heater bands and a platinum crucible. The magnonic bus the spintronic mainframe is wired with. Wafers and charge by ME; films take time, so run it in a stack of machines."]
			icon: "gtceu:yig_lpe_furnace"
			id: "7486DF37973BED77"
			rewards: [{ id: "5AEFFDB492571336", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5A6D73BE11783F0A", item: "gtceu:yig_lpe_furnace", type: "item" }
				{ id: "1571A221A995FDFB", item: "gtceu:robust_machine_casing", type: "item" }
			]
			title: "YIG LPE Furnace"
			x: 10.0d
			y: 15.0d
		}
		{
			dependencies: ["77ECA9A3DDFB480D"]
			description: ["The &6SHeQUID Works&r fills two baths of superfluid helium, joins them through an array and seals the pair as a weak link. A UIV hull, the cryostat casing and a supply of superfluid helium. The weak link cell and the gyro the UXV sensor is built from. Helium by pipe; keep the nanoaperture arrays stocked by ME."]
			icon: "gtceu:shequid_works"
			id: "7AE0BEC91F59A48B"
			rewards: [{ id: "52B703A60683FA50", type: "xp", xp: 120 }]
