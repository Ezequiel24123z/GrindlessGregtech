		}
		{
			dependencies: ["5EB2A04DCE181C6C"]
			description: ["Collide uranium on curium and the two swap nucleons, leaving neutron-rich nuclei near the island of stability. The &6MNT Collider&r stops them in gas, weighs them by flight time and writes the &6Island Chart&r."]
			icon: "gtceu:mnt_collider"
			id: "3B31B6CA6A29B354"
