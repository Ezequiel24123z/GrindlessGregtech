			]
			title: "Weak Link"
			x: 17.5d
			y: -5.5d
		}
		{
			dependencies: ["7AE0BEC91F59A48B"]
			description: ["Two weak links in a loop make an interferometer for superfluid, and it feels the rotation of the Earth. The &6SHeQUID Gyro&r is real physics, built in the same works."]
			icon: "grindless:shequid_gyro"
			id: "37DA616C29C996F0"
			rewards: [{ id: "7353C1E0DEE070E3", type: "xp", xp: 150 }]
