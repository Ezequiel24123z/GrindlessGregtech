				{ id: "3200A5A3CE8CF8BA", item: "gtceu:platinum_plant", type: "item" }
			]
			title: "Cold and Strip"
			x: 2.0d
			y: 13.0d
		}
		{
			dependencies: ["53687208B5A566FC"]
			description: ["The &6Hot Cell&r, &6Fluorspar Kiln&r, &6Fuel Fabrication Plant&r, &6Tritium Removal&r, &6Actinide Partitioning Plant&r and &6Methane Pyrolyser&r take rows for spent tiles and targets, thorium and beryllium fluorides, the ACMF pellet, spent shields, curium and pyrolytic graphite. The reactors and plants you already own and the spent parts of the new lines. The pellet, the shield tiles and the graphite anodes. Spent parts return by bus. Nothing in the tailings is dangerous once sorted."]
			icon: "gtceu:hot_cell"
