			]
			title: "Ramp Compression"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["13765E3D3D991767"]
			description: ["An ingot of metallic hydrogen. The UIV Lines chart shows how far one run stretches it, and what the cable and the coil take."]
			icon: "gtceu:metallic_hydrogen_ingot"
			id: "702BC74A807FB921"
			rewards: [{ id: "70F7C032E7FA3297", type: "xp", xp: 100 }]
