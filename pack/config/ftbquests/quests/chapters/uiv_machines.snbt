			]
			title: "BEUV Scanner"
			x: 7.0d
			y: 5.0d
		}
		{
			dependencies: ["3BD8AB33F973A029"]
			description: ["The &6Spectral Hole Burner&r burns a comb of holes into a rare-earth crystal, so it remembers light for hours. A UIV hull and the cryostat casing, on superfluid helium. The six-hour memory. Crystals by ME and helium by pipe; it gives off nothing else."]
			icon: "gtceu:spectral_hole_burner"
			id: "5EA79DAD9574D598"
			rewards: [{ id: "7495E19AEDFFF02B", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "323FFE550EC1A8CB", item: "gtceu:spectral_hole_burner", type: "item" }
				{ id: "5D1FAC1C9CB912B6", item: "grindless:cryostat_casing", type: "item" }
			]
			title: "Spectral Hole Burner"
			x: 9.5d
			y: 5.0d
		}
		{
			dependencies: ["5EA79DAD9574D598"]
			description: ["The &6STM Lithography Cell&r writes a pattern on silicon one atom at a time with a scanning tip, and fills it with phosphorus. A UIV hull, the UEV casing and the photonic casing around an ultra-high vacuum chamber. The patterned wafer and the P:Si die. Phosphine is contained, then scrubbed to phosphoric acid; run two cells, the tip is slow."]
			icon: "gtceu:stm_lithography_cell"
			id: "7C69DFF0AE7530B7"
			rewards: [{ id: "52F31FA5843D6624", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5F51C0DD359AD68D", item: "gtceu:stm_lithography_cell", type: "item" }
				{ id: "3B4C6B61DE3A18BD", item: "gtceu:uev_machine_casing", type: "item" }
				{ id: "314899C77A9A89C1", item: "grindless:photonic_casing", type: "item" }
			]
			title: "STM Lithography Cell"
			x: 12.0d
			y: 5.0d
		}
		{
			dependencies: ["7C69DFF0AE7530B7"]
			description: ["Colder than the superfluid helium plant ever gets. The &6Millikelvin Cryostat Works&r wets a rare-earth stage with helium-3 and finishes the P:Si processor. A UIV hull, the cryostat casing and metallic hydrogen coil blocks for the magnet. The cryostat module and the P:Si processor. The helium mixture returns to the works; send modules on by ME."]
			icon: "gtceu:millikelvin_cryostat_works"
			id: "5B6546A94A7A177E"
			rewards: [{ id: "575ABBA6D471C1AF", type: "xp", xp: 180 }]
