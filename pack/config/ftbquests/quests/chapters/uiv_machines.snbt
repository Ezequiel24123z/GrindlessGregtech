			title: "Femtosecond Writer"
			x: 4.5d
			y: 5.0d
		}
		{
			dependencies: ["1BE7613A33089960"]
			description: ["A terbium plasma gives light at a wavelength nobody built a scanner for before. The &6BEUV Scanner&r exposes wafers at 6.7 nanometres. A UIV hull, the UEV casing and the photonic casing. The exposed wafer and the driver ASIC. Terbium debris returns by pipe after the mirrors are cleaned; wafers by ME."]
			icon: "gtceu:beuv_scanner"
			id: "3BD8AB33F973A029"
			rewards: [{ id: "33C99DE86066A9E9", type: "xp", xp: 150 }]
			shape: "gear"
