			y: 2.5d
		}
		{
			dependencies: ["7B955176F4E8579C"]
			description: ["The &6TFLN Fab&r bonds a thin crystal of lithium niobate onto a silicon nitride chip, in a cleanroom. A UIV hull, the UEV casing and the photonic casing. The LN-on-SiN wafer in the circuits chapter. Boules and nitride wafers by ME; the donor silicon goes back to refining."]
			icon: "gtceu:tfln_fab"
			id: "512711409DE69322"
			rewards: [{ id: "73647ED04344133A", type: "xp", xp: 150 }]
