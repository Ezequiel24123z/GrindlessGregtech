				{ id: "1137247C6008F1B6", item: "grindless:cryostat_casing", type: "item" }
				{ id: "5FBE321F68D9C26F", item: "grindless:metallic_hydrogen_coil_block", type: "item" }
			]
			title: "Polarised Proton Source"
			x: 2.0d
			y: 8.0d
		}
		{
			dependencies: ["57862F697D22D7F2"]
			description: ["Frozen hydrogen that remembers its spin. Mk5 burns three fuels, and each one starts at this source."]
			icon: "grindless:polarised_h_pellet"
			id: "1758D001959E2283"
			rewards: [{ id: "3A6F7D993D9E620B", type: "xp", xp: 100 }]
