				{ count: 2L, id: "616DD88207161317", item: "gtceu:mv_energy_input_hatch", type: "item" }
				{ id: "49688CE9FDA40096", item: "gtceu:mv_battery_buffer_4x", type: "item" }
			]
			title: "MV Grid"
			x: 5.0d
			y: 0.0d
		}
		{
			dependencies: ["483AF81AF99ECB93"]
			description: [
				"Same bronze boilers, one size up: the &6MV Steam Turbine&r drinks more steam per unit and gives back more current."
				"Creosote and biomass carry the plant until diesel and ethanol take over, later in this chapter."
			]
			icon: "gtceu:mv_steam_turbine"
			id: "262640F3533EE2C3"
			rewards: [{ id: "2D4AB7EF96DFA77D", type: "xp", xp: 35 }]
