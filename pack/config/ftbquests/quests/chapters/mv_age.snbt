		{
			dependencies: ["24DEACCFA4DCD216"]
			description: [
				"Quartz sand and carbon melt in the Kanthal EBF at a heat only a Kanthal coil reaches. A hot silicon ingot, carbon monoxide coming off instead of dioxide this time."
				"That CO is worth keeping: a tank for now, methanol later."
			]
			icon: "gtceu:silicon_ingot"
