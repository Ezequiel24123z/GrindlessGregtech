			title: "Hazmat Suit"
			x: 14.0d
			y: 6.0d
		}
		{
			dependencies: ["0D69D5BBC371A5B7"]
			description: [
				"Hull number three, in stainless steel with polyethylene trim. Both the furnace and the plastic line have to be running for this one."
			]
			icon: "gtceu:hv_machine_hull"
			id: "01AAEC5F1DC1C5EE"
			rewards: [{ id: "57FE7D4629271854", type: "xp", xp: 40 }]
