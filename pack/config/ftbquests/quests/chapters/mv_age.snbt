		}
		{
			dependencies: ["1617CBC90D126D2F"]
			description: [
				"Applied Flux, which stores FE in the network, and the wireless pattern terminals both need MV circuits in this pack. Build whichever you'll actually use."
			]
			icon: "ae2:controller"
