		{
			dependencies: ["39A5A5CC76591697"]
			description: [
				"The blast furnace is running and MV parts are already crawling into the base. Hatches, hulls and circuits just step up a size."
				"This is the biggest machine room yet. A flagship multiblock is coming that replaces half of it on its own."
			]
			icon: "gtceu:mv_machine_hull"
			id: "055851443092A93B"
