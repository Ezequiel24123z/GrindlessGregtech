			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["055851443092A93B"]
			description: [
				"Raw rubber from the greenhouse and a pinch of sulfur vulcanize into real rubber; wrapped around copper wire it finally holds MV amperage."
			]
			icon: "gtceu:copper_single_cable"
			id: "7BA0CD6F048B3FDE"
