			x: 25.0d
			y: 9.0d
		}
		{
			dependencies: ["7168260562812CF8"]
			description: [
				"The silicon line's carbon monoxide and the greenhouse's carbon dioxide both end up here: hydrogen turns either one into methanol."
				"Biodiesel, methyl acetate and MV generators all run on it. Nothing about this gas goes to waste."
			]
			icon: "gtceu:mv_chemical_reactor"
			id: "48331D61E0C6B691"
