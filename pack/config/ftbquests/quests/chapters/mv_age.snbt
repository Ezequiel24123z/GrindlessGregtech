		{
			dependencies: ["51BBBA6F37785CD7"]
			description: [
				"The &6Cutter&r slices one ingot into several plates or wafers. Its saw is vanadium steel instead of plain steel, so keep a spare vanadium ingot close by."
				"The &6Laser Engraver&r burns a circuit pattern onto a wafer. Its emitter only lights up with a flawless emerald. The Nether's beryllium vein is the only place to find one without a trip to the End."
			]
			icon: "gtceu:mv_laser_engraver"
			id: "6213116B3B6723B8"
			rewards: [{ id: "1905C6F89AEBEF24", type: "xp", xp: 35 }]
