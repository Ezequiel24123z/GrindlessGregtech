			y: -3.0d
		}
		{
			dependencies: ["74057E6BDC378944"]
			description: [
				"Iron, chromium, manganese and nickel, through the Kanthal EBF at a lower heat than Kanthal itself needs. &6Stainless Steel&r is what the HV hull and the hazmat suit are waiting on."
			]
			icon: "gtceu:stainless_steel_ingot"
			id: "24DEACCFA4DCD216"
