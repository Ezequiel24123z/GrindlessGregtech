			x: 22.5d
			y: 9.0d
		}
		{
			dependencies: ["3AE74DC5E01AD916"]
			description: [
				"Logs go into the &6Pyrolyse Oven&r and a circuit chooses what comes out: charcoal, creosote, tar, wood gas, dark ash, vinegar. Nitrogen in the hatch runs it twice as fast."
			]
			icon: "gtceu:pyrolyse_oven"
			id: "7168260562812CF8"
			rewards: [{ id: "716F10BFB3CF8C10", type: "xp", xp: 35 }]
