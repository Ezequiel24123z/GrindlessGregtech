			title: "MV Cutter and Laser Engraver"
			x: 12.5d
			y: 0.0d
		}
		{
			dependencies: ["51BBBA6F37785CD7"]
			description: [
				"Macerator, ore washer, thermal centrifuge and centrifuge, one size up. Nothing new to learn here: just faster, and about to be replaced."
			]
			icon: "gtceu:mv_macerator"
