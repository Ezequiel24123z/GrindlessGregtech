			x: 27.5d
			y: 9.0d
		}
		{
			dependencies: ["48331D61E0C6B691"]
			description: [
				"A still gives you one fraction at a time. The &6Biorefinery&r is a column that collects them all in one pass: ethanol, methanol, acetic acid, acetone, phenol, benzene, creosote."
				"Not required. A distillery run one fraction at a time still reaches everywhere this chapter goes, just slower."
			]
			icon: "gtceu:biorefinery"
			id: "62C555A8293900FA"
			optional: true
			rewards: [{ id: "36C63C01BD92A0F6", type: "xp", xp: 40 }]
