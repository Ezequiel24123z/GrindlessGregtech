	quest_links: [ ]
	quests: [
		{
			dependencies: ["39A5A5CC76591697"]
			description: [
				"MV is where the factory stops fitting in one room and the lines start feeding each other. The gas off the silicon furnace ends up as methanol, for one."
				"It also takes you past the Nether, to the End, for veins worth the trip."
			]
			icon: "gtceu:mv_machine_hull"
			id: "055851443092A93B"
			rewards: [{ id: "04FC4C525A119501", type: "xp", xp: 40 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "29FAB6C83D5E24E2", type: "checkmark" }]
			title: "MV Factory"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["51BBBA6F37785CD7"]
			description: [
				"Ruby from the deep redstone vein splits into chromium and aluminium in the electrolyzer. Now that you have MV power, bauxite gives you aluminium too."
			]
			icon: "gtceu:chromium_ingot"
			id: "3EB82BACA3DFF6DB"
			rewards: [{ id: "2CADAAFB5EDA183C", type: "xp", xp: 30 }]
			tasks: [
				{ count: 4L, id: "0D9122DA72BB797F", item: "gtceu:chromium_ingot", type: "item" }
				{ count: 4L, id: "47222F0CFA9330D0", item: "gtceu:aluminium_ingot", type: "item" }
			]
			title: "Chromium and Aluminium"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["3EB82BACA3DFF6DB"]
			description: [
				"Iron, aluminium and chromium, mixed and then melted in the blast furnace, which now wants two MV energy hatches. The hot ingot cools in a chemical bath."
				"Wound into coils, it goes back into the furnace that made it, and now that furnace is hot enough for silicon."
			]
			icon: "gtceu:kanthal_coil_block"
			id: "5DC39DF3C1563B6B"
			rewards: [{ id: "5C6DDC6FFEF5B6E3", type: "xp", xp: 35 }]
			tasks: [{ count: 4L, id: "0928209E9F6A03E3", item: "gtceu:kanthal_coil_block", type: "item" }]
			title: "Kanthal"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["3EB82BACA3DFF6DB"]
			description: [
				"Mostly steel, with a little vanadium and chromium. The cutter's saw blade is made of it, and so is the drill bit that can reach the End veins."
			]
			icon: "gtceu:vanadium_steel_ingot"
			id: "74057E6BDC378944"
			rewards: [{ id: "41D73766281A9B27", type: "xp", xp: 30 }]
			tasks: [{ count: 4L, id: "0EEAC3D611425D40", item: "gtceu:vanadium_steel_ingot", type: "item" }]
			title: "Vanadium Steel"
			x: 8.0d
			y: -1.5d
		}
		{
			dependencies: ["5DC39DF3C1563B6B"]
			description: [
				"Iron with chromium, manganese and nickel, through the blast furnace on its two MV hatches. The HV hull and the HV motor are made of it, and the cleanroom needs both."
			]
			icon: "gtceu:stainless_steel_ingot"
			id: "24DEACCFA4DCD216"
			rewards: [{ id: "40C419EDB155285F", type: "xp", xp: 30 }]
			tasks: [{ count: 4L, id: "743FC2F716A5B238", item: "gtceu:stainless_steel_ingot", type: "item" }]
			title: "Stainless Steel"
			x: 8.0d
			y: 1.5d
		}
		{
			dependencies: ["055851443092A93B"]
			description: [
				"The same five parts, one size up, with aluminium and cupronickel where iron and copper used to be. The rest of MV is built from them."
			]
			icon: "gtceu:mv_electric_motor"
			id: "51BBBA6F37785CD7"
			rewards: [{ id: "790DC64279681079", type: "xp", xp: 35 }]
			tasks: [
				{ id: "6E165FEAE1147BC8", item: "gtceu:mv_electric_motor", type: "item" }
				{ id: "11C48258FDAD4CC6", item: "gtceu:mv_electric_piston", type: "item" }
				{ id: "7072F2D65FCD8EBA", item: "gtceu:mv_electric_pump", type: "item" }
				{ id: "73417A9AFF066795", item: "gtceu:mv_robot_arm", type: "item" }
				{ id: "67DAEC4CC0556D49", item: "gtceu:mv_conveyor_module", type: "item" }
			]
			title: "MV Components"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["74057E6BDC378944"]
			description: [
				"The silicon line needs both. The &6Cutter&r runs on a vanadium steel saw blade, and the &6Laser Engraver&r's emitter needs a flawless emerald."
				"The Nether's beryllium vein has the emeralds, and the sifter finds the flawless ones."
			]
			icon: "gtceu:mv_laser_engraver"
			id: "6213116B3B6723B8"
			rewards: [{ id: "1905C6F89AEBEF24", type: "xp", xp: 35 }]
			tasks: [
				{ id: "3B923A18591A522B", item: "gtceu:mv_cutter", type: "item" }
				{ id: "3DD4F723E828CFB2", item: "gtceu:mv_laser_engraver", type: "item" }
			]
			title: "MV Cutter and Laser Engraver"
			x: 10.0d
			y: -1.5d
		}
		{
			dependencies: ["51BBBA6F37785CD7"]
			description: [
				"The LV ore line, all of it, in one building: crush, wash, bake and crush again, with every byproduct delivered. It's built from the MV versions of the machines it replaces."
				"Same ore and the same energy per ore as the loose machines, about ten fewer machines and no buses in between. A second energy hatch doubles the ores in flight."
			]
			icon: "gtceu:ore_plant"
			id: "3FCAFC1E38DD934C"
			rewards: [
				{ id: "1B8BF1FB66892FB3", type: "xp", xp: 80 }
				{ count: 16, id: "44804D8CAFF739EE", item: "minecraft:torch", type: "item" }
			]
			shape: "gear"
			size: 1.75d
			tasks: [{ id: "637CD62AA2052170", item: "gtceu:ore_plant", type: "item" }]
			title: "Ore Plant"
			x: 2.0d
			y: -3.0d
		}
		{
			dependencies: ["51BBBA6F37785CD7"]
			description: [
				"Same samples as the LV drill, and many more bores: one MV hatch keeps it busier than two LV hatches ever kept the last one."
				"Put a vanadium steel bit in the bus and drilling fluid in the tank, and it reaches the End veins too."
			]
			icon: "gtceu:mv_vein_drill"
			id: "430CFDDFCF9174C1"
			rewards: [
				{ id: "0C4CC380A108D82B", type: "xp", xp: 60 }
				{ count: 16, id: "7F949ADB2FDB784E", item: "minecraft:torch", type: "item" }
			]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "4672CBD07B794FDE", item: "gtceu:mv_vein_drill", type: "item" }]
			title: "MV Vein Drill"
			x: 6.0d
			y: -1.5d
		}
		{
			dependencies: ["430CFDDFCF9174C1", "74057E6BDC378944"]
			description: [
				"Wears down far slower than steel, and drilling fluid slows the wear again. It's the first bit that can bite into the End veins."
			]
			icon: "grindless:vanadium_steel_drill_bit"
			id: "30D3D68203F455F9"
			rewards: [{ id: "269EC3BA9860D58B", type: "xp", xp: 25 }]
			tasks: [{ count: 4L, id: "4F9706A386EF5506", item: "grindless:vanadium_steel_drill_bit", type: "item" }]
			title: "Vanadium Steel Drill Bit"
			x: 10.0d
			y: -3.0d
		}
		{
			dependencies: ["3FCAFC1E38DD934C"]
			description: [
				"At MV the centrifuge can finally do something with all that stone dust: quartzite, marble and a handful of other useful dusts come out of it."
				"The mixed metal residue left over isn't worth sorting yet. Drawer it; EV will ask."
			]
			icon: "gtceu:mv_centrifuge"
			id: "793F6428373310F1"
			rewards: [{ id: "2F874B0D92C4AD22", type: "xp", xp: 25 }]
			tasks: [{ id: "511754291104BED2", type: "checkmark" }]
			title: "Stone Dust Separation"
			x: 4.0d
			y: -4.5d
		}
		{
			dependencies: ["5DC39DF3C1563B6B"]
			description: [
				"This is GregTech's own silicon. Silicon dioxide and carbon go into a blast furnace that only gets hot enough with Kanthal coils, and the ingot comes out hot and needs a dip in the chemical bath."
				"Keep the carbon monoxide it gives off. It's poisonous and goes in a tank, and the methanol line takes it later."
			]
			icon: "gtceu:silicon_ingot"
			id: "7C7BAECAD00C19E7"
			rewards: [{ id: "141E1BFA68E4415F", type: "xp", xp: 30 }]
			tasks: [{ count: 4L, id: "24A64FE0CBFB7BBC", item: "gtceu:silicon_ingot", type: "item" }]
			title: "Silicon Ingot"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["7C7BAECAD00C19E7"]
			description: [
				"Back into the furnace with silicon dust and a pinch of gallium arsenide, and out comes a &6Silicon Boule&r, one big single crystal. All your chips for a long while start as slices of one of these."
			]
			icon: "gtceu:silicon_boule"
			id: "12A688D7F923740B"
			rewards: [{ id: "723753988B299A39", type: "xp", xp: 35 }]
			tasks: [{ id: "314055A0A7D0B4DA", item: "gtceu:silicon_boule", type: "item" }]
			title: "Silicon Boule"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["12A688D7F923740B", "6213116B3B6723B8"]
			description: [
				"The cutter slices a boule into a stack of wafers. Handle them gently; there's a long road between a wafer and a working chip."
			]
			icon: "gtceu:silicon_wafer"
			id: "086C8CD2541ED490"
			rewards: [{ id: "0B53DE86A2D8D40B", type: "xp", xp: 30 }]
			tasks: [{ count: 8L, id: "196CF5113D833357", item: "gtceu:silicon_wafer", type: "item" }]
			title: "Silicon Wafers"
			x: 12.0d
			y: 0.0d
		}
		{
			dependencies: ["086C8CD2541ED490"]
			description: [
				"The laser engraver prints a circuit pattern onto the wafer, and the lens colour decides which one: red for ILC, green for RAM. The cutter then dices the printed wafer into chips."
				"Both go into every integrated circuit until HV."
			]
			icon: "gtceu:ilc_chip"
			id: "4A6B8F971E17C847"
			rewards: [{ id: "22837AE7060D658D", type: "xp", xp: 35 }]
			tasks: [
				{ count: 4L, id: "2CA6F3BD5D88EE26", item: "gtceu:ilc_chip", type: "item" }
				{ count: 4L, id: "25078E469CB4E802", item: "gtceu:ram_chip", type: "item" }
			]
			title: "ILC and RAM"
			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["51BBBA6F37785CD7"]
			description: [
				"Many more crops at once than the LV one, and it takes carbon dioxide on top of the fertilizer: the harvest grows by half, with oxygen back for the blast furnace."
				"The logs go to pyrolysis and the crops to the brewery."
			]
			icon: "gtceu:mv_greenhouse"
			id: "3AE74DC5E01AD916"
			rewards: [
				{ id: "4251E295C87B7454", type: "xp", xp: 60 }
				{ count: 4, id: "3F99F7EF4A1613B8", item: "minecraft:wheat_seeds", type: "item" }
			]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "59AE03D63045757C", item: "gtceu:mv_greenhouse", type: "item" }]
			title: "MV Greenhouse"
			x: 4.0d
			y: 3.0d
		}
		{
			dependencies: ["3AE74DC5E01AD916"]
			description: [
				"The &6Pyrolyse Oven&r cooks logs into charcoal and a whole chemistry set of liquids and gases, and the circuit decides which. Nitrogen in the hatch makes it run twice as fast."
			]
			icon: "gtceu:pyrolyse_oven"
			id: "7168260562812CF8"
			rewards: [{ id: "716F10BFB3CF8C10", type: "xp", xp: 35 }]
			tasks: [{ id: "7A6F1688CFA14C4C", item: "gtceu:pyrolyse_oven", type: "item" }]
			title: "Pyrolysis"
			x: 4.0d
			y: 6.0d
		}
		{
			dependencies: ["7168260562812CF8"]
			description: [
				"Remember the carbon monoxide from the silicon furnace and the hydrogen you tanked in LV? The chemical reactor turns them into methanol. Carbon dioxide works too, with more hydrogen."
				"Methanol goes into biodiesel, or straight into a generator."
			]
			icon: "gtceu:mv_chemical_reactor"
			id: "48331D61E0C6B691"
			rewards: [{ id: "7432D0E71BD682FE", type: "xp", xp: 30 }]
			tasks: [{ id: "3858A9F06BB3A0EE", type: "checkmark" }]
			title: "Methanol"
			x: 8.0d
			y: 7.5d
		}
		{
			dependencies: ["48331D61E0C6B691"]
			description: [
				"A distillery gets one fraction out per run and the rest never comes out. The &6Biorefinery&r is a column that keeps them all, one hatch per layer."
				"It only takes organic feedstock, wood and biomass and the like. Crude oil waits for the distillation tower."
			]
			icon: "gtceu:biorefinery"
			id: "62C555A8293900FA"
			rewards: [{ id: "36C63C01BD92A0F6", type: "xp", xp: 40 }]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "6D666454092B45EE", item: "gtceu:biorefinery", type: "item" }]
			title: "Biorefinery"
			x: 12.0d
			y: 6.0d
		}
		{
			dependencies: ["51BBBA6F37785CD7"]
			description: [
				"GregTech's rig pumps oil, gas or salt water from the fluid vein under it. Veins never run dry in this pack, and the Flatlands and the Void have oil and gas too, so pick a spot once and leave it there."
			]
			icon: "gtceu:mv_fluid_drilling_rig"
			id: "1A38798F23E8EA97"
			rewards: [{ id: "58FE1CD5AD9C17E5", type: "xp", xp: 50 }]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "0721BC67872504EC", item: "gtceu:mv_fluid_drilling_rig", type: "item" }]
			title: "MV Fluid Drilling Rig"
			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["1A38798F23E8EA97"]
			description: [
				"Crude goes through the distillery a fraction at a time, hydrogen strips the sulfur out, and the mixer blends what's left into diesel."
				"No oil under the base? Seed oil and methanol make biodiesel, which burns in the same generators."
			]
			icon: "gtceu:mv_distillery"
			id: "44031073B1E3A181"
			rewards: [{ id: "7509CCC2EB6D0716", type: "xp", xp: 30 }]
			tasks: [{ id: "7A175AB84B6DABE5", type: "checkmark" }]
			title: "Diesel"
			x: 6.0d
			y: 3.0d
		}
		{
			dependencies: ["1A38798F23E8EA97"]
			description: [
				"Salt water comes from the rig if your base sits over an ocean; anywhere else, salt and water in the mixer do the job. The electrolyzer splits it into sodium hydroxide, chlorine and hydrogen."
				"The chlorine goes into PVC and the hydrogen into methanol."
			]
			icon: "gtceu:lv_electrolyzer"
			id: "498077C9A58D9578"
			rewards: [{ id: "609D15E06779863F", type: "xp", xp: 30 }]
			tasks: [{ id: "2061C5FD9F9B9C7B", type: "checkmark" }]
			title: "Brine and Chlorine"
			x: 10.0d
			y: 3.0d
		}
		{
			dependencies: ["62C555A8293900FA"]
			description: [
				"Ethanol and sulfuric acid give ethylene, and ethylene with air or oxygen gives polyethylene, your first plastic. Transistors and the HV hull are both waiting on it."
			]
			icon: "gtceu:lv_chemical_reactor"
			id: "0D69D5BBC371A5B7"
			rewards: [{ id: "5946CE65167C48A5", type: "xp", xp: 30 }]
			tasks: [{ id: "2DADD3DCAD01B312", type: "checkmark" }]
			title: "Ethylene and PE"
			x: 14.0d
			y: 3.0d
		}
		{
			dependencies: ["0D69D5BBC371A5B7", "498077C9A58D9578"]
			description: [
				"Chlorine and ethylene make vinyl chloride, and that polymerizes into PVC. The hazmat suit is mostly PVC."
			]
			icon: "gtceu:mv_mixer"
			id: "0F6966AED46B5795"
			rewards: [{ id: "5DE2D5B9164A186F", type: "xp", xp: 30 }]
			tasks: [{ id: "3C0D1AB8A4AB4406", type: "checkmark" }]
			title: "PVC"
			x: 14.0d
			y: 4.5d
		}
		{
			dependencies: ["0D69D5BBC371A5B7"]
			description: [
				"The small parts the integrated circuits eat by the handful. Transistors need silicon and polyethylene, and the plastic only just arrived. The assembler now makes resistors in batches, too."
			]
			icon: "gtceu:transistor"
			id: "6A521D8B1437F9E4"
			rewards: [{ id: "24107FFF763CEE90", type: "xp", xp: 30 }]
			tasks: [
				{ count: 4L, id: "4DA707ABAEF025A9", item: "gtceu:transistor", type: "item" }
				{ count: 4L, id: "1C024E6FA2BEAE4A", item: "gtceu:resistor", type: "item" }
			]
			title: "Transistors and Resistors"
			x: 14.0d
			y: 1.5d
		}
		{
			dependencies: ["4A6B8F971E17C847", "6A521D8B1437F9E4"]
			description: [
				"The first circuits with a real chip inside. The basic one counts as an LV circuit and the good one as MV, and the circuit assembler makes both."
			]
			icon: "gtceu:good_integrated_circuit"
			id: "1617CBC90D126D2F"
			rewards: [{ id: "6E0340634B4E4921", type: "xp", xp: 40 }]
			tasks: [
				{ count: 4L, id: "647511CD759A7CB8", item: "gtceu:basic_integrated_circuit", type: "item" }
				{ count: 4L, id: "7EE54ED2F26F26DA", item: "gtceu:good_integrated_circuit", type: "item" }
			]
			title: "Integrated Circuits"
			x: 16.0d
			y: 0.0d
		}
		{
			dependencies: ["1617CBC90D126D2F", "6A521D8B1437F9E4"]
			description: [
				"The HV circuit, made on MV power. It wants a bit of everything the chip line makes, and the cleanroom won't build without it."
			]
			icon: "gtceu:advanced_integrated_circuit"
			id: "49BA4B42FA5DD586"
			rewards: [{ id: "60E0CBE6799FF623", type: "xp", xp: 50 }]
			tasks: [{ count: 8L, id: "23078925A3CD9598", item: "gtceu:advanced_integrated_circuit", type: "item" }]
			title: "Advanced Integrated Circuit"
			x: 18.0d
			y: 0.0d
		}
		{
			dependencies: ["0F6966AED46B5795"]
			description: [
				"GregTech's hazards are on in this pack, and some of what you handle from here on will hurt you. The &6Hazmat Suit&r keeps it off you, with PVC on the outside and an activated carbon filter in the mask."
				"The carbon comes from pyrolysis with nitrogen in the hatch."
			]
			icon: "gtceu:hazmat_chestpiece"
			id: "7B6466252E0C044A"
			rewards: [{ id: "66D264C84F214235", type: "xp", xp: 45 }]
			tasks: [
				{ id: "22D15E2F083EBEF9", item: "gtceu:hazmat_headpiece", type: "item" }
				{ id: "0F7CA8A312A8C1EB", item: "gtceu:hazmat_chestpiece", type: "item" }
				{ id: "1877B04F88A3D4C5", item: "gtceu:hazmat_leggings", type: "item" }
