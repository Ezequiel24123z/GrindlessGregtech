			x: 2.5d
			y: 0.0d
		}
		{
			dependencies: ["7BA0CD6F048B3FDE"]
			description: [
				"The &6MV Energy Hatch&r feeds a multiblock controller same as before, just more amps. The &6MV Battery Buffer&r smooths the grid for single-block machines."
				"Build them onto the LV to MV transformer from the gate. That is still where MV power comes from until the fuels arrive."
			]
			icon: "gtceu:mv_energy_input_hatch"
			id: "483AF81AF99ECB93"
			rewards: [{ id: "7A557898B6386F2C", type: "xp", xp: 30 }]
