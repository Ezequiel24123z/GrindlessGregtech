		}
		{
			dependencies: ["0624908D6FDF0EF8"]
			description: [
				"The &6Ore Plant&r is the whole chain in one box: crush, wash, roast and crush again, every secondary intact, without a single bus in between."
				"One energy hatch runs several ores at once; a second hatch runs twice that. The recipe does not change. It just stops needing ten machines to run it."
			]
			icon: "gtceu:ore_plant"
			id: "3FCAFC1E38DD934C"
