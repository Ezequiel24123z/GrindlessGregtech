			y: 1.5d
		}
		{
			dependencies: ["01AAEC5F1DC1C5EE"]
			description: [
				"The first two HV parts, made ahead of the rest. The cleanroom runs its fans on these motors."
			]
			icon: "gtceu:hv_electric_motor"
			id: "21B999C2D0EF51A9"
			rewards: [{ id: "1C8DB2E0CEAB0D08", type: "xp", xp: 40 }]
			tasks: [
				{ id: "242873E27919655F", item: "gtceu:hv_electric_motor", type: "item" }
