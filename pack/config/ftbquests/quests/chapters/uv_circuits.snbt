			size: 1.0d
			tasks: [{ id: "7FEB8328EDD9FE61", item: "gtceu:wetware_processor_computer", type: "item" }]
			title: "Wetware Computer"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["37FC04290594CC34", "34BCB5D648DF0A10"]
			description: ["The &6Wetware Processor Mainframe&r is the biggest circuit UV builds, and the one the UHV hulls and the research stations lean on. Wetware computers and photonic chips by the stack, and the UV assembler to put them together. UV machine hulls and the hatches that open the gate to UHV. Make it from stocked parts; ME keeps the mainframes in a dedicated chest."]
			icon: "gtceu:wetware_processor_mainframe"
			id: "3D8568FCB24941A1"
			rewards: [{ id: "1206428CBE865E89", type: "xp", xp: 180 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "37798CC6FECFE514", item: "gtceu:wetware_processor_mainframe", type: "item" }]
			title: "Wetware Mainframe"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["An &6X-ray Mask&r is the stencil the synchrotron exposes a wafer through. Its lines are far finer than any lens can print. A cleanroom, the lithography you already run, and a gold absorber pattern on a thin membrane. The patterned wafer, and through it the photonic chip. A mask is not consumed in one exposure. Keep a few spares by ME and let the exposures draw them."]
			icon: "grindless:x_ray_mask"
			id: "5AC599C3AF5DFDE9"
			rewards: [{ id: "3CF81790EE66902C", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5B14431F93E4F8DC", item: "grindless:x_ray_mask", type: "item" }]
			title: "X-ray Mask"
			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["5AC599C3AF5DFDE9"]
			description: ["A wafer coated in resist, exposed to the synchrotron through the mask and developed is a &6Patterned Wafer&r. The Synchrotron from the machines chapter, a mask, and PMMA-coated wafers. The photonic chip. Coating and developing run in plain machines by ME; only the exposure waits for the beam."]
			icon: "grindless:patterned_wafer"
			id: "1162AE7DDCC8105B"
			rewards: [{ id: "1A0A958B3C1ABFDD", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "76ABC0C58C4DCAFB", item: "grindless:patterned_wafer", type: "item" }]
			title: "Patterned Wafer"
			x: 4.0d
			y: 1.5d
		}
		{
			dependencies: ["1162AE7DDCC8105B"]
			description: ["Cut from the patterned wafer, the &6Photonic Chip&r moves light instead of electrons and does the work of a wafer of ordinary logic. A patterned wafer, silicon nitride film and a cleanroom. The wetware mainframe, and the starchip at the end of this row. One wafer, many chips: keep a stock by ME so the assembler never waits."]
			icon: "grindless:photonic_chip"
			id: "34BCB5D648DF0A10"
			rewards: [{ id: "3BB32BA23EC5774C", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "12414E450AD9070D", item: "grindless:photonic_chip", type: "item" }]
			title: "Photonic Chip"
			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6HPGe Crystal&r is germanium refined past thirteen nines. It is the detector eye that probes and the interferometer carry. Germanium tetrachloride from the photonics line and the zone refining tower from the machines chapter. The SNSPD array beside it and the detector parts of the Starshot. The tower is slow; keep its feed topped up by ME and stock the crystals."]
			icon: "grindless:hpge_crystal"
			id: "55E637B2C7F65A5B"
			rewards: [{ id: "7A16811DCCDADD90", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3BB16E54C3F97654", item: "grindless:hpge_crystal", type: "item" }]
			title: "High-Purity Germanium"
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["55E637B2C7F65A5B"]
			description: ["A superconducting nanowire turns resistive the moment a single photon lands on it. The &6SNSPD Array&r is a grid of them on a niobium nitride film. An NbN-coated wafer from the MOCVD reactor, and the qubit fab with its helium-3 fridge. The optical ground station, the one reader of the Starshot. Tested arrays come out of the fab one wafer at a time; stock them by ME."]
			icon: "grindless:snspd_array"
			id: "10808A5F2A0FCB35"
			rewards: [{ id: "3379B6946A8AD65A", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "527C2EA5EECE407F", item: "grindless:snspd_array", type: "item" }]
			title: "Counting Photons"
			x: 4.0d
			y: 3.0d
		}
		{
			dependencies: ["7D5E30D919EC171F", "34BCB5D648DF0A10", "10808A5F2A0FCB35"]
			description: ["A photonic chip, a diamond qubit, an americium source and a neutronium wafer become one &6Starchip&r. Mounted on a sail it is a probe about as heavy as a paperclip. The Starchip Fab from the machines chapter, and every part on the light row above. The sailcraft, and with it the launch and the long coast to Proxima. The fab dices in batches and wastes only kerf. Send the chips on by ME to the sail line."]
			icon: "grindless:starchip"
