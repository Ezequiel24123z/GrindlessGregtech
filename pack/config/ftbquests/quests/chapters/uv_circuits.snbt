	quests: [
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6UV Circuit Assembler&r is the first assembler that can build the circuits UV machines are made of. UV components for its hull, the cleanroom you already run, and the ZPM circuits that feed it. The wetware computer and mainframe on this row, and every controller of this era. Boards and chips arrive by ME from the cleanroom; keep a stock of what it returns."]
			icon: "gtceu:uv_circuit_assembler"
			id: "1BC78E04FCA4A428"
			rewards: [{ id: "382E6FFF6483B722", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5657C0E0BC2972AA", item: "gtceu:uv_circuit_assembler", type: "item" }]
			title: "UV Circuit Assembler"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["1BC78E04FCA4A428"]
			description: ["Neuro processing units on a larger board make the &6Wetware Processor Computer&r, the first UV circuit. Several neuro processing units for each, the UV assembler, and the vat that grows them in the machines chapter. UV hulls and the controllers of this era that ask for a circuit. Neuro processing units come out of the vat by ME; let the assembler draw them on demand."]
			icon: "gtceu:wetware_processor_computer"
			id: "37FC04290594CC34"
			rewards: [{ id: "55D88910E2A426ED", type: "xp", xp: 120 }]
