		{
			dependencies: ["5BBE143E97647099"]
			description: ["The &6IV Circuit Assembler&r builds the quantum circuits, which the EV assembler cannot. Two Nano Processor Mainframes from the EV circuit assembler (the LuV-tier circuit this machine is built around), and the machine itself. A LuV universal circuit works too. Every quantum circuit, from the processor to the mainframe. Feed boards and chips by ME, and keep a standing stock of mainframes."]
			icon: "gtceu:iv_circuit_assembler"
			id: "15744347C03FF420"
			rewards: [{ id: "3E87A43B00351FBD", type: "xp", xp: 80 }]
