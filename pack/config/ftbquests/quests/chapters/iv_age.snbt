			x: 11.75d
			y: 0.25d
		}
		{
			dependencies: ["774234968F1BEB95", "004525B795119B1B"]
			description: ["An &6LEU Fuel Assembly&r is enriched uranium pressed into pellets and sealed in Zircaloy tubes with a breath of helium. The zirconium comes from the End's zircon, with a pinch of tin."]
			icon: "grindless:leu_fuel_assembly"
