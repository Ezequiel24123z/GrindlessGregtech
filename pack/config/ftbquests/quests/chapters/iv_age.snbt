			y: -4.5d
		}
		{
			dependencies: ["7DCDEF4DEDB8B607"]
			description: ["&6Raw Naquadah&r comes from the bottom of Venus and nowhere else, with a little plutonium on the side. The drill's steam can turn a turbine or just drift off."]
			icon: "gtceu:raw_naquadah"
