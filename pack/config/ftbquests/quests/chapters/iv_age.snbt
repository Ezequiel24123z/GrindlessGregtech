		}
		{
			dependencies: ["5BBE143E97647099"]
			description: ["The &6IV Circuit Assembler&r builds the quantum circuits, which the EV assembler cannot. Nanoprocessor Supercomputers, the EV line's last circuit, and the machine itself. Every quantum circuit, from the processor to the mainframe. Feed boards and chips by ME, and keep a standing stock of supercomputers."]
			icon: "gtceu:iv_circuit_assembler"
			id: "15744347C03FF420"
			rewards: [{ id: "3E87A43B00351FBD", type: "xp", xp: 80 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ count: 2L, id: "7881831A854DDA70", item: "gtceu:nano_processor_computer", type: "item" }
				{ id: "15F6048FF3651AEC", item: "gtceu:iv_circuit_assembler", type: "item" }
			]
			title: "IV Circuit Assembler"
			x: 67.25d
			y: -0.75d
		}
		{
			dependencies: ["15744347C03FF420"]
			description: ["The &6IV Laser Engraver&r etches the quantum wafers with lenses the EV engraver cannot hold. An IV laser engraver and a cutter beside it, both in the cleanroom. The SoC, QBit and HPIC wafers. Wafers in from the network, chips out. Give each lens its own engraver."]
			icon: "gtceu:iv_laser_engraver"
			id: "331B6A580FDEF235"
			rewards: [{ id: "1CA491898740A4B6", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "35C8C113EFAC00B9", item: "gtceu:iv_laser_engraver", type: "item" }
				{ id: "7687D18B7B8C0E3A", item: "gtceu:iv_cutter", type: "item" }
			]
			title: "IV Laser Engraver"
			x: 69.5d
			y: 0.75d
		}
		{
			dependencies: ["331B6A580FDEF235"]
			description: ["The &6Circuit Assembly Line&r builds quantum circuits in bulk, with several inputs at once. Its controller, plus the same boards and chips the single assembler uses. Quantum circuits at the rate the IV hulls and the next era demand. Every slot fed from the network. Stock first, then run."]
			icon: "gtnn:circuit_assembly_line"
			id: "32D0BFCCDAD998A3"
			rewards: [{ id: "5A109EBA78FEBA29", type: "xp", xp: 80 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "34CC912702F00278", item: "gtnn:circuit_assembly_line", type: "item" }]
			title: "Circuit Assembly Line"
			x: 71.0d
			y: 0.75d
		}
		{
			dependencies: ["571EB64508F2FF8E"]
			description: ["Naquadah grows into a boule in the blast furnace, and the cutter slices it into &6Naquadah Wafers&r. Naquadah from Venus and a blast furnace that reaches the temperature. The SoC, QBit and HPIC wafers. Keep a boule always growing and let the cutter feed the wafer line."]
			icon: "gtceu:naquadah_boule"
			id: "5D4FA5EF247AD4CF"
			rewards: [{ id: "7CCA0F7486821158", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
