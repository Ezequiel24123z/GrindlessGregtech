				{ id: "15F6048FF3651AEC", item: "gtceu:iv_circuit_assembler", type: "item" }
			]
			title: "IV Circuit Assembler"
			x: 67.25d
			y: -0.75d
		}
		{
			dependencies: ["15744347C03FF420"]
			description: ["The &6IV Laser Engraver&r       engraves wafers at a higher voltage, with a cutter beside it to slice them. An IV laser engraver and a cutter beside it, both in the cleanroom. A wafer line that keeps up with the IV circuits. Wafers in from the network, chips out. Give each lens its own engraver."]
			icon: "gtceu:iv_laser_engraver"
			id: "331B6A580FDEF235"
			rewards: [{ id: "1CA491898740A4B6", type: "xp", xp: 60 }]
