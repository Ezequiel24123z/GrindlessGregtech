			]
			title: "Naquadah Boule"
			x: 64.25d
			y: -1.25d
		}
		{
			dependencies: ["5D4FA5EF247AD4CF"]
			description: ["A naquadah wafer, engraved, becomes the &6SoC Wafer&r and the cutter turns it into &6SoCs&r. The IV laser engraver and a cleanroom. The quantum processor. A wafer in, chips out. Let ME feed the engraver and store the chips."]
			icon: "gtceu:soc_wafer"
			id: "11004E2A89BF9FDD"
			rewards: [{ id: "54A3267D88379BC3", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7C6F0D1942F2E96C", item: "gtceu:soc_wafer", type: "item" }
				{ id: "7F224B00EE166AFC", item: "gtceu:soc", type: "item" }
			]
			title: "SoC Wafer"
			x: 66.5d
			y: -2.25d
		}
		{
			dependencies: ["11004E2A89BF9FDD"]
			description: ["The &6QBit CPU Wafer&r is a CPU wafer treated with radon, and its chips go into every quantum assembly. Radon from the air line and a chemical reactor that can take it. The quantum assembly and the supercomputer. Radon by pipe, wafers by ME. Keep a spare tank of radon."]
			icon: "gtceu:qbit_cpu_wafer"
			id: "3C9031CEC5BD66A0"
			rewards: [{ id: "7FBF87A64351AA2A", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "365FF9A654DFBEAF", item: "gtceu:qbit_cpu_wafer", type: "item" }
				{ id: "7FA98CC5526432F4", item: "gtceu:qbit_cpu_chip", type: "item" }
			]
			title: "QBit CPU Wafer"
			x: 70.25d
			y: -2.25d
		}
		{
			dependencies: ["3C9031CEC5BD66A0"]
			description: ["The &6HPIC Wafer&r carries the high-power chips that every IV energy part asks for. A large chemical reactor, or the epitaxy route if you have built it. The supercomputer and the IV hatches. Two routes, one wafer. Pick the one your cleanroom can feed and stock chips."]
			icon: "gtceu:hpic_wafer"
			id: "3D0388842F00E792"
			rewards: [{ id: "7EAC883A5BA2042B", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "3D42B7E169C94FF2", item: "gtceu:hpic_wafer", type: "item" }
				{ id: "5F3D39DE4E44D7C8", item: "gtceu:hpic_chip", type: "item" }
			]
			title: "HPIC Wafer"
			x: 71.5d
			y: -2.0d
		}
		{
			dependencies: ["15744347C03FF420", "11004E2A89BF9FDD"]
			description: ["The &6Quantum Processor&r is the quantum line's EV circuit, and it needs a SoC to exist. SoCs, and the IV assembler or the assembly line. The assembly, and every IV machine that wants circuits. Run it from the assembler's own pattern, with SoCs delivered by ME."]
			icon: "gtceu:quantum_processor"
			id: "367F69A30A29D598"
			rewards: [{ id: "714063FCF3E807DB", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 2L, id: "5BD2A7BF1F266933", item: "gtceu:quantum_processor", type: "item" }]
			title: "Quantum Processor"
			x: 68.75d
			y: -0.75d
		}
		{
			dependencies: ["367F69A30A29D598", "3C9031CEC5BD66A0"]
			description: ["The &6Quantum Processor Assembly&r is the quantum line's IV circuit. Quantum processors and QBit chips. The computer, and the IV machines that ask for assemblies. Processors and QBit chips come from the network; the assembler repeats."]
			icon: "gtceu:quantum_processor_assembly"
			id: "380BC31148B70ADC"
			rewards: [{ id: "3C6C8523BAD74808", type: "xp", xp: 70 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "770D0653A861E305", item: "gtceu:quantum_processor_assembly", type: "item" }]
			title: "Quantum Assembly"
			x: 73.0d
			y: 0.25d
		}
		{
			dependencies: ["380BC31148B70ADC", "3D0388842F00E792"]
			description: ["The &6Quantum Processor Computer&r is the quantum line's LuV circuit and the real wall of IV. Assemblies and HPIC chips, which means the whole wafer row behind it. The LuV machine hull, and the mainframe after it. Stock every input in the network first. This recipe is the one that stalls."]
			icon: "gtceu:quantum_processor_computer"
			id: "54D1F497552CE148"
			rewards: [{ id: "71D3CBBD014A0D16", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5F7531D64C1BFC7F", item: "gtceu:quantum_processor_computer", type: "item" }]
			title: "Quantum Processor Computer"
			x: 75.25d
			y: 0.0d
		}
		{
			dependencies: ["54D1F497552CE148"]
			description: ["The &6Quantum Processor Mainframe&r closes the quantum ladder. Computers, and the same cleanroom discipline at a larger scale. Nothing in IV asks for it. Later eras do. A dedicated assembler line and a standing stock of computers."]
			icon: "gtceu:quantum_processor_mainframe"
			id: "7FB0A0FD3F271048"
			rewards: [{ id: "36D03088A92EFA8C", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "122FF36BCD81AE02", item: "gtceu:quantum_processor_mainframe", type: "item" }]
			title: "Quantum Processor Mainframe"
			x: 76.75d
			y: 0.25d
		}
		{
			dependencies: ["3FB9EA4152DCD1D3"]
			icon: "gtceu:hot_cell"
