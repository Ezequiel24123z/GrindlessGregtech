		}
		{
			dependencies: ["554415D1C549C18E"]
			description: ["The &6Tungstensteel Large Boiler&r is the biggest solid-fuel boiler there is. Its controller, with a tungstensteel firebox casing, IV circuits and aluminium cable. Steam for the largest turbine halls. Fuel in by bus, water in by hatch, steam out by hatch."]
			icon: "gtceu:tungstensteel_large_boiler"
			id: "7FCFF04F0E79419B"
			rewards: [{ id: "322FDA7E0581A486", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3B63499FD57FA3D9", item: "gtceu:tungstensteel_large_boiler", type: "item" }]
			title: "Tungstensteel Large Boiler"
			x: 63.25d
			y: 7.25d
		}
		{
			dependencies: ["7FCFF04F0E79419B"]
			description: ["The &6Extreme Combustion Engine&r burns fuel harder than the large one and pays back in power. Its controller, with an IV piston, an IV motor and tungsten steel gears. High-density fuels turned into power at scale. Fuel in by hatch, with oxygen from a tank."]
			icon: "gtceu:extreme_combustion_engine"
			id: "122C790383346A0B"
			rewards: [{ id: "3EA0282ED60190D1", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "359EEF91147B8307", item: "gtceu:extreme_combustion_engine", type: "item" }]
			title: "Extreme Combustion Engine"
			x: 65.25d
			y: 7.25d
		}
		{
			dependencies: ["122C790383346A0B"]
			description: ["The &6IV Large Miner&r clears a wider square than the EV one, and faster. Its controller, with an IV hull, tungsten steel frames and IV circuits. A deeper ore supply for the heavy halls. Ore out by bus, with drilling fluid from a tank."]
			icon: "gtceu:iv_large_miner"
			id: "7FC246DC5AD04520"
			rewards: [{ id: "36B12FB2C676C998", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5342BE87E6794553", item: "gtceu:iv_large_miner", type: "item" }]
			title: "IV Large Miner"
			x: 67.25d
			y: 7.25d
		}
		{
			dependencies: ["7FC246DC5AD04520"]
			description: ["The &6Large Gas Collector&r pulls air, ender air and nether air at the pace of a plant. Its controller, with cobalt brass plates, an IV motor and an IV pump. Gas for every chemistry line that wants a lot of it. Gas out by hatch, straight into a pipe."]
			icon: "extendedfeatures:large_gas_collector"
			id: "369FB2296D8A96F0"
			rewards: [{ id: "31FA497816359070", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "747C1102E6789DB4", item: "extendedfeatures:large_gas_collector", type: "item" }]
			title: "Large Gas Collector"
			x: 69.25d
			y: 7.25d
		}
		{
			dependencies: ["7FCFF04F0E79419B"]
			description: ["The &6Large Arc Smelter&r runs arc furnace recipes in bulk. Its controller, with tantalum carbide plates, IV circuits and platinum cable. Steel, tungsten steel and other alloys by the stack. Items and oxygen in by bus and hatch, ingots out by bus."]
			icon: "gtceu:large_arc_smelter"
			id: "10B7996CF9A6DE13"
			rewards: [{ id: "31FFDB7DD72CD4A3", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "1FC39617E1D3F670", item: "gtceu:large_arc_smelter", type: "item" }]
			title: "Large Arc Smelter"
			x: 63.25d
			y: 9.25d
		}
		{
			dependencies: ["10B7996CF9A6DE13"]
			description: ["Alloys made hot and melted at once: the &6Alloy Blast Smelter&r turns dust straight into molten metal. Its controller, with IV circuits, tantalum carbide plates and platinum cable, and heat coils. Molten alloys for casting, and metals that no furnace can alloy. Dust in by bus, molten metal out by hatch."]
			icon: "gtceu:alloy_blast_smelter"
			id: "347C9AAA7EBA18CD"
			rewards: [{ id: "7BFF940A2FE55713", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "322A6B85E8545483", item: "gtceu:alloy_blast_smelter", type: "item" }]
			title: "Alloy Blast Smelter"
			x: 65.25d
			y: 9.25d
		}
		{
			dependencies: ["347C9AAA7EBA18CD"]
			description: ["The &6Large Electromagnet&r separates and polarizes in batches. Its controller, with blue steel plates, IV circuits and osmium wire. Cleaner ore streams and charged crystals at scale. Items in and out by bus."]
			icon: "gtceu:large_electromagnet"
			id: "77F174440D5846B3"
			rewards: [{ id: "5B573327F24A89B9", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3F629C3DCEFF23C8", item: "gtceu:large_electromagnet", type: "item" }]
			title: "Large Electromagnet"
			x: 67.25d
			y: 9.25d
		}
		{
			dependencies: ["77F174440D5846B3"]
			description: ["The &6Large Centrifuge&r does the work of a rack of centrifuges, thermal ones too. Its controller, with IV circuits, a molybdenum disilicide spring and an IV motor. Dust and fluid separation in one hall. Items and fluid in, results out by bus and hatch."]
			icon: "gtceu:large_centrifuge"
			id: "3641F51980830DF7"
			rewards: [{ id: "3A305BA468A9EB3B", type: "xp", xp: 60 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "1BF3B4C6726D77B6", item: "gtceu:large_centrifuge", type: "item" }]
			title: "Large Centrifuge"
			x: 69.25d
			y: 9.25d
		}
		{
			dependencies: ["3641F51980830DF7"]
			description: ["The &6Large Electrolyzer&r splits compounds in bulk. Its controller, with black steel plates, platinum cable and IV circuits. Carbon, aluminium, calcium and gases from the bigger lines. Items and fluid in by bus and hatch, results out the same way."]
			icon: "gtceu:large_electrolyzer"
			id: "5F0C1087A84E685C"
			rewards: [{ id: "1E574908D425FA21", type: "xp", xp: 60 }]
