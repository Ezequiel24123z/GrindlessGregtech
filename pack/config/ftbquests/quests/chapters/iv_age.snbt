		{
			dependencies: ["171D167E3CB497BB"]
			description: ["Grains of native iridium and osmium in Mercury's dark crust. &6Raw Iridosmine&r is the only iridium and osmium in the system, and it won't melt in a furnace or split in an electrolyzer, so don't bother asking."]
			icon: "gtceu:raw_iridosmine"
