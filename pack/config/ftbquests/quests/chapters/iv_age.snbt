			x: 64.25d
			y: -1.25d
		}
		{
			dependencies: ["5D4FA5EF247AD4CF"]
			description: ["A naquadah wafer, engraved, becomes the &6SoC Wafer&r and the cutter turns it into &6SoCs&r. The IV laser engraver and a cleanroom. The SoC chip, which later circuits and the Advanced SoC build on. A wafer in, chips out. Let ME feed the engraver and store the chips."]
			icon: "gtceu:soc_wafer"
			id: "11004E2A89BF9FDD"
			rewards: [{ id: "54A3267D88379BC3", type: "xp", xp: 60 }]
