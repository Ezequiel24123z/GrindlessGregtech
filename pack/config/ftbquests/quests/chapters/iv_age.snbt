	quest_links: [ ]
	quests: [
		{
			dependencies: ["7AF6FD3F4F3B06B4"]
			description: [
				"From the far side of the Moon, the antenna can just make out Mercury in the Sun's glare and Venus under its clouds. You're going to both."
				"First, though, the atom: uranium from the End, a hot cell and a reactor that burns nothing."
			]
			icon: "gtceu:iv_machine_hull"
			id: "3FB9EA4152DCD1D3"
			rewards: [{ id: "7044ED917D669557", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "57DEFEB8476D0C21", type: "checkmark" }]
			title: "Inner Planets"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["3FB9EA4152DCD1D3"]
			description: [
				"There's a new Overworld vein of fluorite, barite, galena and sphalerite, and it only grows in freshly generated chunks. Time to go somewhere you've never been."
				"Raw fluorite and raw barite make a &6Fluorite Vein Sample&r, and any vein drill takes it, steam ones included."
			]
			icon: "grindless:vein_sample_fluorite"
			id: "5C008907C9055459"
			rewards: [
				{ id: "7B9F1E328EB5EE2F", type: "xp", xp: 40 }
				{ count: 8, id: "3F7CDDC11E9E812C", item: "gcyr:raw_fluorite", type: "item" }
			]
			tasks: [
				{ id: "5E187BE14C983E81", item: "grindless:vein_sample_fluorite", type: "item" }
				{ count: 16L, id: "77F69ECE1ABFC4AE", item: "gcyr:raw_fluorite", type: "item" }
			]
			title: "Fluorspar"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["5C008907C9055459"]
			description: [
				"A rotary kiln on rollers, turned by a gearbox, with a scrubber at the hot end. The &6Fluorspar Kiln&r cooks fluorite in sulfuric acid into hydrofluoric acid, and nobody grinds a mountain of mica for fluorine again."
				"It runs lots of charges at once instead of overclocking, and its gypsum goes into concrete."
			]
			icon: "gtceu:fluorspar_kiln"
			id: "5EE3EB2547415591"
			rewards: [
				{ id: "51B3F0619D171EC0", type: "xp", xp: 80 }
				{ count: 6, id: "794706880191B58A", item: "gcyr:fluorite_dust", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "15DE13E4D77E3653", item: "gtceu:fluorspar_kiln", type: "item" }
				{ id: "3CF6C2C31D340263", item: "gtceu:hydrofluoric_acid_bucket", type: "item" }
			]
			title: "The Long Kiln"
			x: 4.0d
			y: -1.5d
		}
		{
			dependencies: ["3FB9EA4152DCD1D3"]
			description: [
				"The End's pitchblende vein is back, but no drill will touch it: you're going to dissolve the uranium right out of the rock."
				"Bring raw pitchblende and raw uraninite home for an &6End Pitchblende Vein Sample&r."
			]
			icon: "grindless:vein_sample_pitchblende_end"
			id: "77B6F588980A4B1C"
			rewards: [{ id: "70655102B05149BB", type: "xp", xp: 40 }]
			tasks: [{ id: "7D0E205645D080F6", item: "grindless:vein_sample_pitchblende_end", type: "item" }]
			title: "Yellowcake"
			x: 2.0d
			y: -3.0d
		}
		{
			dependencies: ["77B6F588980A4B1C"]
			description: [
				"Four wells push acid into the rock, one pulls the uranium back up, and resin in the header house catches it. The &6In-Situ Leach Field&r only works in the End, and yes, you dig the five wells yourself."
				"The sample is never used up, the resin wears slowly, and the odd bit of radioactive waste goes into storage, not a chest by the door."
			]
			icon: "gtceu:isr_wellfield"
			id: "5FD0B9548159D199"
			rewards: [
				{ id: "1845E73B52D4284A", type: "xp", xp: 80 }
				{ count: 2, id: "72A3FD84380B88BE", item: "grindless:ion_exchange_resin", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ count: 4L, id: "3F9C133862854E97", item: "grindless:ion_exchange_resin", type: "item" }
				{ id: "743B9F4AD256F24B", item: "gtceu:isr_wellfield", type: "item" }
				{ count: 30L, id: "7DAF0BEA5BE61AD0", item: "gtceu:uraninite_dust", type: "item" }
			]
			title: "Five-Spot"
			x: 4.0d
			y: -3.0d
		}
		{
			dependencies: ["3FB9EA4152DCD1D3"]
			description: [
				"The hot cell and the reactor are both walled with &6Radiation-Proof Machine Casing&r: dense lead around a tungsten steel frame, set in concrete in the IV assembler."
				"Concrete from clay will do until the kiln's gypsum takes over."
			]
			icon: "gtnn:radiation_proof_machine_casing"
			id: "5BDF50007C1EAFE2"
			rewards: [{ id: "7503D049BFB5C02C", type: "xp", xp: 40 }]
			tasks: [{ count: 54L, id: "70F4496C01D4AED9", item: "gtnn:radiation_proof_machine_casing", type: "item" }]
			title: "Radiation-Proof Casing"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["5BDF50007C1EAFE2"]
			description: [
				"Two shielded cells, lead-glass windows and tongs through the wall. Radioactive stuff goes into the &6Hot Cell&r through buses and leaves to the network, your hands never touch it, and the circuit picks the job."
				"IV hatches wait for Mercury's iridium, so for now two EV energy hatches give it IV power."
			]
			icon: "gtceu:hot_cell"
			id: "30D78F6EB49AF27B"
			rewards: [{ id: "5FE2E31B75F05904", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3E606383198DBAB6", item: "gtceu:hot_cell", type: "item" }]
			title: "Behind Lead Glass"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["30D78F6EB49AF27B", "5EE3EB2547415591", "5FD0B9548159D199"]
			description: ["Circuit 1 turns uraninite and hydrofluoric acid into &6Uranium 235&r, plus a lot more uranium 238 than you'd like. The hexafluoride never leaves the cell, and the fluorine comes back out as gas."]
			icon: "gtceu:uranium_235_dust"
			id: "174353B4F6C61A79"
			rewards: [{ id: "31A78D220008DAFC", type: "xp", xp: 60 }]
			tasks: [
				{ id: "54EE2919EBE407C9", item: "gtceu:uranium_235_dust", type: "item" }
				{ id: "77DB1A0B29910D9C", item: "gtceu:uranium_dust", type: "item" }
			]
			title: "Cascade"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["174353B4F6C61A79", "73D14393C00DE14D"]
			description: [
				"Circuit 4 blows air over uranium 238 and makes radon, and the plutonium GregTech's own recipe asks for stays inside the cell as a catalyst."
				"Soak a Nether Star in radon in the chemical bath for a &6Quantum Star&r. All those Wither fights finally pay off."
			]
			icon: "gtceu:quantum_star"
			id: "7136B78C360303F9"
			rewards: [{ id: "76D5B425BB45E0F2", type: "xp", xp: 60 }]
			tasks: [
				{ id: "796CE71547E2EE7D", item: "gtceu:radon_bucket", type: "item" }
				{ id: "5078B8A7FDF5EBC5", item: "gtceu:quantum_star", type: "item" }
			]
			title: "Quantum Star"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["7136B78C360303F9", "72022B0ECDC3668B"]
			description: [
				"Four uranium channels, water through the core and a turbine hall out front. The &6Fission Reactor&r burns nothing, and if the water or the room for spent fuel runs out, it shuts down instead of melting."
				"Its controller wants an IV field generator: a Quantum Star and samarium wire from Mars, which only melts in a blast furnace with HSS-G coils."
			]
			icon: "gtceu:fission_reactor"
			id: "774234968F1BEB95"
			rewards: [
				{ id: "7191AFDE0ABC670A", type: "xp", xp: 150 }
				{ count: 16, id: "336827B61BB005C1", item: "gtceu:light_concrete", type: "item" }
			]
			shape: "gear"
			size: 1.5d
			tasks: [
				{ id: "5B8B6955385CCA84", item: "gtceu:iv_field_generator", type: "item" }
				{ id: "314CE8A31C2B2D45", item: "gtceu:fission_reactor", type: "item" }
			]
			title: "A Core of Your Own"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["174353B4F6C61A79"]
			description: [
				"Real nuclear fuel is pellets in metal tubes, pressed, sintered and sealed with helium. The &6Fuel Fabrication Plant&r does the whole line, and the circuit picks the step."
				"You'll build it around an IV assembler, so maybe make two of those."
			]
			icon: "gtceu:fuel_fabrication_plant"
			id: "77A25AB4BB859C79"
			rewards: [{ id: "1E5C7EB0C7637A72", type: "xp", xp: 80 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "135CC8040C8DB996", item: "gtceu:fuel_fabrication_plant", type: "item" }]
			title: "Fuel Line"
			x: 8.0d
			y: -1.5d
		}
		{
			dependencies: ["77A25AB4BB859C79", "004525B795119B1B"]
			description: [
				"Uranium pressed into pellets, Zircaloy rolled into tubes and a breath of the Moon's helium make an &6LEU Fuel Assembly&r. The zirconium comes from the End's zircon, with a pinch of tin."
				"The sintering wants hydrogen in a hatch, but it never uses any up."
			]
			icon: "grindless:leu_fuel_assembly"
			id: "77E9A2979A7161D3"
			rewards: [{ id: "54040CCC26849B75", type: "xp", xp: 60 }]
			tasks: [
				{ count: 10L, id: "1DE73D3441521EAC", item: "grindless:leu_pellet", type: "item" }
				{ count: 4L, id: "1C78223D64859AE3", item: "grindless:zircaloy_cladding_tube", type: "item" }
				{ id: "15DCE7EEEBD913CC", item: "grindless:leu_fuel_assembly", type: "item" }
			]
			title: "Fresh Fuel"
			x: 10.0d
			y: -1.5d
		}
		{
			dependencies: ["774234968F1BEB95", "77E9A2979A7161D3"]
			description: [
				"Load an LEU assembly with circuit 1, give it water, and the reactor wakes up; each assembly in the bus runs another channel, up to four."
				"IV dynamo hatches need Mercury's iridium, so for now EV ones carry the power out, and the &6EV 16A Dynamo Hatch&r carries the most."
			]
			icon: "grindless:leu_fuel_assembly"
			id: "72139ED6F4E46D37"
			rewards: [{ id: "165CFE01A1667E2A", type: "xp", xp: 100 }]
			tasks: [{ id: "372DFA502C128D18", item: "gtceu:ev_energy_output_hatch_16a", type: "item" }]
			title: "First Criticality"
			x: 12.0d
			y: 0.0d
		}
		{
			dependencies: ["72139ED6F4E46D37"]
			description: ["An assembly lasts a good long while, then turns into a &6Spent Fuel Assembly&r. It still holds uranium and the plutonium it bred, so it goes back to the hot cell."]
			icon: "grindless:spent_fuel_assembly"
			id: "53A436AE28A4DED1"
			rewards: [{ id: "56F7D5151B5A6D65", type: "xp", xp: 40 }]
			tasks: [{ id: "124381414F9E6762", item: "grindless:spent_fuel_assembly", type: "item" }]
			title: "Spent, Not Wasted"
			x: 14.0d
			y: -1.5d
		}
		{
			dependencies: ["53A436AE28A4DED1"]
			description: ["Circuit 3 dissolves a spent assembly in nitric acid and hands back the uranium, along with the &6Plutonium&r it bred. The waste gets glassed and kept, and the fumes go back to making nitric acid."]
			icon: "gtceu:plutonium_dust"
			id: "7E266AE6DB3351F7"
			rewards: [{ id: "55D892B85E698FA5", type: "xp", xp: 50 }]
			tasks: [{ id: "3DB4FFE06F95ACB0", item: "gtceu:plutonium_dust", type: "item" }]
			title: "Nothing Wasted"
			x: 16.0d
			y: -1.5d
		}
		{
			dependencies: ["7E266AE6DB3351F7"]
			description: [
				"Plutonium and uranium 238 in Zircaloy tubes make a &6MOX Fuel Assembly&r, which the reactor burns in heavy water on circuit 3."
				"A breeder assembly on circuit 4 gives less power but hands back more plutonium than it took."
			]
			icon: "grindless:mox_fuel_assembly"
			id: "16CAD9CBBF3B46D9"
			optional: true
			rewards: [{ id: "3BAB6E4A8186641F", type: "xp", xp: 40 }]
			size: 0.75d
			tasks: [{ id: "5764F970966E4FAE", item: "grindless:mox_fuel_assembly", type: "item" }]
			title: "Mixed Oxide"
			x: 18.0d
			y: -3.0d
		}
		{
			dependencies: ["7E266AE6DB3351F7"]
			description: ["Plutonium oxide sealed in platinum and rhodium stays warm for years. Circuit 2 makes an &6RTG Pellet&r, about as close to a pocket sun as GregTech will let you get."]
			icon: "grindless:rtg_pellet"
			id: "1D931CB1451E8B5A"
			rewards: [{ id: "1AAE161648DE4215", type: "xp", xp: 40 }]
			tasks: [{ id: "76AAE02263EB02CB", item: "grindless:rtg_pellet", type: "item" }]
			title: "Pocket Suns"
			x: 18.0d
			y: -1.5d
		}
		{
			dependencies: ["1D931CB1451E8B5A"]
			description: [
				"A pellet behind lead, a thermopile and some fins: the &6RTG Cell&r burns nothing, so it works on every world, day and night."
				"Each pellet lasts about an hour of running, and the first bases on Venus and Mercury start on these, so pack a few."
			]
			icon: "gtceu:ev_rtg"
			id: "503863FFACA225A8"
			rewards: [
				{ id: "125CEA08554D895E", type: "xp", xp: 60 }
				{ id: "53F03289B7802D20", item: "grindless:rtg_pellet", type: "item" }
			]
			tasks: [{ id: "74D514BC27E28AF3", item: "gtceu:ev_rtg", type: "item" }]
			title: "Pocket Power"
			x: 20.0d
			y: -1.5d
		}
		{
			dependencies: ["72139ED6F4E46D37", "148A0854C671B0AC"]
			description: [
				"Where it's cold, deuterium moves from water into hydrogen sulfide; where it's hot, it moves back. The &6Heavy-Water Plant&r plays that game between two towers until Martian ice gives up its heavy water."
				"Its controller starts from EV's distillation tower."
			]
			icon: "gtceu:heavy_water_plant"
			id: "5A1DBDF9E739CEF2"
			rewards: [{ id: "58E46537278E0B36", type: "xp", xp: 80 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "39600F8879724225", item: "gtceu:heavy_water_plant", type: "item" }]
			title: "Two Towers"
			x: 12.0d
			y: 1.5d
		}
		{
			dependencies: ["5A1DBDF9E739CEF2"]
			description: [
				"The hydrogen sulfide goes in a hatch of its own and only circulates, so one fill lasts forever."
				"Circuit 1 makes a concentrate from ice and steam and circuit 2 finishes it into &6Heavy Water&r. Any steam works, and the combined-cycle plant and the hot strip mill have plenty they're not allowed to throw away."
			]
			icon: "gtceu:heavy_water_bucket"
			id: "3513B00E50D7C58B"
			rewards: [{ id: "1927F031E0113E2D", type: "xp", xp: 50 }]
			tasks: [
				{ id: "3B84E2D84CA1A792", item: "gtceu:hydrogen_sulfide_bucket", type: "item" }
				{ id: "7A613D0C7A728F23", item: "gtceu:heavy_water_concentrate_bucket", type: "item" }
				{ id: "5AA8209BEA7FE401", item: "gtceu:heavy_water_bucket", type: "item" }
			]
			title: "Heavy Water"
			x: 14.0d
			y: 1.5d
		}
		{
			dependencies: ["72139ED6F4E46D37", "3513B00E50D7C58B"]
			description: ["Heavy water slows neutrons without eating them, so on circuit 2 the same assembly gives twice the power. It comes out as &6Tritiated Heavy Water&r, and the reactor will never vent it, so give it a tank."]
			icon: "gtceu:tritiated_heavy_water_bucket"
			id: "373CBFB746FCAD51"
			rewards: [{ id: "5FB7091F09100089", type: "xp", xp: 60 }]
			tasks: [{ id: "1A82047FD3D6215B", item: "gtceu:tritiated_heavy_water_bucket", type: "item" }]
			title: "The Heavier Moderator"
			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["3513B00E50D7C58B"]
			description: ["Heavy water in the electrolyzer splits into &6Deuterium&r and oxygen, the first deuterium since Earth ran out of it. The Moon's tritium facility wants a charge, and fusion will want the rest."]
			icon: "gtceu:deuterium_bucket"
			id: "1802C3DEADA12B33"
			rewards: [{ id: "3134B8343CD4914B", type: "xp", xp: 40 }]
			tasks: [{ id: "1F57DEA61BE43132", item: "gtceu:deuterium_bucket", type: "item" }]
			title: "Deuterium"
			x: 16.0d
			y: 1.5d
		}
		{
			dependencies: ["373CBFB746FCAD51", "79EE0C54F2D89358"]
			description: [
				"On the Moon, a cold box between two exchange columns pulls the tritium out and hands the heavy water back for the reactor. The &6Tritium Removal Facility&r is built from a cryogenic plant controller, and its deuterium charge is never drained."
				"Run it at night with every radiator open to the sky and it costs half."
			]
			icon: "gtceu:tritium_removal_facility"
			id: "32FD8F32DC829A03"
			rewards: [
				{ id: "1FB2D45849999215", type: "xp", xp: 80 }
				{ count: 2, id: "3D7C17422BC4EE30", item: "grindless:night_sky_radiator", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "517C82990CE93DDE", item: "gtceu:tritium_removal_facility", type: "item" }]
			title: "Out of the Moderator"
			x: 16.0d
			y: 0.0d
		}
		{
			dependencies: ["32FD8F32DC829A03", "1802C3DEADA12B33"]
			description: ["The only &6Tritium&r in the pack comes out of that cold box. Nothing uses it yet, but fusion will, so store every drop."]
			icon: "gtceu:tritium_bucket"
			id: "7FD8A4969E497C3A"
			rewards: [{ id: "77B41281449353DE", type: "xp", xp: 50 }]
			tasks: [{ id: "1C954386BA730522", item: "gtceu:tritium_bucket", type: "item" }]
			title: "Tritium"
			x: 18.0d
			y: 1.5d
		}
		{
			dependencies: ["32FD8F32DC829A03", "319C39AD99B5E4A8"]
			description: [
				"While you're on the Moon, give the antenna on the far side a second EV energy hatch, because two of them reach IV. At night, with the Mars chart calibrating the dish, it writes the &6Inner Planets Chart&r onto a data stick."
				"It's never used up, but copy it anyway: charts have a way of ending up in the wrong chest."
			]
			icon: "grindless:inner_planets_chart"
			id: "539716A235672461"
			rewards: [
				{ id: "1BFDF964AD6323E1", type: "xp", xp: 60 }
				{ count: 2, id: "15B37430C2F6B838", item: "gtceu:data_stick", type: "item" }
			]
			tasks: [{ id: "319C2A03113D6CD4", item: "grindless:inner_planets_chart", type: "item" }]
			title: "Venus and Mercury, Fixed"
			x: 18.0d
			y: 0.0d
		}
		{
			dependencies: ["539716A235672461"]
			description: [
				"Venus and Mercury want a level 3 rocket, and GCYR averages the parts, so one leftover advanced motor keeps you at level 2. The IV assembler makes the &6elite parts&r with the chart, and one trip takes two elite tanks."
				"Each suit piece gets the thermal upgrade and a heat shielding fabric in a smithing table: do all four, unless you like warm knees."
			]
			icon: "gcyr:elite_rocket_motor"
			id: "5A378E5CFD8DFF82"
			rewards: [
				{ id: "3F155B6C3573CD88", type: "xp", xp: 100 }
				{ count: 4, id: "5131070CAECCD5E6", item: "gcyr:heat_shielding_fabric", type: "item" }
			]
			tasks: [
				{ count: 2L, id: "59C4E8109DDA23B7", item: "gcyr:elite_fuel_tank", type: "item" }
				{ count: 6L, id: "7F07DE4F24210C8C", item: "gcyr:elite_rocket_motor", type: "item" }
				{ count: 4L, id: "501C290545582F38", item: "gcyr:space_suit_thermal_upgrade_smithing_template", type: "item" }
			]
			title: "Elite Rocket, Thermal Suit"
			x: 20.0d
			y: 0.0d
		}
		{
			dependencies: ["5A378E5CFD8DFF82"]
			description: [
				"Ninety bar of carbon dioxide, clouds of sulfuric acid and ground hot enough to melt lead: lovely place."
				"Fill the chestplate's tank and land with an RTG cell, since nothing burns here. Bring a chemical reactor, ender pearls and helium-3 for the bridge, and a waystone for the ride home."
			]
			icon: "gcyr:venusian_regolith"
			id: "5693331C34A5A291"
