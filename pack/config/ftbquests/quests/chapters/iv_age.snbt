			title: "Advanced SoC Wafer"
			x: 68.5d
			y: -3.75d
		}
		{
			dependencies: ["11004E2A89BF9FDD"]
			description: ["The &6QBit CPU Wafer&r       is a nano CPU wafer treated with radon. The cutter slices it into QBit chips, which the quantum processor is built from. Nano CPU wafers, radon from the air line and a chemical reactor. Every wafer uses radon up, so the supply has to be continuous. The quantum processor. Radon by pipe, wafers by ME, chips from the cleanroom cutter."]
			icon: "gtceu:qbit_cpu_wafer"
			id: "3C9031CEC5BD66A0"
			rewards: [{ id: "7FBF87A64351AA2A", type: "xp", xp: 60 }]
			shape: "hexagon"
