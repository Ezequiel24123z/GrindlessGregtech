			y: 9.25d
		}
		{
			dependencies: ["10B7996CF9A6DE13"]
			description: ["The &6Large Brewer&r brews, ferments and heats fluids in one hall. Its controller, with molybdenum disilicide springs, an IV pump and IV circuits. Biomass and other organic fluids by the tank. Items and fluid in, fluid out."]
			icon: "gtceu:large_brewer"
			id: "5083F6A8F1676689"
