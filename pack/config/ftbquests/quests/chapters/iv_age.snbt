		}
		{
			dependencies: ["1D2410B18346F998"]
			description: ["Naquadah only melts in a blast furnace with HSS-G coils, and the hot ingot wants liquid helium in the vacuum freezer. The &6Naquadah Ingot&r is where the doped boule, the wafers and the UHPIC chips of LuV start."]
			icon: "gtceu:naquadah_ingot"
			id: "571EB64508F2FF8E"
