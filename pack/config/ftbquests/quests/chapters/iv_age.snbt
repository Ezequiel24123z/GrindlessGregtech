			]
			title: "QBit CPU Wafer"
			x: 70.25d
			y: -2.25d
		}
		{
			dependencies: ["3C9031CEC5BD66A0"]
			description: ["The &6HPIC Wafer&r carries the high-power chips       that the energy hatches, transformers and large power parts ask for. A chemical reactor or large chemical reactor, or the epitaxy route if you have built it. The IV and LuV energy parts. No quantum circuit needs it. Two routes, one wafer. Pick the one your cleanroom can feed and stock chips."]
			icon: "gtceu:hpic_wafer"
			id: "3D0388842F00E792"
			rewards: [{ id: "7EAC883A5BA2042B", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "3D42B7E169C94FF2", item: "gtceu:hpic_wafer", type: "item" }
				{ id: "5F3D39DE4E44D7C8", item: "gtceu:hpic_chip", type: "item" }
			]
			title: "HPIC Wafer"
			x: 71.5d
			y: -2.0d
		}
		{
			dependencies: ["15744347C03FF420", "3C9031CEC5BD66A0"]
			description: ["The &6Quantum Processor&r is the quantum line's EV circuit. The usual recipe takes QBit and nano CPU chips. QBit chips, nano CPU chips and fibre-reinforced boards, in the IV assembler or the assembly line. A faster recipe takes Advanced SoCs but wants an assembler far bigger than IV. The assembly, and every IV machine that wants circuits. Run it from the assembler's own pattern, with chips delivered by ME."]
			icon: "gtceu:quantum_processor"
			id: "367F69A30A29D598"
			rewards: [{ id: "714063FCF3E807DB", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 2L, id: "5BD2A7BF1F266933", item: "gtceu:quantum_processor", type: "item" }]
			title: "Quantum Processor"
			x: 71.75d
			y: -0.75d
		}
		{
			dependencies: ["367F69A30A29D598"]
			description: ["The &6Quantum Processor Assembly&r is the quantum line's IV circuit. A stack of quantum processors and fibre-reinforced boards. It takes no chips of its own. The computer, and the IV machines that ask for assemblies. Processors come from the network; the assembler repeats."]
			icon: "gtceu:quantum_processor_assembly"
			id: "380BC31148B70ADC"
			rewards: [{ id: "3C6C8523BAD74808", type: "xp", xp: 70 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "770D0653A861E305", item: "gtceu:quantum_processor_assembly", type: "item" }]
			title: "Quantum Assembly"
			x: 73.5d
			y: 0.25d
		}
		{
			dependencies: ["380BC31148B70ADC"]
			description: ["The &6Quantum Processor Computer&r is the quantum line's LuV circuit and the real wall of IV. Assemblies, boards, plenty of RAM and NOR chips. The wall is the volume of processors behind it. The LuV machine hull, and the mainframe after it. Stock every input in the network first. This recipe is the one that stalls."]
			icon: "gtceu:quantum_processor_computer"
			id: "54D1F497552CE148"
			rewards: [{ id: "71D3CBBD014A0D16", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5F7531D64C1BFC7F", item: "gtceu:quantum_processor_computer", type: "item" }]
			title: "Quantum Processor Computer"
			x: 75.25d
			y: 0.0d
		}
		{
			dependencies: ["54D1F497552CE148"]
			description: ["The &6Quantum Processor Mainframe&r closes the quantum ladder. Computers, and the same cleanroom discipline at a larger scale. Nothing in IV asks for it. Later eras do. A dedicated assembler line and a standing stock of computers."]
			icon: "gtceu:quantum_processor_mainframe"
			id: "7FB0A0FD3F271048"
			rewards: [{ id: "36D03088A92EFA8C", type: "xp", xp: 120 }]
