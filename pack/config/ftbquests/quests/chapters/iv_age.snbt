			x: 71.25d
			y: 9.25d
		}
		{
			dependencies: ["5F0C1087A84E685C"]
			description: ["The &6Large Chemical Bath&r soaks and washes ore in batches. Its controller, with IV circuits, an IV pump and an IV conveyor. Purified ore and paper at the rate a line wants. Ore and fluid in, purified ore out."]
			icon: "gtceu:large_chemical_bath"
			id: "12A43896D9092D7E"
			rewards: [{ id: "5A9DE7EEC407C6BA", type: "xp", xp: 60 }]
