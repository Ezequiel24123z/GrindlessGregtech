			y: 0.0d
		}
		{
			dependencies: ["171D167E3CB497BB"]
			description: ["&6Raw Iridosmine&r is grains of native iridium and osmium in Mercury's dark crust, and the only iridium and osmium in the system. It won't melt in a furnace or split in an electrolyzer. Don't bother asking."]
			icon: "gtceu:raw_iridosmine"
			id: "147AC69C089D11C2"
			rewards: [{ id: "1DB9EF3AA96D2E21", type: "xp", xp: 60 }]
