		}
		{
			dependencies: ["18E80E32AB01B8F6"]
			description: ["The hiss the Moon's antenna picked up from Sagittarius finally has an address: one faint, steady point at the centre of the galaxy, the same one two astronomers found in 1974. The &6Sagittarius A* Signal&r is a long way off, and you're going anyway."]
			icon: "grindless:sagittarius_a_star_signal"
			id: "5EC977A2B65C7030"
