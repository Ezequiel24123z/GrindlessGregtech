			title: "Quantum Processor Mainframe"
			x: 76.75d
			y: 0.25d
		}
		{
			dependencies: ["3FB9EA4152DCD1D3"]
			description: ["The IV halls: fuel, fission, enrichment and the heavy plants of Venus and Mercury, each with the first steps that put it to work."]
			icon: "gtceu:hot_cell"
