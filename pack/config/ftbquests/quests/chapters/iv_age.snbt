			x: 26.0d
			y: 0.0d
		}
		{
			dependencies: ["32D53F1384080352"]
			description: ["Mercury's own dust, baked under the mirrors, makes &6Hermean Heat-Shield Bricks&r. The drill, the solar field and the interferometer all stand on them."]
			icon: "grindless:hermean_heat_shield_brick"
