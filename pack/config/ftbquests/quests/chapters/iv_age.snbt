			x: 69.5d
			y: 0.75d
		}
		{
			dependencies: ["571EB64508F2FF8E"]
			description: ["Naquadah grows into a boule in the blast furnace, and the cutter slices it into &6Naquadah Wafers&r. Naquadah from Venus, silicon, argon and a blast furnace that reaches the temperature. The SoC and Advanced SoC wafers. Keep a boule always growing and let the cutter feed the wafer line."]
			icon: "gtceu:naquadah_boule"
			id: "5D4FA5EF247AD4CF"
			rewards: [{ id: "7CCA0F7486821158", type: "xp", xp: 60 }]
