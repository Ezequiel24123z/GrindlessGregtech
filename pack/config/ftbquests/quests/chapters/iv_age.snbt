		}
		{
			dependencies: ["30D78F6EB49AF27B", "5EE3EB2547415591", "5FD0B9548159D199"]
			description: ["Circuit 1 is the hot cell's shortcut for the whole fluorine chain: uraninite and hydrofluoric acid in, &6Uranium 235&r out, with a pile of uranium 238. Keep the 238: pellets, radon and later MOX all want it. The row below unfolds the real steps."]
			icon: "gtceu:uranium_235_dust"
			id: "174353B4F6C61A79"
			rewards: [{ id: "5D156FB3DAA8368D", type: "xp", xp: 60 }]
