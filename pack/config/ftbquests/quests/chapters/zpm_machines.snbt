				{ id: "347BA511CB79BF9B", item: "gtceu:entry_probe_bay", type: "item" }
				{ id: "565AEE848552A9CF", item: "grindless:probe_bay_casing", type: "item" }
				{ id: "32275F4A25DB29F7", item: "grindless:titan_entry_probe", type: "item" }
