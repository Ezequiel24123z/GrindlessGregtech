	quests: [
		{
			dependencies: ["32D24E3C2D028686"]
			description: ["The &6Horizon Strand Repeater&r keeps the wireless network in step across the galaxy. Without one in each tower the MAX tier cannot reach the platforms at the centre. Horizon strand from the way in, and the assembly hall on two OpV hatches. The MAX cell and the MAX wireless tier. Nothing to feed: build the repeaters once and add one per new tower."]
			icon: "grindless:horizon_strand_repeater"
			id: "1B14456734D691CA"
			rewards: [{ id: "1F65A4F29D932823", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "1F50C451C8209025", item: "grindless:horizon_strand_repeater", type: "item" }]
			title: "Strand Repeater"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["1B14456734D691CA"]
			description: ["The &6MAX SMES Cell&r is the store of the last tier. The last recipe of the shell draws from the wireless network, and this cell is what lets a tower hold that load. A repeater for each tower, and strand from the way in. The MAX wireless hatches and the shell's last recipe. Nothing to feed. Size the towers for your busiest hour."]
			icon: "grindless:max_smes_cell"
			id: "586558AD36EEC6F4"
			rewards: [{ id: "3E097F99F8E85CB1", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3C6C288DA65A5FC2", item: "grindless:max_smes_cell", type: "item" }]
			title: "The MAX Cell"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["586558AD36EEC6F4"]
			description: ["Move your towers onto &6MAX SMES Cells&r and the wireless network carries MAX to every platform, the black hole orbit and the belt included. Every formed tower holding MAX cells. Until then the network stays at the tier below. The MAX wireless hatches, and the load of the shell and its machines. Add cells when the network dips at your busiest hour."]
			icon: "gtceu:max_wireless_energy_hatch"
			id: "1B62C1279BB0415F"
			rewards: [{ id: "734628D4DEC748A7", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "1103D67371DA1028", item: "gtceu:max_wireless_energy_hatch", type: "item" }
				{ id: "745067A598835901", item: "gtceu:max_wireless_dynamo_hatch", type: "item" }
			]
			title: "The Network Goes MAX"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["1F08060BC8BCA682"]
			description: ["The &6MAX Parallel Hatch&r is the widest in the pack. Behind it a mega machine runs a whole hall of recipes at once. A mega machine that takes parallel hatches, and the power for the width you ask for. Every mega machine of the pack at its full width. Feed it by wide buses and watch the network, since the load grows with the width."]
			icon: "gtceu:max_parallel_hatch"
			id: "3443B6F290684B46"
			rewards: [{ id: "12BE61280C48CC3E", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "79F944DF014AEC5A", item: "gtceu:max_parallel_hatch", type: "item" }]
			title: "The MAX Parallel Hatch"
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["33DDC08F5E410B5F"]
			description: ["AE2 has no new tier at MAX. The far rings of the platforms around the hole seed a network of their own, and the wireless network carries it home."]
			icon: "ae2:controller"
			id: "36D6484248E3C605"
			rewards: [{ id: "78401C2FB4EBB1D4", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ id: "5936627BCE03C58E", type: "checkmark" }]
			title: "AE2 at the Centre"
			x: 2.0d
			y: 5.0d
		}
		{
			dependencies: ["348A116DE7098B29"]
			description: ["The &6Geroch Winch&r lowers a tether over the horizon and takes power from the spin of the hole. It wears its tether as it works. A formed winch at the black hole orbit and a stock of tethers. The first MAX power that is not a fuel. Spare tethers arrive over AE2; a worn one goes back to its line."]
			icon: "gtceu:geroch_winch"
			id: "51FFBC5A2B05B2CA"
			rewards: [{ id: "3594E213E47CBE1B", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5E47BD4C13DAF44D", item: "grindless:horizon_tether", type: "item" }]
			title: "Power From the Spin"
			x: 2.0d
			y: 7.0d
		}
		{
			dependencies: ["51FFBC5A2B05B2CA"]
			description: ["The &6Penrose Engine&r drops a payload into the ergosphere and collects more energy than it spent. The excess comes from the rotation of the hole. A formed engine and payloads from the payload line. A big, steady supply of MAX power for the platforms. One payload per cycle by bus; the spent casing goes back to the line."]
			icon: "gtceu:penrose_engine"
			id: "7AEEF7B6A57C9C2F"
			rewards: [{ id: "36B8EC02DB7779C8", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "70C9D7DE9B1AA42B", item: "gtceu:penrose_engine", type: "item" }
				{ id: "7758449AE46EDC8F", item: "grindless:max_penrose_payload", type: "item" }
			]
			title: "The Penrose Engine"
			x: 4.0d
			y: 7.0d
		}
		{
			dependencies: ["7AEEF7B6A57C9C2F"]
			description: ["Once the &6Mirror Shell&r is up it has a power mode of its own, the vent, which lets back out part of the light the shell returned to the hole. A closed shell and a seed wave packet to start it. Power drawn from the shell instead of fuel, for as long as the packet lasts. Packets arrive by bus; watch the network at the start of each one."]
			icon: "gtceu:mirror_shell"
			id: "766DF39BA6B1F04B"
			rewards: [{ id: "7D443B3FFBDB9DA9", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3F75F91B83771163", item: "grindless:spent_wave_packet", type: "item" }]
			title: "The Shell Vent"
			x: 6.0d
			y: 7.0d
		}
		{
			dependencies: ["33DDC08F5E410B5F"]
			description: ["The &6Accretion Disk Skimmer&r, &6Plasma Mass Filter&r, &6FRC Former&r and &6BZ Dynamo&r each take a mode that works on matter from the disc: hot flow, filtered flow, flux-loaded plasma and a dynamo fed by it. The UXV controllers you already own, and the hot flow from the black hole orbit. The fuels and feeds of the machines of the era. Flow by pipe from the orbit; send filtered cuts to their own lines."]
			icon: "gtceu:accretion_disk_skimmer"
			id: "13E6AE6FF32324EA"
			rewards: [{ id: "5E62E0C09FF5ABDE", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5199EED90A953356", item: "gtceu:accretion_disk_skimmer", type: "item" }
				{ id: "791C7468C86322D9", item: "gtceu:plasma_mass_filter", type: "item" }
				{ id: "37FA81C1B419A0AA", item: "gtceu:frc_former", type: "item" }
				{ id: "71F0B0C0620E4DCD", item: "gtceu:bz_dynamo", type: "item" }
			]
			title: "Disc and Plasma"
			x: 2.0d
			y: 10.0d
		}
		{
			dependencies: ["33DDC08F5E410B5F"]
			description: ["The &6Droplet Radiator Works&r and &6Femtosecond Writer&r each take a MAX mode: nozzle plates for the shell radiator, and writes on the new die. The UIV controllers you already own. The shell radiator and the MAX die. Plates by bus; return what the writer rejects."]
			icon: "gtceu:femtosecond_writer"
			id: "76DCCA9EC423CC9E"
			rewards: [{ id: "7945EBF0B5F413F0", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7F27923BF2DB16BB", item: "gtceu:droplet_radiator_works", type: "item" }
				{ id: "5AD9314FCED03C6B", item: "gtceu:femtosecond_writer", type: "item" }
			]
			title: "Radiators and Writers"
			x: 2.0d
			y: 12.0d
		}
		{
			dependencies: ["1F08060BC8BCA682"]
			description: ["The &6Megabar Press&r and &6Degenerate Harvester&r each take a MAX row: the press shapes the heavy plates of the shell and the harvester gathers degenerate matter for the engine's slug. The UEV controllers you already own and matter from the orbit. The plates of the shell and the slug of the Penrose payload. Matter and plates by bus. The spent slug is an output, so route it."]
			icon: "gtceu:degenerate_harvester"
			id: "5489EFFC1AA7E360"
			rewards: [{ id: "560573A101E3989F", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "781506391F745E05", item: "gtceu:megabar_press", type: "item" }
				{ id: "357099CDDB5C7D32", item: "gtceu:degenerate_harvester", type: "item" }
			]
			title: "Press and Harvest"
			x: 2.0d
			y: 14.0d
		}
		{
			dependencies: ["1F08060BC8BCA682"]
			description: ["The &6Spark Plasma Sinterer&r takes a row that sinters the cores of the shell segments. The UHV controller you already own and the powders of the belt. The segment cores. Powders by bus; the cores go straight to the segment line."]
			icon: "gtceu:spark_plasma_sinterer"
			id: "179AD382D4871413"
			rewards: [{ id: "3B9CBBF04931AFC3", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "74A6221BDF92FA9C", item: "gtceu:spark_plasma_sinterer", type: "item" }]
			title: "Sinter the Segments"
			x: 2.0d
			y: 16.0d
		}
		{
			dependencies: ["348A116DE7098B29"]
			description: ["The &6SRF Cavity Works&r takes a row for the cavities of the drivers and the coil. Fiction: the drivers and the coil are built at the scale of the solar system. The UV controller you already own and the niobium of the platforms. The driver modules and the coil. Cavities by bus; a rejected one goes back to the melt."]
			icon: "gtceu:srf_cavity_works"
			id: "118F1A3968FC4666"
			rewards: [{ id: "7B2CDD835EBD8F6A", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "74CE152954DC8C45", item: "gtceu:srf_cavity_works", type: "item" }]
			title: "Cavities for the Drivers"
			x: 2.0d
			y: 18.0d
		}
		{
			dependencies: ["305F48FF31D86B06"]
			description: ["The &6Extraction Cascade&r takes a row that sorts belt rock into its metals before the furnace takes it. The EV controller you already own and rock from the belt. The metal feedstock of the segments. Rock in by bus; each metal leaves on its own line."]
			icon: "gtceu:extraction_cascade"
			id: "55A4165DF8CEC24B"
			rewards: [{ id: "1155FD6B4932DB0D", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "193EBEF715488E94", item: "gtceu:extraction_cascade", type: "item" }]
			title: "Cascade of the Belt"
			x: 2.0d
			y: 20.0d
		}
	]
	subtitle: ["A repeater and a cell for the wireless network, a hatch of enormous width, three plants at the black hole and older machines with new modes."]
	title: "MAX: Power and Older Machines"
}
