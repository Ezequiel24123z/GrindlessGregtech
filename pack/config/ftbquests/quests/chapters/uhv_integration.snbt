		}
		{
			dependencies: ["7547756221DFC688"]
			description: ["The &6Biofoundry&r, &6Organoid Lab&r and &6Algae Bioreactor&r grow new strains: neural tissue on a scaffold, and an algae that feeds on red light. Gene cassettes, the far-red strain, and sealed rooms. Organoid processors and the far-red algae. Seed cultures from ME; keep every room sealed."]
			icon: "gtceu:biofoundry"
			id: "3F2C2F3D89E4BC2C"
