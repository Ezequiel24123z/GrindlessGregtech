	quests: [
		{
			dependencies: ["7547756221DFC688"]
			description: ["Silicon carbide takes more heat and volts than silicon, and the &6SiC Power Module&r is what the swarm's control gear is built from. An inverted metamorphic array stacks a junction for every colour of light. The SiC device fab and the solar array fab, both from the machines tab, and ultrapure water for the wafers. Swarm segments and the UHV power gear. Boules and wafers move by bus; keep the ultrapure water on its own pipe."]
			icon: "grindless:sic_power_module"
			id: "5777F10880908743"
			rewards: [{ id: "3A939E13B316928C", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "74C792F613E9D327", item: "gtceu:sic_device_fab", type: "item" }
				{ id: "3F4FE809733A53B3", item: "grindless:sic_power_module", type: "item" }
				{ id: "36ABAC76BA437D4D", item: "gtceu:solar_array_fab", type: "item" }
				{ id: "50510D2F6FF87557", item: "grindless:imm_solar_array", type: "item" }
			]
			title: "Power Devices"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["5777F10880908743"]
			description: ["The &6Platinum Plant&r turns the biomining liquor into salts, and the ruthenium, iridium and americium end up as the alloy that carries the highest currents yet: RTAN wire. Proxima leach liquor from the biomining heap, and a long afternoon on the platinum plant. UHV wiring for the network and the heaviest machines. Liquor by pipe from Proxima b over the gate's AE2 pair; the plant hands salts to the blast furnace line."]
			icon: "gtceu:platinum_plant"
			id: "5E8DBDD3BE5E8C23"
			rewards: [{ id: "3E1032E7810A80D1", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "75C2CB17134C60BC", item: "gtceu:platinum_plant", type: "item" }
				{ id: "14B88CD68D841270", item: "gtceu:ruthenium_trinium_americium_neutronate_single_wire", type: "item" }
			]
			title: "RTAN"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["188AE1CE6129054A"]
			description: ["The &6Swarm Control Station&r steers a cloud of segments round the Sun and sends the power down as a beam. Two stations feed one bank, and the bank loses a little on the way. Swarm segments from the foundry in Mercury orbit, and the station in the orbit itself. UHV power without fuel, and the swarm half of the gate to UEV. Segments ride the Mercury AE2 pair; worn ones go back to the foundry as scrap."]
			icon: "gtceu:swarm_control_station"
			id: "7AAE7008AA466590"
			rewards: [{ id: "163E8662FE869F6E", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "105E5722D91D5E94", item: "gtceu:swarm_control_station", type: "item" }
				{ id: "38C26A13EB4BDEF0", item: "grindless:swarm_segment", type: "item" }
			]
			title: "The Swarm"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["7AAE7008AA466590"]
			description: ["A probe that dips into the corona comes back with the &6Coronal Field Map&r. The swarm points itself with it. The solar probe bay in Mercury orbit, and a probe for every run. Aimed beams, and the map the Gate to UEV asks for. The bay builds probes from ME; the map goes back to the network."]
			icon: "grindless:coronal_field_map"
			id: "10329AFF72FD580B"
			rewards: [{ id: "1B6AB5FBDA3A9AAB", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5CD6060A433B2B8E", item: "gtceu:solar_probe_bay", type: "item" }
				{ id: "16B9394E724BC350", item: "grindless:solar_probe", type: "item" }
				{ id: "593C83F3B2D3AD76", item: "grindless:coronal_field_map", type: "item" }
			]
			title: "Coronal Map"
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["10329AFF72FD580B"]
			description: ["A civilisation that uses all the power of its star is a type II on the Kardashev scale. You have a swarm, so you are on the way. It is only on the way."]
			icon: "gtceu:swarm_control_station"
			id: "540417452644F0F3"
			rewards: [{ id: "314EA8A0CB5E59DE", type: "xp", xp: 100 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ id: "35EC929F0411AD1C", type: "checkmark" }]
			title: "Kardashev II"
			x: 6.0d
			y: 2.0d
		}
		{
			dependencies: ["7547756221DFC688"]
			description: ["The &6UHV SMES Cell&r holds a huge store of EU, and the nuclear clock keeps it in step with the network. The naquadria magnet works, and the nuclear clock for the sync. The UHV wireless tier. Nothing to feed. Size the towers for your busiest hour."]
			icon: "grindless:uhv_smes_cell"
			id: "5E6B4DEB712EECBE"
			rewards: [{ id: "3CE50DA47EC8E899", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "73DB8F65AD12D9BD", item: "gtceu:naquadria_magnet_works", type: "item" }
				{ id: "36ADD428AD14F1EB", item: "grindless:uhv_smes_cell", type: "item" }
			]
			title: "The UHV Cell"
			x: 2.0d
			y: 4.0d
		}
		{
			dependencies: ["5E6B4DEB712EECBE"]
			description: ["Move your towers onto &6UHV SMES Cells&r and the wireless network carries UHV, out to the stations and now to Mercury and Proxima. Every formed tower holding UHV cells: until then the network stays at UV. Stations that run on power made at home, and the wireless hatches and covers at UHV. Add cells when the network dips at your busiest hour."]
			icon: "gtceu:uhv_wireless_energy_hatch"
			id: "3B594BE1402C7B55"
			rewards: [{ id: "758A54F40ABB6F18", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "55A118F8F168C4C7", item: "gtceu:uhv_wireless_energy_hatch", type: "item" }
				{ id: "32CE1F0CEC423BA8", item: "gtceu:uhv_wireless_dynamo_hatch", type: "item" }
			]
			title: "The Network Goes UHV"
			x: 4.0d
			y: 4.0d
		}
		{
			dependencies: ["3B594BE1402C7B55"]
			description: ["There is no UHV parallel hatch. The &6UV Parallel Hatch&r is the top of the line, and one more machine of the same kind is the only other way to go wider."]
			icon: "gtceu:uv_parallel_hatch"
			id: "32E554E77D7298BA"
			rewards: [{ id: "7C3C911F3C4092B6", type: "xp", xp: 60 }]
			tasks: [{ id: "74B755A21A7ACD91", item: "gtceu:uv_parallel_hatch", type: "item" }]
			title: "Parallel Hatch"
			x: 6.0d
			y: 4.0d
		}
		{
			dependencies: ["7547756221DFC688"]
			description: ["The &6Quantum Fabricator&r does the work of the assembler, circuit assembler, forming press, laser engraver and cutter in one cleanroom machine. A parallel hatch multiplies it, and it overclocks perfectly. A cleanroom, UHV power, a parallel hatch and every older recipe's inputs on one bus. Your Assembly Hall folded into one machine. One bus of inputs, one of outputs: it takes the recipes of five machines."]
			icon: "gtceu:quantum_fabricator"
			id: "1A714B616F2F3010"
			rewards: [{ id: "57E37DFAF7195F0E", type: "xp", xp: 250 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5B0B675A6B7F3B45", item: "gtceu:quantum_fabricator", type: "item" }]
			title: "Quantum Fabricator"
			x: 2.0d
			y: 6.0d
		}
		{
			dependencies: ["188AE1CE6129054A"]
			description: ["The seed for the Mercury bridge is made in Mercury orbit, with the first swarm segment as the catalyst. Once linked, the foundry's output reaches home through ME."]
			icon: "gcyr:mercury_orbit"
			id: "555DAA8FBE97E6F1"
			rewards: [{ id: "7FF1FBD3EC6380EA", type: "xp", xp: 100 }]
			tasks: [{ id: "53B865DC8B0C2AFF", item: "grindless:swarm_segment", type: "item" }]
			title: "Mercury on AE2"
			x: 2.0d
			y: 8.0d
		}
		{
			dependencies: ["773081F576E0FF0C"]
			description: ["Proxima b has no bridge of its own: only the gate makes the &6Proxima Gate Seed&r, and the first flora sample is its catalyst. Samples then arrive through ME, never by hand."]
			icon: "grindless:proxima_gate_seed"
			id: "533F887480ED2BCA"
			rewards: [{ id: "599BF2A3F82EEE46", type: "xp", xp: 100 }]
