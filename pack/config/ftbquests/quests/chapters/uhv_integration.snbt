		{
			dependencies: ["166C0A74107A1EF3"]
			description: [
				"Oganesson is the heaviest noble gas and the best propellant a thruster could ask for. The &6Oganesson Propellant Pod&r packs it for the ICAN motor. Oganesson from the cryogenic plant. The motor and the sails' pods. One pod line off the cryogenic plant, kept in its own tank."
				"Real oganesson lasts milliseconds and only a few atoms exist. GregTech Modern treats it as a stable gas, and the pack goes along."
			]
			icon: "grindless:oganesson_propellant_pod"
			id: "5388F974D6992B80"
			rewards: [{ id: "5EDF89574D0DA2FE", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "76608925D8F02E2C", item: "grindless:oganesson_propellant_pod", type: "item" }]
			title: "Noble Thrust"
			x: 4.0d
			y: 20.0d
		}
	]
	subtitle: ["Silicon carbide power, a swarm round the Sun, the network at UHV, one machine doing five jobs, older machines with new tricks and two more stations on AE2."]
	title: "UHV: Power and Scale"
}
