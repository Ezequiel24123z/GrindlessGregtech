				{ id: "3710DE6B774E9372", type: "checkmark" }
			]
			title: "Isotope Chemistry"
			x: 2.0d
			y: 12.0d
		}
		{
			dependencies: ["7547756221DFC688"]
			description: ["Heavy water, platinum salts and rare-earth liquors from Proxima b go through the &6Platinum Plant&r, &6Heavy Water Plant&r, &6Extraction Cascade&r, &6Regolith Cell&r and &6Lunar Solar Array&r. Each machine learns a new input. Proxima leach liquors, and the arrays tuned to the red. RTAN, UHV catalysts and the base's power. Liquors arrive over the Proxima AE2 pair; each plant hands its output on."]
			icon: "gtceu:heavy_water_plant"
			id: "7F6C236A1EA2F118"
			rewards: [{ id: "374ADDEBCB73B958", type: "xp", xp: 100 }]
