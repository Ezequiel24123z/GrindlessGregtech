	quests: [
		{
			dependencies: ["19F92230E8321753"]
			description: ["The &6Multi-Plasma Blender&r mixes one plasma from each place the pack has worked into the slurry that grows the gate's crystals. It is the only source of that slurry. Plasmas from the forge, elevator, filter, very massive star, p-process and jet lines, plus hot flow and condensate. The horizon crystal furnace. Give each plasma its own pipe. A starved line stops the whole mix."]
			icon: "gtceu:multi_plasma_blender"
			id: "356C983684E66DEB"
			rewards: [{ id: "3F61C0588866F832", type: "xp", xp: 300 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "32A6BB440BB5B252", item: "gtceu:multi_plasma_blender", type: "item" }]
			title: "Multi-Plasma Blender"
			x: 2.0d
			y: -4.0d
		}
		{
			dependencies: ["19F92230E8321753"]
			description: ["The &6Horizon Crystal Furnace&r grows core and controller crystals from slurry. Other packs wait weeks for this; here the cost is slurry and many parallel runs. Slurry by the hundred million millibuckets, and condensate for heat. Core crystals and the controller crystal. Slurry is the bottleneck. Size the blender line before you add furnaces."]
			icon: "gtceu:horizon_crystal_furnace"
			id: "74E81FE8A5CDCFA9"
			rewards: [{ id: "7CD3C0979B40A0B7", type: "xp", xp: 300 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5189277BD2C203D6", item: "gtceu:horizon_crystal_furnace", type: "item" }]
			title: "Horizon Crystal Furnace"
			x: 2.0d
			y: -2.0d
		}
		{
			dependencies: ["19F92230E8321753"]
			description: ["The &6Condensate Assembler&r bathes its parts in condensate. Containment plates, chevron cores, mesh and frame parts come from here and nowhere else. Dozens of inputs a recipe and an ocean of condensate. The meta-materials arrive from the loom at home. Frame parts, plates and cores for the whole grid. Run several. Condensate output sets the pace, not the clock."]
			icon: "gtceu:condensate_assembler"
			id: "7079333C124E4015"
			rewards: [{ id: "587942F81DBC2FFF", type: "xp", xp: 300 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7ACD98E5CFC97592", item: "gtceu:condensate_assembler", type: "item" }]
			title: "Condensate Assembler"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["19F92230E8321753"]
			description: ["The &6Horizon Capacitor Bank&r is a ring of capacitors that adds its capacity to your network. It stores; it never makes energy. The dial only starts when the formed banks hold at least one dial of charge. Capacitors in a ring, at Sgr A* orbit only. The network's generators fill it, and some charge is lost on the way in. The dial. Charge it long before the dial. A big plant refills it in minutes, a small one in days."]
			icon: "gtceu:horizon_capacitor_bank"
			id: "3BFE22DD06FBAD6D"
			rewards: [{ id: "362B9EC1F7DE9580", type: "xp", xp: 300 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5A718376EF409CF2", item: "gtceu:horizon_capacitor_bank", type: "item" }]
			title: "Horizon Capacitor Bank"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["19F92230E8321753"]
			description: ["The &6Hyper Assembly Array&r crafts what no single machine can take: dozens of different inputs in one recipe. Every part of the gate and every creative item is made here. A wide room and a great many input buses, all fed by AE2. The ring, the upgrades, the iris, the base and the interface. Let AE2 patterns do the counting. Never hand-feed this machine."]
			icon: "gtceu:hyper_assembly_array"
			id: "7179FF6F8D490EE1"
			rewards: [{ id: "71B1288CB2C6928A", type: "xp", xp: 300 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7103D07967C325DA", item: "gtceu:hyper_assembly_array", type: "item" }]
			title: "Hyper Assembly Array"
			x: 2.0d
			y: 4.0d
		}
		{
			dependencies: ["748B55AD58F78BA7"]
			description: ["A shutter of hundreds of blades that closes the ring between crossings. Each blade is a craft of its own, so queue them early."]
			icon: "grindless:horizon_iris"
