		}
		{
			dependencies: ["32232F1A7BC5FBA2"]
			description: ["The &6Niobium Nitride Film Wafer&r is a stage of the wafer lines of this era. Made from the Sapphire Wafer in the next machine of its line, in the cleanroom. The next stage of its line, or the chip that is built from it. Chain the machines by ME, and keep a small buffer of this wafer between steps."]
			icon: "grindless:nbn_film_wafer"
			id: "36CF77E4CABDC548"
			rewards: [{ id: "1DE8788C3D312EC3", type: "xp", xp: 50 }]
