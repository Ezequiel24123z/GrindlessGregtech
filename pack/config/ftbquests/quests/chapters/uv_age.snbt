		}
		{
			dependencies: ["168DB3651CB5C124"]
			description: ["The diamond lattice fab grows a &6Fuel Capsule&r round decaborane, or round deuterium and helium-3 for the other burn. Every shot spends one, so automate them early."]
			icon: "grindless:pb11_capsule"
			id: "561A6287570BE65F"
