			title: "One Way Fuel"
			x: 20.5d
			y: 1.5d
		}
		{
			dependencies: ["384F072F5A9C68C5"]
			description: ["Pluto orbit, as far out as the stations go. Sunlight takes hours to get here; chunk-load the station and keep spares, because nothing out here is quick to replace."]
			icon: "grindless:station_truss_casing"
			id: "309F1CA9C2FE71C9"
			rewards: [{ id: "7F623D7EC6843684", type: "xp", xp: 150 }]
