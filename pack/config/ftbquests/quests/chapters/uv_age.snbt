			x: 6.0d
			y: -2.0d
		}
		{
			dependencies: ["3CAA678656F421E4"]
			description: ["Thorium can't keep a chain reaction going by itself. The &6Accelerator-Driven Reactor&r fires a proton beam into a lead-bismuth pool and the spallation neutrons do the rest: switch the beam off and it stops."]
			icon: "gtceu:accelerator_driven_reactor"
			id: "531F95CE48EB6C79"
			rewards: [{ id: "5C3E4CA800187BD9", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "734B95D163FFD5AA", item: "gtceu:accelerator_driven_reactor", type: "item" }
				{ id: "5A8380970F833FBF", item: "grindless:thorium_oxide_fuel_assembly", type: "item" }
			]
			title: "Thorium at Last"
			x: 8.0d
			y: -2.0d
		}
		{
			dependencies: ["531F95CE48EB6C79"]
			description: ["The &6Pyroprocessing Cell&r melts spent thorium fuel in salt and pulls the bred &6Uranium-233&r out. The thorium goes back in, the salt is cleaned for another run, and only the waste leaves."]
			icon: "gtceu:pyroprocessing_cell"
			id: "7F5AFF284AB79EA8"
			rewards: [{ id: "39000AE6494F0929", type: "xp", xp: 120 }]
