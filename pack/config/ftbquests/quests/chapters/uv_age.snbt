			tasks: [
				{ id: "5706261529788541", item: "gtceu:thruster_works", type: "item" }
				{ id: "5D647D977A36F37E", item: "gtceu:uv_machine_casing", type: "item" }
			]
			title: "Thruster Works"
			x: 3.75d
			y: 17.25d
		}
		{
			dependencies: ["56276A4A85BCF379"]
			description: ["Two kinds of thruster, one gas: the &6Ion Thruster&r for a long cruise and the &6Hall Thruster&r for a quick correction."]
			icon: "grindless:ion_thruster"
			id: "5D390F57DD62EDF8"
