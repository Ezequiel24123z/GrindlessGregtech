			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["3C6A1EFD6D4E4A5C"]
			description: ["The Kuiper Belt is leftover from the Solar System's birth. An interceptor sent into it brings back a &6Planetesimal Sample&r, a stone that never melted."]
			icon: "grindless:planetesimal_sample"
			id: "5443B4BF3D09D99E"
