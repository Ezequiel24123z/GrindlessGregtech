		{
			dependencies: ["3496B9631FC03AC3"]
			description: ["Protons on a tungsten target throw off a trickle of antiprotons. An &6Antiproton Cartridge&r is the only way to carry them out of the ring."]
			icon: "grindless:antiproton_cartridge"
			id: "38256BC657C245CD"
