			title: "Network Switch"
			x: 10.0d
			y: 37.5d
		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6Tegmark Forge&r is a Community Additions multiblock that forges the exotic alloys of the late game from a single seed of matter. The controller takes a neutronex frame, a double neutronex plate and a duranium X frame. Adamantium, ohriharukon and orundum ingots. Item buses and fluid hatches in, item buses out."]
			hide_dependency_lines: true
			icon: "gtca:tegmark_forge"
			id: "33AD6B9DD6C271FD"
			rewards: [{ id: "54EE67FC14469B40", type: "xp", xp: 100 }]
