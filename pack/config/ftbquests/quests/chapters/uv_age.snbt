			x: 8.0d
			y: 31.5d
		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6PMMA Wafer&r: A high-power wafer under a thick PMMA resist. Made in the &6Chemical Bath&r from the HPIC Wafer, with PMMA resist, in the cleanroom. Exposed by the synchrotron (circuit 1). The Exposed Wafer in the Synchrotron. Stock it by ME and let the next step pull it; nothing here needs a hand."]
			hide_dependency_lines: true
			icon: "grindless:pmma_coated_wafer"
			id: "1E59B32B1A43DD99"
