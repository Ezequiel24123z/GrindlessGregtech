			title: "Sixth Station"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["309F1CA9C2FE71C9"]
			description: ["Sputnik Planitia is a plain of nitrogen ice that flows like a slow glacier. It's the softest place to land a probe, and the first sample comes from there."]
			icon: "grindless:sputnik_ice_core"
			id: "5D374D87F5C412C1"
