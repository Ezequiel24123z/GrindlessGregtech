			x: 6.0d
			y: 2.0d
		}
		{
			dependencies: ["11FAD777A18E748F"]
			description: ["The hot cell already splits boron's isotopes. React the &6Boron-11&r trifluoride with hydrogen into decaborane, and the fluorine leaves as acid the rest of your chemistry takes."]
			icon: "gtceu:boron_dust"
			id: "168DB3651CB5C124"
