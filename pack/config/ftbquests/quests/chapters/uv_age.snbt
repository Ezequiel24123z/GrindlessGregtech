				{ id: "14E4722BB571B705", item: "grindless:station_truss_casing", type: "item" }
			]
			title: "Triton's Geysers"
			x: 19.0d
			y: 8.5d
		}
		{
			dependencies: ["762C4669D260B0F2"]
			description: ["A &6Triton Ice Core&r is the catalyst the Pluto penetrator drills with, cut from Triton ice. It is made in the Triton line from the ice a probe brings back, so it needs that run first. It unlocks the Pluto penetrator. Keep the line stocked by ME, since the penetrator uses a core for every bore."]
			icon: "grindless:triton_ice_core"
			id: "76C00CDEFC09A52F"
			rewards: [{ id: "74EE7036CCFF3E79", type: "xp", xp: 80 }]
