			x: 12.0d
			y: 1.5d
		}
		{
			dependencies: ["309F1CA9C2FE71C9"]
			description: ["A penetrator probe melts into the nitrogen glacier and sends a core up. The &6Sputnik Ice Core&r grows the &6Plutonian Quantum Seed&r, the last pipe home."]
			icon: "grindless:sputnik_ice_core"
