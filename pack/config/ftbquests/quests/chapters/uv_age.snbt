			title: "Ion Thrusters"
			x: 5.5d
			y: 18.75d
		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6Ark Biosphere&r is a closed ecosystem fed by Pluto's ices. It is the first greenhouse that keeps its own air. Its controller, a UV casing floor, glass walls and an anaerobic core of inert casing. The stem cells and feedstock the vat uses. Ice by ME from Pluto; the ark recycles the rest itself."]
			icon: "gtceu:ark_biosphere"
			id: "59F34562582255AD"
			rewards: [{ id: "5ECBAF07ABC6A1B2", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1F4F149923F0AD40", item: "gtceu:ark_biosphere", type: "item" }
				{ id: "5994D85F080E7CEA", item: "gtceu:uv_machine_casing", type: "item" }
				{ id: "54299180013D6B8C", item: "gtceu:inert_machine_casing", type: "item" }
			]
			title: "The Ark"
			x: 2.25d
			y: 16.25d
		}
		{
			dependencies: ["59F34562582255AD"]
			description: ["The &6Neural Culture Vat&r grows stem cells and neuro processing units in a single run. Its controller, plascrete, filter casing hoods and robust casing for the bioprinter. The wetware computer, further along. Media and stem cells by ME; the vat ships the units out."]
			icon: "gtceu:neural_culture_vat"
			id: "350003D221C6A101"
			rewards: [{ id: "100A666BEF0EB154", type: "xp", xp: 120 }]
