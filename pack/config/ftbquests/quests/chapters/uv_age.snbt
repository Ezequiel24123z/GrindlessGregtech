			title: "Shadow of the Hole"
			x: 37.0d
			y: 1.0d
		}
		{
			dependencies: ["332CC4FD00C435F0"]
			description: ["A &6Light Sail&r is a film a few atoms thick and as wide as a stadium. It weighs almost nothing and takes a lot to make."]
			icon: "grindless:light_sail"
			id: "3C44B521C564CB61"
