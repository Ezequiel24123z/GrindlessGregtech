			]
			title: "The Shadow"
			x: 26.0d
			y: 9.5d
		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6Nano Forge&r is the UV hall that works matter by the atom, building nanoscale parts that no assembler can place. Its controller, built on an assembly line, and a UV energy hatch: it draws about 491,520 EU/t while it runs. The nanoscale parts of the late-game lines. Feed inputs by ME and pull the parts out by bus; give it its own power line."]
			icon: "gtca:nano_forge"
			id: "1468097102B4CAE6"
			rewards: [{ id: "128D6F6632222FBB", type: "xp", xp: 120 }]
