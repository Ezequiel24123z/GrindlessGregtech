		}
		{
			dependencies: ["1AA12DFECDEFD309"]
			description: ["Triton's geysers throw nitrogen and dark grit high above the ice. The &6Triton Geyser Sampler&r flies through them, and its &6Triton Ice Core&r is what the Pluto penetrator is tuned on."]
			icon: "gtceu:triton_geyser_sampler"
