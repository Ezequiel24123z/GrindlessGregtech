			title: "Sixth Station"
			x: 21.0d
			y: 5.0d
		}
		{
			dependencies: ["309F1CA9C2FE71C9"]
			description: ["Sputnik Planitia is a plain of nitrogen ice that flows like a slow glacier. It's the softest place to land a probe, and the first sample comes from there. The Penetrator Probe Bay drops the probe, and the Volatile Ice Fractionator then splits each core into its gases (both in the Machines chapter)."]
			icon: "grindless:sputnik_ice_core"
			id: "5D374D87F5C412C1"
			rewards: [{ id: "73267F9463075B4C", type: "xp", xp: 20 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "7FD26935936BFDF5", type: "checkmark" }]
			title: "The Heart of Pluto"
			x: 23.5d
			y: 5.5d
		}
		{
			dependencies: ["309F1CA9C2FE71C9"]
			description: ["A penetrator probe melts into the nitrogen glacier and sends a core up. The &6Sputnik Ice Core&r grows the &6Plutonian Quantum Seed&r, the last pipe home."]
			icon: "grindless:sputnik_ice_core"
			id: "532BD235B8BD480D"
