				{ id: "72FCC7E42E07ED30", item: "grindless:lithium_breeder_blanket", type: "item" }
			]
			title: "Cold Fusion That Works"
			x: 8.0d
			y: -3.5d
		}
		{
			dependencies: ["3CAA678656F421E4"]
			description: ["Bend a beam round a ring and it shines X-rays. The &6Synchrotron&r prints chip patterns through an X-ray mask far finer than any lens can, and turns them into &6Photonic Chips&r."]
			icon: "gtceu:synchrotron"
			id: "3496B9631FC03AC3"
			rewards: [{ id: "73F7CB102ECBB71D", type: "xp", xp: 120 }]
