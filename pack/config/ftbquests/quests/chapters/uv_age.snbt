			]
			title: "Nano Forge"
			x: 0.75d
			y: 19.0d
		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6PCB Factory Mk I&r prints circuit boards in bulk, so the board and chip lines keep up with UV demand. Its controller, built on an assembly line, a cleanroom and a UV energy hatch: it draws about 491,520 EU/t while it runs. Boards at a rate the single assembler cannot hold, for every era after this one. Feed the inputs by ME and send the finished boards on by bus."]
			icon: "gtca:pcb_factory_mki"
			id: "721E38F5552E4D0B"
			rewards: [{ id: "38A9A12BF72C0AEF", type: "xp", xp: 120 }]
