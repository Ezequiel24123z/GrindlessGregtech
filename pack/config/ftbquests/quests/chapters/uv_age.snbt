			x: 18.0d
			y: 1.5d
		}
		{
			dependencies: ["58FBA751AA68D97F"]
			description: ["Stock krypton and xenon in tanks before you build the thrusters. Both are produced a drop at a time, so a full tank is what matters, not the rate."]
			icon: "gtceu:xenon_bucket"
