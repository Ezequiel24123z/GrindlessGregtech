			y: -0.5d
		}
		{
			dependencies: ["3C44B521C564CB61"]
			description: ["The sail carries a chip a few grams in weight: sensors, a small laser and a radio. Fit it in the sail and the &6Sailcraft&r is ready for the launcher."]
			icon: "grindless:sailcraft"
			id: "54D323DCC3423433"
			rewards: [{ id: "3F8AC658DDB1DA60", type: "xp", xp: 120 }]
