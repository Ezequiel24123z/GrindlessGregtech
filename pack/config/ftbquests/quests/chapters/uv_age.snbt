		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The wafers, chips and circuits of the era, from the first assembler to the mainframe, and the parts built from them."]
			icon: "minecraft:writable_book"
			id: "135F36C81C412CD0"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "5E25BA1D3CCE6D78", type: "checkmark" }]
			title: "Circuits"
			x: 2.5d
			y: -7.0d
		}
		{
			dependencies: ["135F36C81C412CD0"]
			description: ["The &6Wetware Processor Computer&r is the first UV circuit, and the assembly line is the only machine that builds it. The living part comes from Pluto: its ices and the ark and the vat grow organoids, which become stem cells and neuro processing units. The chain runs wetware processor, assembly, computer. Several wetware processor assemblies, wetware boards, RAM and NOR chips, and an assembly line with ZPM hatches. The stem cells and neuro processing units come from the organoid line, not from a recipe of their own. The wetware mainframe, and through it the UV assembler. Assemblies come from the ZPM line by ME; the assembly line draws them on demand."]
			icon: "gtceu:wetware_processor_computer"
			id: "37FC04290594CC34"
			rewards: [{ id: "55D88910E2A426ED", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7FEB8328EDD9FE61", item: "gtceu:wetware_processor_computer", type: "item" }]
			title: "Wetware Computer"
			x: 4.5d
			y: -9.5d
		}
		{
			dependencies: ["37FC04290594CC34"]
			description: ["The &6Wetware Processor Mainframe&r is a UHV-tier circuit, and the UV assembler is built around it. It comes out of the assembly line, not out of a circuit assembler. Wetware computers, tritanium frames and advanced SMD parts by the stack, and an assembly line with UV hatches. Photonic chips play no part in it. The UV circuit assembler, and the UHV hulls after it. Make it from stocked parts; ME keeps the mainframes in a dedicated chest."]
			icon: "gtceu:wetware_processor_mainframe"
			id: "3D8568FCB24941A1"
			rewards: [{ id: "1206428CBE865E89", type: "xp", xp: 180 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "37798CC6FECFE514", item: "gtceu:wetware_processor_mainframe", type: "item" }]
			title: "Wetware Mainframe"
			x: 7.0d
			y: -9.5d
		}
		{
			dependencies: ["3D8568FCB24941A1"]
			description: ["The &6UV Circuit Assembler&r builds the circuits UV machines are made of, and it is the only place the wetware processor is made from Highly Advanced SoCs. UV components for its hull, the cleanroom you already run, and a UHV-tier circuit: the Wetware Processor Mainframe, or a UHV universal circuit. Wetware processors from Highly Advanced SoCs, and the circuits the controllers of this era ask for. Boards and chips arrive by ME from the cleanroom; keep a stock of what it returns."]
			icon: "gtceu:uv_circuit_assembler"
			id: "1BC78E04FCA4A428"
			rewards: [{ id: "382E6FFF6483B722", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5078A520D111FF76", item: "gtceu:wetware_processor_mainframe", type: "item" }
				{ id: "5214933A7E49F976", item: "gtceu:uv_circuit_assembler", type: "item" }
			]
			title: "UV Circuit Assembler"
			x: 9.5d
			y: -9.5d
		}
		{
			dependencies: ["135F36C81C412CD0"]
			description: ["Gallium arsenide dust melts in a blast furnace under argon and grows into a &6Gallium Arsenide Boule&r, the seed stock of the photonic chips. A cutter slices it into wafers. Gallium arsenide dust, argon, an electric blast furnace that reaches 1600 K, and a cutter with lubricant. The gallium arsenide wafer, the InGaAs diodes, and the neutronium boule that grows from it. One boule yields eight wafers. Keep a furnace growing and send the wafers on by ME."]
			icon: "grindless:gallium_arsenide_boule"
			id: "78FADDA34778308B"
			rewards: [{ id: "7E463690A8366383", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7869971F767BF5C0", item: "grindless:gallium_arsenide_boule", type: "item" }]
			title: "Gallium Arsenide Boule"
			x: 4.0d
			y: -11.0d
		}
		{
			dependencies: ["78FADDA34778308B"]
			description: ["Neutronium, silicon and gallium arsenide grow into a &6Neutronium Boule&r in a blast furnace under xenon. The cutter slices it into &6Neutronium Wafers&r. Neutronium ingots, silicon blocks, the gallium arsenide boule from the quest before, xenon, a blast furnace that reaches the temperature, and a cutter with lubricant or water. The Highly Advanced SoC wafer, and the neutronium wafer the Starchip is cut from. The boule is slow and one boule yields a great many wafers. Keep one growing and stock the wafers by ME."]
			icon: "gtceu:neutronium_boule"
			id: "347BB93B6A76E068"
			rewards: [{ id: "5F9FE9C40E36C9D4", type: "xp", xp: 80 }]
