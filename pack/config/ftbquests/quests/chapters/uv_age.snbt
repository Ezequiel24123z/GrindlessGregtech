			title: "Tegmark Forge"
			x: 12.0d
			y: 37.5d
		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6Web Receiver&r is the first piece of a wireless energy web: it catches power from the web and hands it to a machine. The controller takes an active transformer, Naquadah alloy plates and a UV sensor. The Web Hub, which needs one to be built. It takes no items: place it next to the machines it should feed."]
			hide_dependency_lines: true
			icon: "gtmutils:web_receiver"
			id: "183507A491A7EE6A"
			rewards: [{ id: "103D0951E9D88D41", type: "xp", xp: 100 }]
