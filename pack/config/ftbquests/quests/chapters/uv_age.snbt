		}
		{
			dependencies: ["56E5B02FDDF0BC16", "39B2DA139D15F729"]
			description: ["Put the BNNT tank in the rocket and Pluto is in reach. Bring plenty of fuel: there's nothing out there to refuel you."]
			icon: "grindless:bnnt_fuel_tank"
			id: "384F072F5A9C68C5"
			rewards: [{ id: "341C64CAC6858136", type: "xp", xp: 120 }]
