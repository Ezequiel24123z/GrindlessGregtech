				{ id: "565D718E5B6D0CB8", item: "gtceu:neutronium_wafer", type: "item" }
			]
			title: "Neutronium Boule"
			x: 7.5d
			y: -11.0d
		}
		{
			dependencies: ["347BB93B6A76E068", "1BC78E04FCA4A428"]
			description: ["A neutronium wafer under a black lens becomes the &6Highly Advanced SoC Wafer&r, and the cutter turns it into &6Highly Advanced SoCs&r. A neutronium wafer, a black lens, a laser engraver, a cutter with lubricant or water, and a cleanroom. Wetware processors in the UV assembler, with neuro processing units. A wafer in, chips out. Send the chips on by ME to the UV assembler."]
			icon: "gtceu:highly_advanced_soc_wafer"
			id: "12D99BDAC8BA7ECD"
			rewards: [{ id: "517E070ABB97ADA2", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "59DFF3239AC22A02", item: "gtceu:highly_advanced_soc_wafer", type: "item" }
				{ id: "16476460D59C0345", item: "gtceu:highly_advanced_soc", type: "item" }
			]
			title: "Highly Advanced SoC"
			x: 11.5d
			y: -11.0d
		}
		{
			dependencies: ["135F36C81C412CD0"]
			description: ["An &6X-ray Mask&r is the stencil the synchrotron exposes a wafer through. Its lines are far finer than any lens can print. A cleanroom, the lithography you already run, and a gold absorber pattern on a thin membrane. The patterned wafer, and through it the photonic chip. A mask is not consumed in one exposure. Keep a few spares by ME and let the exposures draw them."]
			icon: "grindless:x_ray_mask"
			id: "5AC599C3AF5DFDE9"
			rewards: [{ id: "3CF81790EE66902C", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5B14431F93E4F8DC", item: "grindless:x_ray_mask", type: "item" }]
			title: "X-ray Mask"
			x: 4.0d
			y: -7.0d
		}
		{
			dependencies: ["5AC599C3AF5DFDE9"]
			description: ["A wafer coated in resist, exposed to the synchrotron through the mask and developed is a &6Patterned Wafer&r. The Synchrotron from further up, a mask, and PMMA-coated wafers. The photonic chip. Coating and developing run in plain machines by ME; only the exposure waits for the beam."]
			icon: "grindless:patterned_wafer"
			id: "1162AE7DDCC8105B"
			rewards: [{ id: "1A0A958B3C1ABFDD", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "76ABC0C58C4DCAFB", item: "grindless:patterned_wafer", type: "item" }]
			title: "Patterned Wafer"
			x: 6.5d
			y: -7.5d
		}
		{
			dependencies: ["1162AE7DDCC8105B"]
			description: ["Cut from the patterned wafer, the &6Photonic Chip&r moves light instead of electrons and does the work of a wafer of ordinary logic. A patterned wafer, silicon nitride film and a cleanroom. The starchip at the end of this row. No wetware circuit needs it. One wafer, many chips: keep a stock by ME so the assembler never waits."]
			icon: "grindless:photonic_chip"
			id: "34BCB5D648DF0A10"
			rewards: [{ id: "3BB32BA23EC5774C", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "12414E450AD9070D", item: "grindless:photonic_chip", type: "item" }]
			title: "Photonic Chip"
			x: 8.0d
			y: -8.0d
		}
		{
			dependencies: ["135F36C81C412CD0"]
			description: ["The &6HPGe Crystal&r is germanium refined past thirteen nines. It is the detector eye that probes and the interferometer carry. Germanium tetrachloride from the photonics line and the zone refining tower from further up. The SNSPD array beside it and the detector parts of the Starshot. The tower is slow; keep its feed topped up by ME and stock the crystals."]
			icon: "grindless:hpge_crystal"
			id: "55E637B2C7F65A5B"
			rewards: [{ id: "7A16811DCCDADD90", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3BB16E54C3F97654", item: "grindless:hpge_crystal", type: "item" }]
			title: "High-Purity Germanium"
			x: 4.5d
			y: -4.0d
		}
		{
			dependencies: ["55E637B2C7F65A5B"]
			description: ["A superconducting nanowire turns resistive the moment a single photon lands on it. The &6SNSPD Array&r is a grid of them on a niobium nitride film. An NbN-coated wafer from the MOCVD reactor, and the qubit fab with its helium-3 fridge. The optical ground station, the one reader of the Starshot. Tested arrays come out of the fab one wafer at a time; stock them by ME."]
			icon: "grindless:snspd_array"
			id: "10808A5F2A0FCB35"
			rewards: [{ id: "3379B6946A8AD65A", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "527C2EA5EECE407F", item: "grindless:snspd_array", type: "item" }]
			title: "Counting Photons"
			x: 8.0d
			y: -4.0d
		}
		{
			dependencies: ["7D5E30D919EC171F", "34BCB5D648DF0A10", "10808A5F2A0FCB35"]
			description: ["A photonic chip, a diamond qubit, an americium source and a neutronium wafer become one &6Starchip&r. Mounted on a sail it is a probe about as heavy as a paperclip. The Starchip Fab from further up, and every part on the light row above. The sailcraft, and with it the launch and the long coast to Proxima. The fab dices in batches and wastes only kerf. Send the chips on by ME to the sail line."]
			icon: "grindless:starchip"
			id: "5CBBEA07EE6F6329"
			rewards: [{ id: "7A505A39F1D1F270", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "754FC32002488365", item: "grindless:starchip", type: "item" }
				{ id: "3719F2BE65E6056C", item: "grindless:sailcraft", type: "item" }
			]
			title: "Starchip"
			x: 10.0d
			y: -3.5d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["Power, networks and processes that tie this era to the lines you already run."]
			icon: "minecraft:writable_book"
			id: "7A0170CCCE44944D"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "5D5D1837A4053106", type: "checkmark" }]
			title: "Integration"
			x: 11.5d
			y: 6.5d
		}
		{
			dependencies: ["7A0170CCCE44944D"]
			description: ["The &6Fusion Reactor Mk3&r is a bigger ring that lights plasmas the Mk2 cannot start. Sixteen UV energy hatches on the network for a 640 M start, and four wetware mainframes in the build. Americium, neutronium and the UV wireless tier. Feed it from tanks by pipe, and keep the hatches topped from the network."]
			icon: "gtceu:uv_fusion_reactor"
			id: "387E0EB82EC57EC4"
			rewards: [{ id: "7550E299F6AA9BF7", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.5d
			tasks: [
				{ id: "313782F9B227EE2A", item: "gtceu:uv_fusion_reactor", type: "item" }
				{ count: 16L, id: "3B0627B445897187", item: "gtceu:uv_energy_input_hatch", type: "item" }
			]
			title: "Third Ring"
			x: 14.0d
			y: 8.5d
		}
		{
			dependencies: ["387E0EB82EC57EC4"]
			description: ["Plutonium-241 and hydrogen fuse into &6Americium&r plasma, and a plasma turbine turns the heat into power on the way out. Plutonium-241 from IV, and a turbine on the Mk3's plasma output. Neutronium, and the americium the next ring also asks for. The cooled metal goes straight back in: pipe the plasma out, the ingots to ME."]
			icon: "gtceu:americium_plasma_bucket"
			id: "1571312A32D970D7"
			rewards: [{ id: "7F51C3DD1A0D7214", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7875CF04280E9C7E", item: "gtceu:plutonium_241_ingot", type: "item" }
				{ id: "14CAEF48058CDE87", item: "gtceu:americium_plasma_bucket", type: "item" }
				{ id: "7809ADDE1AF6E23F", item: "gtceu:americium_ingot", type: "item" }
			]
			title: "Americium Loop"
			x: 17.0d
			y: 9.0d
		}
		{
			dependencies: ["1571312A32D970D7"]
			description: ["Americium and naquadria start the hottest burn the Mk3 runs, and &6Neutronium&r comes out. It's the densest metal you'll handle, and UV's parts are full of it."]
			icon: "gtceu:neutronium_ingot"
			id: "55CB97D57C8A08CC"
			rewards: [{ id: "70C196EA59435A90", type: "xp", xp: 120 }]
			tasks: [{ id: "53316533B06855FA", item: "gtceu:neutronium_ingot", type: "item" }]
			title: "Neutronium"
			x: 19.5d
			y: 10.0d
		}
		{
			dependencies: ["55CB97D57C8A08CC"]
			description: ["A &6Gravi Star&r is a nether star wrapped in neutronium. It's the link the UV wireless network is built on."]
			icon: "gtceu:gravi_star"
			id: "500C872278B8AD2E"
			rewards: [{ id: "3A6EFF49DF3D03AE", type: "xp", xp: 100 }]
			tasks: [{ id: "19D3CA291D15FB7B", item: "gtceu:gravi_star", type: "item" }]
			title: "Gravi Star"
			x: 22.0d
			y: 12.0d
		}
		{
			dependencies: ["500C872278B8AD2E"]
			description: ["The network runs at its strongest cell, so one &6UV SMES Cell&r makes it carry UV. The new hatches draw from it wherever the network reaches, out to the stations too. The gravi star as the link, and at least one UV cell in a formed tower: until then the network stays at ZPM. Stations at Neptune and Pluto that run on power made at home. Nothing to feed: size the cells for your busiest hour and add more when it dips."]
			icon: "grindless:uv_smes_cell"
			id: "51C58090D6955D24"
			rewards: [{ id: "548E502447EB461D", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5AA057F72E0CFE2B", item: "grindless:uv_smes_cell", type: "item" }
				{ id: "583ABDC4A76B4838", item: "gtceu:uv_wireless_energy_hatch", type: "item" }
			]
			title: "The Network Goes UV"
			x: 23.5d
			y: 13.5d
		}
		{
			dependencies: ["51C58090D6955D24"]
			description: ["The &6UV Parallel Hatch&r runs far more recipes side by side in the plants that take one. The big generators and the single-shot probe bays do not. A machine that accepts one, and power to match: full parallel is a network job. Throughput without another hall. Bigger batches need bigger input buffers: check that your pipes keep up."]
			icon: "gtceu:uv_parallel_hatch"
			id: "5E51E4390B4AA17B"
			optional: true
			rewards: [{ id: "33BC2ED115597C13", type: "xp", xp: 60 }]
			shape: "gear"
			size: 0.75d
			tasks: [{ id: "3DD5BB1FA54BFE98", item: "gtceu:uv_parallel_hatch", type: "item" }]
			title: "Wider Still"
			x: 26.0d
			y: 17.0d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["Reactor thorium cannot be used as mined: the rare earths that travel with it are neutron poisons, and they would stall the core. The cure is a solvent, &6TBP&r (tributyl phosphate) in kerosene, that carries thorium and nothing else. Propene, hydrogen and carbon monoxide in the oxo process (butyraldehyde, hydrogenated over a nickel catalyst that is kept, to n-butanol), phosphoryl chloride to esterify it, and kerosene to dilute it to 30% TBP. The THOREX extraction. The hydrochloric acid from the esterification goes to your chlorine chemistry. The solvent is never used up: it goes round the extraction, so make one batch and top it up by pipe."]
			icon: "gtceu:tbp_solvent_bucket"
			id: "17EEA897E91DE2B5"
			rewards: [{ id: "3BD3291FD8CC7455", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "1ED29C8314ACC9A9", item: "gtceu:n_butanol_bucket", type: "item" }
				{ id: "5B63D3E19163256F", item: "gtceu:tributyl_phosphate_bucket", type: "item" }
				{ id: "72D344F73FD1BB36", item: "gtceu:tbp_solvent_bucket", type: "item" }
			]
			title: "Purify First"
			x: 4.0d
			y: 1.5d
		}
		{
			dependencies: ["17EEA897E91DE2B5"]
			description: ["Thorium dissolved in nitric acid is crude thorium nitrate. The solvent takes the thorium out and the poisons stay behind in the raffinate as lanthanide nitrate; distilled water strips it back as nuclear-grade &6Thorium Nitrate&r. Oxalate precipitates it, and the EBF calcines the oxalate to &6Thoria&r. Thorium dust, nitric acid, the TBP solvent, distilled water and oxalate. Thoria, the oxide fuel route that needs no nitrogen-15. The lanthanide nitrate is not waste: it feeds the EV rare-earth cascade, and the nitric acid goes back to the dissolution. Two tanks and a loop: solvent in a circle, acid in a circle, thoria out by ME."]
			icon: "gtceu:thoria_dust"
			id: "14CC12E0578EF12D"
			rewards: [{ id: "1042FA7F8A95B54F", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7444BF414A5B6057", item: "gtceu:crude_thorium_nitrate_bucket", type: "item" }
				{ id: "54EACD6F8B98FC6D", item: "gtceu:thorium_nitrate_bucket", type: "item" }
				{ id: "7BB68399219CD781", item: "gtceu:thorium_oxalate_dust", type: "item" }
				{ id: "7DFDB601112C9BC2", item: "gtceu:thoria_dust", type: "item" }
			]
			title: "THOREX to Thoria"
			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["14CC12E0578EF12D"]
			description: ["A thorium nitride core breeds better than oxide, but ordinary nitrogen-14 eats neutrons: the nitride has to be made with nitrogen-15. Triton's geysers are rich in it. Burn the Triton nitrogen to nitric oxide, distil the nitrogen-15 oxide out in the EV cryogenic plant and reduce it with hydrogen; the tholin comes out as a by-product for its own reformer. The Triton geyser sampler from Neptune orbit, thoria, carbon and the nitrogen-15 itself: carbothermic nitridation runs under it, and the carbon monoxide goes to the syngas plant. Thorium nitride dust and, with the next quest, the nitride assembly. The spent nitride gives its nitrogen-15 back at the pyroprocessing cell, so after the first fill you only top it up."]
			icon: "gtceu:thorium_mononitride_dust"
			id: "1B1F0B3332F15721"
			rewards: [{ id: "3418DDE37BD4A5D0", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "37269070398A3128", item: "gtceu:nitrogen_15_bucket", type: "item" }
				{ id: "5DD9CC6F4B1866EF", item: "gtceu:thorium_mononitride_dust", type: "item" }
			]
			title: "Nitrogen-15 and the Nitride"
			x: 8.0d
			y: 1.5d
		}
		{
			dependencies: ["1B1F0B3332F15721"]
			description: ["Thoria is sintered with a niobia aid into pellets and the nitride is pressed and sintered under a nitrogen-15 flush. Pellets go into &6cladding tubes&r of 15-15Ti steel, helium-bonded and welded into pins, and the pins and their grids into assemblies. Either powder, cladding tube (stainless steel and titanium), and the fuel fabrication plant. The oxide assembly breeds less and burns shorter; the nitride assembly breeds better. Fuel for the accelerator-driven reactor. Oxide works the moment you have thoria, so you can start before Triton. Pellets, pins and assemblies are three steps of the same plant; leave the output on ME and let the reactor draw from it."]
			icon: "grindless:thorium_nitride_fuel_pin"
			id: "3BA6639AC4EB9283"
			rewards: [{ id: "3F2428D68674421F", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7784513D45FD008A", item: "grindless:thoria_pellet", type: "item" }
				{ id: "7000E8B0B5C30240", item: "grindless:thorium_nitride_pellet", type: "item" }
				{ id: "3AE741527779CBD8", item: "grindless:thorium_oxide_fuel_assembly", type: "item" }
				{ id: "75F7A26F9837D71B", item: "grindless:thorium_nitride_fuel_assembly", type: "item" }
			]
			title: "Pellets, Pins, Assemblies"
			x: 10.0d
			y: 1.5d
		}
		{
			dependencies: ["3BA6639AC4EB9283"]
			description: ["Thorium is fertile, not fissile: a core of it cannot sustain itself. The accelerator-driven reactor supplies the missing neutrons with a proton beam on a lead-bismuth pool (never used up), so the core stays subcritical and stops when the beam stops. About six assemblies an hour, four and a half on nitride; IV's stored thorium decides how many reactors run. Contain the polonium-210 until it decays. The reactor, and assemblies from the pin line. The biggest steady power of the era, with fission products as the only waste, and spent fuel for the pyroprocessing cell. Spent assemblies go to the pyroprocessing cell and come back as fuel: close the loop before you scale."]
			icon: "grindless:thorium_oxide_fuel_assembly"
			id: "325BE1C42B45620C"
			rewards: [{ id: "3645ADD2CF1C4971", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "1DDDEDFBBA214F57", item: "gtceu:accelerator_driven_reactor", type: "item" }
				{ id: "70A6F1EB0185CF93", type: "checkmark" }
			]
			title: "The Thorium Burn"
			x: 12.5d
			y: 3.0d
		}
		{
			dependencies: ["325BE1C42B45620C"]
			description: ["The pyroprocessing cell works spent fuel in three hot cells behind lead glass. It chops the assemblies into fragments (the hulls are waste), reduces oxide fragments to thorium-uranium metal with lithium, and electrorefines the metal in molten lithium chloride, and the bred uranium collects on the cathode. The pyroprocessing cell, an argon supply and lithium. The nitride fragments skip the reduction and go straight to the refiner, giving back their thorium and nitrogen-15 on the way. The cathode deposit, which is distilled free of salt into the uranium ingots. Keep some for UHV. Fragments, salt and metal never leave the cell: feed spent fuel in by ME and take thorium and nitrogen-15 back to their dissolution and cryogenic plant."]
			icon: "grindless:u233_cathode_deposit"
			id: "7E6528C2D66A2DD3"
			rewards: [{ id: "30C9BF0CB8EBEC75", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "504FFE8617584272", item: "grindless:spent_oxide_fragments", type: "item" }
				{ id: "71A19410CFC3A01F", item: "grindless:spent_nitride_fragments", type: "item" }
				{ id: "346B7BB3D121ADA4", item: "gtceu:thorium_uranium_metal_dust", type: "item" }
				{ id: "5ABB43D1C6FC9C7D", item: "grindless:u233_cathode_deposit", type: "item" }
			]
			title: "Chop and Electrorefine"
			x: 14.5d
			y: 4.0d
		}
		{
			dependencies: ["7E6528C2D66A2DD3"]
			description: ["A quarter of the uranium-233 is not in the cathode: it is still protactinium-233 in the loaded salt. Lithium pulls the protactinium into bismuth, and it has to sit for 27 days while it decays to uranium-233. Rush it and you lose that quarter. The loaded salt from the refiner, and a tank that can wait. The clean salt goes back into the cell, and the radioactive waste goes to the waste store. The last of the uranium, smelted together with the cathode ingots. It is also the seed that grows thorium-229 in UHV. Run several holding tanks in rotation so one is always ready; the output merges with the cathode line."]
			icon: "gtceu:protactinium_bismuth_bucket"
			id: "572C075E6EBF0B00"
			rewards: [{ id: "383F5B4508D0EB81", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "126B023199E37F0B", item: "gtceu:protactinium_bismuth_bucket", type: "item" }
				{ id: "34B3B38CBCC8FD96", item: "gtceu:uranium_233_dust", type: "item" }
			]
			title: "The 27-Day Hold"
			x: 14.5d
			y: 5.5d
		}
		{
			dependencies: ["7E6528C2D66A2DD3", "572C075E6EBF0B00"]
			description: ["The IV &6Fuel Fabrication Plant&r learns three thorium rows, and a uranium rod for IV's fission reactor: the end of the thorium cycle. The uranium ingots from the cathode and the hold, and the fuel fabrication plant. A fission reactor that burns what the thorium bred. Send the bred metal straight to the plant and the spent rods back to the cell."]
			icon: "gtceu:fuel_fabrication_plant"
			id: "1FEBAAE91287085C"
			rewards: [{ id: "53F98BFAD5289ADE", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "1E9985A62FA45B79", item: "gtceu:fuel_fabrication_plant", type: "item" }
				{ id: "3F46B97EEA41BC9F", item: "gtceu:uranium_233_ingot", type: "item" }
				{ id: "72DB79F7D3B43E83", item: "grindless:u233_fuel_rod", type: "item" }
			]
			title: "Back to Uranium-233"
			x: 16.0d
			y: 5.5d
		}
		{
			dependencies: ["7A0170CCCE44944D"]
			description: ["A &6Muon Fusion Cell&r burns liquid deuterium and tritium, and its lithium blanket breeds most of the tritium back. The rest is IV's tritium removal facility's work. The cell from further up, deuterium and tritium by pipe, and a linac behind it. Power with no fission and almost no waste. The cell is an extrapolation: real muons are lost too soon. Watch the make-up tritium: when the facility lags, the cell starves."]
			icon: "grindless:lithium_breeder_blanket"
			id: "1832088E3A8ADB56"
			rewards: [{ id: "57362C2A00CBB09B", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "30AB064A0C464C2E", item: "gtceu:muon_fusion_cell", type: "item" }
				{ id: "3F5CEC270E667895", type: "checkmark" }
			]
			title: "Tritium Comes Back"
			x: 13.0d
			y: 6.5d
		}
		{
			dependencies: ["561A6287570BE65F"]
			description: ["The &6Laser Fusion Chamber&r burns one fuel capsule per shot. Lead-boron capsules take 400 ticks, about 180 an hour; deuterium and helium-3 capsules take 600, about 120 an hour, and also give off hydrogen. Capsules from the lattice fab, and fibre laser modules that wear by about two percent a shot. The largest single plant of the era, and a reason to scale the lattice fab. The fab's throughput is the cap by design: store capsules in ME and keep spare modules."]
			icon: "gtceu:laser_fusion_chamber"
			id: "1CFA41A19DF007BF"
			rewards: [{ id: "7F93037C91621B29", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "3EBA6C90D9BE7E2B", item: "gtceu:laser_fusion_chamber", type: "item" }
				{ id: "52A73C0328622A07", type: "checkmark" }
			]
			title: "A Capsule a Shot"
			x: 22.0d
			y: 15.0d
		}
		{
			dependencies: ["7A0170CCCE44944D"]
			description: ["The IV &6Hot Cell&r learns a boron mode: four boron trifluoride in, one boron-11 trifluoride and a little boron-10 out. Boron trifluoride from the centrifuges and the next free circuit in the cell. Decaborane for the capsules, and boron-10 for the nanotube reactor. The fluorine leaves as acid the rest of your chemistry takes: pipe the boron-10 on."]
			icon: "gtceu:hot_cell"
			id: "168DB3651CB5C124"
			rewards: [{ id: "538EACE58A418FA6", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7495A18DB52383BF", item: "gtceu:hot_cell", type: "item" }
				{ id: "5777843390CAFC97", item: "gtceu:boron_11_trifluoride_bucket", type: "item" }
			]
			title: "Boron-11"
			x: 17.0d
			y: 15.5d
		}
		{
			dependencies: ["168DB3651CB5C124"]
			description: ["The ZPM &6Diamond Lattice Fab&r grows a fuel capsule round decaborane, or round deuterium and helium-3 for the other burn. Decaborane from the hot cell, or deuterium and helium-3 from Neptune, plus the new circuits in the fab. Every shot of the laser chamber. Every shot spends one: automate the capsules first and let ME hold a day's worth."]
			icon: "grindless:pb11_capsule"
			id: "561A6287570BE65F"
			rewards: [{ id: "5F596B4504419CD5", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5123EB03EA75E9E8", item: "gtceu:diamond_lattice_fab", type: "item" }
				{ id: "354A374C5F8303B7", item: "grindless:pb11_capsule", type: "item" }
				{ id: "7E41CAE2CA63C3B1", item: "grindless:d_he3_capsule", type: "item" }
			]
			title: "Diamond Capsules"
			x: 19.0d
			y: 14.5d
		}
		{
			dependencies: ["561A6287570BE65F"]
			description: ["The EV &6Cryogenic Plant&r splits nitric oxide into nitrogen-15 and nitrogen-14 oxide, and Kuiper noble gas into argon, krypton and xenon. Nitric oxide from Triton's nitrogen, and the two UV rows in the plant. Thorium nitride, which breeds better, and the krypton for the thrusters. The pyroprocessing cell hands the nitrogen back: loop it to the plant."]
			icon: "gtceu:cryogenic_plant"
			id: "19B2FBC6EE88BA08"
			rewards: [{ id: "39ECA7B65AB79318", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "1651C60F11617C68", item: "gtceu:cryogenic_plant", type: "item" }
				{ id: "3227C58A62A6B19E", item: "gtceu:nitrogen_15_bucket", type: "item" }
			]
			title: "Nitrogen-15"
			x: 21.0d
			y: 17.0d
		}
		{
			dependencies: ["19B2FBC6EE88BA08"]
			description: ["The EV &6Extraction Cascade&r strips ytterbium oxide out of the mixed rare-earth chloride and sends the chloride back. Mixed rare-earth chloride from the monazite line, and the next free circuit in the cascade. The fibre draw tower and every laser built on its fibre. Loop the chloride back to the monazite line and send the oxide to ME."]
			icon: "gtceu:extraction_cascade"
			id: "501B3E34C390183C"
			rewards: [{ id: "5CC18BC661065F6B", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "33277DB67DC64334", item: "gtceu:extraction_cascade", type: "item" }
				{ id: "517C7A6414FA4CD9", item: "gtceu:ytterbium_oxide_dust", type: "item" }
			]
			title: "Ytterbium Strip"
			x: 23.0d
			y: 17.5d
		}
		{
			dependencies: ["501B3E34C390183C"]
			description: ["The HV &6Composite Autoclave&r bakes carbon fibre and pitch into a &6Carbon-Carbon Aeroshell&r, the skin a probe needs where a heat shield melts. Carbon fibre from ZPM's tholin reformer and pitch, and the next free circuit in the autoclave. The thruster works and the probes that fly to the heliopause. Shells are bulky: let ME hold them and the probe bays pull what they need."]
			icon: "grindless:carbon_carbon_aeroshell"
			id: "5628CEEA5E0ADD03"
			rewards: [{ id: "3A7D283E6319EE71", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "3E23BF3D73D60176", item: "gtceu:composite_autoclave", type: "item" }
				{ id: "36067D46D190C7E9", item: "grindless:carbon_carbon_aeroshell", type: "item" }
			]
			title: "Carbon Shell"
			x: 24.5d
			y: 17.5d
		}
		{
			dependencies: ["1AA12DFECDEFD309"]
			description: ["Neptune orbit gets its own &6AE2 pair&r, so what the station makes goes home and what it needs comes out. Power doesn't need it: the wireless network already carries that."]
			icon: "grindless:station_truss_casing"
			id: "756406F70D5B33F4"
			rewards: [{ id: "38C06798F0727E32", type: "xp", xp: 80 }]
			tasks: [{ id: "18293B578B4D2293", type: "checkmark" }]
			title: "Neptune on the Network"
			x: 17.0d
			y: -2.0d
		}
		{
			dependencies: ["756406F70D5B33F4", "309F1CA9C2FE71C9"]
			description: ["Same again at Pluto orbit. Both stations send hydrogen, helium, nitrogen and noble gases by the tankful, so fluid cells and extra coprocessors matter more than item storage. Chunk-load them both: the far machines only run while their chunks are loaded."]
			icon: "grindless:station_truss_casing"
			id: "54E3E2B4FA4B5586"
			rewards: [{ id: "3EA94D8B23C84B9C", type: "xp", xp: 80 }]
			tasks: [{ id: "5FD6C3EC8E5BA777", type: "checkmark" }]
			title: "Pluto on the Network"
			x: 23.5d
			y: -2.0d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The machines of the era and the first steps that put each one to work."]
			icon: "minecraft:writable_book"
			id: "16D1550DF465D570"
