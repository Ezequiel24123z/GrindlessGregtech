			x: 6.0d
			y: 30.0d
		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6Sapphire Wafer&r is a wafer stage on the way to the NbTiN Film Wafer. Made by the first machine of its line; the cleanroom and EMI show the exact recipe. The NbTiN Film Wafer in the MTJ Sputtering. Feed it by ME from the machine before it; keep a few spare wafers in stock."]
			hide_dependency_lines: true
			icon: "grindless:sapphire_wafer"
