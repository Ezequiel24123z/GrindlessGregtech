			x: 31.5d
			y: 0.5d
		}
		{
			dependencies: ["54D323DCC3423433"]
			description: ["An interferometer the size of a planet is out of reach, so this one is an extrapolation: the &6Sgr A* Image&r is pieced together from many telescopes. It opens the UHV hatch."]
			icon: "grindless:sgr_a_star_image"
			id: "39792D192AD44A70"
