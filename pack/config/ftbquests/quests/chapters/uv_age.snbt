				{ id: "3F0103BF5EF9138B", item: "grindless:station_truss_casing", type: "item" }
			]
			title: "Arrokoth's Kin"
			x: 23.5d
			y: 4.0d
		}
		{
			dependencies: ["1F125850043BA593"]
			description: ["A &6Planetesimal Sample&r is ice and dust that has not changed since the Solar System formed, so it is the one thing that shows what the young system was made of. A probe brings it back from the Kuiper Belt in a canister, so you need the probe line and a launch. It unlocks the annealing carousel of the fractionator, which keeps the ice as it was. Probes go out by ME and the canister comes back the same way."]
			icon: "grindless:planetesimal_sample"
			id: "3D26AB0B36F9CEB1"
			rewards: [{ id: "3568332CA756123D", type: "xp", xp: 80 }]
			tasks: [{ id: "5FC9F0CFF93FC518", item: "grindless:planetesimal_sample", type: "item" }]
			title: "Planetesimal Sample"
			x: 25.5d
			y: 4.5d
		}
		{
			dependencies: ["309F1CA9C2FE71C9"]
			description: ["The &6Precursor Probe Bay&r sends a probe ahead along a rail to the edge of the Sun's wind, and listens to what it finds. Its controller, the station truss casing, a pressure hull casing and a computer casing relay. The heliopause data. Probes by ME; the data is one item per flight."]
			icon: "gtceu:precursor_probe_bay"
			id: "75BE44AC4E14F680"
			rewards: [{ id: "17216760A7FAC65E", type: "xp", xp: 120 }]
