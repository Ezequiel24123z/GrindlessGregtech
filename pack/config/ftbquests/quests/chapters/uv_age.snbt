			title: "Triton Ice Core"
			x: 20.5d
			y: 8.5d
		}
		{
			dependencies: ["309F1CA9C2FE71C9"]
			description: ["The &6Penetrator Probe Bay&r drops a probe that melts its way into the glacier of Sputnik Planitia and sends a core up. Its controller, the station truss casing and a pressure hull casing. The Sputnik ice core and the Plutonian quantum seed. Probes by ME; the bay returns the core in the same pass."]
			icon: "gtceu:penetrator_probe_bay"
			id: "7532E9F54B57BF70"
			rewards: [{ id: "1649E5FAC20F6FA6", type: "xp", xp: 120 }]
