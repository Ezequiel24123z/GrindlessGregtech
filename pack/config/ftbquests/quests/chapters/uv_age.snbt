				{ id: "5CA0F69E4887CBE0", item: "gtceu:laser_fusion_chamber", type: "item" }
				{ id: "32376DFCE35F3BB1", item: "gtceu:uv_machine_casing", type: "item" }
				{ id: "584EC4FC124C035B", item: "grindless:laser_module_block", type: "item" }
			]
			title: "Laser Fusion Chamber"
			x: 6.5d
			y: 10.5d
		}
		{
			dependencies: ["598B196C669CA9B5"]
			description: ["The &6Muon Fusion Cell&r makes cold fusion with muons as the catalyst: deuterium and tritium fuse close to room temperature. Its controller, the cryostat casing and the &6SRF Cryomodule Block&r that drives the muon channel. A second fusion generator that needs no plasma. Keep a deuterium-tritium tank on a pipe and let the helium out by ME."]
			icon: "gtceu:muon_fusion_cell"
			id: "1225702AF9F2A2E4"
			rewards: [{ id: "7BBCFA27ABA6914E", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "79AC5E9ADB0ECE07", item: "gtceu:muon_fusion_cell", type: "item" }
				{ id: "3A42B04451BB2798", item: "grindless:cryostat_casing", type: "item" }
				{ id: "7FB86716C4ABEA64", item: "grindless:srf_cryomodule_block", type: "item" }
			]
			title: "Muon Fusion Cell"
			x: 11.0d
			y: 8.5d
		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6Superfluid Helium Plant&r cools helium below its lambda point, where it flows without friction, and splits Neptune's helium with a superleak. Its controller, the &6Cryostat Casing&r, a &6Mu-Metal Shield&r that keeps stray fields off the cold stage, and the stainless gearboxes that run the cold compressors. Helium II for the cryomodules and the cavity works. Gas arrives by pipe; stock helium II in a dedicated tank."]
			icon: "gtceu:superfluid_helium_plant"
			id: "50932D647CEF0A54"
			rewards: [{ id: "3A5B4438597AD1F7", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5DB04F970177D45A", item: "gtceu:superfluid_helium_plant", type: "item" }
				{ id: "5025515AE5D2D6DC", item: "grindless:cryostat_casing", type: "item" }
				{ id: "1F4E45076F0C75F2", item: "grindless:mu_metal_shield", type: "item" }
			]
			title: "Superfluid Helium"
			x: 3.5d
			y: 9.5d
		}
		{
			dependencies: ["50932D647CEF0A54"]
			description: ["The &6SRF Cavity Works&r melts niobium very pure (RRR sheet), deep-draws it into half-cells (two from each sheet), welds eighteen half-cells into a nine-cell bare cavity, polishes it in acid, and welds on a titanium helium vessel to dress it. Its controller and clean room casing; niobium ingots and helium II run through it. Dressed cavities (eight make a string) for the cryomodule, the accelerators and the synchrotron. The spent acid is electrolysed back to niobium and both acids: keep that loop closed. Take cavities out by ME."]
			icon: "gtceu:srf_cavity_works"
			id: "375D70399F1951D2"
			rewards: [{ id: "7F016E2F2D84DADE", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "705A82674604C042", item: "gtceu:srf_cavity_works", type: "item" }
				{ id: "5ABC99C2B00854CD", item: "gtceu:clean_machine_casing", type: "item" }
				{ id: "722F33F9F01E4BF7", item: "grindless:rrr_niobium_sheet", type: "item" }
				{ id: "1DEA13935578C7D3", item: "grindless:niobium_half_cell", type: "item" }
				{ id: "79D0D69538817D03", item: "grindless:bare_srf_cavity", type: "item" }
			]
			title: "Cavity Works"
			x: 6.5d
			y: 9.0d
		}
		{
			dependencies: ["375D70399F1951D2"]
			description: ["A finished &6SRF Cavity&r is niobium cut to a few microns of surface roughness; welded into its helium vessel it becomes a &6Dressed SRF Cavity&r, and eight dressed cavities in superfluid helium make the cryomodule. Every beam machine of this era sits on them."]
			icon: "grindless:srf_cavity"
			id: "598B196C669CA9B5"
			rewards: [{ id: "151F080E9C6C1576", type: "xp", xp: 80 }]
