				{ id: "33CA9827EF18E6EE", item: "grindless:silver_tube", type: "item" }
			]
			title: "Powder Billet"
			x: 11.5d
			y: 16.5d
		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6Powder Bed Printer&r melts atomised metal powder layer by layer into parts that no machine tool could cut. Its controller, UV casing and a heated bed under an argon blanket. Thruster chambers, array mounts and probe frames. Printing consumes most of its powder, and atomising loses a little argon. Keep both stocked and store the parts by ME."]
			icon: "gtceu:powder_bed_printer"
			id: "1CC82013F8BF2D9B"
			rewards: [{ id: "7ED6E0AE66B3AF04", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "36BEB5C5C133CDF3", item: "gtceu:powder_bed_printer", type: "item" }
				{ id: "1C808105601C6D4B", item: "gtceu:uv_machine_casing", type: "item" }
			]
			title: "Powder Bed Printer"
			x: 5.0d
			y: 15.75d
		}
		{
			dependencies: ["1CC82013F8BF2D9B"]
			description: ["The &6Printed Probe Frame&r is the lightest rigid thing you build; the probe hangs from it. The powder bed printer prints it from atomised metal powder under argon. It unlocks the cryotank winder and every probe after it. Keep powder and argon stocked and store the frames in ME."]
			icon: "grindless:printed_probe_frame"
			id: "1ACAD1676B56BFC3"
			rewards: [{ id: "58CDFDA1D1DD9503", type: "xp", xp: 80 }]
			tasks: [{ id: "1AA67A07BA194382", item: "grindless:printed_probe_frame", type: "item" }]
			title: "Printed Probe Frame"
			x: 7.5d
			y: 16.25d
		}
		{
			dependencies: ["1ACAD1676B56BFC3"]
			description: ["The &6Cryotank Winder&r winds BNNT yarn round a liner into the tier 11 tank that level 7 rockets need. Its controller and UV casing; the resin trim is voidable. The level 7 fuel tank. Yarn and liners by ME; trim goes to a void."]
			icon: "gtceu:cryotank_winder"
			id: "7BC2C74CC4129019"
			rewards: [{ id: "53901BA266CED66E", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1B77ED5E0ECFCC1C", item: "gtceu:cryotank_winder", type: "item" }
				{ id: "1BAE79C07C32A17A", item: "gtceu:uv_machine_casing", type: "item" }
