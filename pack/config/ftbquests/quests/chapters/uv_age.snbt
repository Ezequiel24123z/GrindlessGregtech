			y: 0.0d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["Past Neptune the sun is a bright star: solar and sky mirrors give almost nothing. Everything out there runs on power made at home, so build the UV network before the first launch."]
			icon: "grindless:pluto_kuiper_chart"
			id: "1CF3C7EC4F724FAB"
			rewards: [{ id: "10BFCE21030912C6", type: "xp", xp: 20 }]
			shape: "circle"
			size: 0.75d
