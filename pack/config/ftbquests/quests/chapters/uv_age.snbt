			title: "Charon"
			x: 14.0d
			y: 1.5d
		}
		{
			dependencies: ["532BD235B8BD480D"]
			description: ["Every ice boils off at its own temperature. Warmed step by step, one core gives nitrogen, carbon monoxide, methane, water and ammonia apart, and each has a home in your chemistry."]
			icon: "grindless:sputnik_ice_core"
			id: "3C6A1EFD6D4E4A5C"
			rewards: [{ id: "73B6899C2D81B877", type: "xp", xp: 30 }]
