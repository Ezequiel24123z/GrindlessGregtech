			title: "Sailcraft"
			x: 34.5d
			y: -1.0d
		}
		{
			dependencies: ["54D323DCC3423433"]
			description: ["On the Moon, a whole array of fibre lasers points at one sail and pushes. The Laser Sail Launcher fires the sailcraft from the Starchip Fab (Machines chapter). The heliopause data sets the course and is kept, and every launch wears the modules: keep the refurbishing going."]
			icon: "grindless:starshot_probe"
			id: "393D800CED26F9C1"
			rewards: [{ id: "34F6D61189838896", type: "xp", xp: 200 }]
