		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6Pyroprocessing Cell&r takes spent thorium fuel apart in molten salt and gives back uranium-233 and nitrogen-15. Its controller and the &6Radiation-Proof Casing&r that contains the salt. Uranium-233 for fuel rods, and nitrogen-15 for the nitride fuel. Feed spent fuel by ME and loop the salt in its own tank; never let it run dry."]
			icon: "gtceu:pyroprocessing_cell"
			id: "7F5AFF284AB79EA8"
			rewards: [{ id: "39000AE6494F0929", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "531FE7704905C32C", item: "gtceu:pyroprocessing_cell", type: "item" }
				{ id: "179B61ED1414FD7A", item: "gtnn:radiation_proof_machine_casing", type: "item" }
			]
			title: "Pyroprocessing"
			x: 3.5d
			y: 8.0d
		}
		{
			dependencies: ["7F5AFF284AB79EA8"]
			description: ["The &6Accelerator-Driven Reactor&r burns the thorium you stored at IV, kept subcritical by a proton beam. Power from it stops the moment the beam does. Its controller, UV machine casing, superconducting coils and the &6SRF Cryomodule Block&r that holds the beam cold. Thorium as a generator, and the fuel assemblies the cell recycles. Fuel assemblies by ME from the fabrication plant; spent ones go straight back to the cell."]
			icon: "gtceu:accelerator_driven_reactor"
			id: "531F95CE48EB6C79"
			rewards: [{ id: "5C3E4CA800187BD9", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "734B95D163FFD5AA", item: "gtceu:accelerator_driven_reactor", type: "item" }
				{ id: "72AEDF31493FD4C1", item: "gtceu:uv_machine_casing", type: "item" }
				{ id: "5DB291BEEDD887D9", item: "grindless:srf_cryomodule_block", type: "item" }
			]
			title: "Accelerator-Driven Reactor"
			x: 5.0d
			y: 8.0d
		}
		{
			dependencies: ["531F95CE48EB6C79"]
			description: ["The cell's uranium-233 becomes a &6U-233 Fuel Rod&r for the fission reactor you built at IV. Thorium fuel closes its own loop."]
			icon: "grindless:u233_fuel_rod"
			id: "5899817CE39B0BF5"
			rewards: [{ id: "3AA7DA53481B041C", type: "xp", xp: 80 }]
