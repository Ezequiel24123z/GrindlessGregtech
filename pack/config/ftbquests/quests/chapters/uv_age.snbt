			title: "Triton"
			x: 6.0d
			y: -1.5d
		}
		{
			dependencies: ["56E5B02FDDF0BC16"]
			description: ["Only helium-4 slips through a superleak. Run Neptune helium through the superfluid plant and the helium-3 stays behind as a concentrate for the isotope column."]
			icon: "gtceu:superfluid_helium_plant"
			id: "1CC95A249766A52E"
			rewards: [{ id: "3C8D2A9636E0D7D5", type: "xp", xp: 40 }]
