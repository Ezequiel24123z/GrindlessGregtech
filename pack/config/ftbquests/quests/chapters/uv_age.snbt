			title: "Level Seven"
			x: 19.0d
			y: 3.0d
		}
		{
			dependencies: ["384F072F5A9C68C5"]
			description: ["Pluto is about thirty times further than the Earth from the Sun. Plan the trip as a round one: fuel for the way back goes in the tank before you leave."]
			icon: "grindless:bnnt_fuel_tank"
			id: "1F1791E42189CE4B"
