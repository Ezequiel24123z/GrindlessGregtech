			x: 8.0d
			y: 1.5d
		}
		{
			dependencies: ["56E5B02FDDF0BC16", "39B2DA139D15F729"]
			description: ["Put the BNNT tank in the rocket and Pluto is in reach. Bring plenty of fuel: there's nothing out there to refuel you."]
			icon: "grindless:bnnt_fuel_tank"
			id: "384F072F5A9C68C5"
			rewards: [{ id: "341C64CAC6858136", type: "xp", xp: 120 }]
			tasks: [{ id: "56FD3E401FA48B76", item: "grindless:bnnt_fuel_tank", type: "item" }]
			title: "Level Seven"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["384F072F5A9C68C5"]
			description: ["Pluto is about thirty times further than the Earth from the Sun. Plan the trip as a round one: fuel for the way back goes in the tank before you leave."]
			icon: "grindless:bnnt_fuel_tank"
			id: "1F1791E42189CE4B"
			rewards: [{ id: "37FC9953F8396EDE", type: "xp", xp: 20 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "71E48C6672F41A30", type: "checkmark" }]
			title: "One Way Fuel"
			x: 10.0d
			y: 1.5d
		}
		{
			dependencies: ["384F072F5A9C68C5"]
			description: ["Pluto orbit, as far out as the stations go. Sunlight takes hours to get here; chunk-load the station and keep spares, because nothing out here is quick to replace."]
			icon: "grindless:station_truss_casing"
			id: "309F1CA9C2FE71C9"
			rewards: [{ id: "7F623D7EC6843684", type: "xp", xp: 150 }]
			shape: "rsquare"
