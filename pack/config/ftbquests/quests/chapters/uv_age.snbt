		}
		{
			dependencies: ["393D800CED26F9C1"]
			description: ["Years later in the pack's time, the probe passes Proxima Centauri and a ground station catches its signal. The &6Proxima Approach Data&r is the first look at the next star."]
			icon: "grindless:proxima_approach_data"
			id: "7192C8527301DC08"
