			x: 27.5d
			y: 0.0d
		}
		{
			dependencies: ["5443B4BF3D09D99E"]
			description: ["Krypton and xenon are what an ion thruster burns. Kuiper gas gives both once the cryogenic plant sorts it: there is no other source out here."]
			icon: "gtceu:krypton_bucket"
			id: "58FBA751AA68D97F"
			rewards: [{ id: "114AB5B088987DF4", type: "xp", xp: 20 }]
