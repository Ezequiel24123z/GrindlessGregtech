		}
		{
			dependencies: ["5510E49421AB4078"]
			description: ["A precursor probe crosses the heliopause, where the solar wind gives way to interstellar space. Its &6Heliopause Data&r sets the course for the sail."]
			icon: "grindless:heliopause_data"
