		}
		{
			dependencies: ["5D202249DE11C108", "3D26AB0B36F9CEB1"]
			description: ["The &6Volatile Ice Fractionator&r warms a core and collects each ice as it turns to gas. Circuit 1 splits a Sputnik core into nitrogen, carbon monoxide, methane and tholin; 2 a Charon core into water, ammonia and silica; 3 anneals a Kuiper sample at about 140 K, so its noble gases escape. Its controller in a cold tower: station truss casings, titanium frames, laminated glass, frostproof bands, a steel pipe cold finger and a ring of cryostat casings. One Terminal pass. The gases at their sources, and the Kuiper noble gas that the cryogenic plant splits into argon, krypton and xenon. Cores and samples in by ME, each fluid to its own hatch. Annealing dust is voided inside the machine."]
			icon: "gtceu:volatile_ice_fractionator"
			id: "11689C4D9A9ABF77"
			rewards: [{ id: "5DF7243CAAE3C87A", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "343B21497302CF70", item: "gtceu:volatile_ice_fractionator", type: "item" }
				{ id: "16ED74AA2D96D858", item: "grindless:station_truss_casing", type: "item" }
				{ id: "7F327C9338A63D79", item: "gtceu:frostproof_machine_casing", type: "item" }
				{ id: "57095DA9F0896029", item: "grindless:cryostat_casing", type: "item" }
			]
			title: "Ices Apart"
			x: 29.0d
			y: 8.5d
		}
		{
			dependencies: ["309F1CA9C2FE71C9"]
			description: ["The &6Kuiper Interceptor Bay&r launches a probe at a Kuiper belt object and brings a sample back. Its controller, the station truss casing and the probe hangar rail. The planetesimal sample. Probes by ME; the sample comes out in a canister."]
			icon: "gtceu:kuiper_interceptor_bay"
			id: "1F125850043BA593"
			rewards: [{ id: "71B1692CA99E1E54", type: "xp", xp: 120 }]
