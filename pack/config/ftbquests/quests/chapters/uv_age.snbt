			title: "Mega Vacuum Freezer"
			x: 8.0d
			y: 37.5d
		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6Network Switch&r is the multiblock that routes data between computers. It is the hub of a data network. The controller takes tritanium foils, a computer casing and a ZPM emitter. Bigger data networks, with more computers talking at once. It has no inputs to feed: place it and link the data hatches of the computers it serves."]
			hide_dependency_lines: true
			icon: "gtceu:network_switch"
			id: "7B889427723DB48D"
			rewards: [{ id: "77881E207D8D9F0A", type: "xp", xp: 100 }]
