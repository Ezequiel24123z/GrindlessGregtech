			y: -4.0d
		}
		{
			dependencies: ["1EB1FB2B94059E74"]
			description: ["The &6Zone Refining Tower&r sweeps germanium's impurities to the ends of a bar, over and over, until the crystal is purer than almost anything else you make. Probes carry it as their eye."]
			icon: "gtceu:zone_refining_tower"
			id: "1ADBEF1F47053EC9"
			rewards: [{ id: "1C883F1697D2369F", type: "xp", xp: 120 }]
