			]
			title: "The Network Goes UV"
			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["51C58090D6955D24"]
			description: ["The &6UV Parallel Hatch&r runs more recipes side by side in the plants that take one. Optional, but your queues will thank you."]
			icon: "gtceu:uv_parallel_hatch"
			id: "5E51E4390B4AA17B"
