			x: 10.25d
			y: 14.25d
		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6Thruster Works&r builds gridded ion and Hall thrusters that run on xenon and krypton instead of burning anything. Its controller, UV casing, a frostproof column and PTFE pipe. The thruster pod and the probe's long burn. Noble gas comes from the cryogenic plant by pipe; stock thrusters by ME."]
			icon: "gtceu:thruster_works"
			id: "56276A4A85BCF379"
			rewards: [{ id: "56212C0D3E658A57", type: "xp", xp: 120 }]
			shape: "gear"
