			]
			title: "Thirteen Nines"
			x: 4.0d
			y: -4.0d
		}
		{
			dependencies: ["1ADBEF1F47053EC9"]
			description: ["A superconducting nanowire turns resistive the moment a single photon lands on it. The &6SNSPD Array&r is a grid of them on a niobium nitride film, and it's how the faintest signal gets read."]
			icon: "grindless:snspd_array"
			id: "10808A5F2A0FCB35"
			rewards: [{ id: "3379B6946A8AD65A", type: "xp", xp: 100 }]
