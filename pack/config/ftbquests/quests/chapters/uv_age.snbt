			title: "Synchrotron Light"
			x: 8.0d
			y: -5.0d
		}
		{
			dependencies: ["3496B9631FC03AC3"]
			description: ["The synchrotron knocks antiprotons loose too. The &6Antimatter Trap&r holds them in a superfluid-cooled magnetic bottle, and a pinch sparked into a uranium pellet makes the &6ICAN Pellets&r a deep-space probe kicks with."]
			icon: "gtceu:antimatter_trap"
