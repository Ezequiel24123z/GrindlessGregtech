		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["Past Pluto the Sun is too faint for panels. The &6Heat Source Works&r presses curium into pellets, clads them in iridium and carbon, and stacks them into &6Probe RTGs&r. The heavier curium it sorts out is kept, never voided."]
			icon: "gtceu:heat_source_works"
			id: "1EB1FB2B94059E74"
