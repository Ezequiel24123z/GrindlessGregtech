		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6Fibre Draw Tower&r lays doped glass inside a tube, collapses it into a preform and pulls it into &6Ytterbium Fibre&r. Pumped hard, that fibre is a laser."]
			icon: "gtceu:fibre_draw_tower"
