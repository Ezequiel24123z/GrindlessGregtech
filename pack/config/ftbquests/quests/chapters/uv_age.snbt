				{ id: "531FE7704905C32C", item: "gtceu:pyroprocessing_cell", type: "item" }
				{ id: "3F1FAA23A39753EA", item: "gtceu:uranium_233_ingot", type: "item" }
				{ id: "72F260A570C5107B", item: "grindless:u233_fuel_rod", type: "item" }
			]
			title: "Back to Uranium-233"
			x: 10.0d
			y: -2.0d
		}
		{
			dependencies: ["3CAA678656F421E4"]
			description: [
				"In the &6Muon Fusion Cell&r a muon stands in for the electron and pulls deuterium and tritium close enough to fuse, with a lithium blanket breeding the tritium back."
				"Real muon-catalysed fusion never broke even: each muon is lost too soon. This machine is an extrapolation that assumes it does."
			]
			icon: "gtceu:muon_fusion_cell"
			id: "1225702AF9F2A2E4"
			rewards: [{ id: "7BBCFA27ABA6914E", type: "xp", xp: 150 }]
