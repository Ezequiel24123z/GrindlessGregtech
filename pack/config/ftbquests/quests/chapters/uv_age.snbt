			title: "Pluto and Beyond"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6Ark Biosphere&r is a sealed little world: algae fix the air, archaea eat what dies, and a growth medium comes out the other side. Grown neurons need that medium."]
			icon: "gtceu:ark_biosphere"
			id: "59F34562582255AD"
			rewards: [{ id: "5ECBAF07ABC6A1B2", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "1F4F149923F0AD40", item: "gtceu:ark_biosphere", type: "item" }]
			title: "The Ark"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["59F34562582255AD"]
			description: ["The &6Neural Culture Vat&r grows stem cells on the ark's medium and wires them into processing units by the batch. Wetware mainframes are what the third ring's controller asks for."]
			icon: "gtceu:neural_culture_vat"
			id: "350003D221C6A101"
			rewards: [{ id: "100A666BEF0EB154", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3519193C9DCFA278", item: "gtceu:neural_culture_vat", type: "item" }
