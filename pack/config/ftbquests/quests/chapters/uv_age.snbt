			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["1CF3C7EC4F724FAB"]
			description: ["Neptune orbit, on the same aerogel tank that took you to Uranus. Chunk-load the station; the winds below are the fastest anywhere in the Solar System."]
			icon: "grindless:station_truss_casing"
			id: "1AA12DFECDEFD309"
			rewards: [{ id: "55845AB13A2EC9C5", type: "xp", xp: 120 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ dimension: "grindless:neptune_orbit", id: "1D6F35D3303ACEF9", type: "dimension" }]
			title: "Fifth Station"
			x: 15.0d
			y: 0.0d
		}
		{
			dependencies: ["1AA12DFECDEFD309"]
			description: ["Neptune has the fastest winds in the Solar System, past 2000 kilometres an hour. They make the scoop below hard to hold: the deep siphon fires in bursts."]
			icon: "grindless:station_truss_casing"
			id: "13D0B8BF7734EC7F"
			optional: true
			rewards: [{ id: "579162C474CD76C0", type: "xp", xp: 20 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "5280B24F5234B659", type: "checkmark" }]
			title: "Winds of Neptune"
			x: 17.0d
			y: 0.0d
		}
		{
			dependencies: ["1AA12DFECDEFD309"]
			description: ["The deep siphon scoops hydrogen rich in deuterium, and helium with a trace of helium-3. That helium also grows the &6Neptunian Quantum Seed&r, so pipes reach home."]
			icon: "grindless:neptunian_quantum_seed"
			id: "56E5B02FDDF0BC16"
			rewards: [{ id: "5E01D9A3FE24A5C3", type: "xp", xp: 100 }]
