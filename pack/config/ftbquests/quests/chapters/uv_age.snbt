		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6Epitaxial Silicon Wafer&r: Silicon grown from silane in the wake shield's hard vacuum. Made by the first machine of its line; the cleanroom and EMI show the exact recipe. The light sail's carrier. The next stage of its line, or the chip that is built from it. A pattern provider on the machine of the step before keeps it supplied."]
			icon: "grindless:epitaxial_silicon_wafer"
			id: "3F344FE65BE2FD68"
			rewards: [{ id: "724D9BC07B98B8DC", type: "xp", xp: 50 }]
