			title: "Neptunian Seed"
			x: 18.0d
			y: 1.5d
		}
		{
			dependencies: ["1AA12DFECDEFD309"]
			description: ["A geyser sampler on Triton brings up a &6Triton Ice Core&r: frozen nitrogen with methane and carbon monoxide. It's where the nitrogen-15 comes from."]
			icon: "grindless:triton_ice_core"
			id: "39B2DA139D15F729"
			rewards: [{ id: "34B5B94B92940F59", type: "xp", xp: 100 }]
