			title: "Sputnik Core"
			x: 23.5d
			y: 2.5d
		}
		{
			dependencies: ["532BD235B8BD480D"]
			description: ["Aim the penetrator at Charon instead and it brings back the moon's crust: water ice laced with ammonia, and grit underneath."]
			icon: "grindless:charon_core"
			id: "519B2A0DF9A2213C"
			rewards: [{ id: "3BBDCC23C4077937", type: "xp", xp: 100 }]
			tasks: [{ id: "75B40C60F5998F55", item: "grindless:charon_core", type: "item" }]
			title: "Charon"
			x: 28.0d
			y: 2.5d
		}
		{
			dependencies: ["532BD235B8BD480D"]
			description: ["Every ice boils off at its own temperature. Warmed step by step, one core gives nitrogen, carbon monoxide, methane, water and ammonia apart, and each has a home in your chemistry."]
			icon: "grindless:sputnik_ice_core"
			id: "3C6A1EFD6D4E4A5C"
			rewards: [{ id: "73B6899C2D81B877", type: "xp", xp: 30 }]
			shape: "circle"
