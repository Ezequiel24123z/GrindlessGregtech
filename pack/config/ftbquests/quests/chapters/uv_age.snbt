		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6Gallium Arsenide Wafer&r is a wafer stage on the way to the InAs QD Wafer. Made in the &6Space Photovoltaics&r from the IMM Epi Wafer, with hydrofluoric acid, in the cleanroom. The InAs QD Wafer and AlGaAs Bragg Stack in the Molecular Beam Epitaxy. A pattern provider on the machine of the step before keeps it supplied."]
			icon: "grindless:gallium_arsenide_wafer"
			id: "13B75B45C0C9611D"
			rewards: [{ id: "56EE3F11D70914B9", type: "xp", xp: 50 }]
