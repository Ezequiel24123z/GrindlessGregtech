		}
		{
			dependencies: ["3D71CDF674EF3302"]
			description: ["Fire a ring of fibre lasers at a fuel capsule and a proton and boron-11 fuse into helium, with almost no neutrons. The &6Laser Fusion Chamber&r is the era's big power plant; its lasers wear, so keep spares."]
			icon: "gtceu:laser_fusion_chamber"
			id: "11FAD777A18E748F"
