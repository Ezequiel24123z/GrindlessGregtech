		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6InGaAs Epi Wafer&r is a wafer stage on the way to the Red Tuned Solar Array. Made by the first machine of its line; the cleanroom and EMI show the exact recipe. The Red Tuned Solar Array in the Space Photovoltaics. Stock it by ME and let the next step pull it; nothing here needs a hand."]
			icon: "grindless:ingaas_epi_wafer"
			id: "5E61D81CF8144D25"
			rewards: [{ id: "3241C7718CBB5F2B", type: "xp", xp: 50 }]
