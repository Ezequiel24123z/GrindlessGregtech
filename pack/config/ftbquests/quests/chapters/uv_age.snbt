		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["Cool liquid helium past the lambda point and it turns superfluid: no viscosity at all, and it creeps up the walls. The &6Superfluid Helium Plant&r makes it, and every accelerator here bathes in it."]
			icon: "gtceu:superfluid_helium_plant"
			id: "50932D647CEF0A54"
			rewards: [{ id: "3A5B4438597AD1F7", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5DB04F970177D45A", item: "gtceu:superfluid_helium_plant", type: "item" }]
			title: "Below Lambda"
			x: 2.0d
			y: -2.0d
		}
		{
			dependencies: ["50932D647CEF0A54"]
			description: ["The &6SRF Cavity Works&r melts niobium very pure, forms it into cavities and polishes them in acid. The spent acid gives its niobium back, so nothing goes down the drain."]
			icon: "gtceu:srf_cavity_works"
			id: "375D70399F1951D2"
			rewards: [{ id: "7F016E2F2D84DADE", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "705A82674604C042", item: "gtceu:srf_cavity_works", type: "item" }
