			title: "The Long Dark"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["Cavities, a superfluid bath and a magnetic shield make one &6SRF Cryomodule&r. Placed as blocks, they're the linac inside every accelerator that follows."]
			icon: "grindless:srf_cryomodule"
			id: "3CAA678656F421E4"
			rewards: [{ id: "5FFD8034E53CAC4E", type: "xp", xp: 100 }]
