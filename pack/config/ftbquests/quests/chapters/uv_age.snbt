		{
			dependencies: ["5443B4BF3D09D99E"]
			description: ["An ion thruster, a krypton tank and an aeroshell make a &6Thruster Pod&r. A probe with one can reach the edge of the Solar System in a few game days."]
			icon: "grindless:thruster_pod"
			id: "5510E49421AB4078"
