			]
			title: "Neural Culture Vat"
			x: 4.0d
			y: 20.25d
		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6Light Sail Fab&r deposits a film a hundred nanometres thick on a carrier, then lifts it free as a sail. Its controller, the station truss casing, a Whipple shield and a tungsten heater. The sail every probe hangs from. Xenon and silicon tetrafluoride are kept: loop them; sails go out by ME."]
			icon: "gtceu:light_sail_fab"
			id: "7E77EFDBCC3B4374"
			rewards: [{ id: "7ABC6BB3BC68E871", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5B875D7270B07C9E", item: "gtceu:light_sail_fab", type: "item" }
				{ id: "746CA7407285CA5A", item: "grindless:station_truss_casing", type: "item" }
			]
			title: "Light Sail Fab"
			x: 2.5d
			y: 21.0d
		}
		{
			dependencies: ["7E77EFDBCC3B4374"]
			description: ["A &6Light Sail&r weighs almost nothing and reflects almost everything, so light alone can push a probe to another star. It is made at the sail line from thin reflective film, in an orbital build with a truss casing. It unlocks the Starchip Fab and the launch. Sails go out by ME, one for each run."]
			icon: "grindless:light_sail"
			id: "3AB434D5A69FAF2B"
			rewards: [{ id: "3FB536BDD9DFD03B", type: "xp", xp: 80 }]
			tasks: [{ id: "7CEB583A4EB7C29B", item: "grindless:light_sail", type: "item" }]
			title: "Light Sail"
			x: 4.0d
			y: 22.5d
		}
		{
			dependencies: ["3AB434D5A69FAF2B"]
			description: ["The &6Starchip Fab&r bonds a photonic chip, an NV diamond chip and an americium micro source onto a neutronium wafer and dices out a one-gram starchip. The circuit picks the step: 1 the starchip, 2 the sailcraft (a starchip on a light sail). Its controller in a clean room hall: clean machine casing, stainless steel frames, plascrete, laminated glass, a filter casing ceiling and a gearbox bonding line. One Terminal pass. The starchip and the sailcraft that the launcher fires. Parts by ME; the wafer kerf is silicon dust, so loop it back to the silicon line."]
			icon: "gtceu:starchip_fab"
			id: "3D0F0BDA824B2E7B"
			rewards: [{ id: "1ED124D179A7777A", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7B9A8E65D3D42EE1", item: "gtceu:starchip_fab", type: "item" }
				{ id: "5A789706E36BA627", item: "gtceu:clean_machine_casing", type: "item" }
			]
			title: "Starchip Fab"
			x: 6.25d
			y: 21.0d
		}
		{
			dependencies: ["3D0F0BDA824B2E7B"]
			description: ["The &6Laser Sail Launcher&r works on the Moon only, where no air scatters the beam. Circuit 1 pushes a sailcraft out of the Solar System as a Starshot probe; the heliopause data sets the course and is kept. Its controller in an open-sky array: UV casing, tungsten steel frames and pipe casings, fusion glass, a computer casing as beam director and a checkerboard of 228 &6Laser Module Blocks&r. One Terminal pass; it draws 16 A of UV. The probe in flight, and the data it sends home. Each launch spends a fibre laser module at 64 % and returns a spent one for the draw tower: keep sailcraft and modules stocked by ME."]
			icon: "gtceu:laser_sail_launcher"
			id: "1AC40B9509A5D9E4"
			rewards: [{ id: "5BF163ACB042919C", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3DA1D360CD6447FE", item: "gtceu:laser_sail_launcher", type: "item" }
				{ id: "7BE505E68FE46C8D", item: "gtceu:uv_machine_casing", type: "item" }
				{ id: "30838FE821EE6835", item: "grindless:laser_module_block", type: "item" }
			]
			title: "Laser Sail Launcher"
			x: 7.25d
			y: 18.25d
		}
		{
			dependencies: ["16D1550DF465D570"]
			description: ["The &6Mega Factory&r has sockets, and each takes a module that adds its own recipe types. Every installed module drinks PCB coolant. Its controller, a shell of UV casing, naquadah coils and the modules you mean to run. Separation, forming, cutting, mixing and heat in a single frame. Keep a PCB coolant tank on a pipe; the modules share it."]
			icon: "gtceu:mega_factory"
			id: "1A2F724B54F17B1E"
			rewards: [{ id: "7094975ADD1BB9B1", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5859EA0AFFFAF02C", item: "gtceu:mega_factory", type: "item" }
				{ id: "5C73AA99C83AEC60", item: "gtceu:uv_machine_casing", type: "item" }
			]
			title: "Mega Factory"
			x: 2.0d
			y: 5.0d
		}
		{
			dependencies: ["1AA12DFECDEFD309"]
			description: ["The &6Neptune Deep Siphon&r drops a scoop through the methane deck for hydrogen rich in deuterium, and helium with a trace of helium-3. Its controller and the station truss casing; at least fourteen casings among its floor cells. The helium for the superleak and the Neptunian quantum seed. Pipe the gas home through the seed; no hand work."]
			icon: "gtceu:neptune_deep_siphon"
			id: "7D3D51F478AD6842"
			rewards: [{ id: "75B8668ED9F126E9", type: "xp", xp: 120 }]
			shape: "gear"
