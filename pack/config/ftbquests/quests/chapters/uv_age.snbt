			title: "Exposed Wafer"
			x: 6.0d
			y: 34.5d
		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6Mega Blast Furnace&r runs Electric Blast Furnace recipes at scale. It is the blast furnace of the UV age. The controller takes a ZPM field generator, Naquadah springs and Naquadah alloy dense plates; the body follows the structure preview. Big batches of every blast furnace metal, steel and neodymium among them. Item buses and fluid hatches in, item buses and fluid hatches out."]
			hide_dependency_lines: true
			icon: "gtceu:mega_blast_furnace"
			id: "561676ED55225B08"
			rewards: [{ id: "712C833665B5F226", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3915C82B214057A4", item: "gtceu:mega_blast_furnace", type: "item" }]
			title: "Mega Blast Furnace"
			x: 6.0d
			y: 37.5d
		}
		{
			dependencies: ["7F5A9C113BBA2A9D"]
			description: ["The &6Mega Vacuum Freezer&r runs Vacuum Freezer recipes at scale, cooling hot ingots and cryogenic fluids in bulk. The controller takes a ZPM field generator, a niobium titanium fluid pipe and rhodium plated palladium dense plates; the body follows the structure preview. Trinaquadalloy and cold-chain recipes in volume. Item buses and fluid hatches in, item buses and fluid hatches out."]
			hide_dependency_lines: true
			icon: "gtceu:mega_vacuum_freezer"
			id: "5B6CEBAE35F1A7DB"
