				{ id: "5039ED5323998051", item: "gtceu:uv_machine_casing", type: "item" }
				{ id: "1B13CA27BBDE46DE", item: "grindless:silver_tube", type: "item" }
			]
			title: "Powder-in-Tube Line"
			x: 11.25d
			y: 12.5d
		}
		{
			dependencies: ["1682DED202B72CC5"]
			description: ["A drawn &6PIT Billet&r is a silver sheath filled with powder, ready to be rolled into wire. The powder-in-tube line makes it, and each one eats a silver tube. It unlocks the wire step and EnTED wire for the UV network. Remelt the returned silver into tubes and keep them stocked by ME."]
			icon: "grindless:pit_billet"
			id: "1352F5938C0B0298"
			rewards: [{ id: "38E49737526E364E", type: "xp", xp: 80 }]
