	quests: [
		{
			dependencies: ["7C074BF11FC1790D"]
			description: ["The &6Tetron Fab&r grows two nanowires, bonds a superconducting backbone between them and tests the parity of the pair. Nothing older builds a qubit that is read that way. An OpV hull, the plascrete shell, cleanroom glass and a superconducting coil, with silicon-28 wafers to work on. The tetron die and the tetron array, which opv_age asks for as a product. Wafers and metals by ME; failed dies come out in their own output, so route them back to the start."]
			icon: "gtceu:tetron_fab"
			id: "11AA3FE52CF398DB"
			rewards: [{ id: "7C5B16C1BEF5B4E4", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "769C855660319FF4", item: "gtceu:tetron_fab", type: "item" }
				{ id: "14194C869944A1A2", item: "gtceu:plascrete", type: "item" }
				{ id: "1C9C79F60285B3D7", item: "gtceu:cleanroom_glass", type: "item" }
				{ id: "3DFABE985C0AAC85", item: "gtceu:superconducting_coil", type: "item" }
			]
			title: "Tetron Fab"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["11AA3FE52CF398DB"]
			description: ["The &6Gated 2DEG Wafer&r is a layered wafer whose electron sheet is switched by a gate. The tetron fab builds its nanowires from it."]
			icon: "grindless:gated_2deg_wafer"
			id: "7B71C07475CE03D9"
			rewards: [{ id: "348D29532DC6ED1A", type: "xp", xp: 80 }]
			tasks: [{ id: "1E3CBC039DE0A1A5", item: "grindless:gated_2deg_wafer", type: "item" }]
			title: "Gated 2DEG Wafer"
			x: 4.5d
			y: 0.0d
		}
		{
			dependencies: ["7C074BF11FC1790D"]
			description: ["The &6Gamma Optics Works&r focuses gamma rays by Laue lensing, which nothing older can do. Gamma light of this energy only bends in a crystal. An OpV hull, the high power casing and laminated glass, and a Compton crystal to bend the beam. The gamma beam that the antihydrogen foundry and the absorber tiles need. Crystals by ME; they wear slowly, so a small stock is enough."]
			icon: "gtceu:gamma_optics_works"
			id: "1F29C7B921EC10C4"
			rewards: [{ id: "5F3873AE089D0581", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5D500BC6C3A9ACB1", item: "gtceu:gamma_optics_works", type: "item" }
				{ id: "5854F180AAE75908", item: "gtceu:high_power_casing", type: "item" }
				{ id: "1ADC90F202E9D6DD", item: "gtceu:laminated_glass", type: "item" }
			]
			title: "Gamma Optics Works"
			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["1F29C7B921EC10C4"]
			description: ["The &6HPGE Compton Crystal&r is germanium grown pure enough to be a detector and a lens at once. The works wears one out slowly."]
			icon: "grindless:hpge_compton_crystal"
			id: "3D43FF6312199146"
			rewards: [{ id: "728BCE70ACA5C9AB", type: "xp", xp: 80 }]
			tasks: [{ id: "120AFCF178DB8090", item: "grindless:hpge_compton_crystal", type: "item" }]
			title: "Compton Crystal"
			x: 4.5d
			y: 1.5d
		}
		{
			dependencies: ["7C074BF11FC1790D"]
			description: ["The &6Antihydrogen Foundry&r merges antiprotons and positrons in a trap, cools the atoms with a laser and freezes them into a cell. It is the first neutral antimatter in the pack. An OpV hull, the negative-potential casing and the annihilation shield casing, with antiprotons from Cygnus and positrons from SGR 1806-20. The antihydrogen cell that opv_age asks for, and the strangelet vault. Antiprotons and positrons by the beam lines; cells are the product to chest."]
			icon: "gtceu:antihydrogen_foundry"
			id: "597A9984A1B74479"
			rewards: [{ id: "1D0E3BF3B30AB3B6", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5228845410A85BD5", item: "gtceu:antihydrogen_foundry", type: "item" }
				{ id: "3E567C1B9FE94A60", item: "grindless:neg_xhv_casing", type: "item" }
				{ id: "1935AEDC98DAC0BB", item: "grindless:annihilation_shield_casing", type: "item" }
			]
			title: "Antihydrogen Foundry"
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["597A9984A1B74479"]
			description: ["The &6Negative-Potential Casing&r holds an extreme vacuum at a voltage that repels what is inside it. The foundry and the decelerator are built of it."]
			icon: "grindless:neg_xhv_casing"
			id: "54B5FC10DC58127A"
			rewards: [{ id: "39E02379AF6E2285", type: "xp", xp: 80 }]
			tasks: [{ id: "14F2F27C828EC326", item: "grindless:neg_xhv_casing", type: "item" }]
			title: "Negative-Potential Casing"
			x: 4.5d
			y: 3.0d
		}
		{
			dependencies: ["597A9984A1B74479"]
			description: ["The &6Annihilation Shield Casing&r stops gammas, neutrons and charged debris. Every machine that holds antimatter or a black hole is lined with it."]
			icon: "grindless:annihilation_shield_casing"
			id: "73D6911F1FDA32DC"
			rewards: [{ id: "56F11F445A91A568", type: "xp", xp: 80 }]
			tasks: [{ id: "5CDD797492C45981", item: "grindless:annihilation_shield_casing", type: "item" }]
			title: "Annihilation Shield Casing"
			x: 4.5d
			y: 4.5d
		}
		{
			dependencies: ["54B5FC10DC58127A"]
			description: ["The &6Thorium-229 Lasing Crystal&r makes the Lyman-alpha light that laser-cools antihydrogen. The foundry uses a crystal for a while and then it must be replaced."]
			icon: "grindless:th229_lasing_crystal"
			id: "576E522130567846"
			rewards: [{ id: "590EB2C52D3B7EA5", type: "xp", xp: 80 }]
			tasks: [{ id: "1D229E5913F37891", item: "grindless:th229_lasing_crystal", type: "item" }]
			title: "Thorium-229 Lasing Crystal"
			x: 7.0d
			y: 3.0d
		}
		{
			dependencies: ["7C074BF11FC1790D"]
			description: ["The &6Strangelet Vault&r holds strange matter in a frozen field, where it cannot touch ordinary atoms. Any contact would convert them. An OpV hull, the field-frozen casing and the annihilation shield casing. Storage for the strangelet seed and the pasta core sample. Seeds go in by hatch and out by hatch; never keep them outside the vault."]
			icon: "gtceu:strangelet_vault"
			id: "3DB8108B84BC8C3C"
			rewards: [{ id: "75B37513AF5FDE52", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5B734DA92CE3E8B2", item: "gtceu:strangelet_vault", type: "item" }
				{ id: "3AAC20D1C6275901", item: "grindless:field_frozen_casing", type: "item" }
				{ id: "5C192FE3C357E222", item: "grindless:annihilation_shield_casing", type: "item" }
			]
			title: "Strangelet Vault"
			x: 2.0d
			y: 4.5d
		}
		{
			dependencies: ["7B1E66BC13548877"]
			description: ["The &6Jet Beam Line&r draws protons from the base of the Cygnus X-1 jet and bunches them on superconducting cavities into a beam no Earth injector can reach. An OpV hull, the high power casing and the superconducting RF cryomodule blocks. The proton beam for the spallation station, and through it every antiproton. Power and coolant by pipe; the beam is continuous, so give it a dedicated supply."]
			icon: "gtceu:jet_beam_line"
			id: "7B82C6325DA8F876"
			rewards: [{ id: "572EB6DF544FE3F1", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "32925750B3572DCE", item: "gtceu:jet_beam_line", type: "item" }
				{ id: "7260292334065BD6", item: "gtceu:high_power_casing", type: "item" }
				{ id: "1510099F459EB377", item: "grindless:srf_cryomodule_block", type: "item" }
			]
			title: "Jet Beam Line"
			x: 2.0d
			y: 7.5d
		}
		{
			dependencies: ["7B82C6325DA8F876"]
			description: ["The &6SRF Cryomodule Block&r is a niobium cavity in its own cryostat, which accelerates the beam with very little loss."]
			icon: "grindless:srf_cryomodule_block"
			id: "37DD95E0E3D6332E"
			rewards: [{ id: "72977405F90DC6CB", type: "xp", xp: 80 }]
			tasks: [{ id: "74A81A67A1C1C63C", item: "grindless:srf_cryomodule_block", type: "item" }]
			title: "SRF Cryomodule Block"
			x: 4.5d
			y: 7.5d
		}
		{
			dependencies: ["7B82C6325DA8F876"]
			description: ["The &6Spallation Target Station&r hits an iridium target with the beam, collects the antiprotons with a magnetic horn and breeds tritium in the shield. An OpV hull and the annihilation shield casing, with the beam line in front of it. Raw antiprotons for the decelerator and tritium for the hydrogen lines. Targets by ME; the tritium is a byproduct, so pipe it away at once."]
			icon: "gtceu:spallation_target_station"
			id: "5CAB5711F456C75A"
			rewards: [{ id: "5DA13D309350064C", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5A842245120572AF", item: "gtceu:spallation_target_station", type: "item" }
				{ id: "3358D7352451EDB9", item: "grindless:annihilation_shield_casing", type: "item" }
			]
			title: "Spallation Target Station"
			x: 2.0d
			y: 9.0d
		}
		{
			dependencies: ["5CAB5711F456C75A"]
			description: ["The &6Antiproton Decelerator&r cools antiprotons from gigaelectronvolts to kiloelectronvolts, first by stochastic cooling and then with electrons, and fills them into traps. An OpV hull, the high power and negative-potential casings and the cryomodule blocks. Trapped antiprotons for the antihydrogen foundry. The traps fill slowly, so run a second decelerator before adding a second target."]
			icon: "gtceu:antiproton_decelerator"
			id: "1458D096423EA6D4"
			rewards: [{ id: "3F362D833F72AD18", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1C2B29552AAA6417", item: "gtceu:antiproton_decelerator", type: "item" }
				{ id: "3B95E711A1BDA15A", item: "gtceu:high_power_casing", type: "item" }
				{ id: "3FD09E0339166D35", item: "grindless:neg_xhv_casing", type: "item" }
				{ id: "3B33786B56C4A343", item: "grindless:srf_cryomodule_block", type: "item" }
			]
			title: "Antiproton Decelerator"
			x: 2.0d
			y: 10.5d
		}
		{
			dependencies: ["1458D096423EA6D4"]
			description: ["The &6Strangelet Distiller&r boils the strangeness out of a lead-208 fireball and catches it as a droplet seed, catalysed by a pasta core sample. An OpV hull, the field-frozen casing and fusion glass. The strangelet seed that opv_age asks for, and the exotic matter after it. Beam and sample by ME; seeds go straight to the vault."]
			icon: "gtceu:strangelet_distiller"
			id: "5ACC310114FACE71"
			rewards: [{ id: "364CC46524130D2C", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3E7BACAB3C70007F", item: "gtceu:strangelet_distiller", type: "item" }
				{ id: "51A921F2C9CF8600", item: "grindless:field_frozen_casing", type: "item" }
				{ id: "31F08524567A988C", item: "gtceu:fusion_glass", type: "item" }
			]
			title: "Strangelet Distiller"
			x: 2.0d
			y: 12.0d
		}
		{
			dependencies: ["5ACC310114FACE71"]
			description: ["The &6Kugelblitz Forge&r crowds so much light into one point that it collapses into a black hole made of light. It is the largest machine of the age. An OpV hull, field-frozen and annihilation shield casing, and fusion coils, with the gamma optics works and a huge power supply behind it. The kugelblitz core, and the Hawking radiation of the collector. Feed power and gammas by hatch; build the shield first and the coils last."]
			icon: "gtceu:kugelblitz_forge"
			id: "196E5592451BC661"
			rewards: [{ id: "52BA5C6DB47D00E6", type: "xp", xp: 300 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "132BDCE519F709A7", item: "gtceu:kugelblitz_forge", type: "item" }
				{ id: "38B15C21F2CEF2F8", item: "grindless:field_frozen_casing", type: "item" }
				{ id: "19C52AABE2B15D47", item: "grindless:annihilation_shield_casing", type: "item" }
				{ id: "37EE96166B205CBE", item: "gtceu:fusion_coil", type: "item" }
			]
			title: "Kugelblitz Forge"
			x: 2.0d
			y: 13.5d
		}
		{
			dependencies: ["7F4169BDA6339C6F"]
			description: ["The &6Magnetic Pair Converter&r turns gammas into electron and positron pairs inside the magnetar field, seeded by a positron plasma from home. Only a field this strong allows it. An OpV hull and the field-frozen casing, with gamma light and a rotating-wall positron plasma. The dense positron cell, which only this machine makes. Seed plasma by hatch; the cells go straight to the antihydrogen foundry."]
			icon: "gtceu:magnetic_pair_converter"
			id: "3E86C36587CF8FBB"
			rewards: [{ id: "1BE2DC7CCBC9F8E8", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5A9907C395BC5487", item: "gtceu:magnetic_pair_converter", type: "item" }
				{ id: "7112B5BC438625D1", item: "grindless:field_frozen_casing", type: "item" }
			]
			title: "Magnetic Pair Converter"
			x: 2.0d
			y: 16.5d
		}
		{
			dependencies: ["3E86C36587CF8FBB"]
			description: ["The &6Field-Frozen Press&r presses chain-matter laminae in the magnetar field so that the field stays frozen in the billet. An OpV hull, the high power casing and a tungsten steel frame, with laminae from the chain-matter line. The field-frozen plate and, from it, the field-frozen casing. Laminae by ME; plates come out stacked, so chest them for the casing."]
			icon: "gtceu:field_frozen_press"
			id: "3EA9271449E0281E"
			rewards: [{ id: "73870403D9A2274E", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "33F5D38604045136", item: "gtceu:field_frozen_press", type: "item" }
				{ id: "129F139901E8DE2A", item: "gtceu:high_power_casing", type: "item" }
				{ id: "5EA8474AECB7F3EC", item: "gtceu:tungsten_steel_frame", type: "item" }
			]
			title: "Field-Frozen Press"
			x: 2.0d
			y: 18.0d
		}
		{
			dependencies: ["3EA9271449E0281E"]
			description: ["The &6Field-Frozen Plate&r keeps the magnetar field it was pressed in. Pressed into the &6Field-Frozen Casing&r, it is what the vault, the distiller and the forge are built of."]
			icon: "grindless:field_frozen_plate"
			id: "7F7487A3E9823C9A"
			rewards: [{ id: "71E64E3B5D013405", type: "xp", xp: 80 }]
			tasks: [{ id: "5993055E2BEF03F9", item: "grindless:field_frozen_plate", type: "item" }]
			title: "Field-Frozen Plate"
			x: 4.5d
			y: 18.0d
		}
		{
			dependencies: ["7F7487A3E9823C9A"]
			description: ["The &6Superfluid Helium-3 Seal&r closes the cold joint of a frozen-field casing. A magnetar field cracks an ordinary gasket in a few seconds."]
			icon: "grindless:superfluid_he3_seal"
			id: "3946AF14206E410E"
			rewards: [{ id: "1A14BA2BF3660E1D", type: "xp", xp: 80 }]
			tasks: [{ id: "337CAC646870BAC6", item: "grindless:superfluid_he3_seal", type: "item" }]
			title: "Superfluid Helium-3 Seal"
			x: 7.0d
			y: 18.0d
		}
		{
			dependencies: ["34EC6937B4EB1880"]
			description: ["The &6Debris Harvester&r collects and sorts the debris of the core into metal and silicate, so the cluster feeds the probe with nothing from home. An OpV hull, the robust casing and a steel gearbox. The bulge debris that opv_age asks for, and the refinery behind it. Run it continuously and split the output by item filter into metal and silicate."]
			icon: "gtceu:debris_harvester"
			id: "397BE2355436062F"
			rewards: [{ id: "1A4D121357184494", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5DE0DD7D37475136", item: "gtceu:debris_harvester", type: "item" }
				{ id: "5321A0BC6C6591C2", item: "gtceu:robust_machine_casing", type: "item" }
				{ id: "30F8B08B737C5412", item: "gtceu:steel_gearbox", type: "item" }
			]
			title: "Debris Harvester"
			x: 2.0d
			y: 21.0d
		}
		{
			dependencies: ["397BE2355436062F"]
			description: ["The &6Replication Refinery&r turns local silicon and metal into probe feedstock by two real routes, and sinters the rest into the casing of the next probe. An OpV hull, the clean casing, titanium pipe casing and a heat vent. The cluster sinter casing, and the probe parts for the foundry. Chain it to the harvester by pipe and belt; it never needs anything from home."]
			icon: "gtceu:replication_refinery"
			id: "1521EF011A60705F"
			rewards: [{ id: "72307B98139F0FDB", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1E5329378C3D7367", item: "gtceu:replication_refinery", type: "item" }
				{ id: "350A033A8F13ADE5", item: "gtceu:clean_machine_casing", type: "item" }
				{ id: "75288BD800F72831", item: "gtceu:titanium_pipe_casing", type: "item" }
				{ id: "38447536DB931F6C", item: "gtceu:heat_vent", type: "item" }
			]
			title: "Replication Refinery"
			x: 2.0d
			y: 22.5d
		}
		{
			dependencies: ["1521EF011A60705F"]
			description: ["The &6Collector Node Works&r turns local silicon into thin photovoltaic nodes and packs them onto a seed, four at a time. An OpV hull, cleanroom glass, plascrete and assembly line grating. The deployed node pack that opv_age asks for, and the bulge collector in the power chapter. Silicon from the harvester line; one pack per seed, so send them straight out."]
			icon: "gtceu:collector_node_works"
			id: "7A800CFF0E239E9B"
			rewards: [{ id: "559E04873B2E19F4", type: "xp", xp: 120 }]
