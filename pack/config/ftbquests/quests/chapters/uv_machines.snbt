	quests: [
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6Pyroprocessing Cell&r takes spent thorium fuel apart in molten salt and gives back uranium-233 and nitrogen-15. Its controller and the &6Radiation-Proof Casing&r that contains the salt. Uranium-233 for fuel rods, and nitrogen-15 for the nitride fuel. Feed spent fuel by ME and loop the salt in its own tank; never let it run dry."]
			icon: "gtceu:pyroprocessing_cell"
			id: "7F5AFF284AB79EA8"
			rewards: [{ id: "39000AE6494F0929", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "531FE7704905C32C", item: "gtceu:pyroprocessing_cell", type: "item" }
				{ id: "179B61ED1414FD7A", item: "gtnn:radiation_proof_machine_casing", type: "item" }
			]
			title: "Pyroprocessing"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["7F5AFF284AB79EA8"]
			description: ["The &6Accelerator-Driven Reactor&r burns the thorium you stored at IV, kept subcritical by a proton beam. Power from it stops the moment the beam does. Its controller, UV machine casing, superconducting coils and the &6SRF Cryomodule Block&r that holds the beam cold. Thorium as a generator, and the fuel assemblies the cell recycles. Fuel assemblies by ME from the fabrication plant; spent ones go straight back to the cell."]
			icon: "gtceu:accelerator_driven_reactor"
			id: "531F95CE48EB6C79"
			rewards: [{ id: "5C3E4CA800187BD9", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "734B95D163FFD5AA", item: "gtceu:accelerator_driven_reactor", type: "item" }
				{ id: "72AEDF31493FD4C1", item: "gtceu:uv_machine_casing", type: "item" }
				{ id: "5DB291BEEDD887D9", item: "grindless:srf_cryomodule_block", type: "item" }
			]
			title: "Accelerator-Driven Reactor"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["531F95CE48EB6C79"]
			description: ["The cell's uranium-233 becomes a &6U-233 Fuel Rod&r for the fission reactor you built at IV. Thorium fuel closes its own loop."]
			icon: "grindless:u233_fuel_rod"
			id: "5899817CE39B0BF5"
			rewards: [{ id: "3AA7DA53481B041C", type: "xp", xp: 80 }]
			tasks: [{ id: "7A639BB24F369F20", item: "grindless:u233_fuel_rod", type: "item" }]
			title: "Uranium-233 Rod"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6Heat Source Works&r presses and sinters curium-244 into the pellets a probe carries in place of sunlight. Its controller and radiation-proof casing; the curium comes from the ZPM partitioning plant. The probe RTG and the americium micro source. Curium moves in sealed pipes and buses only; send the pellets on by ME."]
			icon: "gtceu:heat_source_works"
			id: "1EB1FB2B94059E74"
			rewards: [{ id: "318C035F61FA79DC", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3BEE7EB70A91F743", item: "gtceu:heat_source_works", type: "item" }
				{ id: "52AF675894612034", item: "gtnn:radiation_proof_machine_casing", type: "item" }
			]
			title: "Heat Source Works"
			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["1EB1FB2B94059E74"]
			description: ["A &6Curium-244 Pellet&r gives off heat for years. Wrapped in a &6GPHS Module&r it is the only power a probe has past Neptune."]
			icon: "grindless:curium_244_pellet"
			id: "713DCC29A0BF2749"
			rewards: [{ id: "7C7A72E131D63A39", type: "xp", xp: 80 }]
			tasks: [
				{ id: "1CAA616EEF5C3B1B", item: "grindless:curium_244_pellet", type: "item" }
				{ id: "5C06792F9A16A063", item: "grindless:gphs_module", type: "item" }
			]
			title: "Curium Heat"
			x: 4.0d
			y: 1.5d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6Laser Fusion Chamber&r fuses a proton and boron-11 into three alpha particles. No neutrons, and the output is helium-4. Its controller, UV casing and the &6Laser Module Block&r ring that focuses the beams. Aneutronic power from boron capsules. Capsules arrive by ME and the helium goes back to the compressor loop."]
			icon: "gtceu:laser_fusion_chamber"
			id: "11FAD777A18E748F"
			rewards: [{ id: "759D9CC318C4ABE4", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5CA0F69E4887CBE0", item: "gtceu:laser_fusion_chamber", type: "item" }
				{ id: "32376DFCE35F3BB1", item: "gtceu:uv_machine_casing", type: "item" }
				{ id: "584EC4FC124C035B", item: "grindless:laser_module_block", type: "item" }
			]
			title: "Laser Fusion Chamber"
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["598B196C669CA9B5"]
			description: ["The &6Muon Fusion Cell&r makes cold fusion with muons as the catalyst: deuterium and tritium fuse close to room temperature. Its controller, the cryostat casing and the &6SRF Cryomodule Block&r that drives the muon channel. A second fusion generator that needs no plasma. Keep a deuterium-tritium tank on a pipe and let the helium out by ME."]
			icon: "gtceu:muon_fusion_cell"
			id: "1225702AF9F2A2E4"
			rewards: [{ id: "7BBCFA27ABA6914E", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "79AC5E9ADB0ECE07", item: "gtceu:muon_fusion_cell", type: "item" }
				{ id: "3A42B04451BB2798", item: "grindless:cryostat_casing", type: "item" }
				{ id: "7FB86716C4ABEA64", item: "grindless:srf_cryomodule_block", type: "item" }
			]
			title: "Muon Fusion Cell"
			x: 8.0d
			y: 4.5d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6Superfluid Helium Plant&r cools helium below its lambda point, where it flows without friction, and splits Neptune's helium with a superleak. Its controller, the &6Cryostat Casing&r and the stainless gearboxes that run the cold compressors. Helium II for the cryomodules and the cavity works. Gas arrives by pipe; stock helium II in a dedicated tank."]
			icon: "gtceu:superfluid_helium_plant"
			id: "50932D647CEF0A54"
			rewards: [{ id: "3A5B4438597AD1F7", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5DB04F970177D45A", item: "gtceu:superfluid_helium_plant", type: "item" }
				{ id: "5025515AE5D2D6DC", item: "grindless:cryostat_casing", type: "item" }
			]
			title: "Superfluid Helium"
			x: 2.0d
			y: 4.5d
		}
		{
			dependencies: ["50932D647CEF0A54"]
			description: ["The &6SRF Cavity Works&r forms, polishes and anneals niobium into cavities that carry a beam with almost no loss. Its controller and clean room casing; niobium sheet and helium II run through it. Cavities for the cryomodule, the accelerators and the synchrotron. Niobium and acid are loops. Take cavities out by ME and keep the scrap going back."]
			icon: "gtceu:srf_cavity_works"
			id: "375D70399F1951D2"
			rewards: [{ id: "7F016E2F2D84DADE", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "705A82674604C042", item: "gtceu:srf_cavity_works", type: "item" }
				{ id: "5ABC99C2B00854CD", item: "gtceu:clean_machine_casing", type: "item" }
			]
			title: "Cavity Works"
			x: 4.0d
			y: 4.5d
		}
		{
			dependencies: ["375D70399F1951D2"]
			description: ["A finished &6SRF Cavity&r is niobium cut to a few microns of surface roughness. Every beam machine of this era sits on a pair of them."]
			icon: "grindless:srf_cavity"
			id: "598B196C669CA9B5"
			rewards: [{ id: "151F080E9C6C1576", type: "xp", xp: 80 }]
