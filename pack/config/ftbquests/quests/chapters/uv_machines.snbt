			x: 2.0d
			y: 10.5d
		}
		{
			dependencies: ["37B93B08FCFF08DA"]
			description: ["Spin the tubes and you get &6BNNT Yarn&r: light, strong and transparent to neutrons."]
			icon: "grindless:bnnt_yarn"
