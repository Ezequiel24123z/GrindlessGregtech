			]
			title: "Niobium Cavity"
			x: 6.0d
			y: 4.5d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["Bend a beam round a ring and it shines X-rays. The &6Synchrotron&r prints through an X-ray mask and makes the antiprotons the trap stores. Its controller, UV casing and the &6SRF Cryomodule Block&r; the target is activated and has to be contained. Patterned wafers for the photonic chip, and antiprotons. Run it off a stock of masks and wafers by ME; the target goes out sealed."]
			icon: "gtceu:synchrotron"
			id: "3496B9631FC03AC3"
			rewards: [{ id: "73F7CB102ECBB71D", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3BACA311AAB9ACB4", item: "gtceu:synchrotron", type: "item" }
				{ id: "18914A95F26AF529", item: "gtceu:uv_machine_casing", type: "item" }
				{ id: "151AC7AA5C51EAC8", item: "grindless:srf_cryomodule_block", type: "item" }
			]
			title: "Synchrotron"
			x: 2.0d
			y: 6.0d
		}
		{
			dependencies: ["3496B9631FC03AC3"]
			description: ["Protons on a tungsten target throw off a trickle of antiprotons. An &6Antiproton Cartridge&r is the only way to carry them out of the ring."]
			icon: "grindless:antiproton_cartridge"
			id: "38256BC657C245CD"
			rewards: [{ id: "7DB5000D69D87501", type: "xp", xp: 80 }]
			tasks: [{ id: "7F2DCF0E47129095", item: "grindless:antiproton_cartridge", type: "item" }]
			title: "Antiproton Cartridge"
			x: 4.0d
			y: 6.0d
		}
		{
			dependencies: ["38256BC657C245CD"]
			description: ["The &6Antimatter Trap&r holds antiprotons in a magnetic bottle in Earth orbit, far from anything they could touch. Its controller and the &6Station Truss Casing&r of an orbital build. ICAN pellets for the sail and the launch. Hand cartridges to the trap by ME; never stack more than one trap on a hatch."]
			icon: "gtceu:antimatter_trap"
			id: "16371CCBBF6B0622"
			rewards: [{ id: "1FF1D25A751F653C", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "33FA101E84F51F28", item: "gtceu:antimatter_trap", type: "item" }
				{ id: "151D1B5FF2B8B921", item: "grindless:station_truss_casing", type: "item" }
			]
			title: "Antimatter Trap"
			x: 6.0d
			y: 6.0d
		}
		{
			dependencies: ["7D5E30D919EC171F"]
			description: ["The &6Fibre Draw Tower&r pulls a preform of ytterbium-doped glass into optical fibre, and winds it into a fibre laser module. Its controller, clean room casing, PTFE pipe and a heatproof draw furnace. The laser modules for the fusion chamber and the sail launcher. A chlorine loop cleans the preform; keep it sealed and stock the fibre by ME."]
			icon: "gtceu:fibre_draw_tower"
			id: "33CBE187D3DF4EA8"
			rewards: [{ id: "340D8B303B909940", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7052083D5408A302", item: "gtceu:fibre_draw_tower", type: "item" }
				{ id: "31651AA9F4CA8612", item: "gtceu:clean_machine_casing", type: "item" }
			]
			title: "Fibre Draw Tower"
			x: 2.0d
			y: 7.5d
		}
		{
			dependencies: ["33CBE187D3DF4EA8"]
			description: ["A length of fibre with a Bragg grating at each end is a laser. The &6Fibre Laser Module&r is what the big chambers fire."]
			icon: "grindless:fibre_laser_module"
			id: "51F3CB52EBEB3BCB"
			rewards: [{ id: "56B4C30A70CF7509", type: "xp", xp: 80 }]
			tasks: [{ id: "1EA6CADF664FD09D", item: "grindless:fibre_laser_module", type: "item" }]
			title: "Fibre Laser Module"
			x: 4.0d
			y: 7.5d
		}
		{
			dependencies: ["51F3CB52EBEB3BCB"]
			description: ["The &6MOCVD Reactor&r grows compound semiconductors one atomic layer at a time: pump diodes for the fibre, and a niobium nitride film. Its controller, clean room casing, an inert casing for the gas cabinet and a filter hood. InGaAs pump diodes and the SNSPD film. Arsenic is contained; keep the scrubber supplied and the diodes going out by ME."]
			icon: "gtceu:mocvd_reactor"
			id: "3D71CDF674EF3302"
			rewards: [{ id: "71C9A097B98E6CC3", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "33CC90ED047DEB79", item: "gtceu:mocvd_reactor", type: "item" }
