		{
			dependencies: ["3E5A326AEACCF50A"]
			description: ["The &6Powder-in-Tube Line&r packs a wire powder into a silver sheath and draws it down, turning one ingot of material into four. Its controller and UV casing, a drawing bench and a furnace coil. EnTED wire for the UV network. Silver sheath is kept: loop it back by ME."]
			icon: "gtceu:powder_in_tube_line"
			id: "1682DED202B72CC5"
