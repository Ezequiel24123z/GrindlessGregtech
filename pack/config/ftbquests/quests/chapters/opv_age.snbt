			tasks: [{ id: "7B390B262A4D2EDB", type: "checkmark" }]
			title: "Eight Sources"
			x: 52.5d
			y: 0.0d
		}
		{
			dependencies: ["187802F892D5F6DF"]
			description: ["The &6Cryogenic Plant&r, &6Rare Earth Extraction Cascade&r, &6Hot Strip Mill&r and &6Platinum Plant&r each take a new mode: liquid helium-3 and tests at 77 K, germanium and silicon chlorides, beryllium foil and iridium of five nines. The controllers you already own, and the cuts and dust from the stars. The tetron cryostat, the beam window and the iridium target. Each plant hands its product on by pipe. Return the nitrogen and the water."]
			icon: "gtceu:cryogenic_plant"
			id: "1F959B4FEF224AD3"
			rewards: [{ id: "13BD31AFD84B5D06", type: "xp", xp: 120 }]
			shape: "hexagon"
