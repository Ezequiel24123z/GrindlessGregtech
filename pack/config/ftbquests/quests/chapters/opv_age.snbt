			title: "Circuits"
			x: 10.0d
			y: 7.0d
		}
		{
			dependencies: ["3134E7DC3A7F7858"]
			description: ["A niobium interposer carries the signals through the die, a HEMT amplifier lifts them out of the noise, and an optical link takes them out of the cold without carrying heat in. The &6Nb TSV Interposer&r is tested cold in the helium refrigerator, the &6HEMT Amplifier&r is cut from its wafer and the &6Cryo Optical Link&r is drawn on the fibre tower."]
			icon: "grindless:cryo_optical_link"
			id: "328CDB4584A0E113"
			rewards: [{ id: "57487BE14A359C27", type: "xp", xp: 120 }]
			tasks: [
				{ id: "3F4452F8C40138FF", item: "grindless:nb_tsv_interposer", type: "item" }
				{ id: "589FD06B4D89DAEC", item: "grindless:hemt_amplifier", type: "item" }
				{ id: "712C8D7A0D318AB9", item: "grindless:cryo_optical_link", type: "item" }
			]
			title: "Cryogenic Links"
			x: 52.5d
			y: -4.0d
		}
		{
			dependencies: ["328CDB4584A0E113"]
			description: ["A cryo-CMOS die, a niobium interposer, an amplifier and an optical link, all joined in one cold package. The &6Cosmic Mainframe&r is the OpV circuit. The cryo-CMOS die and the three parts of the row before it, in the photonic integration hall. Every recipe that asks for OpV circuits: the sensor, the hatches and every OpV controller. One of each part per mainframe, so keep a dedicated chest and never a big stock."]
			icon: "gtnn:cosmic_mainframe"
			id: "74C17E229844F7DF"
			rewards: [{ id: "7A3CDCD62A90CD5F", type: "xp", xp: 250 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7611412123E87135", item: "gtnn:cosmic_mainframe", type: "item" }]
			title: "Cosmic Mainframe"
			x: 55.0d
			y: -4.0d
		}
		{
			dependencies: ["5DE7C491611D14C0"]
			description: ["A flexible steel cup that deforms against a ring of teeth turns with no backlash at all. The &6OpV Harmonic Drive&r is the gear of the OpV robot arm and holds position to a fraction of an arc second."]
			icon: "grindless:opv_harmonic_drive"
			id: "7FD656811E00D002"
			rewards: [{ id: "1B562FCD3792D51F", type: "xp", xp: 100 }]
			tasks: [{ id: "7E805A218F31BAC8", item: "grindless:opv_harmonic_drive", type: "item" }]
			title: "Harmonic Drive"
			x: 17.5d
			y: 9.0d
		}
		{
			dependencies: ["5DE7C491611D14C0"]
			description: ["A sapphire crystal doped with titanium is the gain medium of a tunable laser. The &6Ti:Sapphire Boule&r is the crystal that the Lyman-alpha laser of the antihydrogen line is built round. The crystal growth furnace, two sapphire dust, a titanium dust and an iridium crucible, with a circuit of any kind. It draws OpV power. The Lyman-alpha laser, which cools the antihydrogen atoms before they freeze into a cell, beside the krypton tripler cell. Feed the dusts by ME and keep a spare crucible; one boule is used up per laser, so stock only a few."]
			icon: "grindless:ti_sapphire_boule"
			id: "15DB2B19BF5783B5"
			rewards: [{ id: "3932025D0FF6D051", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7A4A4D44B1308013", item: "grindless:ti_sapphire_boule", type: "item" }]
			title: "Ti:Sapphire Boule"
			x: 14.5d
			y: 9.0d
		}
		{
			dependencies: ["74C17E229844F7DF"]
			description: ["The &6OpV Sensor&r measures what the detectors of the age need to see: single photons, charge and spin. The emitter, the field generator and many controllers use one. An HPGE Compton crystal, a chain lamina stack, a cryo optical link, chain strand cable, a UXV sensor and OpV circuits, in an assembler. The energy input hatches, the annihilation shield casing and the controllers that watch a beam. Mainframes by ME in matched counts; keep sensors in a small stock."]
			icon: "gtceu:opv_sensor"
			id: "3BA080B24583F060"
			rewards: [{ id: "3EEEFF1E6AB60D86", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "562FAE7CE1E2707A", item: "gtceu:opv_sensor", type: "item" }]
			title: "OpV Sensor"
			x: 57.5d
			y: -4.0d
		}
		{
			dependencies: ["59A06A2C9ADDA9E4", "7FD656811E00D002"]
			description: ["The &6OpV Electric Motor&r turns chain composite rods inside a chain field coil, a trained REBCO pancake wound with chain strand, and is charged with superfluid helium-3. The &6OpV Electric Pump&r spins a chain composite rotor behind superfluid helium-3 seals, and the conveyor drives a chain mesh belt. The piston runs on rods and lamina stacks, the robot arm turns on the harmonic drive, and the emitter and sensor carry the Th-229 lasing crystal and the Compton crystal on a cryo optical link. The field generator and the fluid regulator close the set."]
			icon: "gtceu:opv_electric_motor"
			id: "51B76517CEFC0F97"
			rewards: [{ id: "73B2A86758A64E86", type: "xp", xp: 200 }]
			tasks: [
				{ id: "1B3266F01B6A11B3", item: "gtceu:opv_electric_motor", type: "item" }
				{ id: "1D088B0E0CC5978E", item: "gtceu:opv_electric_pump", type: "item" }
				{ id: "179EFC776530C279", item: "gtceu:opv_electric_piston", type: "item" }
				{ id: "119266EE4FCF6357", item: "gtceu:opv_conveyor_module", type: "item" }
				{ id: "33E26360D3A29FB7", item: "gtceu:opv_robot_arm", type: "item" }
				{ id: "7CB4896ABAA11E6B", item: "gtceu:opv_emitter", type: "item" }
				{ id: "39558120E4867B3E", item: "gtceu:opv_field_generator", type: "item" }
				{ id: "11B606E21F7B69CE", item: "gtceu:opv_fluid_regulator", type: "item" }
			]
			title: "OpV Components"
			x: 27.5d
			y: 9.0d
		}
		{
			dependencies: ["51B76517CEFC0F97"]
			description: ["The &6OpV Energy Hatch&r takes power in or gives it back, as a single, four or sixteen amp hatch. Each is built with an AlN power die and a field-frozen plate. The beam lines and the engines of the age are wired to them."]
			icon: "gtceu:opv_energy_input_hatch"
			id: "500C1E02A6CC0121"
			rewards: [{ id: "762094F57DA03DD6", type: "xp", xp: 150 }]
			tasks: [
				{ id: "55AF0ADCAFCCFC64", item: "gtceu:opv_energy_input_hatch", type: "item" }
				{ id: "3722CFF3D950ED02", item: "gtceu:opv_energy_output_hatch", type: "item" }
			]
			title: "OpV Energy Hatches"
			x: 30.0d
			y: 9.0d
		}
		{
			dependencies: ["500C1E02A6CC0121"]
			description: ["The &6OpV Assembler&r is the single-block assembler at the voltage of the age, for every part that does not need a line. An OpV hull, the OpV components and the machine casing of the age. Faster part rows at OpV voltage. Parts by ME in and out; one assembler per product keeps the recipes from interleaving."]
			icon: "gtceu:opv_assembler"
			id: "5B22AF4BC1D6F0C9"
			rewards: [{ id: "3B54CD6BD3EE291C", type: "xp", xp: 120 }]
			shape: "gear"
