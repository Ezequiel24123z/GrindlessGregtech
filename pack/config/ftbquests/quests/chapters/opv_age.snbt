				{ id: "132BDCE519F709A7", item: "gtceu:kugelblitz_forge", type: "item" }
				{ id: "38B15C21F2CEF2F8", item: "grindless:field_frozen_casing", type: "item" }
				{ id: "19C52AABE2B15D47", item: "grindless:annihilation_shield_casing", type: "item" }
				{ id: "37EE96166B205CBE", item: "gtceu:fusion_coil", type: "item" }
			]
			title: "Kugelblitz Forge"
			x: 37.5d
			y: 21.5d
		}
		{
			dependencies: ["7F7487A3E9823C9A"]
			description: ["The &6Magnetic Pair Converter&r turns gammas into electron and positron pairs inside the magnetar field, seeded by a positron plasma from home. Only a field this strong allows it. An OpV hull, the field-frozen casing and field-frozen plate from the press, a gamma laser and a chain field coil, then gamma light and a rotating-wall positron plasma. Its shape is 13 by 17 by 13, built by the Terminal in 2 passes. Unsealed positron cells, which the electron beam furnace seals into dense positron cells. Seed plasma by hatch; send the cells to the furnace and on to the antihydrogen foundry."]
			icon: "gtceu:magnetic_pair_converter"
			id: "3E86C36587CF8FBB"
			rewards: [{ id: "1BE2DC7CCBC9F8E8", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5A9907C395BC5487", item: "gtceu:magnetic_pair_converter", type: "item" }
				{ id: "7112B5BC438625D1", item: "grindless:field_frozen_casing", type: "item" }
			]
			title: "Magnetic Pair Converter"
			x: 22.5d
			y: 13.0d
		}
		{
			dependencies: ["7F4169BDA6339C6F"]
			description: ["The &6Field-Frozen Press&r presses chain-matter laminae in the magnetar field so that the field stays frozen in the billet. An OpV hull, the high power casing and a tungsten steel frame, with laminae from the chain-matter line. Its shape is 11 by 15 by 11, built by the Terminal in one pass. The field-frozen plate and, from it, the field-frozen casing that the pair converter, the vault, the distiller and the forge are built of. Laminae by ME; plates come out stacked, so chest them for the casing."]
			icon: "gtceu:field_frozen_press"
			id: "3EA9271449E0281E"
			rewards: [{ id: "73870403D9A2274E", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "33F5D38604045136", item: "gtceu:field_frozen_press", type: "item" }
				{ id: "129F139901E8DE2A", item: "gtceu:high_power_casing", type: "item" }
				{ id: "5EA8474AECB7F3EC", item: "gtceu:tungsten_steel_frame", type: "item" }
			]
			title: "Field-Frozen Press"
			x: 17.5d
			y: 14.5d
		}
		{
			dependencies: ["3EA9271449E0281E"]
			description: ["The &6Field-Frozen Plate&r keeps the magnetar field it was pressed in. Pressed into the &6Field-Frozen Casing&r, it is what the vault, the distiller and the forge are built of."]
			icon: "grindless:field_frozen_plate"
			id: "7F7487A3E9823C9A"
			rewards: [{ id: "71E64E3B5D013405", type: "xp", xp: 80 }]
			tasks: [{ id: "5993055E2BEF03F9", item: "grindless:field_frozen_plate", type: "item" }]
			title: "Field-Frozen Plate"
			x: 20.0d
			y: 14.5d
		}
		{
			dependencies: ["7F7487A3E9823C9A"]
			description: ["The &6Superfluid He-3 Seal&r keeps a superfluid from creeping past a moving shaft. The OpV pump and fluid regulator are built with it, and so, later, is the MAX pump."]
			icon: "grindless:superfluid_he3_seal"
			id: "3946AF14206E410E"
			rewards: [{ id: "1A14BA2BF3660E1D", type: "xp", xp: 80 }]
			tasks: [{ id: "337CAC646870BAC6", item: "grindless:superfluid_he3_seal", type: "item" }]
			title: "Superfluid He-3 Seal"
			x: 25.0d
			y: 14.5d
		}
		{
			dependencies: ["34EC6937B4EB1880"]
			description: ["The &6Debris Harvester&r collects and sorts the debris of the core into metal and silicate, so the cluster feeds the probe with nothing from home. An OpV hull, the robust casing and a steel gearbox. Its shape is 15 by 7 by 15, built by the Terminal in one pass. The bulge debris, and the refinery behind it. Run it continuously and split the output by item filter into metal and silicate."]
			icon: "gtceu:debris_harvester"
			id: "397BE2355436062F"
			rewards: [{ id: "1A4D121357184494", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5DE0DD7D37475136", item: "gtceu:debris_harvester", type: "item" }
				{ id: "5321A0BC6C6591C2", item: "gtceu:robust_machine_casing", type: "item" }
				{ id: "30F8B08B737C5412", item: "gtceu:steel_gearbox", type: "item" }
			]
			title: "Debris Harvester"
			x: 36.5d
			y: 17.5d
		}
		{
			dependencies: ["397BE2355436062F"]
			description: ["The &6Replication Refinery&r turns local silicon and metal into probe feedstock by two real routes, and sinters the rest into the casing of the next probe. An OpV hull, the clean casing, titanium pipe casing and a heat vent. Its shape is 13 by 15 by 13, built by the Terminal in 2 passes. The cluster sinter casing, and the probe parts for the foundry. Chain it to the harvester by pipe and belt; it never needs anything from home."]
			icon: "gtceu:replication_refinery"
			id: "1521EF011A60705F"
			rewards: [{ id: "72307B98139F0FDB", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1E5329378C3D7367", item: "gtceu:replication_refinery", type: "item" }
				{ id: "350A033A8F13ADE5", item: "gtceu:clean_machine_casing", type: "item" }
				{ id: "75288BD800F72831", item: "gtceu:titanium_pipe_casing", type: "item" }
				{ id: "38447536DB931F6C", item: "gtceu:heat_vent", type: "item" }
			]
			title: "Replication Refinery"
			x: 38.0d
			y: 17.5d
		}
		{
			dependencies: ["1521EF011A60705F"]
			description: ["The &6Collector Node Works&r turns local silicon into thin photovoltaic nodes and packs them onto a seed, four at a time. An OpV hull, cleanroom glass, plascrete and assembly line grating. Its shape is 21 by 9 by 13, built by the Terminal in 2 passes. The deployed node pack, and the bulge collector. Silicon from the harvester line; one pack per seed, so send them straight out."]
			icon: "gtceu:collector_node_works"
			id: "7A800CFF0E239E9B"
			rewards: [{ id: "559E04873B2E19F4", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "3799A49845162A01", item: "gtceu:collector_node_works", type: "item" }
				{ id: "31483F50FF9121F2", item: "gtceu:cleanroom_glass", type: "item" }
				{ id: "1397EF7D4B4B74F9", item: "gtceu:plascrete", type: "item" }
				{ id: "140F416750EC8493", item: "gtceu:assembly_line_grating", type: "item" }
			]
			title: "Collector Node Works"
			x: 42.5d
			y: 16.0d
		}
		{
			dependencies: ["5DB4AECF2C68DD7A"]
			description: ["The &6Von Neumann Foundry&r builds a probe that builds a copy of itself, from feedstock and parts made on the spot. Once a seed is here, the cluster feeds its own growth. An OpV hull, the robust casing and assembly line grating, with cluster sinter casings, a tetron array and an XNAV unit in the controller, and feedstock from the refinery. Its shape is 17 by 13 by 17, built by the Terminal in 2 passes. The self-copying probe seed. Every input comes from the cluster by belt, so wire it to the refinery."]
			icon: "gtceu:von_neumann_foundry"
			id: "10ABDF6F9EF0EBC0"
			rewards: [{ id: "78C3F5A173F6F754", type: "xp", xp: 250 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1954CF85833052C4", item: "gtceu:von_neumann_foundry", type: "item" }
				{ id: "14905F2DFF2C19B0", item: "gtceu:robust_machine_casing", type: "item" }
				{ id: "1BE1AC0C40898713", item: "gtceu:assembly_line_grating", type: "item" }
			]
			title: "Von Neumann Foundry"
			x: 41.0d
			y: 17.5d
		}
		{
			dependencies: ["1A9EE7510BD6DBFC"]
			description: ["Twenty-three steps from silicon-28 ash to the tetron array: purify the silicon, build a cold CMOS chip on it, then grow the qubits. The cosmic mainframe and every OpV sensor and emitter draw from this line."]
			icon: "grindless:tetron_array"
			id: "743F8415C4AA94EE"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "50DE27163CDC7DB4", type: "checkmark" }]
			title: "Si-28 qubit line"
			x: 5.0d
			y: -2.0d
		}
		{
			dependencies: ["743F8415C4AA94EE"]
			description: ["Silicon-28 enters the line as the ash of oxygen burning in a star, made by plasma quenching. Hydrochloric acid turns the ash into a liquid silicon compound that can be distilled. The &6Extraction Cascade&r: Si-28 ash and hydrochloric acid, 100 ticks, give &6Crude Si-28 Trichlorosilane&r and hydrogen. Place the machine to finish the quest. The distillation tower, which cleans the crude. Pipe the acid and the ash by ME; the hydrogen returns to the MOCVD steps."]
			icon: "gtceu:extraction_cascade"
			id: "1A873EBD84722AD5"
			rewards: [{ id: "355CE127EB29F313", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3C0FDCD58B507F4B", item: "gtceu:extraction_cascade", type: "item" }]
			title: "1. Extraction Cascade: Crude Trichlorosilane"
			x: 7.5d
			y: -2.0d
		}
		{
			dependencies: ["1A873EBD84722AD5"]
			description: ["The ash carries phosphorus and other impurities. Fractional distillation separates pure &6Si-28 Trichlorosilane&r from a tetrachloride fraction and a small purge. The &6Distillation Tower&r: the crude trichlorosilane, 200 ticks. The tetrachloride goes back to the crude in a chemical reactor (hydrogen in, crude and acid out); hydrolyse the purge, which carries the phosphorus out. The MOCVD reactor, which grows the polysilicon rods. Route the three outputs by fluid hatch; the tetrachloride loop keeps the silicon from being lost."]
			icon: "gtceu:distillation_tower"
			id: "3A28E8A22271FF31"
			rewards: [{ id: "53DCC0C434DD8AFD", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "391D5F628FE45CEE", item: "gtceu:distillation_tower", type: "item" }]
			title: "2. Distillation: Pure Trichlorosilane"
			x: 10.0d
			y: -2.0d
		}
		{
			dependencies: ["3A28E8A22271FF31"]
			description: ["Hot hydrogen strips the chlorine from the trichlorosilane and deposits solid silicon on a seed. The &6Si-28 Poly Rod&r is the pure feed for the crystal. The &6MOCVD Reactor&r: trichlorosilane and hydrogen, 1,200 ticks, give a rod and a large flow of hydrochloric acid, which feeds the first step again. The zone refining tower. One rod needs a large volume of fluid, so size the tanks and let the acid loop back by pipe."]
			icon: "grindless:si28_poly_rod"
			id: "1702969CB6975F46"
			rewards: [{ id: "72ACB7EB5BF2B1A0", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "715BE496199CA7A9", item: "grindless:si28_poly_rod", type: "item" }]
			title: "3. MOCVD: Si-28 Poly Rod"
			x: 12.5d
			y: -2.0d
		}
		{
			dependencies: ["1702969CB6975F46"]
			description: ["A molten zone swept along the rod pushes the last impurities to one end. The &6Si-28 FZ Ingot&r is single-crystal silicon-28. The &6Zone Refining Tower&r: poly rods and argon, 800 ticks, give an ingot. Spent donor wafers of the slicing step (step 7) are regrown into ingots the same way. The large cutter. Send the donor wafers back here by conveyor so no silicon-28 is wasted."]
			icon: "grindless:si28_fz_ingot"
			id: "75CA4947AC845EC8"
			rewards: [{ id: "366A0D781744B471", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "77CA9373EAAB32B3", item: "grindless:si28_fz_ingot", type: "item" }]
			title: "4. Zone Refining: Si-28 FZ Ingot"
			x: 15.0d
			y: -2.0d
		}
		{
			dependencies: ["75CA4947AC845EC8"]
			description: ["The ingot is sliced into thin discs. The &6Si-28 FZ Wafer&r is the blank for every chip of the line. The &6Large Cutter&r: an ingot and water, 400 ticks, give eight wafers. The ion implanter. A buffer chest after the cutter feeds both the SOI and the later wafers."]
			icon: "grindless:si28_fz_wafer"
			id: "3E9024A0E0052EF9"
			rewards: [{ id: "1ABEABF39E390F22", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "39E4CFC3D66A13AB", item: "grindless:si28_fz_wafer", type: "item" }]
			title: "5. Cutting the Si-28 Wafers"
			x: 17.5d
			y: -2.0d
		}
		{
			dependencies: ["3E9024A0E0052EF9"]
			description: ["Hydrogen ions driven deep into the wafer weaken a thin layer, along which the top of the wafer can later be split off. The &6Ion Implanter&r: a Si-28 wafer and hydrogen, 600 ticks, give an &6H Si-28 Wafer&r. The TFLN fab, which splits the layer onto an oxide. Hydrogen comes back from the slicing step, so share one hydrogen line."]
			icon: "grindless:h_si28_wafer"
			id: "505D40BADDD91FEB"
			rewards: [{ id: "5BFEC1ACFA1D91B0", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3F6ECCF78515B2DC", item: "grindless:h_si28_wafer", type: "item" }]
			title: "6. Ion Implanter: Hydrogen Layer"
			x: 20.0d
			y: -2.0d
		}
		{
			dependencies: ["505D40BADDD91FEB"]
			description: ["The weakened wafer is bonded to an oxidised wafer and split: a thin silicon-28 film on an insulator is the &6Si-28 SOI Wafer&r, the base of every cold chip. The &6TFLN Fab&r (ion slicing): an H Si-28 wafer and an oxidised wafer, 1,600 ticks, give the SOI wafer, a donor wafer (regrown in step 4) and hydrogen. The anneal that heals the bonded film. Keep a chest of oxidised wafers beside the fab."]
			icon: "grindless:si28_soi_wafer"
			id: "14D19766AADE574D"
			rewards: [{ id: "13FAF9F700E14F89", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3B2C538FF7A3FCA5", item: "grindless:si28_soi_wafer", type: "item" }]
			title: "7. TFLN Fab: Si-28 SOI Wafer"
			x: 22.5d
			y: -2.0d
		}
		{
			dependencies: ["14D19766AADE574D"]
			description: ["The bond and the implant leave defects in the silicon. A long hot anneal in nitrogen repairs them. The &6Electric Blast Furnace&r at 1,373 K: an SOI wafer and nitrogen, 400 ticks, give the &6Annealed SOI Wafer&r. The back-gate implant. Nitrogen by pipe, wafers by conveyor."]
			icon: "grindless:annealed_soi_wafer"
			id: "1AD2342368CAA476"
			rewards: [{ id: "130B1C3649588598", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3F1D9F61F3544C6E", item: "grindless:annealed_soi_wafer", type: "item" }]
			title: "8. Annealing the SOI Wafer"
			x: 25.0d
			y: -2.0d
		}
		{
			dependencies: ["1AD2342368CAA476"]
			description: ["A doped layer under the insulator lets a voltage tune the transistors from behind, which cold devices need. The &6Ion Implanter&r: an annealed wafer and boron dust, 400 ticks, give the &6Back-Gated SOI Wafer&r. The gate stack. Boron dust from an input bus."]
			icon: "grindless:back_gated_soi_wafer"
			id: "30CE241102E209C0"
			rewards: [{ id: "1282A0F2C62FB051", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "1677713DC0A59D2B", item: "grindless:back_gated_soi_wafer", type: "item" }]
			title: "9. Back-Gate Implant"
			x: 27.5d
			y: -2.0d
		}
		{
			dependencies: ["30CE241102E209C0"]
			description: ["A hafnium oxide gate insulator and a titanium nitride metal make a transistor gate that works at a few kelvin. The &6MOCVD Reactor&r: a back-gated wafer, six-nines hafnium, titanium dust, oxygen and ammonia, 1,200 ticks, give the &6Gate Stack SOI Wafer&r and hydrogen. The cryo-CMOS exposure. The hafnium is an ultra-pure product of the metal chain; stock a few."]
			icon: "grindless:gate_stack_soi_wafer"
			id: "197AF5328EEAAC07"
			rewards: [{ id: "18040CB7A3C17E3A", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "35B4508E32DC44A8", item: "grindless:gate_stack_soi_wafer", type: "item" }]
			title: "10. MOCVD: Gate Stack"
			x: 30.0d
			y: -2.0d
		}
		{
			dependencies: ["197AF5328EEAAC07"]
			description: ["The transistor pattern is printed with beyond-extreme ultraviolet light from a terbium plasma. The &6BEUV Scanner&r: a gate stack wafer, a terbium droplet target and a BEUV mirror, 2,000 ticks, give the &6Cryo-CMOS Litho Wafer&r and a fouled mirror to be cleaned and reused. The source and drain implant. Keep the mirror cleaning loop running; mirrors and targets are the limit."]
			icon: "grindless:cryo_cmos_litho_wafer"
			id: "502ED70BB89465D6"
			rewards: [{ id: "5FA216F368837B32", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "1390452BE3FB0DFC", item: "grindless:cryo_cmos_litho_wafer", type: "item" }]
			title: "11. BEUV: Cryo-CMOS Exposure"
			x: 32.5d
			y: -2.0d
		}
		{
			dependencies: ["502ED70BB89465D6"]
			description: ["Arsenic ions dope the source and drain of every transistor through the exposed pattern. The &6Ion Implanter&r: a litho wafer and arsenic dust, 400 ticks, give the &6Cryo-CMOS Implanted Wafer&r. The flash anneal. Arsenic dust from an input bus."]
			icon: "grindless:cryo_cmos_implanted_wafer"
			id: "78C8292FA9F28911"
			rewards: [{ id: "73DA4F2C16A27E37", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3EFE40ADD8A8CB51", item: "grindless:cryo_cmos_implanted_wafer", type: "item" }]
			title: "12. Ion Implanter: Source and Drain"
			x: 35.0d
			y: -2.0d
		}
		{
			dependencies: ["78C8292FA9F28911"]
			description: ["A pulse of electrons activates the dopants without letting them diffuse. The &6Electron Beam Furnace&r: an implanted wafer and a lanthanum hexaboride cathode (worn slowly, 1% per run), 400 ticks, give the &6Activated CMOS Wafer&r. The tungsten contacts. Replace the cathode by ME when it wears out."]
			icon: "grindless:activated_cmos_wafer"
			id: "35553B4FCC2EADEF"
			rewards: [{ id: "7F94EA55282F0016", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "54C89867E9D5E25F", item: "grindless:activated_cmos_wafer", type: "item" }]
			title: "13. Flash Anneal: Activated CMOS Wafer"
			x: 37.5d
			y: -2.0d
		}
		{
			dependencies: ["35553B4FCC2EADEF"]
			description: ["Tungsten plugs connect the transistors to the metal above them. The &6MOCVD Reactor&r: an activated wafer, tungsten hexafluoride and hydrogen, 800 ticks, give the &6Contacted CMOS Wafer&r and hydrofluoric acid, which joins the fluorine chain. The metal layer. Pipe the hydrofluoric acid to the fluorine chain; it is a product, not waste."]
			icon: "grindless:contacted_cmos_wafer"
			id: "55F2EC2D94AD38D7"
			rewards: [{ id: "7A5FA84CF72BB896", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "190F92543529ABC9", item: "grindless:contacted_cmos_wafer", type: "item" }]
			title: "14. MOCVD: Tungsten Contacts"
			x: 40.0d
			y: -2.0d
		}
		{
			dependencies: ["55F2EC2D94AD38D7"]
			description: ["Gold wiring stays a good conductor in the cold. The &6Spintronic Cluster Tool&r: a contacted wafer, gold foil and argon, 600 ticks, give the &6Cryo-CMOS Metal Wafer&r and gold overspray, which is recycled. The via exposure. Recycle the overspray into gold so the foil stays cheap."]
			icon: "grindless:cryo_cmos_metal_wafer"
			id: "51A5BEF84CA3AEE5"
			rewards: [{ id: "3C025E55FBA64106", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7FB9EBD64A938863", item: "grindless:cryo_cmos_metal_wafer", type: "item" }]
			title: "15. Sputtering the Metal Layer"
			x: 42.5d
			y: -2.0d
		}
		{
			dependencies: ["51A5BEF84CA3AEE5"]
			description: ["A second exposure opens the vias that join the metal layers. The &6BEUV Scanner&r: a metal wafer, a terbium droplet target and a BEUV mirror, 2,000 ticks, give the &6Interconnected CMOS Wafer&r. Cutting into dies. Share the mirror loop with step 11."]
			icon: "grindless:interconnected_cmos_wafer"
			id: "7BBBD0859EA6A685"
			rewards: [{ id: "716408A447EC7F54", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3467EE657DF9AA43", item: "grindless:interconnected_cmos_wafer", type: "item" }]
			title: "16. BEUV: Via Exposure"
			x: 45.0d
			y: -2.0d
		}
		{
			dependencies: ["7BBBD0859EA6A685"]
			description: ["The wafer is cut into four chips, none of which has been proved to work cold yet. The &6Large Cutter&r: an interconnected wafer and water, 400 ticks, give four &6Untested Cryo-CMOS Dies&r. The cold test. A chest of dies buffers the cold test."]
			icon: "grindless:untested_cryo_cmos_die"
			id: "1A2C71E2842CC522"
			rewards: [{ id: "581A0807E1397A1D", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "15885E732A669F58", item: "grindless:untested_cryo_cmos_die", type: "item" }]
			title: "17. Cutting the Cryo-CMOS Dies"
			x: 47.5d
			y: -2.0d
		}
		{
			dependencies: ["1A2C71E2842CC522"]
			description: ["Each die is cooled in liquid helium and only working ones pass. The &6Cryo-CMOS Die&r is the logic of the cosmic mainframe and of every tetron. The &6Helium Refrigerator&r (closed-loop cooling): an untested die, liquid helium and a little liquid nitrogen, 400 ticks, give the die and nitrogen. The cosmic mainframe is made from this die in the photonic integration hall, with the niobium interposer, the optical link and two HEMT amplifiers. The tetron fab and the cosmic mainframe. Liquid helium by pipe; the die goes to two lines, so split it by filter."]
			icon: "grindless:cryo_cmos_die"
			id: "3134E7DC3A7F7858"
			rewards: [{ id: "30E1A623C1462875", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "365921531B644899", item: "grindless:cryo_cmos_die", type: "item" }]
			title: "18. Cold Test: Cryo-CMOS Die"
			x: 50.0d
			y: -2.0d
		}
		{
			dependencies: ["3134E7DC3A7F7858"]
			description: ["Qubits are written onto a gated two-dimensional electron gas and wired to the cryo-CMOS die that controls them. The &6Tetron Fab&r: a Gated 2DEG wafer (the InP wafer branch) and a cryo-CMOS die, 1,200 ticks, give four &6Tetron Dies&r. Bumping the dies. Keep the 2DEG branch running ahead; it is the slow side."]
			icon: "grindless:tetron_die"
			id: "72226ED2762C28A7"
			rewards: [{ id: "545ED86BC13D386E", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5ECF77AE0AB34055", item: "grindless:tetron_die", type: "item" }]
			title: "19. Tetron Fab: Tetron Die"
			x: 52.5d
			y: -2.0d
		}
		{
			dependencies: ["72226ED2762C28A7"]
			description: ["Indium bumps make the connections between a die and its interposer. The &6Spintronic Cluster Tool&r: four tetron dies, indium dust and argon, 600 ticks, give four &6Bumped Tetron Dies&r. The bonding. Indium dust from an input bus."]
			icon: "grindless:bumped_tetron_die"
			id: "77C5674534C89B44"
			rewards: [{ id: "3BB700CCEC869CBD", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "33EDD3A57D29D6ED", item: "grindless:bumped_tetron_die", type: "item" }]
			title: "20. Sputtering the Indium Bumps"
			x: 55.0d
			y: -2.0d
		}
		{
			dependencies: ["77C5674534C89B44"]
			description: ["The die is bonded face-down to a niobium TSV interposer that carries its signals out. The &6TFLN Fab&r: a bumped die and an &6Nb TSV Interposer&r (the interposer branch), 1,600 ticks, give the &6Bonded Tetron Die&r. The millikelvin test. The interposer branch must be automated ahead of this step."]
			icon: "grindless:bonded_tetron_die"
			id: "341E5713FC2FE9C1"
			rewards: [{ id: "533209ADC21EF07A", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "53EFCA66E3434940", item: "grindless:bonded_tetron_die", type: "item" }]
			title: "21. TFLN Fab: Bonded Tetron Die"
			x: 57.5d
			y: -2.0d
		}
		{
			dependencies: ["341E5713FC2FE9C1"]
			description: ["Qubits only prove themselves near absolute zero. The cryostat is not used up by the test. The &6Millikelvin Cryostat Works&r: a bonded die, an MK cryostat module (not consumed) and liquid helium, 1,600 ticks, give the &6Tested Tetron Die&r. The tetron array. The works is large; run one die at a time and keep the module in its slot."]
			icon: "grindless:tested_tetron_die"
			id: "3143989A0AEAA808"
			rewards: [{ id: "5BFC6B07ACE39872", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "34E8608681D9C0EF", item: "grindless:tested_tetron_die", type: "item" }]
			title: "22. Millikelvin Test"
			x: 60.0d
			y: -2.0d
		}
		{
			dependencies: ["3143989A0AEAA808"]
			description: ["Four tested dies and a HEMT amplifier make an array: the qubit block that the MAX components and the relay probes are built on. The &6Tetron Fab&r (tetron assembly): four tested dies, a HEMT amplifier and superfluid helium-3, 1,600 ticks, give the &6Tetron Array&r and, one run in ten, a failed die, which the extraction cascade recovers into indium, aluminium and gold. MAX components, the probes and the mainframe of the supracausal era. Recycle the failed dies by ME and keep a stock of arrays."]
			icon: "grindless:tetron_array"
			id: "1DC4918611338BD8"
			rewards: [{ id: "391F3AF1195C13AB", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3C99D4B329CF5E52", item: "grindless:tetron_array", type: "item" }]
			title: "23. Tetron Array"
			x: 62.5d
			y: -2.0d
		}
