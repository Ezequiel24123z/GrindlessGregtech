			tasks: [{ id: "3371D5550DAE8267", item: "gtceu:opv_assembler", type: "item" }]
			title: "OpV Assembler"
			x: 32.5d
			y: 9.0d
		}
		{
			dependencies: ["5B22AF4BC1D6F0C9"]
			description: ["The &6OpV Circuit Assembler&r works at the voltage of the cosmic mainframe, for everything below it that still wants a board. An OpV hull, the OpV components and the cleanroom you already run. Faster circuit rows at OpV voltage; the mainframe itself still comes from the cold line. Boards and chips by ME; keep a small stock of what it returns."]
			icon: "gtceu:opv_circuit_assembler"
			id: "5CB5C38F24E89ABD"
			rewards: [{ id: "117CD95FF7FD401F", type: "xp", xp: 120 }]
