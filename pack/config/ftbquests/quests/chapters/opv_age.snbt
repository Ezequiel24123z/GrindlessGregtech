		{
			dependencies: ["7AA246E5F046BCCF"]
			description: ["A casing lined with a non-evaporable getter that soaks up the last stray gas and holds an extreme-high vacuum. The foundry and the decelerator need it. An assembler, 400 ticks: an activated NEG chamber, chain lamina stacks, a stainless frame and two UXV pumps, with nitrogen, for four casings. The Antihydrogen Foundry and the Antiproton Complex. Chambers by ME; nitrogen by pipe."]
			icon: "grindless:neg_xhv_casing"
			id: "31F433D89329FB0F"
			rewards: [{ id: "1221D2A399A75628", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 4L, id: "356A99CB91696DFC", item: "grindless:neg_xhv_casing", type: "item" }]
			title: "NEG XHV Casing"
			x: 20.0d
			y: 31.0d
		}
		{
			dependencies: ["31F433D89329FB0F"]
			description: ["A wall of thermophotovoltaic panels that turns the glow of a hot core back into current. It is what lets a Hawking collector or an annihilation engine feed itself. An assembler, 400 ticks: TPV panels, a gamma absorber tile, a chain lamina stack, copper, tungsten and stainless plate and two UXV sensors, with superfluid helium-3, for three casings. The Annihilation Engine and the Hawking Collector. Panels by ME; the helium-3 by pipe."]
			icon: "grindless:tpv_wall_casing"
			id: "75E5A2739F783CBE"
			rewards: [{ id: "72FCBB639F2FCF42", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 3L, id: "7465294155CED11F", item: "grindless:tpv_wall_casing", type: "item" }]
			title: "TPV Wall Casing"
			x: 22.5d
			y: 31.0d
		}
		{
			dependencies: ["75E5A2739F783CBE"]
			description: ["The cavity that holds a Kugelblitz: a gamma mirror and field-frozen plate around an annihilation shield casing. It is the hardest casing of the age. The assembly line, 600 ticks: a gamma multilayer mirror, field-frozen plates, an annihilation shield casing, strand wires and a UXV field generator, for three casings. The Kugelblitz Forge and, through it, the gate to MAX. Build it from a dedicated line: every part is a product of an earlier casing or line."]
			icon: "grindless:kugelblitz_cavity_casing"
			id: "596CD194B371E4BA"
			rewards: [{ id: "3B08E75337D1B744", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ count: 3L, id: "798372F6ED46A95A", item: "grindless:kugelblitz_cavity_casing", type: "item" }]
			title: "Kugelblitz Cavity Casing"
			x: 25.0d
			y: 31.0d
		}
		{
			dependencies: ["1A9EE7510BD6DBFC"]
			description: ["The wafers, chips and circuits of the era, from the first wafer to the mainframe, and the parts built from them."]
			icon: "minecraft:writable_book"
			id: "5DE7C491611D14C0"
			rewards: [ ]
			shape: "circle"
