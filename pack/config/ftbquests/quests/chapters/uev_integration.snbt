	quests: [
		{
			dependencies: ["7BF609F908839C42"]
			description: ["The first fuel run on the Mk4 ring turns D-He-3 into helium plasma and protons, and the plasma is the energy: a direct converter takes it as current. A formed Mk4 ring on UEV hatches, a premixed D-He-3 fuel and a very large buffer: a run is refused when the start energy is above what the ring stores. The ring's power for the gate, and the plasma the Stellar Forge burns for extra heat. Fuel in by bus from the helium-3 and deuterium lines; the helium ash goes back to the cryogenic plant."]
			icon: "gtceu:uev_dhe3_plasma_bucket"
			id: "72E2761F9FC0A537"
			rewards: [{ id: "3A74CF837C38CC6E", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "33B1496F2F463CE7", item: "gtceu:uev_dhe3_plasma_bucket", type: "item" }]
			title: "First Mk4 Burn"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["72E2761F9FC0A537"]
			description: ["Proton and boron-11 fuse into three helium nuclei and almost no neutrons, so the first wall wears far less than with helium-3. Boron-11 from the isotope column, and the same Mk4 ring and converter as the first burn. A second source of Mk4 power with no tritium side reactions. Keep boron-11 on its own line from the column; the plasma goes straight to the converter."]
			icon: "gtceu:uev_pb11_plasma_bucket"
			id: "78C5C5037351F0AD"
			rewards: [{ id: "71E7F9417597575C", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5B402C5F60EA959F", item: "gtceu:uev_pb11_plasma_bucket", type: "item" }]
			title: "Aneutronic"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["78C5C5037351F0AD"]
			description: ["The &6Direct Energy Converter&r takes three Mk4 plasmas and the &6Naquadria Magnet Works&r makes the UEV cell. Both are older machines with a new row. The Mk4 plasma buckets and the magnet works from ZPM. The converter's output is written final, so no generator array doubles it. The Mk4 figures on the Power tab and the cell below. Plasma by pipe from the ring; leave the converter's hatches empty of anything else."]
			icon: "gtceu:direct_energy_converter"
			id: "13C93E95696BC875"
			rewards: [{ id: "10454819E59073E0", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "3BCEDBCCEDCDE536", item: "gtceu:direct_energy_converter", type: "item" }
				{ id: "1D3A4B3E8FB04083", item: "gtceu:naquadria_magnet_works", type: "item" }
			]
			title: "Written Final"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["3622F47EE2F048E9"]
			description: ["The &6Ultimate Parallel Control Hatch&r lets a mega machine run up to 4,096 copies of a recipe at once. Energy is still the limit: every copy pays its own EU/t. A machine with a parallel slot, and the power for every copy. The first copies cost the same as the last. The Stellar Forge at full width, and every mega machine of the era. Feed the machine a bus wide enough for the copies it will run."]
			icon: "gtceu:uev_parallel_hatch"
			id: "3CE8ED7227C70D82"
			rewards: [{ id: "37FEEAB9B356500E", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5C72191EADDB5B20", item: "gtceu:uev_parallel_hatch", type: "item" }]
			title: "Parallel Control"
			x: 2.0d
			y: 4.0d
		}
		{
			dependencies: ["3622F47EE2F048E9"]
			description: ["The &6UEV SMES Cell&r holds ninety-six UV naquadria batteries, about 250 billion EU. The quantum repeater keeps the network in step. The naquadria magnet works, and the quantum repeater node from the photonic lane. The UEV wireless tier. Nothing to feed. Size the towers for your busiest hour."]
			icon: "grindless:uev_smes_cell"
			id: "5304F9E360A95261"
			rewards: [{ id: "13A1AC8E372B9C70", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "58922BAB908733EB", item: "grindless:uev_smes_cell", type: "item" }]
			title: "The UEV Cell"
			x: 2.0d
			y: 6.0d
		}
		{
			dependencies: ["5304F9E360A95261"]
			description: ["Move your towers onto &6UEV SMES Cells&r and the wireless network carries UEV to every station, out to Alpha Centauri and beyond. Every formed tower holding UEV cells: until then the network stays at UHV. The wireless hatches at UEV, and the gate's load at Sirius B. Add cells when the network dips at your busiest hour."]
			icon: "gtceu:uev_wireless_energy_hatch"
			id: "31927D93FA5DAFEE"
			rewards: [{ id: "704008987819AD6D", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "31934F87266F934B", item: "gtceu:uev_wireless_energy_hatch", type: "item" }
				{ id: "5293AF5A5AA9D0C5", item: "gtceu:uev_wireless_dynamo_hatch", type: "item" }
			]
			title: "The Network Goes UEV"
			x: 4.0d
			y: 6.0d
		}
		{
			dependencies: ["31927D93FA5DAFEE"]
			description: ["The gate to UIV needs 134,217,728 EU/t for sixty seconds, and the bank loses five per cent on the way in. Four Mk4 rings on the polarised fuel and two swarm stations at Alpha Centauri close the sum; the Power tab shows each source."]
			icon: "gtceu:uev_wireless_energy_hatch"
			id: "1EBF66BAEA384B1D"
			rewards: [{ id: "538D1970DC7B2468", type: "xp", xp: 100 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ id: "14BC06235A070553", type: "checkmark" }]
			title: "Sixteen Amps of UEV"
			x: 6.0d
			y: 6.0d
		}
		{
			dependencies: ["19984A527170882C"]
			description: ["The &6Thruster Works&r makes two drives now, the Mk1 and the Mk2. Neither runs a real fusion: they hold a plasma in fiction only, as blocks. The UEV emitter and motor for the antenna, and single-crystal turbine wheels for the Mk2. Level 9 and level 10 rockets. Motors go to ME; the Mk2 wheels come from the single-crystal foundry."]
			icon: "gtceu:thruster_works"
			id: "3DDE5C2C942D2B01"
			rewards: [{ id: "17F86E5D5D05AA88", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "763A2504D1F29F88", item: "gtceu:thruster_works", type: "item" }
				{ id: "11E776CEBBB0B90E", item: "grindless:dfd_mk1_motor", type: "item" }
				{ id: "3F0C85496760FEA4", item: "grindless:dfd_mk2_motor", type: "item" }
			]
			title: "Drives for the Stars"
			x: 2.0d
			y: 10.0d
		}
		{
			dependencies: ["52CC6BA393B05B31"]
			description: ["A &6Warp Gate&r built again in Alpha Centauri orbit seeds an AE2 bridge home, so the collectors' gas and the dust lab's records reach ME without a trip. A second warp gate at station nine, with the first run as its catalyst. The star's output in your network, and the seed Barnard b is fed from. Never carry a stack: let ME move gas home and goods back."]
			icon: "ae2:quantum_ring"
			id: "15FB14436CDEDA0A"
			rewards: [{ id: "70B2707C7C3B0FF4", type: "xp", xp: 100 }]
			tasks: [
				{ id: "1DA228DAE2E623F3", item: "gtceu:warp_gate", type: "item" }
				{ id: "77F590CEE1489A88", type: "checkmark" }
			]
			title: "Alpha Centauri on AE2"
			x: 2.0d
			y: 12.0d
		}
		{
			dependencies: ["545210E1EB9C1D44"]
			description: ["Barnard b has no gate of its own. It is fed from the Alpha Centauri relay by the same mechanism that served Proxima b, and the carbonyl refinery takes carbon monoxide from the HV syngas plant over it."]
			icon: "ae2:quantum_ring"
			id: "17B06D558A6C999C"
			rewards: [{ id: "139DF2F0CE0EC4A4", type: "xp", xp: 100 }]
			tasks: [{ id: "70D8503DE3C6DB46", type: "checkmark" }]
			title: "Barnard b on AE2"
			x: 2.0d
			y: 14.0d
		}
		{
			dependencies: ["31F75527A44532C5"]
			description: ["The tenth station gets its own relay from the Alpha Centauri one. Pellets and samples come home sealed, and the gate's hold is ordered from ME."]
			icon: "ae2:quantum_ring"
			id: "5968A518A75DBA68"
			rewards: [{ id: "148604B9496AB4E9", type: "xp", xp: 100 }]
