				{ id: "3219BEBD3C740DC4", item: "grindless:dfd_mk2_motor", type: "item" }
				{ id: "33E8E3AAAFD40697", item: "grindless:brayton_turbine_wheel", type: "item" }
			]
			title: "Drive Mk2"
			x: 29.5d
			y: 0.0d
		}
		{
			dependencies: ["33D419EAF6FDDE54"]
			description: ["The level 10 flight is one of the gate's tests: one trip to Sirius B on the Mk2 drive, with the pulsar course set."]
			icon: "gtceu:uev_machine_hull"
			id: "35A51182375E77A6"
			rewards: [{ id: "5DEB439F6DA74390", type: "xp", xp: 50 }]
