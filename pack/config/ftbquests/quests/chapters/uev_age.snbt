			title: "Parallel Control"
			x: 23.0d
			y: 7.0d
		}
		{
			dependencies: ["13C93E95696BC875"]
			description: ["The &6UEV SMES Cell&r stores the power of the UEV wireless network. Four UHV SMES cells, sixteen lanthanum superhydride wires, eight plates and liquid helium, made in the Naquadria Magnet Works. The UEV wireless tier. Nothing to feed. Size the towers for your busiest hour."]
			icon: "grindless:uev_smes_cell"
			id: "5304F9E360A95261"
			rewards: [{ id: "13A1AC8E372B9C70", type: "xp", xp: 200 }]
