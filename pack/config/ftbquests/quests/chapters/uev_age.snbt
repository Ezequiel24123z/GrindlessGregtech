			title: "UEV Hatches"
			x: 44.5d
			y: 0.25d
		}
		{
			dependencies: ["572E0C57B385B5AF"]
			description: ["A thin film of lithium niobate bonded onto an insulator makes the &6LNOI Wafer&r, the stage a modulator guides light on. The photonic foundry and a boule from UHV's crystal growth furnace, in the cleanroom. The waveguide circuit next to it, and through it the whole photonic line. Bonding runs in plain machines by ME; keep spare wafers for the foundry."]
			icon: "grindless:lnoi_wafer"
			id: "15B48323A772E536"
			rewards: [{ id: "7C1304AC42D45CB9", type: "xp", xp: 100 }]
