			]
			title: "Several Stars"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["3622F47EE2F048E9"]
			description: ["Most of UEV is built at home. The drives, the stations and the gate all need what the four home lanes make, so the machine tabs come before the rockets."]
			icon: "gtceu:uev_machine_hull"
			id: "74B8B99C87A3BABC"
			rewards: [{ id: "59C141912DC118B6", type: "xp", xp: 25 }]
