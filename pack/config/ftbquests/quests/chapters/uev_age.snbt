			x: 10.0d
			y: 46.0d
		}
		{
			dependencies: ["31927D93FA5DAFEE"]
			description: ["The gate to UIV needs 134,217,728 EU/t for sixty seconds, and the bank loses five per cent on the way in. Four Mk4 rings on the polarised fuel and two swarm stations at Alpha Centauri close the sum; the Power tab shows each source."]
			icon: "gtceu:uev_wireless_energy_hatch"
			id: "1EBF66BAEA384B1D"
