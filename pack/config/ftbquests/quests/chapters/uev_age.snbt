			title: "Level Nine"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["7AAAC4DF44923FD1"]
			description: ["Park in orbit round &6Alpha Centauri&r A and B and build station nine. Every machine of the star lives in that orbit."]
			icon: "gtceu:uev_machine_casing"
