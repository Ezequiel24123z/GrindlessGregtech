			title: "Optical Computer"
			x: 14.5d
			y: 13.5d
		}
		{
			dependencies: ["572E0C57B385B5AF"]
			description: ["Two photons entangled over a distance let a network stay in step. A &6Quantum Repeater Node&r keeps one end of the link. The entanglement station in Earth orbit, an Eu:YSO memory crystal, quantum dots, SNSPDs and hollow-core fibre. The UEV wireless link, and the cell that the quantum repeater keeps in step. Ship the parts to orbit by ME and bring the nodes back; one node is worth a long run."]
			icon: "grindless:quantum_repeater_node"
			id: "7B8852855265F1E3"
			rewards: [{ id: "7C1CF223384BD91B", type: "xp", xp: 180 }]
			shape: "hexagon"
