		}
		{
			dependencies: ["5E1E28A92397EEB5"]
			description: ["Graphene between two films of boron nitride changes how much light passes when a voltage is applied: the &6Graphene Modulator&r. The van der Waals stacker, graphene film and hBN film. The quantum photonic chip. Graphene and boron nitride arrive by ME; send modulators on by ME."]
			icon: "grindless:graphene_modulator"
			id: "5FBB5CC4F79C7D79"
			rewards: [{ id: "7427923C5736E237", type: "xp", xp: 120 }]
