	quests: [
		{
			dependencies: ["7C44999E6D4544D4"]
			description: [
				"The &6Stellar Neighbourhood Chart&r is the research for the &6UEV Machine Casing&r line, and two casings are the body of the &6UEV Machine Hull&r. The hull also takes three UEV sensors and three UEV circuits, so the parts and the optical computer come first. One star is not enough now: three more are within reach of a drive."
				"Home first: isotopes, pressure, light and a new fusion reactor. Then Alpha Centauri and Barnard b, and last a white dwarf."
			]
			icon: "gtceu:uev_machine_hull"
			id: "3622F47EE2F048E9"
			rewards: [{ id: "5489B15441E6373D", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "32C357A599766D1C", type: "checkmark" }]
			title: "Several Stars"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["3622F47EE2F048E9"]
			description: ["Most of UEV is built at home. The drives, the stations and the gate all need what the four home lanes make, so build those machines before the rockets."]
			icon: "gtceu:uev_machine_hull"
			id: "74B8B99C87A3BABC"
			rewards: [{ id: "59C141912DC118B6", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "173D4D8D8A2B6097", type: "checkmark" }]
			title: "Home First"
			x: 1.5d
			y: 0.0d
		}
		{
			dependencies: ["74B8B99C87A3BABC"]
			description: ["Calcium-48 and an actinide target make atoms heavier than anything in nature. They live for seconds, so the chemistry is built around speed. The Superheavy Census closes the lane."]
			icon: "gtceu:calutron"
			id: "5C3658D111B1DA98"
			rewards: [{ id: "1F9DE55910CD3757", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "3D84DA65CF753F02", type: "checkmark" }]
			title: "The Heaviest Atoms"
			x: 2.25d
			y: -6.0d
		}
		{
			dependencies: ["74B8B99C87A3BABC"]
			description: ["Pressure and clean melting give diamond harder than any mined, ceramic fibres with no seam and the coil for the next fusion reactor."]
			icon: "gtceu:megabar_press"
			id: "17700FA46A322203"
			rewards: [{ id: "5C1729B30EC30785", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "191180B75250D74D", type: "checkmark" }]
			title: "A Megabar"
			x: 4.25d
			y: -5.0d
		}
		{
			dependencies: ["74B8B99C87A3BABC"]
			description: ["Single-photon detectors, stacked graphene and a chip made of waveguides lead to the first computer that thinks in light."]
			icon: "gtceu:photonic_integration_hall"
			id: "1D5911D8136A07FF"
			rewards: [{ id: "7ACDAB3DD3C7531F", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "33630CF84B9265FC", type: "checkmark" }]
			title: "One Photon at a Time"
			x: 4.0d
			y: -3.25d
		}
		{
			dependencies: ["74B8B99C87A3BABC"]
			description: ["The Mk4 ring burns helium-3 aligned by a laser, and a direct converter turns its plasma into current. It is the power the gate asks for."]
			icon: "gtceu:uev_fusion_reactor"
			id: "7BF609F908839C42"
			rewards: [{ id: "1D566F43DA4E80DA", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "18B6662E5C1EA6FA", type: "checkmark" }]
			title: "A Hotter Ring"
			x: 5.25d
			y: -1.5d
		}
		{
			dependencies: ["3E4117575EE79C34", "3DDE5C2C942D2B01"]
			description: ["The &6Direct Fusion Drive Mk1&r is made at home in the Thruster Works from Wf/W tiles, SiC/SiC plates, HfTaCN ingots, D-He3 fuel mix and a UEV emitter for its antenna. It carries a level 9 rocket to the next star and needs nothing from abroad."]
			icon: "grindless:dfd_mk1_motor"
			id: "19984A527170882C"
			rewards: [{ id: "3A0BD71AD4745BC1", type: "xp", xp: 150 }]
			tasks: [{ id: "164A7B407A68EB8E", item: "grindless:dfd_mk1_motor", type: "item" }]
			title: "Drive Mk1"
			x: 20.25d
			y: 0.0d
		}
		{
			dependencies: ["19984A527170882C"]
			description: ["A level 9 rocket is the first that crosses between stars. The trip takes four light years of fuel, so load the tanks from ME and check the guidance before launch."]
			icon: "gtceu:uev_machine_hull"
			id: "7AAAC4DF44923FD1"
			rewards: [{ id: "169327862C5782D8", type: "xp", xp: 50 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "361531248F140E58", type: "checkmark" }]
			title: "Level Nine"
			x: 21.5d
			y: 0.0d
		}
		{
			dependencies: ["7AAAC4DF44923FD1"]
			description: ["Park in orbit round &6Alpha Centauri&r A and B and build station nine. The nebula collector and the pulsar timing survey need that orbit."]
			icon: "gtceu:uev_machine_casing"
			id: "52CC6BA393B05B31"
			rewards: [{ id: "1368A7C1A248EE7F", type: "xp", xp: 200 }]
			tasks: [{ dimension: "grindless:alpha_centauri_orbit", id: "596199995B625AE1", type: "dimension" }]
			title: "First Light of Another Star"
			x: 22.25d
			y: -2.75d
		}
		{
			dependencies: ["52CC6BA393B05B31"]
			description: ["A and B circle each other, and a dim third star trails far behind. The swarm here collects from A."]
			icon: "minecraft:sunflower"
			id: "5C4445A8F7BFB013"
			rewards: [{ id: "5BE5C04DE1883099", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "76E457B6617A3610", type: "checkmark" }]
			title: "Two Suns"
			x: 23.25d
			y: -5.75d
		}
		{
			dependencies: ["52CC6BA393B05B31"]
			description: ["The orbit holds gas and dust between the stars. The collector works the gas and the dust lab studies the grains. Real interstellar gas is a few atoms in a cubic metre; the yield here is a game number."]
			icon: "gtceu:nebula_collector"
			id: "5FB0F9524805A6FD"
			rewards: [{ id: "550724CB38758170", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "5E8C9C04DB42D9BB", type: "checkmark" }]
			title: "Thin Gas, Old Dust"
			x: 24.5d
			y: -2.25d
		}
		{
			dependencies: ["5FB0F9524805A6FD", "530544BFDCF5D75E"]
			description: ["Pulsars tick like clocks, and three of them fix your place. The Pulsar Timing Station turns its timing data and the dust lab's iron-60 record into the &6Pulsar Navigation Chart&r. The chart gives the course to the white dwarf, is a catalyst of the gate's first holds at Sirius B, and is the research for the UIV casing line."]
			icon: "grindless:pulsar_navigation_chart"
			id: "7F279D6558D52119"
			rewards: [{ id: "51C66F49CDED7277", type: "xp", xp: 150 }]
			tasks: [{ id: "5CCBD9D62FD74164", item: "grindless:pulsar_navigation_chart", type: "item" }]
			title: "The Course to Sirius"
			x: 28.25d
			y: -1.75d
		}
		{
			dependencies: ["7AAAC4DF44923FD1"]
			description: ["Barnard's Star is a cold red dwarf with an iron planet. Land on &6Barnard b&r and sink the &6Barnard Core Drill&r for a core rock."]
			icon: "gtceu:barnard_core_drill"
			id: "545210E1EB9C1D44"
			rewards: [{ id: "7CC8062069519C75", type: "xp", xp: 200 }]
			tasks: [
				{ dimension: "grindless:barnard_b", id: "761849ACF4380E52", type: "dimension" }
				{ id: "39696BAF530DC5A7", item: "gtceu:barnard_core_drill", type: "item" }
			]
			title: "Barnard b"
			x: 22.5d
			y: 1.75d
		}
		{
			dependencies: ["545210E1EB9C1D44"]
			description: ["The planet's year is days long and its star flares. Build the base under shielding, and keep the machines that fear heat on the night side."]
			icon: "minecraft:red_dye"
			id: "793D8D0659A39F99"
			rewards: [{ id: "72B7FC4D25A18C20", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "33CB88BD4D68F333", type: "checkmark" }]
			title: "A Cold Red Light"
			x: 33.0d
			y: 2.25d
		}
		{
			dependencies: ["545210E1EB9C1D44"]
			description: ["Barnard b is mostly iron, with nickel, cobalt and a rhenium-rich residue. The &6Barnard Core Rock&r is what the carbonyl route starts from. The platinum plant at home turns the residue into a crude rhenium salt, and the rhenium rows run here for the Mk2 drive."]
			icon: "grindless:barnard_core_rock"
			id: "7B9833873D5CD02A"
			rewards: [{ id: "79244E1C84435DBF", type: "xp", xp: 150 }]
			tasks: [{ id: "3259718EC12A366A", item: "grindless:barnard_core_rock", type: "item" }]
			title: "An Iron World"
			x: 24.5d
			y: 1.25d
		}
		{
			dependencies: ["7F279D6558D52119", "7B9833873D5CD02A", "3A453C8950865687", "35189CD5902AFFE4"]
			description: ["The Mk2 drive is a Mk1 motor with a UEV motor, eight bonded iron nitride magnets and a Brayton turbine wheel cast as single crystals. It is the drive for a level 10 rocket."]
			icon: "grindless:dfd_mk2_motor"
			id: "33D419EAF6FDDE54"
			rewards: [{ id: "16180A88574D2695", type: "xp", xp: 250 }]
