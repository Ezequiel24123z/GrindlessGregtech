				{ id: "763A2504D1F29F88", item: "gtceu:thruster_works", type: "item" }
				{ id: "11E776CEBBB0B90E", item: "grindless:dfd_mk1_motor", type: "item" }
				{ id: "3F0C85496760FEA4", item: "grindless:dfd_mk2_motor", type: "item" }
