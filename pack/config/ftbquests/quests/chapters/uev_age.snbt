			y: -2.0d
		}
		{
			dependencies: ["74B8B99C87A3BABC"]
			description: ["Single-photon detectors, stacked graphene and a chip made of waveguides lead to the first computer that thinks in light."]
			icon: "gtceu:photonic_integration_hall"
			id: "1D5911D8136A07FF"
