			]
			title: "Quantum Dot Wafer"
			x: 6.5d
			y: 13.5d
		}
		{
			dependencies: ["750B64193AFA4A16"]
			description: ["A tungsten silicide nanowire cooled to near zero fires when a single photon lands on it: the &6SNSPD&r. The SNSPD foundry, a WSi wafer and superfluid helium to cool and package it. The quantum photonic chip, and the entanglement station's repeater. Helium by pipe; stock packaged detectors by ME, one per chip and one per repeater."]
			icon: "grindless:snspd"
			id: "5C32C3BBED862564"
			rewards: [{ id: "3924A8FEC52A2DE1", type: "xp", xp: 120 }]
