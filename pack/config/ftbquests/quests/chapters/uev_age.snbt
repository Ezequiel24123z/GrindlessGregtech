			tasks: [{ id: "3BD13B6D0D20912D", item: "grindless:annealed_sin_chip", type: "item" }]
			title: "Silicon Nitride Chip"
			x: 7.75d
			y: 4.5d
		}
		{
			dependencies: ["15B48323A772E536", "1AC90115EC98790D"]
			description: ["An SiN Waveguide Chip bonded to an LNOI wafer is a &6Waveguide Circuit&r: light goes in, is steered and switched, and comes out. The Photonic Integration Hall, one SiN Waveguide Chip, one LNOI wafer and a circuit 1 program. The quantum photonic chip, which puts sources and detectors on it. One chip and one wafer per circuit: stock both by ME and send circuits on."]
			icon: "grindless:waveguide_circuit"
			id: "1EB339EC7EEE0427"
			rewards: [{ id: "16AF97B8E6AAC7D6", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5B3AB2F3F89B7D6D", item: "grindless:waveguide_circuit", type: "item" }]
			title: "Waveguide Circuit"
			x: 18.0d
			y: 8.5d
		}
		{
			dependencies: ["572E0C57B385B5AF"]
			description: ["Indium arsenide islands a few nanometres wide emit one photon at a time. The &6InAs Quantum Dot Wafer&r is where the chip's source comes from. UHV's MBE reactor, indium and arsenic, which is contained. The quantum dot source, mounted and ready for the chip. Contain the arsenic loop; keep wafers by ME and cut one source per chip."]
			icon: "grindless:inas_qd_wafer"
			id: "750B64193AFA4A16"
			rewards: [{ id: "3900C32593C9D1D1", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "366A4786CBE12BCD", item: "grindless:inas_qd_wafer", type: "item" }
				{ id: "5F1EF17AF02D692C", item: "grindless:qd_source", type: "item" }
			]
			title: "Quantum Dot Wafer"
			x: 8.25d
			y: 7.0d
		}
		{
			dependencies: ["1DCFFEC97F5A28AF"]
			description: ["A tungsten silicide nanowire cooled to near zero fires when a single photon lands on it: the &6SNSPD&r. The SNSPD Foundry, a WSi wafer and superfluid helium to cool and package it. The quantum photonic chip, and the entanglement station's repeater. Helium by pipe; stock packaged detectors by ME, one per chip and one per repeater."]
			icon: "grindless:snspd"
			id: "5C32C3BBED862564"
			rewards: [{ id: "3924A8FEC52A2DE1", type: "xp", xp: 120 }]
