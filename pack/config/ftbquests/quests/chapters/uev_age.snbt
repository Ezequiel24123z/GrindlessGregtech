			tasks: [{ id: "58922BAB908733EB", item: "grindless:uev_smes_cell", type: "item" }]
			title: "The UEV Cell"
			x: 8.0d
			y: 46.0d
		}
		{
			dependencies: ["5304F9E360A95261"]
			description: ["Move your towers onto &6UEV SMES Cells&r and the wireless network carries UEV to every station, out to Alpha Centauri and beyond. Every formed tower holding UEV cells: until then the network stays at UHV. The wireless hatches at UEV, and the gate's load at Sirius B. Add cells when the network dips at your busiest hour."]
			icon: "gtceu:uev_wireless_energy_hatch"
			id: "31927D93FA5DAFEE"
			rewards: [{ id: "704008987819AD6D", type: "xp", xp: 200 }]
