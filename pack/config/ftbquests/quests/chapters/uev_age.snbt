		}
		{
			dependencies: ["1EB339EC7EEE0427", "5C32C3BBED862564", "5FBB5CC4F79C7D79"]
			description: ["A waveguide circuit with a quantum dot source, a detector, a modulator and an emitter on it is the &6Quantum Photonic Chip&r: a whole optical circuit on a few millimetres. The photonic integration hall, a circuit 2 program and one of each part above. The optical computer, which is a chip on an optical assembly. Parts by ME in matched counts; keep a few chips in stock, one per computer."]
			icon: "grindless:quantum_photonic_chip"
			id: "5F27E2F032F8C5FD"
			rewards: [{ id: "30DD83A335FE115E", type: "xp", xp: 180 }]
