		}
		{
			dependencies: ["74B8B99C87A3BABC"]
			description: ["The Mk4 ring burns helium-3 aligned by a laser, and a direct converter turns its plasma into current. It is the power the gate asks for."]
			icon: "gtceu:uev_fusion_reactor"
			id: "7BF609F908839C42"
