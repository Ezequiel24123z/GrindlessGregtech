			size: 1.0d
			tasks: [{ id: "56CDF5C67EF904BE", item: "grindless:lnoi_wafer", type: "item" }]
			title: "Lithium Niobate on Insulator"
			x: 8.0d
			y: 8.75d
		}
		{
			dependencies: ["572E0C57B385B5AF"]
			description: ["Light travels in silicon nitride with almost no loss. An annealed &6SiN Waveguide Chip&r carries the waveguides cut into it. The photonic foundry, a damascene SiN wafer and the cleanroom. The waveguide circuit, which joins it to the LNOI wafer. The anneal is slow, so run two foundries; keep chips in a stocked chest by ME."]
			icon: "grindless:annealed_sin_chip"
			id: "3C3FC8DE94FAC5EE"
			rewards: [{ id: "5F86BE3492E5476D", type: "xp", xp: 100 }]
