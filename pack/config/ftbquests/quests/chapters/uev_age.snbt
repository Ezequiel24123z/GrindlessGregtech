			title: "Sixteen Amps of UEV"
			x: 12.0d
			y: 46.0d
		}
		{
			dependencies: ["1F193E617E35A100"]
			description: ["The &6Thruster Works&r makes two drives now, the Mk1 and the Mk2. Neither runs a real fusion: they hold a plasma in fiction only, as blocks. The UEV emitter and motor for the antenna, and single-crystal turbine wheels for the Mk2. Level 9 and level 10 rockets. Motors go to ME; the Mk2 wheels come from the single-crystal foundry."]
			icon: "gtceu:thruster_works"
			id: "3DDE5C2C942D2B01"
			rewards: [{ id: "17F86E5D5D05AA88", type: "xp", xp: 150 }]
