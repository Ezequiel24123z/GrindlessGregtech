				{ id: "1A0383529BE50FF9", item: "gtceu:uev_electric_motor", type: "item" }
			]
			title: "UEV Parts"
			x: 19.0d
			y: 0.75d
		}
		{
			dependencies: ["129CFFFDA25F22DC", "7674F530D0218D45"]
			description: ["The &6UEV Field Generator&r holds the plasma and the gate's fields. It is the first part that needs a degenerate pellet. A UHV field generator, two degenerate pellets, two single-crystal pump impellers, three UEV emitters and three UEV sensors. The UEV Energy Hatch, the Stellar Forge and the Mk4 fusion reactor. Pellets and impellers by ME; stock a few, since the hatch takes three."]
			hide_dependency_lines: true
			icon: "gtceu:uev_field_generator"
			id: "5F644828F712C60C"
			rewards: [{ id: "16297E127277B204", type: "xp", xp: 120 }]
			tasks: [{ id: "548BBC16C1A6195A", item: "gtceu:uev_field_generator", type: "item" }]
			title: "UEV Field Generator"
			x: 42.25d
			y: 0.75d
		}
		{
			dependencies: ["3E4117575EE79C34", "12A3828ECE0C81B8"]
			description: ["The &6UEV Machine Hull&r is the body of every UEV machine and hatch. Its assembly line is researched with the UEV Machine Casing. Two UEV Machine Casings, three lanthanum superhydride single cables, six SiC/SiC plates, three Faraday isolators, three ULE cavities, three UEV sensors and three UEV circuits of any kind. The UEV Circuit Assembler, the UEV hatches and every machine built on a UEV hull. Casings and parts by ME; hulls are made one at a time, so keep a chest of them."]
			icon: "gtceu:uev_machine_hull"
			id: "19174331BF47A9B1"
			rewards: [{ id: "5247867DE116494E", type: "xp", xp: 150 }]
			tasks: [{ id: "5BE55A1E6185E663", item: "gtceu:uev_machine_hull", type: "item" }]
			title: "UEV Machine Hull"
			x: 22.25d
			y: 8.25d
		}
		{
			dependencies: ["5F644828F712C60C"]
			description: ["The &6UEV Energy Hatch&r is an assembly line recipe on the UEV hull: it feeds a UEV machine its power. A UEV Machine Hull, three lanthanum superhydride cables, three Faraday isolators, an ULE cavity, three UV voltage coils, three UEV field generators and three UEV circuits of any kind. Every UEV machine that takes power from a hatch, and the wireless hatch. Craft a few by ME; each machine takes one."]
			icon: "gtceu:uev_energy_input_hatch"
			id: "58C1564694482EBE"
			rewards: [{ id: "534BE26FD27D8060", type: "xp", xp: 100 }]
