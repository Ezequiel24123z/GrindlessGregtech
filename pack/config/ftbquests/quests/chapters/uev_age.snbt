		{
			dependencies: ["37BBAC4FC45216FC"]
			description: ["A &6Warp Gate&r built again in Alpha Centauri orbit seeds an AE2 bridge home, so the collectors' gas and the dust lab's records reach ME without a trip. A second Warp Gate at station nine, built the way the first one was. The star's output in your network, and the seed Barnard b is fed from. Never carry a stack: let ME move gas home and goods back."]
			icon: "ae2:quantum_ring"
			id: "15FB14436CDEDA0A"
			rewards: [{ id: "70B2707C7C3B0FF4", type: "xp", xp: 100 }]
