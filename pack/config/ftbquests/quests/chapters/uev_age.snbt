		{
			dependencies: ["52CC6BA393B05B31"]
			description: ["The orbit holds gas and dust between the stars, and the collectors and the dust lab work it. Real interstellar gas is a few atoms in a cubic metre; the yield here is a game number."]
			icon: "gtceu:nebula_collector"
			id: "5FB0F9524805A6FD"
