			title: "Single-Photon Detector"
			x: 4.0d
			y: 5.0d
		}
		{
			dependencies: ["3622F47EE2F048E9"]
			description: ["A defect in a layer of hexagonal boron nitride gives off photons one by one: the &6hBN Emitter Chip&r. The van der Waals stacker, CVD boron nitride film and a cleanroom. The quantum photonic chip, as its second light source. Film by ME; the stacker returns chips in a chest, stock a few."]
			icon: "grindless:hbn_emitter_chip"
			id: "5E1E28A92397EEB5"
			rewards: [{ id: "5FA6892CEA21E7EE", type: "xp", xp: 120 }]
