		{
			dependencies: ["7547756221DFC688"]
			description: ["A &6Lithium Niobate Wafer&r is cut from a boule pulled out of a melt. It bends light with an electric field, so a chip can modulate a beam. A boule from the crystal growth furnace, and a cleanroom to cut and polish it. The thin-film wafer next to it, and through it the optical processor. The crucible is reused; keep boules and cut wafers in a stocked chest by ME."]
			icon: "grindless:lithium_niobate_wafer"
			id: "5EEE3C1532815682"
			rewards: [{ id: "302C197B378C3009", type: "xp", xp: 100 }]
