			title: "Lithium Niobate Wafer"
			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["5EEE3C1532815682"]
			description: ["Bond a thin lithium niobate film onto an insulating layer and you have the &6LNOI&r wafer, the stage light is guided on. A lithium niobate wafer, silicon nitride film and the cleanroom. The optical processor, which is cut from it. Bonding runs in plain machines by ME; keep spare wafers for the foundry."]
			icon: "grindless:ln_on_insulator_plus"
			id: "337220D20FD9CC58"
			rewards: [{ id: "1B142E48CA1A15CB", type: "xp", xp: 120 }]
