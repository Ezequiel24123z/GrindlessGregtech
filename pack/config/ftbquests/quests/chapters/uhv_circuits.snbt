			title: "Indium Phosphide Wafer"
			x: 2.0d
			y: 3.0d
		}
		{
			dependencies: ["5432C6DC48ECC9A5"]
			description: ["An electron falls down a staircase of thin layers and gives up a photon at every step. The &6Quantum Cascade Laser&r is hundreds of those layers on InP. The MBE reactor, an InP wafer and arsenic, which is contained. The optical processor, and the sensors of the astrometer and the swarm. Contain the arsenic loop; stock lasers by ME."]
			icon: "grindless:quantum_cascade_laser"
			id: "34795C9D86BC364D"
			rewards: [{ id: "1C75B01990D303EC", type: "xp", xp: 120 }]
			shape: "hexagon"
