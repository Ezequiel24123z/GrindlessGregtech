			tasks: [{ id: "1D84C000676A5624", item: "grindless:eu_yso_boule", type: "item" }]
			title: "Europium-Doped Crystal"
			x: 2.0d
			y: 4.5d
		}
		{
			dependencies: ["7CE22CED63CCF1E9"]
			description: ["A slab cut from the boule and patterned in the photonic foundry becomes a &6Quantum Memory Chip&r that holds light as an excitation. An Eu:YSO boule and the photonic foundry. The optical processor. One boule cuts several slabs; send chips on by ME."]
			icon: "grindless:quantum_memory_chip"
