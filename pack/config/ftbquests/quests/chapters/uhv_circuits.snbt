			tasks: [{ id: "3446A88116833B67", item: "grindless:pcm_photonic_die", type: "item" }]
			title: "Phase-Change Die"
			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["1EBB75CF8CF72E85", "34795C9D86BC364D", "7DB98960A4C2D2E8"]
			description: ["A processor that thinks in light and runs cold: the &6Optical Processor&r is the circuit that comes after the wetware computer. An LNOI wafer, phase-change dies, a quantum cascade laser, a memory chip and a UHV circuit, all in the photonic foundry. The optical assembly and, through it, the mainframes of the organoid array. Foundry inputs by ME; processors go into their own chest, one stack per assembly."]
			icon: "gtnn:optical_processor"
			id: "74E5CDD1317012FB"
			rewards: [{ id: "3E4D2C78AEF40DD6", type: "xp", xp: 180 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "1CA603022AD58C0D", item: "gtnn:optical_processor", type: "item" }]
			title: "Optical Processor"
			x: 10.0d
			y: 1.5d
		}
		{
			dependencies: ["74E5CDD1317012FB"]
			description: ["Optical processors on an optical board with capacitors and diodes make the &6Optical Assembly&r, the largest circuit this era builds. Optical processors, the UHV circuit assembler and optical SMD parts. The wetware mainframe, whose recipe in the organoid array asks for one. One assembly per mainframe batch: keep a small stock by ME and never more."]
			icon: "gtnn:optical_assembly"
			id: "18F76220739031F7"
			rewards: [{ id: "7E16A892A92D78E3", type: "xp", xp: 200 }]
