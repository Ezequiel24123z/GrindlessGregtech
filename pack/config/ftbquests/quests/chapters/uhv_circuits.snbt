			title: "Lithium Niobate on Insulator"
			x: 4.0d
			y: 1.5d
		}
		{
			dependencies: ["337220D20FD9CC58"]
			description: ["A chalcogenide film flips between glass and crystal when a laser says so, and the &6Photonic Die&r keeps a bit of light in that state. The photonic foundry, an LNOI wafer and the phase-change film. The optical processor and the memory node of the photonic line. The foundry fills a stack of dies per wafer; send them on by ME."]
			icon: "grindless:pcm_photonic_die"
			id: "1EBB75CF8CF72E85"
			rewards: [{ id: "57D123494496A216", type: "xp", xp: 120 }]
