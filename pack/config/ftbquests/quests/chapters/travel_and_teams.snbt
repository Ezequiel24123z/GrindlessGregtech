			title: "Claim Your Base"
			x: 5.0d
			y: 1.5d
		}
		{
			dependencies: ["163B6BC04C86A82F"]
			description: ["Hold Shift while you drag over claimed chunks in the same screen to force-load them, and the factory keeps running while you are elsewhere - up to 25 chunks a player by default. It works while someone from the team is online; running with everyone offline is a server setting."]
			icon: "minecraft:compass"
			id: "519566BBE2C4D41C"
