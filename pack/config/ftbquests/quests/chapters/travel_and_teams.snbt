		}
		{
			dependencies: ["12AEF6D64403D824"]
			description: ["Amethyst, an emerald and the ender pearls your creature simulator prints. The &6Warp Stone&r is the heart of every waystone - and on its own it is a pocket teleporter to any waystone you know, with a short cooldown."]
			icon: "waystones:warp_stone"
