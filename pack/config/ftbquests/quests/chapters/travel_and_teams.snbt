			y: 1.5d
		}
		{
			dependencies: ["12AEF6D64403D824"]
			description: ["&6/sethome&r marks a spot and &6/home&r brings you back to it from anywhere, other dimensions included. &6/back&r returns you to where you last teleported or died, and &6/spawn&r to the world spawn. One home by default - waystones cover the rest."]
			icon: "minecraft:red_bed"
