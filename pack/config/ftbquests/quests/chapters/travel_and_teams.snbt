		}
		{
			dependencies: ["6C51B805476EAF2E"]
			description: ["From the Moon on, the first landing on each world is by rocket, as the era chapters tell. Once you have been, place a waystone: from then on the trip home is one click."]
			icon: "waystones:warp_stone"
			id: "6E7F12273752EC74"
