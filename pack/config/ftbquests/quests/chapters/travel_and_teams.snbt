		{
			dependencies: ["6C51B805476EAF2E"]
			description: ["Two &6Warp Plates&r linked by an attuned shard send whoever stands on one to the other, on this planet or another."]
			icon: "waystones:warp_plate"
			id: "42D5B9B7A746FDCA"
