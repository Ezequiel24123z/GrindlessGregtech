		}
		{
			dependencies: ["4F6670F0CBAD4003"]
			description: ["In the &6FTB Chunks&r claim screen, reached from its map, drag with the left button to claim chunks and with the right button to unclaim them. Claimed chunks are safe from other players, explosions and mob griefing, and your allies can still build there."]
			icon: "minecraft:filled_map"
			id: "163B6BC04C86A82F"
			rewards: [{ id: "2D014075731A6F64", type: "xp", xp: 10 }]
