			x: 7.5d
			y: -1.5d
		}
		{
			dependencies: ["12AEF6D64403D824"]
			description: ["Playing with friends? &6/ftbteams party create <name>&r makes a party and &6/ftbteams party invite <player>&r brings the others in. Quest progress, chunk claims and force-loaded chunks all belong to the team."]
			icon: "minecraft:player_head"
