				{ count: 16L, id: "108C6CDDD90C502E", item: "ae2:quantum_ring", type: "item" }
			]
			title: "Earth-Mars Bridge"
			x: 8.0d
			y: -6.0d
		}
		{
			dependencies: ["53893FAB153254B8"]
			description: ["The &6Atmosphere Processor&r breathes Martian air, splits water and joins the hydrogen to the carbon dioxide: three machines in one, and it only runs on Mars. Water sent from home and a ruthenium catalyst. Save the Martian ice for IV. Circuit 1 makes methane and oxygen; circuit 2 only collects carbon dioxide. Water over the bridge, products home by ME."]
			icon: "gtceu:atmosphere_processor"
			id: "58BBEC58FB5953BD"
			rewards: [
				{ id: "7A0B13C332E8056B", type: "xp", xp: 80 }
				{ id: "7CFB02E1A78ECD9E", item: "grindless:ruthenium_catalyst", type: "item" }
			]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "78097613D42E5A43", item: "gtceu:atmosphere_processor", type: "item" }]
			title: "Atmosphere Processor"
			x: 10.0d
			y: -6.0d
		}
		{
			dependencies: ["58BBEC58FB5953BD"]
			description: [
				"Methane and oxygen from the EV mixer make &6Methalox&r, a fuel that brings its own oxygen, so it burns in any gas turbine on Mars or the Moon."
				"It costs more energy to make than it gives back, so treat it as a battery, not a power plant."
			]
			icon: "gtceu:methalox_bucket"
			id: "76CC753087EAD9F0"
			rewards: [{ id: "59C404F9D1D26FD8", type: "xp", xp: 45 }]
			tasks: [{ id: "1C4C427019CC4B41", item: "gtceu:methalox_bucket", type: "item" }]
			title: "Methalox"
			x: 12.0d
			y: -6.0d
		}
		{
			dependencies: ["56FFD4EF98A6C3B8"]
			description: ["Merrillite is a phosphate, and no electrolyzer will split it. The &6Extraction Cascade&r leaches it in hydrochloric acid and then pulls the rare earths apart with kerosene, one stage at a time. Merrillite dust, hydrochloric acid and kerosene. Samarium, neodymium and mixed rare-earth chlorides. Circuit 1 leaches, circuit 2 extracts. Each fluid needs its own output hatch, or the whole cascade stops."]
			icon: "gtceu:extraction_cascade"
			id: "3FCCD81DE98DA9EF"
			rewards: [{ id: "5F47032EACBE0A7F", type: "xp", xp: 80 }]
			shape: "gear"
			size: 1.25d
