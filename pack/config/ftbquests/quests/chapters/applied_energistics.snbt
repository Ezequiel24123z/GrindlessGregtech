				{ id: "1CA5B1C8F56FD437", item: "ae2:energy_cell", optional_task: true, type: "item" }
			]
			title: "Powering the Network"
			x: 2.0d
			y: -4.5d
		}
		{
			dependencies: ["6877CAA8988871F0"]
			description: [
				"&6Applied Flux&r stores Forge Energy in cells and moves it around the network. The Flux Accessor is the plug, and an induction card in an interface charges whatever sits next to it. It stores power; it doesn't make any."
			]
			icon: "appflux:flux_accessor"
			id: "52F7C6CE45331142"
			rewards: [{ id: "698433B7003B4138", type: "xp", xp: 20 }]
