			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["4C1866021512C936"]
			description: [
				"An &6ME Output Bus&r or hatch sends a multiblock's products straight into the network, and an &6ME Input Bus&r or hatch pulls in whatever you configure."
				"They're built on EV buses and hatches, and they work on the Moon too: that's how the tripod's ilmenite gets home."
			]
			icon: "gtceu:me_output_bus"
