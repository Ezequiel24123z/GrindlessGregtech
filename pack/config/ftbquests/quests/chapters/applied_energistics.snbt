		{
			dependencies: ["09539172C5EF719B"]
			description: [
				"The network you built in LV already stores and crafts. From here it learns to talk to GregTech machines and picks up the addons worth having."
				"Hold &6G&r over any AE2 item to open its guide page."
			]
			icon: "ae2:controller"
