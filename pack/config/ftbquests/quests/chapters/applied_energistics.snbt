			]
			title: "Applied Flux"
			x: 4.0d
			y: -6.0d
		}
		{
			dependencies: ["38EE187ED07F2279"]
			description: [
				"Tell the &6ME Requester&r what to keep in stock, and it orders a craft whenever the stock drops below that. Cables, plates and circuits stay topped up while you do something more interesting."
				"The Requester Terminal shows them all on one screen."
			]
			icon: "merequester:requester"
			id: "52EAD94C16BCAE98"
			optional: true
			rewards: [{ id: "4D71C3D1DC422EE0", type: "xp", xp: 15 }]
