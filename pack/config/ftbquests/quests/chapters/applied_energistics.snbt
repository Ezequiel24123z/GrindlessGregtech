			x: 2.0d
			y: -3.0d
		}
		{
			dependencies: ["38EE187ED07F2279"]
			description: [
				"GregTech machines pick recipes by programmed circuit, which used to mean one machine per setting. Put a &6Programmed Circuit Card&r in a pattern provider and the circuit travels with the pattern, so one assembler can handle every setting the network asks for."
			]
			icon: "pccard:card_programmed_circuit"
			id: "4C1866021512C936"
			rewards: [{ id: "3F9C6D0F5762B5C7", type: "xp", xp: 15 }]
