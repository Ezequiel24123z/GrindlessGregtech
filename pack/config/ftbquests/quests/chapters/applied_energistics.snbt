			title: "Applied Energistics 2"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["38EE187ED07F2279"]
			description: [
				"AE2 runs on Forge Energy and your factory makes EU, but they get along fine: GregTech cable plugged straight into the &6Energy Acceptor&r powers the network. No converter, no soft mallet."
				"An energy cell carries the network through a short blackout."
			]
			icon: "ae2:energy_acceptor"
			id: "6877CAA8988871F0"
			rewards: [{ id: "130A91E682AF3BF3", type: "xp", xp: 15 }]
