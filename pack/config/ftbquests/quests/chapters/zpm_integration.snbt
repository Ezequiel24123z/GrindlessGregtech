			title: "Saturn on the Network"
			x: 2.0d
			y: 6.0d
		}
		{
			dependencies: ["790FB7432F6FAD9B"]
			description: ["Same again at Uranus orbit. Chunk-load both stations, because the far machines only run while their chunks are loaded."]
			icon: "grindless:station_truss_casing"
