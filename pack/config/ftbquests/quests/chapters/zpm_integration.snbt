	quests: [
		{
			dependencies: ["7B0EFFD4E295AFAD"]
			description: ["Fuel only gets worth burning once the Mk2 has excited it with radon. That's a big start for a small amount, so in practice the Mk2 comes before the reactor."]
			icon: "gtceu:radon_bucket"
			id: "5331DFDEAD7A36A2"
			rewards: [{ id: "5D6F6C796DAB4E2C", type: "xp", xp: 30 }]
			size: 0.75d
			tasks: [{ id: "1354C757B5C50938", type: "checkmark" }]
			title: "Excited"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["5331DFDEAD7A36A2"]
			description: ["GT--'s &6Large Naquadah Reactor&r burns excited fuel and is the era's main plant. Duranium frames are part of its price. Excited fuel from the Mk2, and a fuel works ready to take the spent fuel back. Power on a scale ZPM's machines expect, with a fuel loop that never leaves the base. Pipe spent fuel straight back to the fuel works and let ME top up the radon."]
			icon: "gtnn:large_naquadah_reactor"
			id: "54B43A225E11111F"
			rewards: [{ id: "36B2389775956097", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.5d
			tasks: [
				{ id: "1900BFBD83C15B01", item: "gtnn:large_naquadah_reactor", type: "item" }
				{ id: "3349030F79E58618", item: "gtceu:duranium_frame", type: "item" }
			]
			title: "The Big Reactor"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["54B43A225E11111F"]
			description: ["A &6ZPM SMES cell&r and a wireless hatch put another tier on the network. Sunlight is a rumour at Saturn, so everything out there draws from it. The cold room that winds the wire, and a reactor worth storing. Stations at Saturn and Uranus that run on power made at home. Nothing to feed: size the cells for your busiest hour and add more when it dips."]
			icon: "grindless:zpm_smes_cell"
			id: "57720D544EAFA2F9"
			rewards: [{ id: "3BD20C011F89364F", type: "xp", xp: 100 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [
				{ id: "1B058F6328DC468F", item: "grindless:zpm_smes_cell", type: "item" }
				{ id: "3CD3FF55887D41DB", item: "gtceu:zpm_wireless_energy_hatch", type: "item" }
			]
			title: "The Network Goes ZPM"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["57720D544EAFA2F9"]
			description: ["The &6Fusion Reactor Mk2&r makes duranium, excites fuel and runs the aneutronic burn. Its start is huge, so give it plenty of ZPM hatches. Four ZPM energy hatches on the network, and gallium and radon for the first batches. Duranium, excited fuel, and the metals UV asks for early. Feed it from tanks by pipe, and keep the hatches topped from the network."]
			icon: "gtceu:zpm_fusion_reactor"
			id: "38199670D4113E48"
			rewards: [{ id: "1014D26A05E4BDFE", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.5d
			tasks: [
				{ id: "7DACEF768CD1D437", item: "gtceu:zpm_fusion_reactor", type: "item" }
				{ count: 4L, id: "3FEBA19E1E2F33E5", item: "gtceu:zpm_energy_input_hatch", type: "item" }
				{ id: "39D334A75BD56C7E", item: "gtceu:duranium_ingot", type: "item" }
			]
			title: "Second Ring"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["38199670D4113E48"]
			description: ["The &6ZPM Parallel Hatch&r runs one machine on far more at a time. Worth a few for any line that keeps backing up. A machine that accepts one, and the power to match what it now eats. Throughput without another hall. Larger batches mean larger input buffers: check your pipes can keep up."]
			icon: "gtceu:zpm_parallel_hatch"
			id: "7BA0FD9FFFA13BFC"
			optional: true
			rewards: [{ id: "5A92D1CD5DF49A74", type: "xp", xp: 60 }]
			shape: "gear"
			size: 0.75d
			tasks: [{ id: "5F30DE5872812640", item: "gtceu:zpm_parallel_hatch", type: "item" }]
			title: "Sixty-Four at Once"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["3CBBA765447C908A"]
			description: ["Deuterium and helium-3 fuse into helium with almost no stray neutrons. It runs on the Mk2 only, and it's the clean way to turn Saturn's gas into power. Helium-3 and deuterium from the isotope column, and a Mk2 that's already running. Power from Saturn that needs no reactor waste. Send the helium-3 home by the pair and let ME keep the Mk2 stocked."]
			icon: "gtceu:helium_3_bucket"
			id: "728E2D977FC3D3C5"
			rewards: [{ id: "118FCFD058C13B9E", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "3F8ED1D3F8195AAB", item: "gtceu:zpm_fusion_reactor", type: "item" }
				{ id: "1F7E480BD8256AC3", item: "gtceu:helium_3_bucket", type: "item" }
			]
			title: "Aneutronic"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["728E2D977FC3D3C5"]
			description: ["The &6Direct Energy Converter&r takes charge straight off the plasma, with no turbine in between. The cooled gas goes back, so nothing is lost but heat. Helium plasma from the Mk2, and a hatch to carry the output. The cleanest power of the era, and the best use of Saturn. Return the cooled gas to the isotope column and the loop closes."]
			icon: "gtceu:direct_energy_converter"
			id: "7E64F29B6EE66B09"
			rewards: [{ id: "7BBC2F2FE62A8776", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5E1D2C03F378C17A", item: "gtceu:direct_energy_converter", type: "item" }]
			title: "Direct Conversion"
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["7B0EFFD4E295AFAD"]
			description: ["The IV &6Naquadah Plant&r learns a third mode: the leftover solution from the refinery becomes enriched naquadah dust, and the acid comes back. Enriched naquadah solution from the naquadria refinery, and the right circuit in the plant. Starts for the Mk2 and fuel for the reactor, from what used to be waste. Pipe the solution in, the acid back to the refinery, and the dust to ME."]
			icon: "gtceu:naquadah_plant"
			id: "510963E4F6E67A64"
			rewards: [{ id: "55C924A4FD6FA669", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "3FD5F0200F8771B3", item: "gtceu:naquadah_plant", type: "item" }
				{ id: "55B9886310BDD8F4", type: "checkmark" }
			]
			title: "Mode Three"
			x: 2.0d
			y: 4.0d
		}
		{
			dependencies: ["510963E4F6E67A64"]
			description: ["The EV &6Extraction Cascade&r takes monazite froth in its ZPM mode and hands back a rare-earth chloride with europium in it. Froth from the monazite line and the ZPM circuit, nothing new to build. The europium reductor, without waiting on fusion. Feed it froth by pipe and send the chloride on to the reductor."]
			icon: "gtceu:extraction_cascade"
			id: "74BD973EDBE9553A"
			rewards: [{ id: "3E47BE9283BD58BF", type: "xp", xp: 80 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "37EE179ABBCA85FB", item: "gtceu:extraction_cascade", type: "item" }
				{ id: "1C2091372D901945", type: "checkmark" }
			]
			title: "Cascade, Reloaded"
			x: 4.0d
			y: 4.0d
		}
		{
			dependencies: ["74BD973EDBE9553A"]
			description: ["The IV &6Hot Cell&r gets a silicon-28 mode: silicon and hydrofluoric acid in, the pure isotope out, the rest looped back. Silicon, hydrofluoric acid and the uranium centrifuges the hot cell already feeds. Silicon-28 for the ion implanter, and so for the qubit arrays. The spare silicon and acid return on their own: just keep both tanks topped."]
			icon: "grindless:silicon_28_dust"
			id: "7C205CBF99A79EFB"
			rewards: [{ id: "133A15B6C99C70E5", type: "xp", xp: 100 }]
			shape: "hexagon"
