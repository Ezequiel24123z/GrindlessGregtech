			x: 62.5d
			y: 3.5d
		}
		{
			dependencies: ["7F59412E666363A0"]
			description: ["The &6Creative Data Access Hatch (Ingredient)&r is the interface's data store: every recipe the gate asks for, always available. A computation core, the array and a pile of pattern memory from the AE2 line. The gate's interface. Craft it after the provider, from the same stock of cores."]
			icon: "grindless:creative_data_access_hatch"
			id: "7C27F7DFC9858171"
			rewards: [{ id: "3BB68F43C660A7F1", type: "xp", xp: 800 }]
