			y: -4.75d
		}
		{
			dependencies: ["357A817798DE0B18"]
			description: ["The gate to the Magellanic Stream leaves from the ring here at 30 Doradus. Its hold takes a whole intergalactic relay probe, unlaunched, with a fresh navigation core inside. Check this off once that probe is in hand."]
			icon: "grindless:optical_nav_core"
			id: "734ABA5214556D87"
