				{ id: "51B7E3025F4F97F8", item: "gtceu:he3_enriched_helium_bucket", type: "item" }
				{ id: "3EF77E3CBBFCD77D", item: "gtceu:crude_helium_3_bucket", type: "item" }
				{ id: "7FA27CC4C5037055", item: "gtceu:pristine_helium_3_bucket", type: "item" }
