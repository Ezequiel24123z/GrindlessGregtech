			size: 0.75d
			tasks: [{ id: "7A7B23DD2B835E14", type: "checkmark" }]
			title: "The Platform in the Stream"
			x: 21.25d
			y: -1.75d
		}
		{
			dependencies: ["16EBA71D0DE35B6E"]
			description: ["Deuterium from the first minutes of the universe, left in the Stream's gas. The works sweeps the gas up; a cold plant, a tower and a calutron pick out the heavy half. The gas works here. Then the cryogenic plant on the Moon, which liquefies the gas, a distillation tower and the calutron. Fuel for the fusion torus, and the beam injector that heats it. The gas never runs out. The calutron sets the pace."]
			icon: "gtceu:primordial_deuterium_bucket"
			id: "5DFE1272DB6130B6"
			rewards: [{ id: "776326DBE1F84F2E", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "149E73EDD7F7AFE4", item: "gtceu:pristine_gas_bucket", type: "item" }
				{ id: "5636A22210F1544C", item: "gtceu:liquid_pristine_hydrogen_bucket", type: "item" }
				{ id: "39051115C2AF9BEA", item: "gtceu:hd_fraction_bucket", type: "item" }
				{ id: "5D62F62073E8314D", item: "gtceu:primordial_deuterium_bucket", type: "item" }
			]
			title: "Primordial Deuterium"
			x: 25.75d
			y: -1.75d
		}
		{
			dependencies: ["16EBA71D0DE35B6E"]
			description: ["Helium-3 from the same gas. The superfluid plant lets helium-4 flow through its leak and keeps the lighter isotope behind. The helium the Moon's cryogenic plant splits off, the superfluid helium plant, a distillation tower and a calutron to finish. The other half of the torus's fuel, and the converter stack that catches its charged products. Send the leftover helium back into your helium lines."]
			icon: "gtceu:pristine_helium_3_bucket"
			id: "164DF010E9BE6259"
			rewards: [{ id: "3EC881C861351929", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
