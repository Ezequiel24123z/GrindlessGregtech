				{ id: "1AF2A5A1F75CDDE6", item: "gtceu:magnetic_pair_converter", type: "item" }
			]
			title: "The Hole Row: Beams and Pairs"
			x: 4.0d
			y: 5.0d
		}
		{
			dependencies: ["13C38AC31B1221D5"]
			description: ["The plasma mass filter and the FRC former turn the lift's raw plasma into confined plasma, the same way at this scale as before. Neither is tied to a place: only the lift is. Both controllers, anywhere you like. Nickel-56 and every plasma line after it. The filter's waste leaves in its own pipe."]
			icon: "gtceu:plasma_mass_filter"
			id: "77C42F51B49506CE"
			rewards: [{ id: "11342D3792216BD4", type: "xp", xp: 100 }]
