			y: -3.25d
		}
		{
			dependencies: ["36E166925A329E17"]
			description: ["The Stream and the Tarantula are running. Andromeda is next, then the dark between the galaxies. The gate to Andromeda leaves from 30 Doradus, and the one to the dark leaves from Andromeda."]
			icon: "grindless:optical_nav_core"
			id: "3D9C39B3E0770704"
			rewards: [{ id: "1BC2D0B0FA4DBD4D", type: "xp", xp: 100 }]
