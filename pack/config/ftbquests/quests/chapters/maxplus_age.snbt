		}
		{
			dependencies: ["5A142F96920D1894", "748B55AD58F78BA7", "5B12B68A0DD8886C", "10BD27BC322C59ED"]
			description: ["The ring stands in a 59 by 60 by 23 shell at Sgr A* orbit: 151 ring blocks and 9 locked chevrons on the ring, wrapped in a jacket of horizon gate casing, a cold channel of primordial cryostat casing, void diamond windows and an Fe-56 pedestal. The base row holds the iris, the base, 4 power units and a 4,096 A wireless MAX+ hatch: the dial draws its power through that hatch from the network store, which only the capacitor banks make large enough."]
			icon: "grindless:hyperstargate_ring_block"
			id: "3AB573B5BD8866CF"
			rewards: [{ id: "7CAC028F9A1A1C59", type: "xp", xp: 100 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "7F4F4C6C729BF781", type: "checkmark" }]
			title: "The Structure"
			x: 64.5d
			y: 7.5d
		}
		{
			dependencies: ["3AB573B5BD8866CF"]
			description: ["The &6Hyperstargate&r is the pack's last multiblock. It forms round a dial at Sgr A* orbit and opens a ring into the final dimension. The controller recipe is crafted at the black hole orbit, from ring blocks, a controller crystal, a creative computation provider, MAX+ circuits and the interface. The structure then needs the ring, the iris, the base, four power units and the 4,096 A wireless hatch, with a horizon lock kept in the controller. Its shape is 59 by 60 by 23, built by the Terminal in 6 passes. The dial. Nothing here is a production line. Build it once and keep the banks charged."]
			icon: "gtceu:hyperstargate"
			id: "1F0228D86B5ACECC"
			rewards: [{ id: "788D39DF58824535", type: "xp", xp: 1000 }]
			shape: "gear"
			size: 1.5d
			tasks: [{ id: "3FBB399BCE28FED5", item: "gtceu:hyperstargate", type: "item" }]
			title: "The Hyperstargate"
			x: 66.0d
			y: 4.0d
		}
		{
			dependencies: ["1F0228D86B5ACECC"]
			description: ["The dial opens the ring for a minute. It eats the genome archive, the cloud phase map, a stack of phase locks and a crate of jacketed cells, and keeps the &6Horizon Lock&r in the controller. The full charge in your team's capacitor banks for the whole opening (the wireless network is per team); EMI shows the draw. The dial will not start on a charge it cannot finish. The crossing, and a spent charge to recharge. Stock every input and keep the banks full. The next opening costs the same."]
			icon: "grindless:horizon_lock"
			id: "1E8E8FFC77B67321"
			rewards: [{ id: "7ED6A82CF0FCCB74", type: "xp", xp: 100 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "3EB104E71C883A79", type: "checkmark" }]
			title: "The Dial"
			x: 67.5d
			y: 4.0d
		}
		{
			dependencies: ["1E8E8FFC77B67321"]
			description: ["The dial returns a spent charge. The condensate refinery recharges it, and 48 of the 64 cells come back for the next opening. The phase locks are used up: each opening needs sixteen new ones."]
			icon: "grindless:spent_dial_charge"
			id: "1EE372F09417300D"
			rewards: [{ id: "1CCF85C0FC47DF2A", type: "xp", xp: 100 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "192270BCD36BA805", type: "checkmark" }]
			title: "Recharging the Dial"
			x: 69.0d
			y: 3.0d
		}
		{
			dependencies: ["1E8E8FFC77B67321"]
			description: ["The ring is open only while the dial runs, and one dial takes the whole team: every member of the team that owns the controller crosses once per opening, and nobody from another team does. A solo player is a team of one. A second crossing, for anyone, pays for its own archive and charge. Nothing else goes through."]
			icon: "gtceu:hyperstargate"
			id: "1C006DC7C70367BE"
			rewards: [{ id: "7EF11E0A42BFA9A3", type: "xp", xp: 100 }]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "57935ECB597B3030", type: "checkmark" }]
			title: "One Dial, One Team"
			x: 69.0d
			y: 4.0d
		}
		{
			dependencies: ["1009AE6C6D8D0887"]
			description: ["What the older machines become at MAX+ scale, the power from nickel-56 and fusion, and the AE2 grid that holds the plan."]
			icon: "gtceu:max_wireless_dynamo_hatch_16a"
			id: "1FCAA9AEBCE1BC58"
			rewards: [ ]
			shape: "circle"
