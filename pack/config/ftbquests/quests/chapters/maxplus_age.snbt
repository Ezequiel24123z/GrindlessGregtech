		{
			dependencies: ["753D9DA13C64AD9D"]
			description: ["The UHV and UV controllers at home, and the MAX+ row each one takes: the crystal growth furnace grows seed plates and boules, the photonic foundry makes the frequency divider and the photonic engine, the MBE reactor grows the piezo layer, the MOCVD reactor the laser arrays, the SRF works the resonance cells and cavities, and the ribbon works draws the tether ribbon. All ten controllers: PBO plant, crystal growth furnace, photonic foundry, MBE reactor, ribbon works, helium plant, SRF works, zone tower, MOCVD and fibre tower. The superfluid helium and fibres that the stream and the dark both ask for. Helium returns by the same pipe that fed it."]
			icon: "gtceu:superfluid_helium_plant"
			id: "568916C4E65A0FD1"
			rewards: [{ id: "5EA2549D8ABD7457", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "376957C747FBDE09", item: "gtceu:pbo_plant", type: "item" }
