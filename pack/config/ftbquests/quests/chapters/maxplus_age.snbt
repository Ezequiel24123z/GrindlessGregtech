			title: "The Shell and Its Tenants"
			x: 2.5d
			y: 3.5d
		}
		{
			dependencies: ["1176DA2E7A954D29"]
			description: ["The Kugelblitz forge, strangelet vault, debris harvester and replication refinery were the last of the hole row. At this scale they feed packets, strange matter, debris and copies. The four controllers. Packets, kerr strange alloy, and the probe's parts. Packets are the busiest lane; give them a belt of their own."]
			icon: "gtceu:kugelblitz_forge"
			id: "1D979E61CB77D854"
			rewards: [{ id: "73164B65E5485105", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "535FB1C9D99A184A", item: "gtceu:kugelblitz_forge", type: "item" }
				{ id: "5A1A3C711E224BE1", item: "gtceu:strangelet_vault", type: "item" }
				{ id: "1BAB3DED18773BE8", item: "gtceu:debris_harvester", type: "item" }
				{ id: "55C668ABCF06F6CF", item: "gtceu:replication_refinery", type: "item" }
