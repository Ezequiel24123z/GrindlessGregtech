			x: 17.0d
			y: -3.25d
		}
		{
			dependencies: ["1009AE6C6D8D0887"]
			description: ["The UXV controllers at home, and the MAX+ row each one takes:       the Spintronic Cluster Tool makes coated tapes, x-ray mirrors and the logic and storage dies; the stellar elevator loads the ribbon of the deep horizon tether. The Pasta Mill and the shequid works join those lines. All four controllers: Pasta Mill, Spintronic Cluster Tool, shequid works and stellar elevator. The ribbon, tether and conduit lines of stage II. They share one hub; lay it out once."]
			icon: "gtceu:pasta_phase_sorter"
			id: "5933EFF02E11707D"
			rewards: [{ id: "710705C34DF566EB", type: "xp", xp: 100 }]
			shape: "gear"
