			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["1E02DD0C6E528775"]
			description: ["An intergalactic probe steers by an &6Optical Nav Core&r, built in the photonic foundry round a thorium nuclear clock. Every probe swallows one whole, so each gate you open from here costs another."]
			icon: "grindless:optical_nav_core"
