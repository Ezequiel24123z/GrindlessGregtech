			x: 32.0d
			y: 0.0d
		}
		{
			dependencies: ["70FAD8F0790EC6B6"]
			description: ["One more intergalactic relay probe, kept unlaunched: the hold of the ring on the M31 platform takes it. Check this off once the probe is in hand."]
			icon: "grindless:ig_relay_probe"
