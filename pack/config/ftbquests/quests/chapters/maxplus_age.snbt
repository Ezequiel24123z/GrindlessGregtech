			title: "Nickel-56"
			x: 23.5d
			y: -4.75d
		}
		{
			dependencies: ["706F3E123B6112E3"]
			description: ["Nickel-56 decays within weeks, so the slug is canned and shielded the day it is made. The burner takes the finished cask."]
			icon: "grindless:shielded_ni56_cask"
			id: "3232ED493BE40B9D"
