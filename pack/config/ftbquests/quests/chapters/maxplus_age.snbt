			title: "A Course for Andromeda"
			x: 24.0d
			y: 0.0d
		}
		{
			dependencies: ["78F1746F58E646ED"]
			description: ["Build another intergalactic relay probe, the same recipe as before. The gate's hold at the Tarantula takes the finished probe, so keep it unlaunched. Check this off once it is in hand."]
			icon: "grindless:ig_relay_probe"
			id: "5776AE7283BF8ABB"
