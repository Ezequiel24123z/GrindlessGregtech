		{
			dependencies: ["31937D2FE81A944B", "33A2D7F5523AA48A"]
			description: ["Chevron blocks, ring blocks, upgrades, MAX+ circuits and field generators, with the creative chest and tank. It is the heaviest single craft of the pack."]
			icon: "grindless:hyperstargate_base"
