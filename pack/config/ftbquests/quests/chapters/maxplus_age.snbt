				{ id: "7836CD8DD1C1372F", item: "gtceu:hot_strip_mill", type: "item" }
			]
			title: "Home Rows: ZPM Down to EV"
			x: 4.5d
			y: 6.5d
		}
		{
			dependencies: ["599D0970AE701F01"]
			description: ["The burner takes a shielded nickel-56 cask and returns a cobalt-56 cask, then burns that again into a spent iron-56 cask. Each decay is heat, and the heat becomes EU wherever the burner stands: it is not tied to the Tarantula. Casks from the crucible, and a dynamo hatch on the burner. The era's first power plant, and the way to send its power to the network. Casks move by belt; run the cobalt casks through a second time before they go to the hot cell."]
			icon: "grindless:co56_cask"
			id: "5904BFC41192005D"
			rewards: [{ id: "7976B1A9FD723DBF", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "39DABB33A8787C44", item: "grindless:co56_cask", type: "item" }]
			title: "Power from Nickel-56"
			x: 28.0d
			y: -4.75d
		}
		{
			dependencies: ["5DE3FE0F732840CC"]
			description: ["Primordial deuterium and pristine helium-3 burn in the torus, and the converter stack turns their charged products straight into EU. The torus runs only in the Stream, where its fuel comes from. Both fuels in bulk, and a formed torus with its injector and stack. A second source for the network. The fuels travel in separate pipes. The helium-4 ash and the hydrogen that come out go home to the gas lines."]
			icon: "gtceu:helium_4_ash_bucket"
			id: "103CB25094617064"
			rewards: [{ id: "1376A41AB507E116", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7AD6D983C2E9863E", item: "gtceu:helium_4_ash_bucket", type: "item" }]
			title: "Power from Fusion Fuel"
			x: 30.25d
			y: -3.5d
		}
		{
			dependencies: ["5904BFC41192005D", "103CB25094617064"]
			description: ["A wireless dynamo hatch feeds the network from each plant, wherever it stands. A fraction is lost on the way, so build more than you need. A MAX wireless dynamo hatch on every plant. The network at home. Power flows without a cable, but not without cost."]
			icon: "gtceu:max_wireless_dynamo_hatch_16a"
			id: "39270E38F40EA6A2"
			rewards: [{ id: "332E805FD6C45CA5", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "5D452DE1703A54CE", item: "gtceu:max_wireless_dynamo_hatch_16a", type: "item" }]
			title: "Wireless Dynamo"
			x: 31.75d
			y: -4.75d
		}
		{
			dependencies: ["39270E38F40EA6A2"]
			description: ["Wireless energy hatches draw from the network, and a MAX+ store smooths out the dips between plants. The 4096-amp and 1024-amp wireless hatches, the MAX+ hatch and an SMES cell. Steady power for the machines that never stop. Size the store for the longest outage of the weakest plant."]
			icon: "grindless:max_smes_cell"
			id: "72B7C5DA86098D43"
			rewards: [{ id: "17B587B53E156C4F", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "7CC713B2C6480AE6", item: "gtceu:max_wireless_energy_hatch_4096a", type: "item" }
				{ id: "131F350D7682B965", item: "gtceu:max_wireless_energy_hatch_1024a", type: "item" }
				{ id: "194C123314D34844", item: "gtceu:max_maxplus_energy_hatch_1024a", type: "item" }
				{ id: "31517155ECF39628", item: "grindless:max_smes_cell", type: "item" }
			]
			title: "A Store That Holds It"
			x: 33.25d
			y: -4.75d
		}
		{
			dependencies: ["57131618A8A6EBF3"]
			description: ["The 256M cell component and a horizon storage die make cells that hold the stage's item and fluid counts. The &6Horizon Storage Die&r from the Circuits section, and the 256M component. Storage that does not run out at a million of anything. One cell type per network; fluids get their own."]
			icon: "megacells:item_storage_cell_256m"
			id: "1341919104B7CC42"
			rewards: [{ id: "5EF7B2C9C1D70918", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7E416B5CDD7230E7", item: "megacells:cell_component_256m", type: "item" }
				{ id: "3E8DA9C6661F552F", item: "megacells:item_storage_cell_256m", type: "item" }
				{ id: "1946A973BAF880AC", item: "megacells:fluid_storage_cell_256m", type: "item" }
				{ id: "3359B620637A978F", item: "grindless:horizon_storage_die", type: "item" }
			]
			title: "256M Storage"
			x: 40.0d
			y: 2.5d
		}
		{
			dependencies: ["1341919104B7CC42"]
			description: ["A wafer of grown laser emitters is the light source of the &6Photonic Coprocessor&r, and of the creative cores of the last stage. The &6Laser Array Wafer&r is made two at a time. The MOCVD reactor with a circuit of the last tier, and the gallium, indium and arsenic feed it grows from. It draws MAX+ power. The photonic coprocessor of the next quest and the creative cores of the end of the era. Feed the metal-organic precursors by pipe and take the wafers by ME; the coprocessor takes one wafer each, so keep a small stock."]
			icon: "grindless:laser_array_wafer"
			id: "35B4487582FDDAE0"
			rewards: [{ id: "3AF1FEAC6C8A8FD7", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "11907811E64734EE", item: "grindless:laser_array_wafer", type: "item" }]
			title: "Laser Array Wafer"
			x: 40.25d
			y: 6.0d
		}
		{
			dependencies: ["35B4487582FDDAE0"]
			description: ["A crafting CPU of 256M storage, with enough accelerators and a photonic coprocessor, can plan a job of a billion items without losing track. The crafting storage, the accelerators and the &6Photonic Coprocessor&r. Plans that stage III asks for. Split a huge plan into several CPUs, one for each line."]
			icon: "megacells:256m_crafting_storage"
			id: "73BAF6EEECC416D6"
			rewards: [{ id: "7450633C6F39644D", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "73E11C640B7F9E78", item: "megacells:256m_crafting_storage", type: "item" }
				{ id: "1BEB9FDA50020EAE", item: "megacells:mega_crafting_accelerator", type: "item" }
				{ id: "1E47FA18CC2A2618", item: "grindless:photonic_coprocessor", type: "item" }
			]
			title: "Crafting at a Billion"
			x: 41.5d
			y: 6.0d
		}
		{
			dependencies: ["73BAF6EEECC416D6"]
			description: ["The assembler matrix keeps hundreds of patterns in one block, and two pattern providers push them out. A pattern memory unit holds the plan. The matrix crafter, frame and walls, an extended provider, an expanded provider and the memory unit. Autocrafting of every item of the era. Group patterns by line, and name them."]
			icon: "expatternprovider:assembler_matrix_crafter"
			id: "72495AA51424E971"
			rewards: [{ id: "1C09BF32B43F8982", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "330E8CA9BA6BB792", item: "expatternprovider:assembler_matrix_crafter", type: "item" }
				{ id: "5A7C269A777E8A00", item: "expatternprovider:assembler_matrix_frame", type: "item" }
				{ id: "384D337E5FCF25D3", item: "expatternprovider:assembler_matrix_wall", type: "item" }
				{ id: "503E37D46D179790", item: "expatternprovider:ex_pattern_provider", type: "item" }
				{ id: "548BA94FEA06CE9B", item: "expandedae:exp_pattern_provider", type: "item" }
				{ id: "3301A96F500A93AD", item: "grindless:pattern_memory_unit", type: "item" }
			]
			title: "Patterns by the Thousand"
			x: 43.0d
			y: 5.25d
		}
		{
			dependencies: ["57131618A8A6EBF3"]
			description: ["The MAX+ parallel hatch lets one machine run a very large batch at once. It does not make a recipe faster; it makes the plan fit. The &6MAX+ Parallel Control Hatch&r, on a controller that accepts it. The scale of the final stage. A batch needs its inputs together, so size the buffer for it."]
			icon: "gtceu:max_maxplus_parallel_hatch"
			id: "1C5936DAC6F975A1"
			rewards: [{ id: "395723223CB5EE0B", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "399B8CF60A021290", item: "gtceu:max_maxplus_parallel_hatch", type: "item" }]
			title: "The Parallel Hatch"
			x: 41.0d
			y: 4.5d
		}
		{
			dependencies: ["182B1EBF7BAC54DC"]
			description: ["Six process lines the earlier chapters only name: the module stage of the horizon processor, the iris blade, the Kerr ribbon, iron-56, the HD and helium-3 polarisation, and the thorium clock. Each is a real chain; follow the ones you need."]
			icon: "grindless:horizon_processor"
			id: "5F699D8ACB0E6834"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "770B2B6B5AB3A844", type: "checkmark" }]
			title: "Horizon lines"
			x: 22.0d
			y: 15.0d
		}
		{
			dependencies: ["5F699D8ACB0E6834"]
			description: ["Step 30 of the horizon processor line: a shielded quantum module with two horizon logic dies stacked on it by magnetic tunnel junction sputtering. The MTJ sputter cluster, 2,400 ticks: a shielded quantum module, two horizon logic dies and programmed circuit 28. 5% of the time it also leaves horizon module scrap. The linked module. The scrap is leached back into the extraction cascade, so no module is ever lost. Modules and dies by ME; send the scrap to the cascade by bus."]
			icon: "grindless:stacked_horizon_module"
			id: "10DE283ABAA2ACD8"
			rewards: [{ id: "31D05EF4763C909D", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "31C0A265069EF7E4", item: "grindless:stacked_horizon_module", type: "item" }]
			title: "Stacked Horizon Module"
			x: 23.5d
			y: 12.0d
		}
		{
			dependencies: ["10DE283ABAA2ACD8"]
			description: ["Step 31: the stack is wired to a horizon interposer by a femtosecond laser, so that the dies share one bus. The femtosecond writer, 2,400 ticks: a stacked horizon module, a horizon interposer and programmed circuit 21. The condensate-cooled module. One interposer per module by ME."]
			icon: "grindless:linked_horizon_module"
			id: "5E6ACFB03C49D7A6"
			rewards: [{ id: "57C3259C5FA0195C", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "734F04C4B69AE778", item: "grindless:linked_horizon_module", type: "item" }]
			title: "Linked Horizon Module"
			x: 26.0d
			y: 12.0d
		}
		{
			dependencies: ["5E6ACFB03C49D7A6"]
			description: ["Step 32: the linked module is soaked in Kerr condensate, which holds it at a steady temperature before the final test. The condensate refinery, 1,800 ticks: a linked horizon module, a full tank of Kerr condensate and programmed circuit 12. The tested module. Condensate by pipe from the Kerr condensate line."]
			icon: "grindless:condensate_cooled_module"
			id: "3020123A8A75F420"
			rewards: [{ id: "1FB45DC72FBC47BA", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "191E7207F45DD9F9", item: "grindless:condensate_cooled_module", type: "item" }]
			title: "Condensate-Cooled Module"
			x: 28.5d
			y: 12.0d
		}
		{
			dependencies: ["3020123A8A75F420"]
			description: ["Step 33: the module is cooled to a few millikelvin and tested; only a module that passes continues. The millikelvin cryostat works, 2,400 ticks: a condensate-cooled module, a millikelvin cryostat module, programmed circuit 13 and a little helium-3/helium-4 mixture. The mixture is returned, so it only has to be topped up. The horizon processor. Keep the mixture in a loop; cryostat modules by ME."]
			icon: "grindless:tested_horizon_module"
			id: "15636E7291B46534"
			rewards: [{ id: "7E4B930934AE9E11", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "57D9D6DE3DB69317", item: "grindless:tested_horizon_module", type: "item" }]
			title: "Tested Horizon Module"
			x: 31.0d
			y: 12.0d
		}
		{
			dependencies: ["15636E7291B46534"]
			description: ["Step 34, the end of the qubit stage: the tested module is joined to a quantum memory node and a Rydberg logic array. It is the processor of the MAX+ circuits. The photonic integration hall, 6,000 ticks: a tested horizon module, a quantum memory node, a Rydberg logic array, two MAX circuits (any) and programmed circuit 14. The MAX+ processor circuits and the machines that need them. Memory nodes and arrays by ME; the five stages run one after another, so a buffer between them keeps the line full."]
			icon: "grindless:horizon_processor"
			id: "3C1D7165C0C694E8"
			rewards: [{ id: "754C3039DFFB3F05", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "74DBF191C7BB9C0B", item: "grindless:horizon_processor", type: "item" }]
			title: "Horizon Processor"
			x: 33.5d
			y: 12.0d
		}
		{
			dependencies: ["5F699D8ACB0E6834"]
			description: ["Step 1 of the iris blade: strangelets melted into tungsten, so that the blade metal holds a strange phase. The levitation melter, 2,400 ticks: four fed strangelets, four tungsten dust, helium and programmed circuit 23. Half the time it leaves melter dross. The oriented blade blank. Fed strangelets by ME from the strangelet line; the dross goes to the voiding line."]
			icon: "grindless:strange_alloy_charge"
			id: "567C6F47D0AA4B49"
			rewards: [{ id: "124066627F110E06", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "123DBA28CB940018", item: "grindless:strange_alloy_charge", type: "item" }]
			title: "Strange Alloy Charge"
			x: 23.5d
			y: 13.5d
		}
		{
			dependencies: ["567C6F47D0AA4B49"]
			description: ["Step 2: a single crystal of tantalum carbide and rhenium, grown with one grain direction so the blade does not crack along it. The single crystal foundry, 1,200 ticks: four Kerr strange plates, 16 tantalum carbide dust, eight rhenium dust, programmed circuit 29 and a little argon, for two blanks. The densified blade. Plates and dust by ME; argon by pipe."]
			icon: "grindless:oriented_blade_blank"
			id: "59E266909B45D69D"
			rewards: [{ id: "1010B4039D5B23EF", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "79273491D1291533", item: "grindless:oriented_blade_blank", type: "item" }]
			title: "Oriented Blade Blank"
			x: 26.0d
			y: 13.5d
		}
		{
			dependencies: ["59E266909B45D69D"]
			description: ["Step 3: the blank is pressed at a megabar to close every pore. The megabar press, 900 ticks: two oriented blade blanks, four tantalum carbide plates and programmed circuit 18, for two blades. The edged blade. Blanks and plates by ME."]
			icon: "grindless:densified_blade"
			id: "1FF7F1460269C52F"
			rewards: [{ id: "71865ACBD789BA63", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "1E7B27FF9510315B", item: "grindless:densified_blade", type: "item" }]
			title: "Densified Blade"
			x: 28.5d
			y: 13.5d
		}
		{
			dependencies: ["1FF7F1460269C52F"]
			description: ["Step 4: the blade is turned to its edge. The swarf is tantalum carbide dust, which goes back into the blank. A lathe, 600 ticks: one densified blade. It returns one tantalum carbide dust. The coated blade. Send the dust back to the foundry by bus."]
			icon: "grindless:edged_blade"
			id: "317ED3071F1266CE"
			rewards: [{ id: "779A261B5EF0B1FA", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3AEAA7A1DD4EA633", item: "grindless:edged_blade", type: "item" }]
			title: "Edged Blade"
			x: 31.0d
			y: 13.5d
		}
		{
			dependencies: ["317ED3071F1266CE"]
			description: ["Step 5: a niobium nitride coat, laid by electron beam, makes the edge hold against the horizon. The electron beam furnace, 900 ticks: two edged blades, two niobium nitride plates and argon, for two blades. Most of the argon is returned. The iris blade. Keep the argon in a loop."]
			icon: "grindless:coated_iris_blade"
			id: "11359CF497F99D60"
			rewards: [{ id: "395CC3CDF349CF4B", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "76BF61F6747A4079", item: "grindless:coated_iris_blade", type: "item" }]
			title: "Coated Iris Blade"
			x: 33.5d
			y: 13.5d
		}
		{
			dependencies: ["11359CF497F99D60"]
			description: ["Step 6 of the iris blade: the blade of the Horizon Iris, the part of the Hyperstargate that opens and closes the ring. The hyper assembly array, 1,200 ticks: a coated iris blade, 12 horizon compressed plates, eight Kerr strange plates, two MAX+ electric pistons, a MAX+ conveyor module, programmed circuit 5 and a large tank of Kerr condensate. The Horizon Iris. The six steps are one line; plates and pistons by ME, condensate by pipe."]
			icon: "grindless:iris_blade"
			id: "188EEDE1626F65BD"
			rewards: [{ id: "54EB641CF0EDB560", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
