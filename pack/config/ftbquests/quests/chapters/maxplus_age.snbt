		{
			dependencies: ["3E745B1C8AB9F567", "5C6CD9758C5ECD8E"]
			description: ["Probe and counterweight go into the slingshot together, at Sgr A* orbit, the only place it runs. The hole's tide splits them, keeps one and throws the other out of the Galaxy."]
			icon: "grindless:bound_probe_pair"
			id: "58258FCDDAD615DE"
			rewards: [{ id: "3456588E246E427C", type: "xp", xp: 150 }]
