				{ id: "5DF65F8F5273B1E6", item: "grindless:deep_horizon_tether", type: "item" }
			]
			title: "A Deep Horizon Tether"
			x: 30.5d
			y: 1.5d
		}
		{
			dependencies: ["72B3053974CD5861"]
			description: ["In the nucleus's photon bath the &6Blueshift Forge&r cracks molybdenum targets into a mix of rare isotopes. Back home the mix is concentrated and melted with helium into p-process plasma in a blast furnace. The forge on its tether here, and enriched targets from a calutron at home. Plasmas for stage III's tree. Targets in, isotopes out, and the light is free."]
			icon: "gtceu:photonuclear_mix_bucket"
			id: "52A22A1D6EAEA20C"
			rewards: [{ id: "710F6FF37DE95BC8", type: "xp", xp: 250 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "57F843A6AC61EC97", item: "gtceu:photonuclear_mix_bucket", type: "item" }
				{ id: "3CA11B91B0DB08FC", item: "gtceu:p_process_plasma_bucket", type: "item" }
			]
			title: "Photonuclear Isotopes"
			x: 35.0d
			y: 1.5d
		}
		{
			dependencies: ["7A63B9D1F4FD1511"]
			description: ["The last gate leaves from M31 and aims at the thin web of gas between the galaxies. Its navigation core is cut for a sky with almost nothing in it; it is the same item as before."]
			icon: "grindless:optical_nav_core"
			id: "70FAD8F0790EC6B6"
