	quests: [
		{
			dependencies: ["3F1C487831920064"]
			description: [
				"The last recipe of MAX left you a &6Horizon Lock&r. It is no ticket home: the shell keeps it as a catalyst, and every tap of the horizon from here on wants one."
				"Make more as you go. The gate that leaves the Galaxy keeps one, every locked chevron of the last gate swallows one, and its dial keeps another."
				"&oFiction:&r a horizon held still, and a lock that holds it. The Galaxy ends at the next gate."
			]
			icon: "grindless:horizon_lock"
			id: "1009AE6C6D8D0887"
			rewards: [{ id: "1A6225BEC3E41424", type: "xp", xp: 100 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ id: "5DE601BD04C7CBBB", item: "grindless:horizon_lock", type: "item" }]
			title: "MAX+ Begins"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["1009AE6C6D8D0887"]
			description: ["The &6Mirror Shell&r can now tap &6Kerr Condensate&r from the still cloud around the hole, with a wave packet to seed it and the lock kept as catalyst. The shell, and a Kugelblitz forge sending packets. Every horizon-bound material. Packets come in by belt, and the lock never leaves the shell."]
			icon: "gtceu:kerr_condensate_bucket"
			id: "1EBBE33BC966BE23"
			rewards: [{ id: "7573D6EA200918FD", type: "xp", xp: 100 }]
