		}
		{
			dependencies: ["1E02DD0C6E528775"]
			description: ["A canned counterweight of dense planetesimal core. The black hole keeps it, which is the honest ending for anything that heavy. The slingshot's coil casing is wound round the same core."]
			icon: "grindless:canned_counterweight"
