			x: 10.5d
			y: 0.0d
		}
		{
			dependencies: ["58258FCDDAD615DE"]
			description: ["The probe is on its way. The warp gate at Sgr A* catches it at the far end: its hold burns the launched probe and keeps a Horizon Lock as a catalyst."]
			icon: "grindless:launched_ig_probe"
			id: "51D3B2F96B6E589C"
