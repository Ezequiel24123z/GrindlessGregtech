			title: "Older Machines, Power and AE2"
			x: 0.0d
			y: 1.5d
		}
		{
			dependencies: ["1009AE6C6D8D0887"]
			description: ["The &6Mirror Shell&r is the one place the horizon is tapped; the old c4 row sits in its shadow and feeds it. The shell and the c4 machines of the hole row. Everything bound in stage I. One lane per machine, all ending at the shell."]
			icon: "gtceu:mirror_shell"
			id: "1176DA2E7A954D29"
			rewards: [{ id: "3FFD5319E44864C6", type: "xp", xp: 100 }]
