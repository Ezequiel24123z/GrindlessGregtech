		{
			dependencies: ["7861A4838AA691E0"]
			description: ["The &6Creative Computation Provider (Ingredient)&r gives the controller all the thinking the dial asks for. Outside the gate it does nothing. A computation core and the array. The gate's controller. One craft, queued after the computation line is running."]
			icon: "grindless:creative_computation_provider"
			id: "7F59412E666363A0"
			rewards: [{ id: "348E2163C79B81EA", type: "xp", xp: 800 }]
