			x: 20.0d
			y: 0.0d
		}
		{
			dependencies: ["36E166925A329E17"]
			description: ["Gas this pristine has never been inside a star. A magnetic scoop sweeps it up, and what it holds is worth carrying home. The platform's ring takes you back the same way: step out of it and back in."]
			icon: "gtceu:pristine_gas_works"
			id: "1A7ECED9F7530435"
			rewards: [{ id: "3770903933531B12", type: "xp", xp: 25 }]
