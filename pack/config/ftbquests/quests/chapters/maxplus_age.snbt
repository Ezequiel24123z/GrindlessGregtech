			tasks: [{ id: "525C54E7F7C47D68", type: "checkmark" }]
			title: "Stage II Begins"
			x: 22.0d
			y: 0.0d
		}
		{
			dependencies: ["3D9C39B3E0770704"]
			description: ["The gate to Andromeda is built at 30 Doradus. Its probe gets a navigation core cut for a nucleus that is coming toward us, and so for a different sky. It is the same item as before: if you hold one, that is all this step needs."]
			icon: "grindless:optical_nav_core"
			id: "78F1746F58E646ED"
			rewards: [{ id: "1EFE82DB5524E01B", type: "xp", xp: 50 }]
