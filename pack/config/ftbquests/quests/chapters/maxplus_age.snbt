			title: "The Platform at M31"
			x: 30.0d
			y: 0.0d
		}
		{
			dependencies: ["7A63B9D1F4FD1511"]
			description: ["The &6Deep Horizon Tether&r holds the blueshift forge at the right depth in the nucleus's pull. Too shallow and it burns; too deep and it never comes back. Kerr ribbon from the strand line, condensate for the coating, and the stellar elevator at Cygnus X-1 for the proof load. The blueshift forge's photonuclear recipes. Build the tether once per forge."]
			icon: "grindless:deep_horizon_tether"
			id: "5851F26D0448CBBB"
			rewards: [{ id: "3EBA40F0D8B8F391", type: "xp", xp: 250 }]
			shape: "hexagon"
