		}
		{
			dependencies: ["51D3B2F96B6E589C"]
			description: ["When that hold completes, a platform appears in the Tarantula Nebula, beside the heaviest stars known, and the ring's output bus gets its &6Relay Coordinates&r. Put them in the input bus of a ring that is holding, stand inside and it carries you there."]
			icon: "grindless:launched_ig_probe"
			id: "13C38AC31B1221D5"
			rewards: [{ id: "30A63481A598D663", type: "xp", xp: 250 }]
			shape: "rsquare"
			size: 1.5d
			tasks: [{ dimension: "grindless:tarantula_orbit", id: "5D4E4936DE8F3806", type: "dimension" }]
			title: "30 Doradus"
			x: 14.0d
			y: 0.0d
		}
		{
			dependencies: ["13C38AC31B1221D5"]
			description: ["A warp ring on a floor, a wireless hatch pair and an AE2 controller with a drive. Everything else you carry in. The ring waits paused with cells of its own: step out of it and back in, and it wakes for one hold, paid by those cells and the network's power, and carries you home."]
			icon: "gtceu:tarantula_stellar_lift"
			id: "357A817798DE0B18"
			rewards: [{ id: "3E3514FCED5553D1", type: "xp", xp: 25 }]
			shape: "circle"
			size: 0.75d
