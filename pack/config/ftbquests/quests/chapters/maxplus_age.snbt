			tasks: [
				{ id: "19F6E5EAB3758B2F", item: "gtceu:pasta_phase_sorter", type: "item" }
				{ id: "1E5218E9ED1E6F34", item: "gtceu:mtj_sputter_cluster", type: "item" }
