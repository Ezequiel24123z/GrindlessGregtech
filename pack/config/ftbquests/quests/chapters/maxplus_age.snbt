			tasks: [{ id: "52841BF7DDF1F11F", type: "checkmark" }]
			title: "A Course for the Stream"
			x: 18.0d
			y: 0.0d
		}
		{
			dependencies: ["734ABA5214556D87"]
			description: ["When that hold completes, a platform appears in the Magellanic Stream, a river of gas torn from the Clouds and older than any star here. The ring at 30 Doradus gets its &6Relay Coordinates&r: ride there as before."]
			icon: "gtceu:pristine_gas_bucket"
			id: "36E166925A329E17"
			rewards: [{ id: "59B240E104F41E69", type: "xp", xp: 250 }]
