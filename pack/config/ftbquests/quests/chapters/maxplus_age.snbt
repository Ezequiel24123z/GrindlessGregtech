				{ id: "74A06B177D5C3272", item: "gtceu:fibre_draw_tower", type: "item" }
			]
			title: "Home Rows: UHV and UV"
			x: 3.0d
			y: 6.5d
		}
		{
			dependencies: ["568916C4E65A0FD1"]
			description: ["The older rows still make parts MAX+ needs: the diamond lattice fab makes the photonic plate, the HTS magnet works winds the SMES toroid and the fault-current coil, the coated conductor line draws tapes, and the helium refrigerator chills toroids, coils and conduits. The implanter, aerogel works, hot cell, rare earth extraction cascade, cryogenic plant and hot strip mill take smaller parts. The ten controllers: diamond fab, implanter, aerogel works, coated conductor line, HTS magnet works, helium refrigerator, hot cell, rare earth extraction cascade, cryogenic plant and hot strip mill. Conductors, aerogel, and a cold chain for the stage. Give each its own chest on the network."]
			icon: "gtceu:hts_magnet_works"
			id: "3C73B0DC0A684E4F"
			rewards: [{ id: "7EA1FC2BBFB0129F", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "32BE72BB510E49C7", item: "gtceu:diamond_lattice_fab", type: "item" }
				{ id: "5E6F2793D9C0F49E", item: "gtceu:ion_implanter", type: "item" }
				{ id: "7261201B627874E8", item: "gtceu:aerogel_works", type: "item" }
