			x: 28.0d
			y: 0.0d
		}
		{
			dependencies: ["7C245280AB59052C"]
			description: ["The horizon here is gentle enough to hang a factory from, and the light is hot enough to split nuclei. Bring a tether, and bring targets."]
			icon: "gtceu:blueshift_forge"
			id: "7A63B9D1F4FD1511"
			rewards: [{ id: "304C59F575BAE0E2", type: "xp", xp: 25 }]
