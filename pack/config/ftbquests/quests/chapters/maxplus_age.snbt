			title: "Probe for M31"
			x: 26.0d
			y: 0.0d
		}
		{
			dependencies: ["5776AE7283BF8ABB"]
			description: ["When that hold completes, a platform appears at the nucleus of Andromeda, bathed in gamma light, and the ring at 30 Doradus gets its &6Relay Coordinates&r. Ride there as before; step out of the platform's ring and back in to come home."]
			icon: "grindless:launched_ig_probe"
			id: "7C245280AB59052C"
			rewards: [{ id: "1DFA149BBFCA1B69", type: "xp", xp: 250 }]
			shape: "rsquare"
