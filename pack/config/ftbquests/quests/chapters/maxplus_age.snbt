			x: 64.0d
			y: 4.0d
		}
		{
			dependencies: ["19F92230E8321753"]
			description: ["The machines of the tree and the parts of the gate: ring blocks, upgrades, chevrons, power units, the base and the controller, then the dial."]
			icon: "gtceu:hyperstargate"
			id: "1AC581A031116D72"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
