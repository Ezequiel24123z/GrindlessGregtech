				{ id: "11A11A864AF0C0E7", item: "gtceu:beuv_scanner", type: "item" }
				{ id: "7BDBD2FB9E54FF39", item: "gtceu:millikelvin_cryostat_works", type: "item" }
				{ id: "1EBB3818E2384704", item: "gtceu:spectral_hole_burner", type: "item" }
			]
			title: "Home Rows: UIV"
			x: 1.0d
			y: 4.5d
		}
		{
			dependencies: ["197BA9E30B9592BF"]
			description: ["The UEV controllers at home, and the MAX+ row each one takes: the calutron makes the silicon-28 feed of the logic die, the stellar forge makes the plasma of the crystal slurry, the CVI furnace makes waveguide tubes and chamber flanges, the nitride magnet works braces the SMES toroid and the SNSPD foundry makes the phase sensor die. All eight controllers: megabar press, degenerate harvester, calutron, CVI furnace, single-crystal foundry, nitride magnet works, SNSPD foundry and stellar forge. The calutron's isotopes, which both stages ask for. The calutron is the slow one; build several."]
			icon: "gtceu:calutron"
			id: "753D9DA13C64AD9D"
			rewards: [{ id: "1513654D35608324", type: "xp", xp: 100 }]
			shape: "gear"
