		{
			dependencies: ["3DB85D84F44BA706"]
			description: ["The emptiest place in the pack has no dust and no heat to spoil a crystal. The fab grows diamond there, and holds the holographic block that the creative store needs. The MAX hull with horizon casings, MAX+ circuits and components, and seed plates cut at home. It grows only in the filament. Void-grown diamond and the engineered lattice that ends the stage. Seed plates and blocks travel by chest. Run it by pattern."]
			icon: "gtceu:void_crystal_fab"
			id: "5B3696F485C80207"
			rewards: [{ id: "5D4CDDBD56D00529", type: "xp", xp: 150 }]
