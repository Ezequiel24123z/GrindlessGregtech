			title: "Pellets and Cavities"
			x: 27.5d
			y: -12.0d
		}
		{
			dependencies: ["305F48FF31D86B06"]
			description: ["The &6Rare Earth Extraction Cascade&r takes fourteen MAX rows: the Er/Ho and Tb/Dy cuts, the YBCO precursor and the Y-Ba-Cu raffinate, hafnia and the Ta-Hf oxide of the hearth liner, cathode copper, vanadium pentoxide, indium sulfate and the tin-lithium eutectic, plus returns for spent ferric chloride, fatigued VO2 sheets and Sn-Li dross. The EV controller you already own. Feeds for most MAX lines, from the cryocooler's regenerator to the belt furnace's hearth liner and the droplet radiator. Feeds by bus; each product leaves on its own line, and the spent sheets and dross come back in."]
			icon: "gtceu:extraction_cascade"
			id: "55A4165DF8CEC24B"
			rewards: [{ id: "1155FD6B4932DB0D", type: "xp", xp: 120 }]
