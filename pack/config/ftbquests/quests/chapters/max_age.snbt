		}
		{
			dependencies: ["5A78426AB64BE300"]
			description: ["A microring on a nitride film, trimmed and packaged, then locked to a nuclear clock. The &6MOCVD Reactor&r, &6BEUV Scanner&r, &6Femtosecond Writer&r, &6Photonic Foundry&r and &6Nuclear Clock Lab&r. The Rydberg logic array and the photon ring imaging recipe. Make a few; they are not consumed."]
			icon: "grindless:clock_locked_microcomb"
