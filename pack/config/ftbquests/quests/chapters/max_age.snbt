			y: 2.5d
		}
		{
			dependencies: ["1E1DCCA995ABBA6C"]
			description: ["The &6MAX Electric Pump&r is a motor with a rotor and a superfluid seal. Nothing leaks past it, which is the point."]
			icon: "grindless:max_electric_pump"
