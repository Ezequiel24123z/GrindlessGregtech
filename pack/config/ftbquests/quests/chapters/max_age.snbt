			y: 38.0d
		}
		{
			dependencies: ["736309345EB90546"]
			description: ["A hollow-core fibre is drawn from ultrapure silica and end-capped by femtosecond writing; it guides UV to the atoms. In a &6Assembler&r: a Endcapped Hc Fibre, 2 Hollow Core Fibre, a MAX circuit, 2 Tritanium Plate, 4 Tritanium Foil, 2 Horizon Strand Single Wire and more. The Rydberg logic array. The tower draws long: cut and stock."]
			icon: "grindless:uv_fibre_harness"
			id: "5B675240F250EA89"
