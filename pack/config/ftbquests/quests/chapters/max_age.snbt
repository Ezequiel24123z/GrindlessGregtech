			x: 20.0d
			y: -3.0d
		}
		{
			dependencies: ["796D2CDBFAF7CCFF"]
			description: ["A film one atom thick, rolled, grown and chilled along a long line. The &6Membrane Line&r makes the superconducting membrane that no older machine can. The MAX hull and a long run of roller casings through a CVD zone and a cold zone, with room for the length. The superconducting membrane, the conveyor module, the field generator and the hatches that move fluids. The line is long but quiet: feed it by ME and send the membrane to the ark and the hall."]
			icon: "gtceu:membrane_line"
			id: "3FC8F0795380E0E2"
			rewards: [{ id: "7EA2EE0810C94BD3", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "5CC2A65DA79BB1EE", item: "gtceu:membrane_line", type: "item" }
