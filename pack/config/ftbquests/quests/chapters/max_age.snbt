			x: 88.5d
			y: 48.0d
		}
		{
			dependencies: ["7D04DB71D6DA59DC"]
			description: ["A copper foil is electropolished to a single crystal, covered with graphene and hBN, and a REBCO layer is grown on a PBO web. It is the skin of the conveyor, field generator and hatches. The &6Single-Crystal Foundry&r, &6Van der Waals Stacker&r, &6Coated Conductor Line&r, &6HTS Magnet Works&r and &6Membrane Line&r. The shielded quantum module and the membrane vacuum and shell window casings. Make the foil and the web in bulk; the membrane waits in ME for the ark, the hall and the casings."]
			icon: "grindless:superconducting_membrane"
			id: "149A72757DA59C30"
			rewards: [{ id: "3BB3EA6CF8A2B851", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3AC32D05738062D8", item: "grindless:superconducting_membrane", type: "item" }]
			title: "Superconducting Membrane"
			x: 76.0d
			y: 50.5d
		}
		{
			dependencies: ["149A72757DA59C30"]
			description: ["A stack of hafnia and silica layers that reflects the light of the cluster back; it faces the sun side of every shell segment and lines the furnace bowl. The &6Zone Refining Tower&r, &6Electron Beam Furnace&r, &6Spintronic Cluster Tool&r and &6Membrane Line&r. The mirror shell segment, the Cluster Light Furnace and the Geroch Winch. Make a stock: every segment takes one."]
			icon: "grindless:albedo_multilayer_panel"
			id: "1AADEAC4897A9C44"
			rewards: [{ id: "5F83344222A1E27B", type: "xp", xp: 100 }]
