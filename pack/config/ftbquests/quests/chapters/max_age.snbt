		{
			dependencies: ["7DA50832A003A040"]
			description: ["Light squeezed until its noise drops below what any ordinary beam can reach. The &6Squeezed-Light Chip&r is the part that makes MAX emitters and the mainframe sharp. The crystals and the femtosecond writer from the older photonic lines, with a cleanroom that stays cold. The tweezer die, the MAX emitter and the mainframe. Crystals by ME; chips are small, so stock a few and send the rest on."]
			icon: "grindless:squeezed_light_chip"
			id: "5910FF92CEC15A2E"
			rewards: [{ id: "113B65BEADB549B4", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "1DB6B458168FE556", item: "grindless:squeezed_light_chip", type: "item" }]
			title: "Squeezed-Light Chip"
			x: 12.5d
			y: 2.5d
		}
		{
			dependencies: ["5910FF92CEC15A2E"]
			description: ["Single atoms held in beams of light, one by one, on a die. The &6Tweezer Array Die&r is the logic the mainframe reads its qubits from. A laser engraver for the last step, a squeezed-light chip and a calibrated lens. The interposer and the Rydberg array works, which is researched from it. Lenses and chips by ME in matched counts; the engraver returns dies in a chest."]
			icon: "grindless:tweezer_array_die"
			id: "17CBBAAEADB21164"
			rewards: [{ id: "5FC4C428E07A8BBA", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7FDED9EDDD366B8E", item: "grindless:tweezer_array_die", type: "item" }]
			title: "Tweezer Array Die"
			x: 15.0d
			y: 2.5d
		}
		{
			dependencies: ["17CBBAAEADB21164"]
			description: ["The board that joins the chips at millikelvin. The &6Cryo Photonic Interposer&r carries light between them without heating either. A cold line: the helium refrigerator and a vacuum, with a die and a chip to bond. The mainframe, which takes one of each part. Keep one of each part per mainframe in a dedicated chest; a big stock gains nothing."]
			icon: "grindless:cryo_photonic_interposer"
			id: "18F41DE9388D684D"
			rewards: [{ id: "30CD7A6501005BD9", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5C233FAA3A69F48D", item: "grindless:cryo_photonic_interposer", type: "item" }]
			title: "Cryo Photonic Interposer"
			x: 17.5d
			y: 2.5d
		}
		{
			dependencies: ["18F41DE9388D684D"]
			description: ["The only circuit of MAX, and the last one the pack has. The &6Supracausal Mainframe&r joins two chips, two dies and an interposer with OpV circuits and a tetron array. The photonic integration hall from UEV, superfluid helium-3 and a full set of the three parts. Every MAX component, hatch and controller. Three part lines into one hall: give each its own chest so one slow line never starves the others."]
			icon: "gtnn:supracausal_mainframe"
			id: "3BEE68D81D2C0817"
			rewards: [{ id: "3F96CF74225A6C7E", type: "xp", xp: 250 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "13AC629C7C67ED7B", item: "gtnn:supracausal_mainframe", type: "item" }]
			title: "Supracausal Mainframe"
			x: 22.5d
			y: 2.5d
		}
		{
			dependencies: ["3BEE68D81D2C0817"]
			description: ["MAX has no assembler of its own, so MAX parts are put together in the &6Assembly Hall&r. It takes many parts at once and does the work of a whole row of assemblers. The hall controller and two OpV hatches that give it MAX voltage, because MAX hatches do not exist yet. Every MAX component, and later the hatches that replace the OpV pair. Parts by ME; the hall hands back one kind at a time, so a pattern provider per component keeps it busy."]
			icon: "gtceu:assembly_hall"
			id: "34FED870BAF8944F"
			rewards: [{ id: "30FF56E65BF22E96", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7768C56441CEB741", item: "gtceu:assembly_hall", type: "item" }]
			title: "The Assembly Hall"
			x: 25.0d
			y: 2.5d
		}
		{
			dependencies: ["34FED870BAF8944F"]
			description: ["MAX motors wind strand cable round a bearing that floats without touching anything, and the piston is a motor with a harmonic drive and a stack of shape-changing metal. The older motors will not do here."]
			icon: "grindless:max_electric_motor"
			id: "1E1DCCA995ABBA6C"
