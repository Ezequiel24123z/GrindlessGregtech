			x: 86.0d
			y: 48.0d
		}
		{
			dependencies: ["566472E6E2247BB3"]
			description: ["Eight scandium-jacketed pellets are canned in liquid helium. Spent pellets are also reclaimed in the Mass Stream Injector at a small yield. In a &6Mass Stream Injection&r: programmed circuit 2, a Spent Stream Pellet. The stream bundles of the horizon lock. Return spent pellets to the injector."]
			icon: "grindless:stream_pellet"
			id: "75D33A11AE23A262"
