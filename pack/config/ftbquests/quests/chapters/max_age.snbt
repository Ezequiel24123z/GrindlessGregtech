		}
		{
			dependencies: ["764F18E0B5749AFE"]
			description: ["The &6Horizon Interferometer&r reads the light that the closed shell returns and maps the cloud of phases around the hole. Its second mode calibrates oscillators against that map. A closed shell that has run its first recipe. The body is 2,837 blocks: 753 truss and 266 optical table casings among others, so the Terminal needs 2 passes. The cloud phase map and the calibrated oscillator bank of the last recipe. Maps and banks leave by bus; keep the oscillators on their own line."]
			icon: "gtceu:horizon_interferometer"
			id: "75EEF916B1DD0828"
			rewards: [{ id: "383CF33D745FFAEF", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "325C66A59E6138DF", item: "gtceu:horizon_interferometer", type: "item" }]
			title: "Horizon Interferometer"
			x: 67.5d
			y: 15.0d
		}
		{
			dependencies: ["75EEF916B1DD0828"]
			description: ["The &6Cloud Phase Map&r holds the phase of the light at every point of the shell. The &6Calibrated Oscillator Bank&r keeps a clock against it. The last recipe wants both."]
