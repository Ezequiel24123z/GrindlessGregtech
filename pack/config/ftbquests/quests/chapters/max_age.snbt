		}
		{
			dependencies: ["3B9E83D6E75352E8"]
			description: ["A cooler the size of a house keeps the shell below the temperature of the sky. The &6Shell Cryocooler&r goes into the shell's controller and into every segment, so it is made by the thousand."]
			icon: "grindless:shell_cryocooler"
			id: "327C37975E5EFBA1"
