		}
		{
			dependencies: ["33DDC08F5E410B5F"]
			description: ["AE2 has no new tier at MAX. The far rings of the platforms around the hole seed a network of their own, and the wireless network carries it home."]
			icon: "ae2:controller"
			id: "36D6484248E3C605"
