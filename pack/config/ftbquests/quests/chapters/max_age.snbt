			x: 76.0d
			y: 60.5d
		}
		{
			dependencies: ["14884E6E5042EC63"]
			description: ["A europium-doped crystal is burned with a spectral hole pattern and pigtailed with fibre: a memory that holds a photon. The &6Crystal Growth Furnace&r, &6Spectral Hole Burner&r and &6Fibre Draw Tower&r. The Photon Ring Imager. A short line; make a few and keep them in a chest."]
			icon: "grindless:quantum_memory_node"
			id: "577223EE824085B3"
			rewards: [{ id: "74FA8B15FF446FE8", type: "xp", xp: 100 }]
