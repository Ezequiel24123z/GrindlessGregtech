		}
		{
			dependencies: ["348A116DE7098B29"]
			description: ["The &6SRF Cavity Works&r takes MAX rows for the superconducting-jacketed pellet, the MAX SRF cavity and the niobium driver cell. The UV controller you already own and RRR niobium sheet. Each row gives niobium scrap back. The jacketed pellet, the MAX cavity and the driver cell. Cavities by bus; send each output to its own line."]
			icon: "gtceu:srf_cavity_works"
			id: "118F1A3968FC4666"
			rewards: [{ id: "7B2CDD835EBD8F6A", type: "xp", xp: 120 }]
