		}
		{
			dependencies: ["577223EE824085B3"]
			description: ["A core of degenerate matter, compressed under a megabar and cased in SiC: the payload of the Penrose process. The &6Degenerate Works&r, &6Megabar Press&r and &6Spark Plasma Sinterer&r. The Penrose extraction recipe. One payload per run: queue them by pattern."]
			icon: "grindless:max_penrose_payload"
