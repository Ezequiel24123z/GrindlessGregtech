		}
		{
			dependencies: ["555BF9154BD47D91"]
			description: ["Grazing-incidence mirrors of iridium-coated SiC that focus X-rays. They are made from platinum-group residue. In a &6Assembler&r: 4 Iridium Coated Shell, 2 Tritanium Plate, 4 Tritanium Foil, 2 Tritanium Round, a MAX circuit, a Fine Gold Wire and more. The Accretion Feeder. Keep a stock."]
			icon: "grindless:wolter_mirror_module"
			id: "11E5921B9205E44D"
			rewards: [{ id: "7F8113D7BB847A49", type: "xp", xp: 60 }]
