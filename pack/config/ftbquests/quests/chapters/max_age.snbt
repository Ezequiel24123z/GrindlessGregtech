		}
		{
			dependencies: ["38EC1422CD925532"]
			description: ["Every segment is set and the last gap in the frame is closed. Check it off once the controller says the shell has formed."]
			icon: "grindless:mirror_shell_segment"
			id: "764F18E0B5749AFE"
			rewards: [{ id: "102D8F36795CFA36", type: "xp", xp: 150 }]
