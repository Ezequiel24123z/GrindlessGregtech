			y: 35.5d
		}
		{
			dependencies: ["7BDFDAE56D37A306"]
			description: ["The Rydberg array is the logic of the genome archive and the horizon lock: a gallium arsenide laser die, a rubidium-87 atom cartridge, a UV fibre harness and a crossed acousto-optic pair, set in a tweezer array. The &6MOCVD Reactor&r, &6Calutron&r and &6Quantum Gas Lab&r for die and atoms, the &6Fibre Draw Tower&r and &6Femtosecond Writer&r for the harness, the &6Spintronic Cluster Tool&r for the AOD. The Rydberg Array Works, then the Gene Ark, the photon ring imager and the horizon lock. A spent array is refilled with a new atom cartridge in a short recipe: loop it home by conveyor."]
			icon: "grindless:rydberg_logic_array"
			id: "3BF4D5302515D048"
			rewards: [{ id: "170ED21257C272F1", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3F12EF44DB95AEB5", item: "grindless:rydberg_logic_array", type: "item" }]
			title: "M8: Rydberg Atoms"
			x: 76.0d
			y: 38.0d
		}
		{
			dependencies: ["3BF4D5302515D048"]
			description: ["The laser die is grown on a gallium arsenide wafer in the MOCVD Reactor. In a &6Mocvd&r: a Gallium Arsenide Wafer, a Indium Dust, a Aluminium Dust, programmed circuit 26, trimethylgallium, arsine. The Rydberg logic array. Stock by ME: the array takes one."]
			icon: "grindless:rydberg_laser_die"
			id: "7EE3AB904CB79C50"
			rewards: [{ id: "77FDDCDFB1906AF4", type: "xp", xp: 60 }]
