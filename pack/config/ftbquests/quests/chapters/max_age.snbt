		}
		{
			dependencies: ["128160668A25AF7B"]
			description: ["A diamond photocell for extreme ultraviolet: pin-doped, metallised and built into a panel. The &6Diamond Lattice Fab&r, &6Betavoltaic Fab&r and &6Solar Array Fab&r. The Accretion Feeder. Keep a spare stock."]
			icon: "grindless:xuv_collector_panel"
