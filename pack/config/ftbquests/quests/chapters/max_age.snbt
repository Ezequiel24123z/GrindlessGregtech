		{
			dependencies: ["5246FF455E6244E1"]
			description: ["The &6Horizon Strand Repeater&r is the link part of the MAX wireless hatches: the energy hatch and the dynamo hatch each take repeaters in their recipe. Horizon strand wire, a chain strand repeater and a MAX sensor, with solder and lubricant, in an assembler at MAX voltage. The MAX wireless energy and dynamo hatches. Nothing to feed: make a stock of repeaters for the hatches."]
			icon: "grindless:horizon_strand_repeater"
			id: "1B14456734D691CA"
			rewards: [{ id: "1F65A4F29D932823", type: "xp", xp: 100 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "1F50C451C8209025", item: "grindless:horizon_strand_repeater", type: "item" }]
			title: "Strand Repeater"
			x: 12.5d
			y: -6.0d
		}
		{
			dependencies: ["1B14456734D691CA"]
			description: ["The &6MAX SMES Cell&r is the store of the last tier. A tower that holds one lifts the whole wireless network to MAX. Horizon strand wire, cold SMES toroids and MAX field generators, in an assembler at MAX voltage. The network at MAX tier. Nothing to feed. Size the towers for your busiest hour."]
			icon: "grindless:max_smes_cell"
			id: "586558AD36EEC6F4"
			rewards: [{ id: "3E097F99F8E85CB1", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "3C6C288DA65A5FC2", item: "grindless:max_smes_cell", type: "item" }]
			title: "The MAX Cell"
			x: 15.0d
			y: -6.0d
		}
		{
			dependencies: ["586558AD36EEC6F4"]
			description: ["Move your towers onto &6MAX SMES Cells&r and the wireless network carries MAX to every platform, the black hole orbit and the belt included. One formed tower holding a MAX cell: the network runs at its strongest cell, so until then it stays at OpV. The MAX wireless hatches. Add cells when the network dips at your busiest hour."]
			icon: "gtceu:max_wireless_energy_hatch"
			id: "1B62C1279BB0415F"
			rewards: [{ id: "734628D4DEC748A7", type: "xp", xp: 200 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "1103D67371DA1028", item: "gtceu:max_wireless_energy_hatch", type: "item" }
				{ id: "745067A598835901", item: "gtceu:max_wireless_dynamo_hatch", type: "item" }
			]
			title: "The Network Goes MAX"
			x: 17.5d
			y: -6.0d
		}
		{
			dependencies: ["5FD613EAED3F564B"]
			description: ["The &6Maximum Parallel Control Hatch&r is the widest hatch of the MAX tier; the MAX+ chapter has one wider still. Behind it a mega machine runs many recipes at once. A MAX hull, field generators and robot arms, in an assembly line researched with the OpV parallel hatch, and a mega machine that takes parallel hatches. The MAX+ parallel hatch, and mega machines at a wider run. Feed it by wide buses and watch the network, since the load grows with the width."]
			icon: "gtceu:max_parallel_hatch"
			id: "3443B6F290684B46"
			rewards: [{ id: "12BE61280C48CC3E", type: "xp", xp: 200 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "79F944DF014AEC5A", item: "gtceu:max_parallel_hatch", type: "item" }]
			title: "The MAX Parallel Hatch"
			x: 7.5d
			y: 5.5d
		}
		{
			dependencies: ["33DDC08F5E410B5F"]
			description: ["AE2 has no new tier at MAX. Every relay platform comes with an AE2 controller and a drive of its own, so a network starts there the moment you arrive."]
			icon: "ae2:controller"
			id: "36D6484248E3C605"
			rewards: [{ id: "78401C2FB4EBB1D4", type: "xp", xp: 50 }]
			shape: "rsquare"
			size: 1.25d
			tasks: [{ id: "5936627BCE03C58E", type: "checkmark" }]
			title: "AE2 at the Centre"
			x: 22.5d
			y: -9.0d
		}
		{
			dependencies: ["348A116DE7098B29"]
			description: ["The &6Geroch Winch&r lowers a tether over the horizon and takes power from the spin of the hole. Each run uses up a canister and wears the tether. A formed winch at the black hole orbit, a Geroch canister and a tether for each run. The first MAX power from the spin of the hole. Canisters and tethers arrive over AE2; the worn tether segment is an output, so route it."]
			icon: "gtceu:geroch_winch"
			id: "51FFBC5A2B05B2CA"
			rewards: [{ id: "3594E213E47CBE1B", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5E47BD4C13DAF44D", item: "grindless:horizon_tether", type: "item" }]
			title: "Power From the Spin"
			x: 32.5d
			y: -8.5d
		}
		{
			dependencies: ["51FFBC5A2B05B2CA"]
			description: ["The &6Penrose Engine&r drops a payload into the ergosphere and collects more energy than it spent. The excess comes from the rotation of the hole. A formed engine and payloads from the payload line. A big, steady supply of MAX power for the network. One payload per cycle by bus; the spent casing goes back to the line."]
			icon: "gtceu:penrose_engine"
			id: "7AEEF7B6A57C9C2F"
			rewards: [{ id: "36B8EC02DB7779C8", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "70C9D7DE9B1AA42B", item: "gtceu:penrose_engine", type: "item" }
				{ id: "7758449AE46EDC8F", item: "grindless:max_penrose_payload", type: "item" }
			]
			title: "The Penrose Engine"
			x: 35.0d
			y: -8.5d
		}
		{
			dependencies: ["7AEEF7B6A57C9C2F"]
			description: ["Once the &6Mirror Shell&r is up it has a power mode of its own, the vent, which lets back out part of the light the shell returned to the hole. A closed shell and a seed wave packet to start it. Power drawn from the shell instead of fuel, for as long as the packet lasts. Packets arrive by bus; watch the network at the start of each one."]
			icon: "gtceu:mirror_shell"
			id: "766DF39BA6B1F04B"
			rewards: [{ id: "7D443B3FFBDB9DA9", type: "xp", xp: 150 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "3F75F91B83771163", item: "grindless:spent_wave_packet", type: "item" }]
			title: "The Shell Vent"
			x: 37.5d
			y: -8.5d
		}
		{
			dependencies: ["33DDC08F5E410B5F"]
			description: ["The &6Accretion Disk Skimmer&r, &6Plasma Mass Filter&r, &6FRC Former&r and &6BZ Dynamo&r each take a mode that works on matter from the disc: hot flow, filtered flow, a flux-loaded FRC and a dynamo that spins down on it. The UXV controllers you already own, and the hot flow from the black hole orbit. The fuels and feeds of the machines of the era. Flow by pipe from the orbit; send filtered cuts to their own lines. The skimmer and the former wear metallic hydrogen windings, so keep some stocked."]
			icon: "gtceu:accretion_disk_skimmer"
			id: "13E6AE6FF32324EA"
			rewards: [{ id: "5E62E0C09FF5ABDE", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "5199EED90A953356", item: "gtceu:accretion_disk_skimmer", type: "item" }
				{ id: "791C7468C86322D9", item: "gtceu:plasma_mass_filter", type: "item" }
				{ id: "37FA81C1B419A0AA", item: "gtceu:frc_former", type: "item" }
				{ id: "71F0B0C0620E4DCD", item: "gtceu:bz_dynamo", type: "item" }
			]
			title: "Disc and Plasma"
			x: 22.5d
			y: -7.0d
		}
		{
			dependencies: ["33DDC08F5E410B5F"]
			description: ["The &6Droplet Radiator Works&r and &6Femtosecond Writer&r each take MAX rows: the radiator works builds the shell droplet radiator, and the writer makes the droplet nozzle plate, the squeezer and isolator waveguide dies, the trimmed microring, the end-capped fibre and the welded glass cell. The UIV controllers you already own. The shell radiator and the parts the squeezed-light line uses. Plates by bus; send each output to its own line."]
			icon: "gtceu:femtosecond_writer"
			id: "76DCCA9EC423CC9E"
			rewards: [{ id: "7945EBF0B5F413F0", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "7F27923BF2DB16BB", item: "gtceu:droplet_radiator_works", type: "item" }
				{ id: "5AD9314FCED03C6B", item: "gtceu:femtosecond_writer", type: "item" }
			]
			title: "Radiators and Writers"
			x: 27.5d
			y: -7.0d
		}
		{
			dependencies: ["5FD613EAED3F564B"]
			description: ["The &6Megabar Press&r and &6Degenerate Harvester&r each take MAX rows: the press makes the payload core, the dense pellet, the densified truss billet, the counterweight core and the degenerate compact, and the harvester gathers the degenerate matter slug at Sagittarius A*. The UEV controllers you already own. The harvester runs at the black hole orbit. The payload core, the dense pellet, the truss billet, the counterweight core and the slug. Matter and plates by bus. The spent slug is an output, so route it."]
			icon: "gtceu:degenerate_harvester"
			id: "5489EFFC1AA7E360"
			rewards: [{ id: "560573A101E3989F", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [
				{ id: "781506391F745E05", item: "gtceu:megabar_press", type: "item" }
				{ id: "357099CDDB5C7D32", item: "gtceu:degenerate_harvester", type: "item" }
			]
			title: "Press and Harvest"
			x: 10.0d
			y: 6.5d
		}
		{
			dependencies: ["5FD613EAED3F564B"]
			description: ["The &6Spark Plasma Sinterer&r takes MAX rows that sinter the exotic composite billet, the radiator collector shell, the payload casing, the Ta-Hf-C billet and the slag pellet. The UHV controller you already own. The billets, the collector shell, the payload casing and the slag pellets the feeder burns. Powders by bus; the billets go straight to the next line."]
			icon: "gtceu:spark_plasma_sinterer"
			id: "179AD382D4871413"
			rewards: [{ id: "3B9CBBF04931AFC3", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "74A6221BDF92FA9C", item: "gtceu:spark_plasma_sinterer", type: "item" }]
			title: "Sintered Parts"
			x: 7.5d
			y: 7.0d
		}
		{
			dependencies: ["348A116DE7098B29"]
			description: ["The &6SRF Cavity Works&r takes MAX rows for the superconducting-jacketed pellet, the MAX SRF cavity and the niobium driver cell. The UV controller you already own and RRR niobium sheet. Each row gives niobium scrap back. The jacketed pellet, the MAX cavity and the driver cell. Cavities by bus; send each output to its own line."]
			icon: "gtceu:srf_cavity_works"
			id: "118F1A3968FC4666"
			rewards: [{ id: "7B2CDD835EBD8F6A", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "74CE152954DC8C45", item: "gtceu:srf_cavity_works", type: "item" }]
			title: "Pellets and Cavities"
			x: 27.5d
			y: -12.0d
		}
		{
			dependencies: ["305F48FF31D86B06"]
			description: ["The &6Rare Earth Extraction Cascade&r takes fourteen MAX rows: the Er/Ho and Tb/Dy cuts, the YBCO precursor and the Y-Ba-Cu raffinate, hafnia and the Ta-Hf oxide of the hearth liner, cathode copper, vanadium pentoxide, indium sulfate and the tin-lithium eutectic, plus returns for spent ferric chloride, fatigued VO2 sheets and Sn-Li dross. The EV controller you already own. Feeds for most MAX lines, from the cryocooler's regenerator to the belt furnace's hearth liner and the droplet radiator. Feeds by bus; each product leaves on its own line, and the spent sheets and dross come back in."]
			icon: "gtceu:extraction_cascade"
			id: "55A4165DF8CEC24B"
			rewards: [{ id: "1155FD6B4932DB0D", type: "xp", xp: 120 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "193EBEF715488E94", item: "gtceu:extraction_cascade", type: "item" }]
			title: "Cuts and Returns"
			x: 30.0d
			y: -10.0d
		}
		{
			dependencies: ["3F1C487831920064"]
			description: ["The processing lines of the era: strands and tethers, cold metrology, the supracausal stage, Rydberg atoms, the genome archive, the ring imager, the shell segment and the horizon lock, then the shorter lines. Each is taught once; the chart shows every step."]
			icon: "gtnn:supracausal_mainframe"
			id: "1F6C5F7F2EA6FE33"
			rewards: [ ]
			shape: "circle"
			size: 0.75d
			tasks: [{ id: "350561F28B1C9772", type: "checkmark" }]
			title: "MAX lines"
			x: 76.0d
			y: 28.0d
		}
		{
			dependencies: ["1F6C5F7F2EA6FE33"]
			description: ["The horizon strand is the wire of the era: stable exotic matter is clad in foil, drawn into a single-crystal strand and sleeved in PBO braid. A second row turns a ribbon into the horizon tether. The &6Strangelet Vault&r for the foil, the &6Pasta Mill&r for preform and wire, the &6PBO Plant&r for the sleeve, the &6Tether Ribbon Works&r and &6Stellar Elevator&r for the tether. Every MAX cable and casing is built from the strand; the tether is what the Geroch winch hangs from. One belt per row: the clad stages feed the Pasta Mill by pipe and ME, and the cable only needs a steady PBO supply."]
			icon: "gtceu:horizon_strand_single_wire"
			id: "3050646667F96AEE"
			rewards: [{ id: "1102E65340B5D5D8", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "30205099F0D9C464", item: "gtceu:horizon_strand_single_cable", type: "item" }]
			title: "M2: Strand and Tether"
			x: 76.0d
			y: 30.5d
		}
		{
			dependencies: ["3050646667F96AEE"]
			description: ["Stable exotic matter is too violent to draw bare. The foil that clads it is made in a Strangelet Vault, a multiblock new to this line. In a &6Strangelet Growth&r: a Stable Exotic Matter, a Boron Dust, programmed circuit 4, water. The clad chain strand. Give the vault its own feed of stable exotic matter and stock the foil by ME."]
			icon: "grindless:exotic_cladding_foil"
			id: "53A4914E9B5D332B"
			rewards: [{ id: "3CA6142B7011F963", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5BEEA6925C223F88", item: "grindless:exotic_cladding_foil", type: "item" }]
			title: "Exotic Cladding Foil"
			x: 78.5d
			y: 30.5d
		}
		{
			dependencies: ["53A4914E9B5D332B"]
			description: ["The Pasta Mill extrudes the clad strand into a preform, then draws the preform into the wire: one machine, two recipes. In a &6Pasta Drawing&r: a Clad Chain Strand, programmed circuit 5. The single wire, and with it every strand cable and casing. Let ME choose the recipe by pattern; one mill serves both."]
			icon: "grindless:horizon_strand_preform"
			id: "38325EE011F437FB"
			rewards: [{ id: "3A3054F4F04C8ADD", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "17864A5390CB1229", item: "grindless:horizon_strand_preform", type: "item" }]
			title: "Horizon Strand Preform"
			x: 81.0d
			y: 30.5d
		}
		{
			dependencies: ["38325EE011F437FB"]
			description: ["The tether row begins by loading each ribbon in the Stellar Elevator, a lift that works only in orbit. In a &6Star Lifting&r: a Strand Ribbon, programmed circuit 3, stellar plasma. The coated and cured ribbon, then the horizon tether. Feed ribbons by ME; the elevator takes one run at a time."]
			icon: "grindless:proof_loaded_ribbon"
			id: "17DE80CB7AC8EE72"
			rewards: [{ id: "1B41B0B7AAF3FB6C", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "54AC7BAAD7CE8D96", item: "grindless:proof_loaded_ribbon", type: "item" }]
			title: "Proof Loaded Ribbon"
			x: 83.5d
			y: 30.5d
		}
		{
			dependencies: ["3050646667F96AEE"]
			description: ["The cold parts every MAX machine is built from: superfluid valve, gradiometer, field coil, composite rod, membrane belt, optical isolator, magnetic bearing and Terfenol stack. The valve row is the longest line of the era. The &6Aerogel Works&r, &6SHeQUID Works&r and &6Millikelvin Cryostat Works&r for the valve, the &6Atom Interferometer Works&r for the gradiometer, the &6Rare Earth Extraction Cascade&r for YBCO and Tb-Dy. The tensegrity truss (composite rods), the clamp coil casings (field coils) and every MAX machine that wants a cold part. Each row ends in a part that waits in ME. The cold stages share one helium refrigerator loop, and the reclamation row feeds YBCO back so it never runs dry."]
			icon: "grindless:matter_wave_gradiometer"
			id: "190860EE07AF5EA6"
			rewards: [{ id: "75967F11526CE8FF", type: "xp", xp: 100 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "52D0490BA85A6904", item: "grindless:superfluid_valve", type: "item" }]
			title: "M5: Cold Metrology"
			x: 76.0d
			y: 33.0d
		}
		{
			dependencies: ["190860EE07AF5EA6"]
			description: ["A silica aerogel is the plug through which only superfluid passes. The Aerogel Works makes it, starting a seven-step row. In a &6Supercritical Drying&r: 2 Silylated Alcogel, ethanol, carbon dioxide. The potted and calibrated superleak, then the valve. The first stages are slow: run several works side by side."]
			icon: "grindless:aerogel_superleak_plug"
			id: "3115DB854BCEC7FF"
			rewards: [{ id: "736078FFFDD1EFC6", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "7F1BE5BA4782A9FE", item: "grindless:aerogel_superleak_plug", type: "item" }]
			title: "Aerogel Superleak Plug"
			x: 78.5d
			y: 33.0d
		}
		{
			dependencies: ["3115DB854BCEC7FF"]
			description: ["Each superleak is cold-tested in the Millikelvin Cryostat Works before it becomes a valve; a bad one never leaves. In a &6Nuclear Demagnetisation&r: a Calibrated Superleak, a Mk Cryostat Module, programmed circuit 11, he3 he4 mixture. The superfluid valve. Send only calibrated superleaks in; the cryostat holds the run."]
			icon: "grindless:cold_tested_superleak"
			id: "54870062EC077330"
			rewards: [{ id: "12CE866A77E53E83", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5C2D02D38EC874ED", item: "grindless:cold_tested_superleak", type: "item" }]
			title: "Cold Tested Superleak"
			x: 81.0d
			y: 33.0d
		}
		{
			dependencies: ["54870062EC077330"]
			description: ["The field coil starts as a REBCO tape on an ITBTC coated conductor. The Coated Conductor Line makes it. In a &6Coated Conductor&r: 4 Itbtc Coated Conductor, 2 Horizon Strand Single Wire, programmed circuit 5, epoxy. The stabilised tape, the CMC coil former, the winding and the field coil. The line is continuous: feed it by ME and cap the tape."]
			icon: "grindless:rebco_tape_max"
			id: "5782583C2489AE07"
			rewards: [{ id: "5F1C96FA5566F2E6", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "5E36755EAB212229", item: "grindless:rebco_tape_max", type: "item" }]
			title: "REBCO Tape"
			x: 83.5d
			y: 33.0d
		}
		{
			dependencies: ["5782583C2489AE07"]
			description: ["A SiC preform is infiltrated with exotic matter and sintered in the Spark Plasma Sinterer, then balanced. In a &6Spark Plasma Sintering&r: a Exotic Infiltrated Preform, 2 Graphite Dust, programmed circuit 21. The balanced billet and the exotic composite rod of the truss. The sinterer is slow: buffer preforms in front of it."]
			icon: "grindless:exotic_composite_billet"
			id: "549A961A70CB3A42"
			rewards: [{ id: "150A8C3EA1395736", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "133F432114344EF6", item: "grindless:exotic_composite_billet", type: "item" }]
			title: "Exotic Composite Billet"
			x: 86.0d
			y: 33.0d
		}
		{
			dependencies: ["549A961A70CB3A42"]
			description: ["A bismuth-doped YIG film is grown by liquid-phase epitaxy, then bonded to lithium niobate for the optical isolator. In a &6Liquid Phase Epitaxy&r: a Yig Film Wafer, 2 Bismuth Dust, a Pt Lpe Crucible, programmed circuit 4, lpe flux. The isolator waveguide die and the MAX optical isolator. The furnace takes a batch at a time; stock the film."]
			icon: "grindless:bi_yig_film"
			id: "1BF1576EBF436BA5"
			rewards: [{ id: "3AA69545D9574D9F", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
			tasks: [{ id: "192D7481EA84BBB9", item: "grindless:bi_yig_film", type: "item" }]
			title: "Bi:YIG Film"
			x: 88.5d
			y: 33.0d
		}
		{
			dependencies: ["1BF1576EBF436BA5"]
			description: ["A single-crystal YBCO bulk is irradiated in the High Flux Reactor to pin its flux, so it can float a rotor. In a &6High Flux Irradiation&r: a Tsmg Ybco Bulk, a Californium 252 Source, programmed circuit 5, helium. The bearing rotor ring and the magnetic bearing. The reactor is shared with other lines: give this row its own slot."]
			icon: "grindless:irradiated_ybco_bulk"
			id: "7690AA593CC7CD25"
			rewards: [{ id: "3DBE640F4C802675", type: "xp", xp: 60 }]
			shape: "hexagon"
			size: 1.0d
