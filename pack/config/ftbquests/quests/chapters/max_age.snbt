		{
			dependencies: ["5FD613EAED3F564B"]
			description: ["The &6Megabar Press&r and &6Degenerate Harvester&r each take MAX rows: the press makes the payload core, the dense pellet, the densified truss billet, the counterweight core and the degenerate compact, and the harvester gathers the degenerate matter slug at Sagittarius A*. The UEV controllers you already own. The harvester runs at the black hole orbit. The payload core, the dense pellet, the truss billet, the counterweight core and the slug. Matter and plates by bus. The spent slug is an output, so route it."]
			icon: "gtceu:degenerate_harvester"
			id: "5489EFFC1AA7E360"
			rewards: [{ id: "560573A101E3989F", type: "xp", xp: 120 }]
