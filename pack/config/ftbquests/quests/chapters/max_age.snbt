			y: 35.5d
		}
		{
			dependencies: ["172E6E6F263912CF"]
			description: ["Light is added: two squeezed-light chips and ultrapure water in the Photonic Foundry, which returns the water. In a &6Photonic Foundry&r: a Transducer Bonded Stack, 2 Squeezed Light Chip, programmed circuit 17, ultrapure water. The calibrated photonic module. The water returns by pipe, so a loop covers it."]
			icon: "grindless:photonic_tetron_module"
			id: "7FE4061C2A0C630B"
			rewards: [{ id: "5A2761E09943DA1F", type: "xp", xp: 60 }]
