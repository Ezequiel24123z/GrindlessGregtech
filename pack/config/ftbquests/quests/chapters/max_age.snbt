			title: "Albedo Multilayer Panel"
			x: 76.0d
			y: 53.0d
		}
		{
			dependencies: ["1AADEAC4897A9C44"]
			description: ["A diamond power die switches current that silicon cannot: a plate is boron-doped by ion implant, metallised and cut into dies. The &6Diamond Lattice Fab&r, &6Ion Implanter&r, &6Spintronic Cluster Tool&r and &6SiC Device Fab&r. The MAX Battery, the Horizon Flux Clamp, the Cluster Light Furnace and the Mass Stream Injector. A few dies per hatch: keep a small stock by ME."]
			icon: "grindless:diamond_power_die"
			id: "34BD327FE06C9C6B"
			rewards: [{ id: "1A3180C03F9EB10F", type: "xp", xp: 100 }]
