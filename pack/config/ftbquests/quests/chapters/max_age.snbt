			y: 35.5d
		}
		{
			dependencies: ["3EFF5EFBF9CE73CD"]
			description: ["The Membrane Line wraps the module in a superconducting membrane, so the last step can hold it. In a &6Membrane Rolling&r: a Calibrated Photonic Module, a Superconducting Membrane, programmed circuit 4, liquid helium. The supracausal mainframe. Make it just before the hall needs it."]
			icon: "grindless:shielded_quantum_module"
