		}
		{
			dependencies: ["7EE3AB904CB79C50"]
			description: ["Rubidium-87 is separated in the Calutron and loaded into a cartridge in the Quantum Gas Lab. A spent array is refilled with a fresh cartridge. In a &6Quantum Degenerate Gas&r: a Rb87 Isotope, a Li Cooling Laser, a Ule Cavity, programmed circuit 6, helium. The Rydberg logic array and its refill. Keep a cartridge per array."]
			icon: "grindless:atom_cartridge_rb87"
			id: "736309345EB90546"
