		}
		{
			dependencies: ["39410922EEDADAC9"]
			description: ["A strand of matter that never crosses the horizon. &oFiction:&r a cable that carries MAX power, with no real counterpart. The hull and the repeater both need it. The strand preform is drawn at SGR 1806-20."]
			icon: "gtceu:horizon_strand_single_cable"
