			]
			title: "Mass Stream Injector"
			x: 22.5d
			y: -5.5d
		}
		{
			dependencies: ["53636F954A3A7FC5"]
			description: ["Bound to be laid in rings round the shell. Ask for them as the segments go up."]
			icon: "grindless:stream_bundle"
			id: "3D0AE7FBA92319CB"
			rewards: [{ id: "324DA15E6617906D", type: "xp", xp: 80 }]
			tasks: [{ id: "1E7B3F3B53E8E605", item: "grindless:stream_bundle", type: "item" }]
			title: "Stream Bundle"
			x: 25.0d
			y: -5.5d
		}
		{
			dependencies: ["71D59C41930835BE"]
			description: ["It melts belt rock with the concentrated light of the cluster, and heats, separates and casts in one structure. The &6Cluster-Light Furnace&r is the only source of segment truss and stream pellets in quantity. The MAX hull, a bowl of albedo panels over a sinter hearth, and sealed hearth liners. It works only in the NSC belt. The silicate slag the feeder burns, and the truss and pellets for the shell. The hearth lining wears, so keep spares; its slag and its volatiles each have somewhere to go."]
			icon: "gtceu:cluster_light_furnace"
			id: "1BF40431DAEF20FB"
			rewards: [{ id: "1EC1B6C316569CDB", type: "xp", xp: 120 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1C830E048DD9A4B1", item: "gtceu:cluster_light_furnace", type: "item" }
				{ id: "7E6C59379AB78DB7", item: "grindless:cluster_sinter_casing", type: "item" }
			]
			title: "Cluster-Light Furnace"
			x: 40.0d
			y: -12.0d
		}
		{
			dependencies: ["1BF40431DAEF20FB", "545B9E9D69F38F72"]
			description: ["What is left of the rock once the iron is out. It is not wasted: Mercury's solar vapour furnace bakes it by day, the regolith cell reduces it, and a compressor and the spark plasma sinterer turn the residue into slag pellets for the feeder."]
			icon: "grindless:silicate_slag"
			id: "5D95EF63D1BEB59B"
			rewards: [{ id: "7C96407501148827", type: "xp", xp: 80 }]
			tasks: [{ id: "12E213F3427931F6", item: "grindless:silicate_slag", type: "item" }]
			title: "Silicate Slag"
			x: 42.5d
			y: -12.0d
		}
		{
			dependencies: ["5D95EF63D1BEB59B"]
			description: ["Slag spiralling into a hole gives back more of its mass as light than anything else in the pack. The &6Accretion Feeder&r catches that light and turns it into power. The MAX hull, a ring of feeder coil casing with collector panels and Wolter mirror modules, and slag pellets. The burn itself runs in the black hole orbit, not in the belt. The biggest generator of the era, and a use for the slag. It wears its panels and modules as it works: rework them in the solar array fab and the assembler."]
			icon: "gtceu:accretion_feeder"
			id: "700822AA57C7AE85"
			rewards: [{ id: "139AD29C3DE765CC", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [
				{ id: "1EFF1CCFF2C3C087", item: "gtceu:accretion_feeder", type: "item" }
				{ id: "1EE538EDC6A2241B", item: "grindless:feeder_coil_casing", type: "item" }
			]
			title: "Accretion Feeder"
			x: 45.0d
			y: -12.0d
		}
	]
	subtitle: ["A probe to Sagittarius A*, a platform on the black hole's orbit and a belt of planetesimals: the way to the last recipe."]
	title: "MAX: The Galactic Centre"
