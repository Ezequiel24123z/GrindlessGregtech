		}
		{
			dependencies: ["5B675240F250EA89"]
			description: ["Two tellurium dioxide crystals, bonded and electroded, steer the tweezers in two directions. In a &6Assembler&r: 2 Electroded Aod, a Teo2 Aod Blank, a MAX circuit, 2 Tritanium Plate, 4 Tritanium Foil, 2 Horizon Strand Single Wire and more. The Rydberg logic array. Make two per array."]
			icon: "grindless:crossed_aod_pair"
