		{
			dependencies: ["327C37975E5EFBA1"]
			description: ["The &6Mirror Shell&r wraps the black hole in mirrors and sends its light back in. &oFiction:&r a shell like this cannot be built; the hole and its light are real. It is the largest structure in the pack. A two-layer sphere in a 35-block box at Sgr A* orbit, about 7,060 blocks: segments inside, a truss outside with two stream bundle belts, and 26 glass ports ringed by shell window coil casings. Hatches sit round the controller, at the equator of the front. The Terminal needs 4 passes of up to 2,300 blocks. The segments, the four horizon machines and the last recipe. Segments leave the line on a belt; plan the bus before you place the controller."]
			icon: "gtceu:mirror_shell"
			id: "3AD1F00AD8DB5003"
			rewards: [{ id: "16DE76451B228310", type: "xp", xp: 150 }]
			shape: "gear"
			size: 1.25d
			tasks: [{ id: "7B2B9B3553212E55", item: "gtceu:mirror_shell", type: "item" }]
			title: "Mirror Shell"
			x: 55.0d
			y: 18.5d
		}
		{
			dependencies: ["3AD1F00AD8DB5003"]
			description: ["About a quarter of the shell's segments are cut. The tether lines hold."]
			icon: "grindless:mirror_shell_segment"
			id: "719DCF42891758DC"
			rewards: [{ id: "5307F22096320918", type: "xp", xp: 100 }]
			tasks: [{ count: 871L, id: "76FC8B1EDE525FD6", item: "grindless:mirror_shell_segment", type: "item" }]
