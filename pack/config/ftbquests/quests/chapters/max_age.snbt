		}
		{
			dependencies: ["5DC7C7B13F7805BC"]
			description: ["When the hold completes, the launched probe comes back out of the ring, a platform appears at Sagittarius A*, and the ring's output bus gets its &6Relay Coordinates&r. Keep the launched probe: the gate to the belt spends it."]
			icon: "grindless:launched_gc_probe"
