			x: 93.5d
			y: 45.5d
		}
		{
			dependencies: ["7154D53F880CEAA8"]
			description: ["The last recipe of the age takes seed wave packets, stream bundles, phase locks, flux clamps and a Rydberg array, with the maps of the horizon interferometer. This chart is every input of it, row by row. The &6Ergoregion Synchroniser&r for the phase locks, the &6Horizon Flux Clamp&r, the &6Horizon Interferometer&r, the &6Kugelblitz Forge&r for the wave packets and the &6Mirror Shell&r. The horizon lock, the end of MAX and the opening of MAX+. Build the horizon machines once and queue the rows through them; the lock itself is one run."]
			icon: "grindless:horizon_lock"
			id: "7D04DB71D6DA59DC"
			rewards: [{ id: "589C618EA496C685", type: "xp", xp: 100 }]
