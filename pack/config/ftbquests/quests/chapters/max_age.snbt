			y: -10.0d
		}
		{
			dependencies: ["39410922EEDADAC9"]
			description: ["The machines of the era and the first steps that put each one to work."]
			icon: "minecraft:writable_book"
			id: "796D2CDBFAF7CCFF"
			rewards: [ ]
