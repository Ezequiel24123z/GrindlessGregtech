		}
		{
			dependencies: ["343CB9FB8854A4CA"]
			description: ["The &6MAX Fluid Regulator&r adds a superfluid valve and a tetron array to the pump, so it can meter a flow nobody can see."]
			icon: "grindless:max_fluid_regulator"
			id: "323F3AD3182A3174"
