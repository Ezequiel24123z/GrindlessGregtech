			title: "M3: Horizon Lock"
			x: 76.0d
			y: 48.0d
		}
		{
			dependencies: ["7D04DB71D6DA59DC"]
			description: ["A VO2 metasurface on sapphire that changes its impedance on command: a segment input and the first step of the phase lock. In a &6Assembler&r: 2 Metallised Metasurface, 4 Gold Foil, 2 Niobium Titanium Foil, a Uxv Sensor, a OPV circuit, soldering alloy. The horizon phase lock. Needed per segment and per lock: keep a stock."]
			icon: "grindless:tunable_impedance_sheet"
			id: "10EC59B617C0F47A"
			rewards: [{ id: "1E2EA3F4A82A5D4F", type: "xp", xp: 60 }]
