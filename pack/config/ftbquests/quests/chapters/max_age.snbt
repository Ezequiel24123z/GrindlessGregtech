			x: 57.5d
			y: 18.5d
		}
		{
			dependencies: ["719DCF42891758DC"]
			description: [
				"Half the segments of the mirror shell are cut. The shell is the reflector around the black hole seed, and it is built a segment at a time, so each half way is a reason to check the line."
				"Segments are cut in a long batch job. The cryocoolers hold the shell cold while it is cut, so charge them before each run and keep them charged. Send the segments into the frame by ME as they come; the count is large, so the check is the task below."
			]
			icon: "grindless:mirror_shell_segment"
			id: "5B3098B8ADC224F9"
			rewards: [{ id: "558CB855926E940D", type: "xp", xp: 100 }]
			tasks: [{ count: 1742L, id: "3403C91E134EA106", item: "grindless:mirror_shell_segment", type: "item" }]
			title: "Half the Shell"
			x: 60.0d
			y: 18.5d
		}
		{
			dependencies: ["5B3098B8ADC224F9"]
			description: ["Three quarters of the segments are cut and most of them are set in the frame. That is more than any inventory can hold, so check this off once the frame is that far along."]
			icon: "grindless:mirror_shell_segment"
			id: "38EC1422CD925532"
			rewards: [{ id: "11B52A0A417A783F", type: "xp", xp: 100 }]
