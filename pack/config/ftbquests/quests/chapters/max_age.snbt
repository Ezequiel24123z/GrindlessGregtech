		{
			dependencies: ["32D24E3C2D028686"]
			description: ["The &6Horizon Strand Repeater&r keeps the wireless network in step across the galaxy. Without one in each tower the MAX tier cannot reach the platforms at the centre. Horizon strand from the way in, and the assembly hall on two OpV hatches. The MAX cell and the MAX wireless tier. Nothing to feed: build the repeaters once and add one per new tower."]
			icon: "grindless:horizon_strand_repeater"
			id: "1B14456734D691CA"
			rewards: [{ id: "1F65A4F29D932823", type: "xp", xp: 100 }]
