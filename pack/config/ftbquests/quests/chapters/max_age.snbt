			x: 12.5d
			y: -6.0d
		}
		{
			dependencies: ["1B14456734D691CA"]
			description: ["The &6MAX SMES Cell&r is the store of the last tier. A tower that holds one lifts the whole wireless network to MAX. Horizon strand wire, cold SMES toroids and MAX field generators, in an assembler at MAX voltage. The network at MAX tier. Nothing to feed. Size the towers for your busiest hour."]
			icon: "grindless:max_smes_cell"
			id: "586558AD36EEC6F4"
			rewards: [{ id: "3E097F99F8E85CB1", type: "xp", xp: 200 }]
